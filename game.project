[project]
title = Matatu
version = 18.5.9
bundle_resources = /bundle
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.3.zip
dependencies#1 = https://github.com/defold/extension-gpgs/archive/refs/tags/4.2.0.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1
samples = 4
update_frequency = 60
dynamic_orientation = 0
resize_resolution = resize_full
variable_dt = 1

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[physics]
type = 2D

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[android]
package = com.matatu.champ
input_method = INPUT_METHOD_HIDDEN
minimum_sdk_version = 23

[gpgs]
app_id = 413944711733
use_saved_games = 0
request_server_auth_code = 1
force_refresh_token = 1
client_id = 413944711733-obti4e9cb3eu0jal7ol59s62lv0nkc7e.apps.googleusercontent.com
client_token = 413944711733-obti4e9cb3eu0jal7ol59s62lv0nkc7e.apps.googleusercontent.com

[firebase]
; SIGN-IN IS BACK ON GOOGLE PLAY GAMES. This section is now here for PUSH
; NOTIFICATIONS ONLY, and it is not optional for them.
;
; Firebase Cloud Messaging IS Firebase, so push cannot outlive the Firebase
; app. Defold does not apply the Google Services Gradle plugin, so
; google-services.json never becomes the string resources that would normally
; initialise FirebaseApp automatically — FirebaseAuthDefold.java builds
; FirebaseOptions from these four values by hand instead, and that same
; initialisation is what fetches the FCM token and creates the notification
; channels. Blank these out and notifications stop, silently.
project_id = matatu-7aba6
api_key = AIzaSyBwKWUFvhd5_vKPcxc3ViL_SotOqjA3wjU
app_id = 1:431938576253:android:4c5453fb238205b3d3b614
; Only ever read by the sign-in half of the extension, which nothing calls any
; more. Left in place because a blank value makes the extension refuse to
; initialise at all, and that would take messaging down with it.
web_client_id = 431938576253-53tdml3h9mrjb1eb6562k56ogqo9gsef.apps.googleusercontent.com

[websocket]
debug = 0
socket_timeout = 10000000

[sound]
max_component_count = 128

[network]
cleartext_traffic = 1
