# ext.manifest for the FirebaseAuth native extension.
#
# Separate from GameServices on purpose. That extension is push notifications
# and in-app updates — things the game can lose without anybody being locked
# out. This one is the front door, and keeping it apart means a build problem
# in one cannot take the other down with it.
name: "FirebaseAuth"

platforms:
  android:
    context:
      flags: []

  arm64-osx:
    context:
      flags: []

  x86_64-osx:
    context:
      flags: []
