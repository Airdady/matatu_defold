-- incoming.gui_script
-- GLOBAL incoming game/tournament request dialog. Lives on the controller
-- object above every screen (render order 15), so an opponent's challenge
-- surfaces ANYWHERE in the app — lobby, online, tournaments, themes, payments,
-- profile, in-game. Previously this dialog was driven only by the online
-- screen, so requests arriving on any other screen were silently missed.
--
-- This follows the proven global-overlay pattern of main/network.gui_script:
-- acquire input focus, render order 15, capture our own URL (ME), register WS
-- listeners that post back to ME (never touching gui.* from the socket owner's
-- context), and swallow input only while a dialog is actually visible.
--
-- Accept's screen transition is centralized elsewhere: accepting → backend →
-- game_request_accepted / game_start → controller.script shows the game. So the
-- accept handler here only sends ws.accept_game_request(id) and clears itself.

local ui     = require("modules.ui")
local ws     = require("modules.websocket_manager")
local screen = require("modules.screen")
local app_state = require("modules.app_state")
local dialog_incoming = require("modules.dialog_incoming")
-- THE TABLE YOU ARE SEATED AT takes this same surface. Distinct from the
-- party OFFER strip below (`dialog.party`), which is an invitation to a table
-- you are not at yet: this one (`dialog.party_table`) is the four chairs
-- filling, and it replaces the search dialog the online screen used to draw.
-- See the long note at the top of modules/dialog_party.lua.
local dialog_party = require("modules.dialog_party")
local api    = require("modules.api_service")
local toast  = require("modules.toast")
local budget = require("modules.incoming_budget")
local champ  = require("modules.championship")
-- The sender's win rate, drawn as a tier pill rather than a percentage. Same
-- module the two request dialogs, the online screen's inline strip and the
-- game-over panel use, so one player cannot be a PRO on one surface and
-- something else on the next.
local rank   = require("modules.rank_badge")

local LOGICAL_W, LOGICAL_H = 1280, 720

-- Only ever a BACKSTOP. Every roster carries the table's own closesAt and that
-- is what the countdown actually runs on; this is what a payload with no
-- deadline at all falls back to, so the dialog still has a clock rather than
-- none. Mirrors PARTY_JOIN_WINDOW_MS in be_matatu's partyRules.ts.
local PARTY_WINDOW_FALLBACK_SECONDS = 20

-- HOW LONG THE TABLE WAITS PAST ZERO BEFORE GIVING UP ON THE SERVER.
--
-- A table has no Cancel: the entry is committed on the seat, so nothing on
-- screen may close this dialog except the server saying the table dealt or was
-- called off. If neither ever arrives — a socket that drops during the twenty
-- seconds the table is open, which is exactly when it costs the most — the
-- player is left in a modal with no way out but restarting the app.
--
-- So zero is not the deadline, zero plus this is. Generous on purpose: the
-- window closing is not the end of the server's work, which still has to
-- charge four wallets, deal and send, and a failsafe that fired during that
-- would take the table away from a player who is about to be dealt in.
local PARTY_STALL_GRACE_SECONDS = 10
local CX, CY = 640, 360

-- ── Palette (mirrors the subset online.gui_script feeds dialog_incoming) ──────
local COL_DIM    = vmath.vector4(0.45, 0.45, 0.45, 1.0)
local COL_MID    = vmath.vector4(0.65, 0.65, 0.65, 1.0)
local COL_GOLD   = vmath.vector4(1.00, 0.84, 0.20, 1.0)
local COL_WHITE  = vmath.vector4(1.00, 1.00, 1.00, 1.0)
local COL_GREEN  = vmath.vector4(0.15, 0.70, 0.25, 1.0)
local COL_RED    = vmath.vector4(0.90, 0.25, 0.25, 1.0)
local COL_CYAN   = vmath.vector4(0.20, 0.90, 1.00, 1.0)

local C = {
    COL_DIM = COL_DIM, COL_MID = COL_MID, COL_GOLD = COL_GOLD, COL_WHITE = COL_WHITE,
    COL_GREEN = COL_GREEN, COL_RED = COL_RED, COL_CYAN = COL_CYAN,
}

local DLG_RED    = vmath.vector4(1.0, 0.40, 0.40, 1.0)
local DLG_AV_BG  = vmath.vector4(0.20, 0.20, 0.20, 0.50)
local DLG_SEARCH = vmath.vector4(1.0, 0.84, 0.00, 1.0)

local function refresh_wh()
    local m = screen.metrics()
    CX, CY = m.CX, m.CY
end

-- ── Node bookkeeping ──────────────────────────────────────────────────────────
local function clear(self)
    for _, n in ipairs(self.nodes) do pcall(gui.delete_node, n) end
    self.nodes, self.buttons = {}, {}
    -- Both countdown handles point into the list just deleted — the ordinary
    -- strip's and the championship strip's. Animating either afterwards is a
    -- call on a deleted node.
    self.ban_bar = nil
    self.ban_anim = nil
    -- The party table's per-frame record points at nodes in the list just
    -- deleted. Driving it afterwards is a gui call on a dead node, which takes
    -- the whole update() with it.
    self.party_anim = nil
end
local function track(self, n) self.nodes[#self.nodes+1] = n; return n end

local function commas(n) return (tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")) end

local function mkbtn(self, id, pos, size, label, style, data, font, text_color)
    local bg
    if type(style) == "string" then bg = track(self, ui.btn9(pos, size, style)) else bg = track(self, ui.box(pos, size, style)) end
    if label then
        local btn_font = font or (size.y >= 44 and "btn_md" or "btn_sm")
        track(self, ui.text(vmath.vector3(pos.x, pos.y - 3, pos.z), label, btn_font, text_color or COL_WHITE))
    end
    self.buttons[#self.buttons+1] = { node = bg, id = id, data = data }
    return bg
end

-- ── Dialog helpers passed to dialog_incoming via ctx ──────────────────────────
local function with_a(c, a) return vmath.vector4(c.x, c.y, c.z, c.w * (a or 1)) end

local function dlg_avatar(self, x, y, size, avatar_id, a)
    track(self, ui.pie(vmath.vector3(x, y, 0), size/2 + 6, with_a(DLG_AV_BG, a)))
    gui.set_color(track(self, ui.avatar(vmath.vector3(x, y, 0), vmath.vector3(size, size, 0), avatar_id)), vmath.vector4(1, 1, 1, a or 1))
end

local function dlg_timer(self, x, y, time_left, max_time, a)
    local frac, R = math.max(0, math.min(1, (time_left or 0) / (max_time or 10))), 34
    local bg = track(self, gui.new_pie_node(vmath.vector3(x, y, 0), vmath.vector3(R*2, R*2, 0))); gui.set_perimeter_vertices(bg, 48); pcall(gui.set_inner_radius, bg, R * 0.80); gui.set_color(bg, vmath.vector4(0.25, 0.25, 0.25, 0.45 * (a or 1)))
    local col = (time_left or 0) <= 3 and COL_RED or COL_CYAN
    local fg = track(self, gui.new_pie_node(vmath.vector3(x, y, 0), vmath.vector3(R*2, R*2, 0))); gui.set_perimeter_vertices(fg, 48); pcall(gui.set_inner_radius, fg, R * 0.80); gui.set_rotation(fg, vmath.vector3(0, 0, 90)); gui.set_fill_angle(fg, frac * 360); gui.set_color(fg, with_a(col, a))
    track(self, ui.text(vmath.vector3(x, y, 0), tostring(math.ceil(time_left or 0)), "title", with_a(col, a)))
end

local function h2h_view(h2h)
    if type(h2h) ~= "table" then return nil end
    local my_id, mine, theirs, opp_id = tostring(ws.get_current_user_id() or ""), 0, 0, nil
    if type(h2h.scores) == "table" then for pid, sc in pairs(h2h.scores) do if tostring(pid) == my_id then mine = tonumber(sc) or 0 else theirs = tonumber(sc) or 0; opp_id = tostring(pid) end end end
    return { p = mine, o = theirs, total = tonumber(h2h.totalGames) or 0, form = (type(h2h.form) == "table" and h2h.form[my_id]) or {}, opp_winrate = (opp_id and type(h2h.ratings) == "table" and type(h2h.ratings[opp_id]) == "table") and tonumber(h2h.ratings[opp_id].winRate) or nil }
end

local function draw_h2h_row(self, cx, y, view, a)
    if not view then return end
    gui.set_pivot(track(self, ui.text(vmath.vector3(cx - 78, y, 0), string.format("H2H %d - %d", view.p or 0, view.o or 0), "small", with_a(COL_GOLD, a))), gui.PIVOT_E)
    local n = math.min(5, #view.form)
    if n == 0 then gui.set_pivot(track(self, ui.text(vmath.vector3(cx - 64, y, 0), "First meeting", "small", with_a(COL_DIM, a))), gui.PIVOT_W); return end
    for i = 1, n do
        local r, col = tostring(view.form[i]), (tostring(view.form[i]) == "W") and COL_GREEN or COL_RED
        local bx = cx - 64 + (i - 1) * 28 + 11
        track(self, ui.box(vmath.vector3(bx, y, 0), vmath.vector3(22, 22, 0), with_a(col, 0.92 * (a or 1))))
        track(self, ui.text(vmath.vector3(bx, y, 0), r, "small", with_a(COL_WHITE, a)))
    end
end

local function make_ctx()
    return {
        C = C, ui = ui, track = track, mkbtn = mkbtn, commas = commas,
        CX = CX, CY = CY, LOGICAL_W = LOGICAL_W, LOGICAL_H = LOGICAL_H,
        DLG_RED = DLG_RED, DLG_SEARCH = DLG_SEARCH,
        with_a = with_a, dlg_avatar = dlg_avatar, dlg_timer = dlg_timer,
        h2h_view = h2h_view, draw_h2h_row = draw_h2h_row,
    }
end

-- ── Top banner (tournament / battle / knockout invites) ───────────────────────
-- The full-bleed strip across the top of the screen — the SAME surface the
-- online screen uses for these invites (main/online.gui_script's draw_banner),
-- so a tournament invite looks identical whether it arrives on the online
-- screen, the lobby, or mid-game. It replaces the small top-right notification
-- panel that used to live here: one banner, one look, one place to expect it.
--
-- It reuses the SAME button ids ("accept" / "decline") so on_input dispatches
-- exactly as the full dialog does. Non-modal by design — no scrim and no
-- "dlg_block" button, so input outside the two buttons falls through to
-- whatever is underneath (see on_input's banner branch).
local BAN_H       = 92
local BAN_PANEL   = vmath.vector4(0.06, 0.10, 0.14, 0.97)
local BAN_RULE    = vmath.vector4(0.20, 0.90, 1.00, 1.00)
local BAN_TITLE   = vmath.vector4(0.92, 0.96, 1.00, 1.00)
local BAN_DESC    = vmath.vector4(0.42, 0.56, 0.68, 1.00)
local BAN_AV_BG   = vmath.vector4(0.10, 0.14, 0.18, 1.00)
local BAN_TRACK   = vmath.vector4(0.12, 0.19, 0.27, 1.00)
local BAN_ACCEPT  = vmath.vector4(0.00, 0.90, 0.63, 0.30)

-- CHAMPIONSHIP badge. Red on purpose: this banner already carries ordinary
-- battles and one-level tournaments, and they look identical to a run at the
-- multi-level ladder. Accepting one costs a level of real progress, so it
-- should not be indistinguishable from a casual invite.
-- One entry per kind modules/championship.lua can name, identical to the table
-- in online.gui_script — the two surfaces show the SAME invite, so a colour
-- that differed would mean one request looked like two.
local BAN_BADGE = {
    CHAMPIONSHIP = { bg = vmath.vector4(0.78, 0.12, 0.16, 1.00), tx = vmath.vector4(1.00, 0.94, 0.94, 1.00) },
    KNOCKOUT     = { bg = vmath.vector4(0.90, 0.42, 0.05, 1.00), tx = vmath.vector4(1.00, 0.96, 0.90, 1.00) },
    BATTLE       = { bg = vmath.vector4(0.16, 0.42, 0.72, 1.00), tx = vmath.vector4(0.94, 0.97, 1.00, 1.00) },
    -- An open party table. Same violet the online screen's strip uses, for the
    -- same reason every other colour here is shared: the two surfaces draw the
    -- SAME offer, and one that changed colour with the screen would read as
    -- two different things.
    PARTY        = { bg = vmath.vector4(0.60, 0.25, 0.78, 1.00), tx = vmath.vector4(1.00, 0.96, 1.00, 1.00) },
}

-- WHERE THE INLINE BADGE GOES, AND WHY H2H MOVES FOR IT.
--
-- Same figures as online.gui_script's banner, because it is the same strip: the
-- right-hand side is laid out from the right edge, ACCEPT at R-90 and DECLINE
-- at R-225 (both 120 wide, so the buttons start at R-285), with the H2H block
-- anchored at R-430 running to about anchor+70. The 75px that leaves between
-- them is narrower than the word CHAMPIONSHIP, so the badge would sit on top of
-- the H2H form squares.
--
-- The H2H anchor therefore shifts left, and ONLY on a banner carrying the
-- badge, so every other invite keeps the layout it has today.
-- The slot reserved is the WIDEST label's, so every badge fits the space the
-- layout test checks — each pill is then drawn at its own width, centred on the
-- same point.
local BAN_H2H_X       = 430
local BAN_H2H_X_CHAMP = 560
local BAN_CHAMP_X     = 387
local BAN_CHAMP_W     = 132
local BAN_CHAMP_H     = 24

-- THE RANK PILL, on the LEFT of the strip and on the title line, where the
-- sender's name is. Height and the gap to the name it belongs to are constants
-- here and in online.gui_script for the same reason the figures above are: the
-- two surfaces draw the SAME invite, and the layout test asserts they have not
-- drifted apart.
local BAN_RANK_H      = 22
local BAN_RANK_GAP    = 10

-- THE JOIN STRIP IS A DIFFERENT ANSWER TO A DIFFERENT QUESTION, so it is a
-- different surface entirely: modules/champ_banner.lua draws it, and the online
-- screen's inline strip calls the same module. See the long note there for why
-- a championship offer does not belong in the same grey row as a match request,
-- and why it is written once rather than twice.
local champ_banner = require("modules.champ_banner")

-- SLIDING THE COUNTDOWN BAR, EVERY FRAME.
--
-- The bar used to be redrawn by rebuild(), and rebuild() only runs when the
-- WHOLE-SECOND counter changes — so a bar that should sweep smoothly across ten
-- seconds jumped in ten steps. Reported as "animating in bits".
--
-- Rebuilding per frame is not the fix: rebuild() deletes and recreates every
-- node on the strip, and doing that sixty times a second to slide a 3px bar is
-- not a trade worth making. So the fill node is created once and kept, and this
-- resizes it in place. The once-a-second rebuild stays exactly as it was, for
-- the things that really do only change once a second.
local function update_ban_bar(self, d)
    local bar = self.ban_bar
    if not bar or not d then return end
    local frac = math.max(0, math.min(1, (d.time_left or 0) / (d.max_time or 10)))
    local w = bar.w * frac
    gui.set_size(bar.node, vmath.vector3(w, 3, 0))
    -- Grows from the left edge, so the centre moves with the width.
    gui.set_position(bar.node, vmath.vector3(bar.left + w / 2, bar.y, 0))
    gui.set_color(bar.node, with_a(frac < 0.3 and COL_RED or COL_GREEN, bar.alpha))
end

-- Draws one pill, centred, sized to its label.
local function draw_badge(self, kind, x, y, h, a)
    local col = BAN_BADGE[kind]
    if not col then return end
    local w = champ.badge_width(kind)
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), with_a(col.bg, a)))
    track(self, ui.text(vmath.vector3(x, y, 0), kind, "small", with_a(col.tx, a)))
end

-- TEAM CUP badge. Purple, matching the lobby tile's accent, so an invitation
-- to somebody's cup is not mistaken at a glance for a match starting now —
-- the two arrive on the same strip and are answered on very different clocks.
local BAN_CUP_BG = vmath.vector4(0.596, 0.298, 0.796, 1.00)
local BAN_CUP_TX = vmath.vector4(1.00, 0.97, 1.00, 1.00)

-- How long a cup invitation stays on the strip.
--
-- Much longer than a game request's 10s, and — the part that matters — it
-- expires by HIDING, never by answering. A game request has to be resolved
-- either way, because an opponent is sitting there waiting; an invitation to a
-- cup that fills over hours has nobody waiting on it, and auto-declining one
-- the player merely did not look at in ten seconds would throw away the thing
-- the push notification was sent to deliver. The invitation stays on the TEAM
-- CUPS tile regardless.
local CUP_BANNER_SECONDS = 15

-- Which invites get the badge: modules/championship.lua, shared with the online
-- screen's inline banner and the game-over panel so one match cannot read as a
-- championship on one screen and an ordinary tournament on the next.
local BAN_DECLINE = vmath.vector4(0.12, 0.19, 0.27, 0.85)

local function draw_banner(self, d, a)
    local m  = screen.metrics()
    local bw = m.VW

    -- A CHAMPIONSHIP INVITE IS NOT AN ORDINARY GAME REQUEST, and gets its own
    -- surface — whether or not this player has joined. Grows downward from the
    -- same top edge so nothing above it moves.
    --
    -- Keyed on `championship`, NOT on `joining`. Those were conflated once and
    -- the design was invisible for it: it fired only for a player who had not
    -- joined, so everybody already in the championship saw the ordinary grey
    -- strip, and so did everybody on a server not yet sending `youHaveJoined`.
    if d.championship then
        local cy = m.T - 70 - (champ_banner.HEIGHT - BAN_H) / 2
        self.ban_anim = champ_banner.draw({
            track = function(node) return track(self, node) end,
            ui = ui,
            box = { L = m.L, R = m.R, CX = m.CX },
            button = function(kind, node)
                self.buttons[#self.buttons + 1] = { node = node, id = kind }
            end,
        }, d, cy, a)
        self.ban_bar = nil
        return
    end

    local cy = m.T - 70
    local top, bot = cy + BAN_H / 2, cy - BAN_H / 2

    track(self, ui.box(vmath.vector3(m.CX, cy, 0), vmath.vector3(bw, BAN_H, 0), with_a(BAN_PANEL, a)))
    track(self, ui.box(vmath.vector3(m.CX, top, 0), vmath.vector3(bw, 3, 0), with_a(BAN_RULE, a)))

    -- Sits ON the top rule, centred. A fixed position rather than trailing the
    -- title: the title carries a player name of unpredictable length, and the
    -- right-hand side is already crowded by H2H and the two buttons, so
    -- anything flowed from either end eventually collides with something.
    -- No centred badge on the rule. The invite carries its label inline,
    -- between the H2H block and the buttons, and having it twice on one strip
    -- said the same thing twice in two places.
    --
    -- TEAM CUP keeps the rule to itself: it is not a match request, it has no
    -- H2H and no inline slot to sit in, and it is answered on a different clock.
    if d.cup_invite then
        local pill_w, pill_h = 120, 22
        track(self, ui.box(vmath.vector3(m.CX, top, 0), vmath.vector3(pill_w, pill_h, 0),
            with_a(BAN_CUP_BG, a)))
        track(self, ui.text(vmath.vector3(m.CX, top, 0), "[TEAM CUP]", "small",
            with_a(BAN_CUP_TX, a)))
    end

    -- Sender avatar (framed disc) on the left.
    local av_x = m.L + 48
    track(self, ui.box(vmath.vector3(av_x, cy, 0), vmath.vector3(60, 60, 0), with_a(BAN_AV_BG, a)))
    gui.set_color(track(self, ui.avatar(vmath.vector3(av_x, cy, 0), vmath.vector3(54, 54, 0), d.avatar or 1)),
        with_a(COL_WHITE, a))

    -- Title + one-line description, left-aligned beside the avatar.
    --
    -- RANK PILL FIRST, THEN THE NAME. It LEADS the title line rather than
    -- trailing it: the title ends with a username of unpredictable length, and
    -- the space to its right is already spoken for by the H2H block, the kind
    -- badge and the two buttons, so a long name would march the pill straight
    -- into them. Leading it, the pill sits at a fixed x and pushes the title
    -- into the empty middle of the strip instead — the direction with slack.
    --
    -- Draws nothing and returns 0 for a sender with no rating, so an unrated
    -- invite keeps exactly the title position it has today.
    local rank_w = rank.draw(
        { track = function(n) return track(self, n) end, ui = ui },
        d.opp_winrate, m.L + 90 + rank.badge_width(d.opp_winrate) / 2, cy + 20,
        BAN_RANK_H, a)
    local title_x = m.L + 90 + (rank_w > 0 and (rank_w + BAN_RANK_GAP) or 0)
    gui.set_pivot(track(self, ui.text(vmath.vector3(title_x, cy + 20, 0),
        tostring(d.title or "GAME REQUEST"), "body", with_a(BAN_TITLE, a))), gui.PIVOT_W)
    gui.set_pivot(track(self, ui.text(vmath.vector3(m.L + 90, cy - 12, 0),
        tostring(d.desc or ""), "small", with_a(BAN_DESC, a))), gui.PIVOT_W)

    -- Actions on the right, in the same order as the online screen's banner.
    -- Labels are overridable because a cup invitation is not answered the way
    -- a match request is: there is no opponent waiting, so the left-hand button
    -- puts it off rather than turning it down.
    mkbtn(self, "decline", vmath.vector3(m.R - 225, cy, 0), vmath.vector3(120, 46, 0),
        d.decline_label or "DECLINE", with_a(BAN_DECLINE, a), nil, "btn_md", with_a(COL_MID, a))
    mkbtn(self, "accept",  vmath.vector3(m.R - 90,  cy, 0), vmath.vector3(120, 46, 0),
        d.accept_label or "ACCEPT",  with_a(BAN_ACCEPT,  a), nil, "btn_md", with_a(COL_WHITE, a))

    -- Inline badge: same centre line as the H2H row and the two buttons, in
    -- the space the shifted H2H anchor opens up.
    draw_badge(self, d.badge, m.R - BAN_CHAMP_X, cy, BAN_CHAMP_H, a)
    if d.h2h then
        draw_h2h_row(self, m.R - (d.badge and BAN_H2H_X_CHAMP or BAN_H2H_X), cy, h2h_view(d.h2h), a)
    end

    -- Countdown along the bottom edge. The fill is created unconditionally,
    -- even at zero width, because update_ban_bar resizes this exact node every
    -- frame — a node created only when there was something to show would not
    -- exist on the frames that need to grow it.
    track(self, ui.box(vmath.vector3(m.CX, bot, 0), vmath.vector3(bw, 3, 0), with_a(BAN_TRACK, a)))
    local fill = track(self, ui.box(vmath.vector3(m.L, bot, 0), vmath.vector3(0, 3, 0), with_a(COL_GREEN, a)))
    self.ban_bar = { node = fill, w = bw, left = m.L, y = bot, alpha = a }
    update_ban_bar(self, d)
end

-- ── Rendering ─────────────────────────────────────────────────────────────────
local function rebuild(self)
    clear(self)
    if not self.dialog then return end
    local ok, err = pcall(function()
        if self.dialog.party_table then
            dialog_party.draw(self, make_ctx(), self.dialog, self.dlg_alpha or 1)
        elseif self.dialog.banner then
            draw_banner(self, self.dialog, self.dlg_alpha or 1)
        else
            dialog_incoming.draw(self, make_ctx(), self.dialog, self.dlg_alpha or 1)
        end
    end)
    if not ok then
        print("[INCOMING] draw error: " .. tostring(err))
        clear(self)
        -- And DROP it. clear() alone leaves self.dialog set with no buttons in
        -- it, and on_input reads that as "a full dialog is up, swallow every
        -- tap" — an invisible modal over the whole app, with nothing on screen
        -- to explain it and nothing to press to get rid of it.
        --
        -- Losing one request to a draw error is a small, honest failure. The
        -- opponent gets their answer from the server's own timeout.
        self.dialog = nil
        app_state.modal_close("incoming")
    end
end

-- ── Dialog lifecycle ──────────────────────────────────────────────────────────
-- Banner wording for a PLAIN game request, which normally never needs any: it
-- gets the full dialog, and the dialog composes its own copy from the fields.
-- Used only when the input budget has run out and the challenge is being shown
-- on the non-blocking strip instead (see modules/incoming_budget.lua).
local function plain_banner_text(d)
    local amt = tonumber((d.stake or {}).amount) or 0
    return "GAME REQUEST  -  " .. tostring(d.name or "A PLAYER"):upper(),
           amt > 0 and (commas(amt * 2) .. " Coins pot") or "Practice Mode"
end

-- `d` is the request as it should be shown:
--   { name, stake, request_id, avatar, opponent_id, h2h, banner, title, desc }
-- A table rather than nine positional arguments — the last three exist only for
-- the banner, and threading them through as trailing nils was how the old
-- signature grew unreadable.
local function open_dialog(self, d)
    -- REPLACING an unanswered request.
    --
    -- A second request arriving before the first is answered overwrites
    -- self.dialog, and the player never sees the first one again. Leaving its
    -- request_id unanswered means the opponent sits watching a spinner until
    -- the server's own timeout expires — for a request that vanished off this
    -- screen seconds ago. Decline it now: that is what would have happened at
    -- its own 10-second mark anyway, just sooner and honestly.
    --
    -- Not for a cup invitation: it has no socket request behind it, and
    -- nobody is waiting on the answer.
    local prev = self.dialog
    if prev and not prev.cup_invite and prev.request_id and prev.request_id ~= ""
       and prev.request_id ~= d.request_id then
        pcall(ws.decline_game_request, prev.request_id)
    end

    -- TWO INVITES RUN ON SOMEBODY ELSE'S CLOCK, NOT THE TEN-SECOND ONE.
    --
    -- A cup invitation has nobody sitting waiting on the answer, so it gets a
    -- long window. A party table has a deadline that is not ours at all: the
    -- server closes it at closesAt — twenty seconds after it opened, so a
    -- strip arriving partway through has less than that — and a window of our
    -- own choosing would either offer a seat at a table that has already dealt
    -- or take one away while it is still filling.
    --
    -- Both also expire by HIDING rather than by answering (see update()):
    -- there is no request behind either of them to decline.
    local window = 10
    if d.cup_invite then window = CUP_BANNER_SECONDS
    elseif d.party_seconds then window = math.max(1, d.party_seconds) end

    -- A PLAIN CHALLENGE IS A DECISION, AND IT GETS THE CENTRED DIALOG.
    --
    -- Both surfaces exist here and the choice between them is not stylistic:
    --
    --   a TOURNAMENT, battle, knockout, championship or cup invite is the
    --     strip. It is one of several a player may be offered, often while
    --     they are doing something else, and none of them needs answering —
    --     letting one run out costs nothing
    --   a plain GAME REQUEST is one person asking THIS player for a game, with
    --     ten seconds on it and somebody watching the other end. It is the one
    --     invite where not answering IS an answer, and it takes the screen
    --
    -- It was made the strip too, on the argument that being challenged is not
    -- worth taking the app away from someone for. Asked for back: on the strip
    -- it read as a notification among notifications, which is exactly what it
    -- is not.
    --
    -- THE BUDGET IS WHY THE DIALOG IS SAFE. It claims "incoming" in the modal
    -- registry and every screen returns early from on_input while that claim
    -- is held — so a BURST of challenges, each restarting the ten seconds,
    -- could hold the whole app input-dead indefinitely. That is the freeze
    -- incoming_budget was written for: past 25 continuous seconds of blocking
    -- it demotes to the strip and stays there for a cooldown, so every request
    -- is still shown and still acceptable while the app works again. The
    -- dialog is the default; the strip is what a burst degrades to.
    -- COMPARED, NOT COERCED. budget.surface answers with a WORD — "banner" or
    -- "dialog" — and in Lua the string "dialog" is truthy, so
    --
    --     local as_banner = budget.surface(...)
    --
    -- made every plain challenge draw as a banner, which is the bug this line
    -- was supposed to fix. It read correctly, it tested correctly (the test
    -- asserted the CALL was there, not what it decided), and it was wrong on
    -- every request. Reported four times before I stopped believing the code
    -- and ran it.
    local as_banner = budget.surface(self.budget, d.banner and true or false) == "banner"
    local title, desc = d.title, d.desc
    -- Copy for the strip, and only when the strip is what will be drawn: the
    -- dialog composes its own from the fields. A request demoted by a burst
    -- gets it too, which is what `as_banner` rather than `d.banner` covers.
    if as_banner and not d.banner and not title then
        title, desc = plain_banner_text(d)
    end

    self.dialog = {
        kind = "incoming",
        name = d.name, stake = d.stake or {}, request_id = d.request_id,
        avatar = tonumber(d.avatar) or 1, time_left = window, max_time = window,
        opponent_id = d.opponent_id and tostring(d.opponent_id) or nil, h2h = d.h2h,
        -- Derived HERE rather than passed in, so every caller of open_dialog —
        -- the game request, the tournament invite, the cup invitation — gets
        -- the badge from the one head-to-head payload they all already carry,
        -- and none of them has to remember to thread a second field through.
        opp_winrate = (h2h_view(d.h2h) or {}).opp_winrate,
        -- The strip for an invite, the centred dialog for a plain challenge —
        -- and the strip for either once a burst has spent the input budget.
        banner = as_banner,
        title = title, desc = desc,
        -- NOT `kind`: that key is already taken by the dialog's own type
        -- ("incoming"), and a second `kind` in this constructor silently wins,
        -- which would send every plain game request down the wrong draw path.
        badge = d.badge,
        -- Team cup invitation: no request_id, answered over HTTP rather than
        -- the socket, and never auto-declined.
        cup_invite = d.cup_invite and true or false,
        cup_id = d.cup_id,
        -- An open party table: joined by id on the socket, never declined —
        -- LATER puts the strip away and tells nobody, because nobody asked.
        party = d.party and true or false,
        party_id = d.party_id,
        accept_label = d.accept_label, decline_label = d.decline_label,
    }
    self.dlg_alpha = 1
    -- Claim top input priority, or RELEASE it. Both directions, every time.
    --
    -- This used to only ever claim, and that is what froze the app.
    --
    -- A full dialog claims "incoming" in the modal registry. A banner
    -- deliberately does not, because it is non-disruptive and play carries on
    -- underneath it. But when a banner REPLACED a full dialog — a tournament
    -- invite landing while a plain game request was still on screen, which is
    -- exactly what happens when requests arrive in a burst — the claim from
    -- the dialog it replaced was left standing.
    --
    -- Every screen in the app begins its on_input with
    -- `if app_state.input_blocked() then return false end`, and that is true
    -- while ANY claim is held. So the visible thing was a banner that lets
    -- taps through, and the actual state was: nothing anywhere responds. No
    -- error, nothing on screen to explain it, and no way out but restarting
    -- the app.
    if self.dialog.banner then
        app_state.modal_close("incoming")
    else
        app_state.modal_open("incoming")
    end
    -- Audible cue when an opponent's challenge arrives. EVERY incoming request
    -- (normal, battle, tournament, knockout — full dialog or top banner) uses
    -- the same request.ogg cue (snd_notify on the sibling controller object).
    pcall(msg.post, "#snd_notify", "play_sound")
    refresh_wh()
    rebuild(self)
end

-- THE TABLE THIS PLAYER IS SEATED AT.
--
-- Deliberately not open_dialog: that one is built around a request id, a
-- ten-second window and an auto-decline at zero, and a table has none of the
-- three. What it does share is everything that matters — the modal claim, the
-- countdown, the rebuild, and the watchdogs in update() that stop a dialog
-- nobody can see from swallowing the app's input — so this sets the same
-- `self.dialog` record and lets update() and on_input drive it.
--
-- Called on EVERY roster, not just the first. A seat filling is a redraw of a
-- table that is already up, and the clock must not restart when it happens: a
-- countdown reset by each arrival is a table that never closes. Only a
-- DIFFERENT table resets it.
local function open_party_table(self, d)
    if type(d) ~= "table" then return end
    local view = dialog_party.view(d)
    if view.party_id == "" then return end

    local prev = self.dialog
    local same = prev and prev.party_table and prev.party_id == view.party_id

    -- WHO JUST SAT DOWN, said in words as well as drawn.
    --
    -- The chairs already show the table filling, but a player watching the
    -- clock does not necessarily catch WHICH chair changed — and partyView
    -- sends the seats in join order precisely so this is answerable. Named on
    -- arrival, once, and never for our own seat: the player knows they joined.
    -- WHICH CHAIR JUST FILLED, and what the pot was a moment ago.
    --
    -- Both have to be worked out HERE and carried into the redraw, because the
    -- roster is the only place the before and after both exist: draw() tears
    -- the dialog down and rebuilds it, so by the time it runs there is no
    -- "previous" left to diff against.
    local arrived_index, pot_from
    if same then
        local prev_view = prev.party_view or {}
        pot_from = dialog_party.pot_of(prev_view)

        local was = {}
        for _, seat in ipairs(prev_view.seats or {}) do was[seat.user_id] = true end
        local me = tostring(ws.get_current_user_id() or "")
        for i, seat in ipairs(view.seats) do
            if not was[seat.user_id] then
                -- The first new chair drives the arrival animation. A roster
                -- grows by one in practice; if two ever landed in the same
                -- push the earlier chair is the one the eye should follow,
                -- because it is the one the reel was standing in.
                arrived_index = arrived_index or i
                if seat.user_id ~= me then
                    -- Named as well as drawn: the chairs show that the table
                    -- filled, not necessarily who by.
                    toast.info(seat.username:upper() .. " joined the table")
                end
            end
        end
    end

    -- A challenge that was on screen when the table opened is declined rather
    -- than silently replaced, exactly as open_dialog does it: the person who
    -- sent it is watching a spinner and should get their answer now instead of
    -- at the server's own ten-second mark. The backend retires these when the
    -- seat is taken (retireRequestsForSeat in be_matatu's party.ts), so this
    -- is the case where that message has not landed yet.
    if prev and not prev.party_table and not prev.cup_invite and not prev.party
       and prev.request_id and prev.request_id ~= "" then
        pcall(ws.decline_game_request, prev.request_id)
    end

    -- THE TABLE'S OWN DEADLINE, not a fresh window. A guest arriving twelve
    -- seconds into a twenty-second table has eight, and a clock starting full
    -- would promise them time the table has not got. Re-read on every roster
    -- so the server keeps the last word on it.
    local now_ms = (socket and socket.gettime and socket.gettime() * 1000) or (os.time() * 1000)
    local left = (view.closes_at > 0) and math.max(0, (view.closes_at - now_ms) / 1000)
        or (same and prev.time_left or PARTY_WINDOW_FALLBACK_SECONDS)

    self.dialog = {
        kind = "party_table",
        party_table = true,
        -- NOT `party`. That flag means the OFFER strip — an invitation to a
        -- table this player is not at — and the party_offer handler below
        -- treats a dialog carrying it as a strip to be closed when its table
        -- leaves the listing. Setting it here would have the table you are
        -- SEATED at close itself the moment the lobby stopped advertising it,
        -- which is the instant it fills.
        party_id = view.party_id,
        party_view = view,
        -- Read by dialog_party.draw: which chair to pop, and what figure the
        -- pot should count UP from.
        arrived_index = arrived_index,
        pot_from = pot_from,
        time_left = left,
        max_time = math.max(left, 1),
        -- Never the strip. A banner is one line of text and what the player is
        -- watching is four chairs filling — see the demote guard in update().
        banner = false,
    }

    self.dlg_alpha = 1
    app_state.modal_open("incoming")
    if not same then pcall(msg.post, "#snd_notify", "play_sound") end
    refresh_wh()
    rebuild(self)
end

local function close_dialog(self)
    self.dialog = nil
    app_state.modal_close("incoming")
    rebuild(self)
end

-- ── Standard Defold hooks ─────────────────────────────────────────────────────
function init(self)
    msg.post(".", "acquire_input_focus")
    gui.set_render_order(15)
    self.nodes, self.buttons, self.dialog, self.dlg_alpha = {}, {}, nil, 0
    -- How long this overlay has been blocking the app, and whether it is
    -- currently serving a burst on the non-blocking surface.
    self.budget = budget.new()
    refresh_wh()

    -- WS callbacks run in the socket owner's (controller) context — post back to
    -- THIS component through a URL captured here, in our own context. We never
    -- call gui.* from inside a listener.
    local ME = msg.url("#")
    self._tokens = {
        ws.on("game_request", function()
            msg.post(ME, "incoming_request")
        end),
        ws.on("game_request_declined", function(_reason, request_id)
            msg.post(ME, "incoming_clear", { request_id = request_id or "" })
        end),
        ws.on("game_request_cancelled", function(request_id)
            msg.post(ME, "incoming_clear", { request_id = request_id or "" })
        end),
        ws.on("game_request_accepted", function()
            msg.post(ME, "incoming_clear", {})
        end),
        ws.on("game_start", function()
            msg.post(ME, "incoming_clear", {})
        end),
        -- THE TABLE THIS PLAYER IS SEATED AT. Same pattern as every listener
        -- here: the socket's callbacks run in the controller's context, so
        -- they post back to this component rather than touching gui.* from
        -- the wrong script. The roster is read off ws.current_party on the
        -- other side, because a Defold message cannot carry the seat list.
        ws.on("party_roster", function()
            msg.post(ME, "party_roster")
        end),
        ws.on("party_starting", function()
            -- No words: the board is about to replace this anyway, and a
            -- toast that arrives on top of a deal is noise.
            msg.post(ME, "party_over", { message = "" })
        end),
        ws.on("party_cancelled", function(d)
            msg.post(ME, "party_over", {
                message = tostring((d or {}).message or "That table was called off."),
            })
        end),
        ws.on("party_error", function(d)
            msg.post(ME, "party_table_error", {
                party_id = tostring((d or {}).partyId or ""),
                message  = tostring((d or {}).message or "That table is not available."),
            })
        end),
        -- Team cups. The invitation is a decision, so it takes the same banner
        -- an incoming tournament request takes; a join is ambient news about a
        -- cup you are already in, so it takes a toast and nothing else.
        --
        -- Both post back to ME rather than acting here: these callbacks run in
        -- the socket owner's context, and building the banner from there would
        -- touch gui.* from the wrong script.
        ws.on("cup_invite", function(d)
            msg.post(ME, "cup_invite", {
                cup_id  = tostring((d or {}).cupId or ""),
                name    = tostring((d or {}).name or "Team Cup"),
                owner   = tostring((d or {}).ownerUsername or ""),
                avatar  = tonumber((d or {}).ownerAvatar) or 1,
                prize   = tonumber((d or {}).grandPrize) or 0,
                members = tonumber((d or {}).members) or 0,
                max     = tonumber((d or {}).maxPlayers) or 0,
            })
        end),
        ws.on("cup_event", function(d)
            msg.post(ME, "cup_event", {
                event   = tostring((d or {}).event or ""),
                name    = tostring((d or {}).name or "the cup"),
                who     = tostring((d or {}).actorUsername or "A player"),
                members = tonumber((d or {}).members) or 0,
                max     = tonumber((d or {}).maxPlayers) or 0,
            })
        end),
    }
end

function final(self)
    for _, t in ipairs(self._tokens or {}) do ws.off(t) end
end

function update(self, dt)
    -- Countdown ALWAYS runs (no _active gate): this overlay is live on every
    -- screen, so the dialog fade-in + 10s auto-decline must advance regardless
    -- of which screen is showing underneath.
    -- WATCHDOG. Nothing on screen must never mean nothing responds.
    --
    -- The claim above and every close() below are meant to keep these two in
    -- step, and the paths that broke it are fixed. This is here anyway,
    -- because the cost of the two disagreeing is not a glitch — it is an app
    -- that accepts no input at all, on any screen, with nothing visible to
    -- explain it and no recovery but a restart. That is worth one comparison
    -- per frame.
    --
    -- Deliberately one-directional: it only ever RELEASES a claim nothing is
    -- showing for. Claiming from here would paper over a genuine bug in
    -- open_dialog instead of leaving it to be found.
    if not self.dialog and app_state.modals and app_state.modals["incoming"] then
        print("[INCOMING] releasing a stale modal claim with no dialog on screen")
        app_state.modal_close("incoming")
    end

    -- The other direction of the same failure: a dialog that IS set but has no
    -- buttons in it. on_input reads that as "modal is up, swallow every tap"
    -- while there is nothing on screen and nothing to press — the app is dead
    -- until the countdown expires. rebuild() drops the dialog on a draw error
    -- now, so this should never fire; it costs one comparison a frame and the
    -- thing it catches costs a restart.
    if self.dialog and not self.dialog.banner and #(self.buttons or {}) == 0 then
        print("[INCOMING] dropping a full dialog that has no buttons to press")
        self.dialog = nil
        app_state.modal_close("incoming")
    end

    -- THE INPUT BUDGET.
    --
    -- Each request gets its own countdown, but a burst restarts that countdown
    -- over and over, and the modal claim underneath is held the whole time —
    -- which is an app that accepts no input at all for as long as challenges
    -- keep arriving. Past the budget the overlay demotes to the top banner:
    -- every invite is still shown and still acceptable, and everything behind
    -- it works again.
    local showing = self.dialog and (self.dialog.banner and "banner" or "dialog") or nil
    -- A SEATED TABLE IS NEVER DEMOTED TO THE STRIP.
    --
    -- The budget exists for a BURST of challenges holding the app's input
    -- indefinitely, and it demotes by converting the dialog to a banner. A
    -- table cannot survive that: a banner is one line of text, and what the
    -- player is watching is four chairs filling. It is also bounded — twenty
    -- seconds, once — which is the thing the budget protects against, so
    -- there is nothing here for it to fix.
    if self.dialog and self.dialog.party_table then showing = nil end
    if budget.tick(self.budget, dt, showing) == "demote" then
        print("[INCOMING] input held too long by a burst of requests - "
            .. "switching to the non-blocking banner")
        self.dialog.banner = true
        if not self.dialog.title then
            self.dialog.title, self.dialog.desc = plain_banner_text(self.dialog)
        end
        app_state.modal_close("incoming")
        rebuild(self)
    end

    if self.dialog then
        local need_reb = false

        self.dialog.time_left = (self.dialog.time_left or 10) - dt

        -- Smooth: resize the existing bar. The whole-second rebuild below still
        -- happens, for the numeric countdown that genuinely ticks in seconds.
        --
        -- The championship strip runs its own animator, for the same reason:
        -- rebuilding every node sixty times a second to slide one bar is not a
        -- trade worth making.
        if self.dialog.banner then
            if self.ban_anim then
                pcall(champ_banner.animate, self.ban_anim, dt,
                    self.dialog.time_left, self.dialog.max_time or 10)
            else
                pcall(update_ban_bar, self, self.dialog)
            end
        end

        -- THE TABLE ANIMATES; IT DOES NOT REBUILD.
        --
        -- Every other dialog here redraws itself once a whole second, for a
        -- countdown that genuinely ticks in seconds. The party table cannot:
        -- it is full of tweens — a reel hunting through avatars, an avatar
        -- popping into a chair, a ring blooming behind it, a pot counting up —
        -- and tearing every node down once a second would restart all four,
        -- forever, so none of them would ever finish. dialog_party.animate
        -- owns the words instead, and the nodes are rebuilt only when the
        -- roster actually changes.
        if self.dialog.party_table then
            dialog_party.animate(self, self.dialog, dt)
        else
            local cur_sec = math.floor(math.max(0, self.dialog.time_left))
            if cur_sec ~= self.dialog._last_sec then
                self.dialog._last_sec = cur_sec
                need_reb = true
            end
        end

        -- ZERO ON A TABLE'S CLOCK IS NOT AN ENDING.
        --
        -- The table is decided by the SERVER at zero — whoever is seated plays,
        -- and a lone host is called off — and that answer lands as
        -- PARTY_STARTING or PARTY_CANCELLED a moment later. Closing the dialog
        -- ourselves would take the table off screen a beat before the app said
        -- what happened to it, which reads as the party having failed. So the
        -- clock stops at zero and the dialog waits to be told.
        if self.dialog.party_table then
            if self.dialog.time_left < 0 then self.dialog.time_left = 0 end
            -- ...but not forever. See PARTY_STALL_GRACE_SECONDS: a dropped
            -- socket must not leave the player in a modal with no way out.
            if self.dialog.time_left <= 0 then
                self.dialog.stalled = (self.dialog.stalled or 0) + dt
                if self.dialog.stalled >= PARTY_STALL_GRACE_SECONDS then
                    print("[INCOMING] the table's deadline passed with no word from the server")
                    toast.info("That table did not start. Check your connection.")
                    self.dialog = nil
                    app_state.modal_close("incoming")
                    need_reb = true
                end
            end
        elseif self.dialog.time_left <= 0 then
            if not self.dialog.cup_invite and not self.dialog.party
               and self.dialog.request_id and self.dialog.request_id ~= "" then
                ws.decline_game_request(self.dialog.request_id)
            end
            self.dialog = nil
            app_state.modal_close("incoming")
            need_reb = true
        end

        if need_reb then rebuild(self) end
    end
end

function on_message(self, message_id, message)
    if message_id == hash("incoming_request") then
        -- A SEAT OUTRANKS A CHALLENGE.
        --
        -- The server refuses to route a request to somebody holding a party
        -- seat, and retires the ones already in flight when they sit down, so
        -- one should never arrive here. This is the belt to that braces: an
        -- invite raised over a table the player has PAID for is a tap that can
        -- only be refused, and the refusal reads as the party having failed.
        if type(ws.current_party) == "table" and ws.current_party.partyId then return end

        local r   = ws.last_game_request or {}
        local raw = (ws.last_game_request or {}).raw or {}

        -- LADDER OR GAME, not TOURNAMENT-or-not.
        --
        -- This read `gameType == "TOURNAMENT" or raw.tournament`, and a
        -- BATTLE — one player challenging another to a single game at a stake
        -- — goes out as gameType TOURNAMENT with a tournament id, because that
        -- is how the battle plumbing routes it. So a normal challenge from the
        -- Battles tab was called a tournament invite and given the strip.
        -- See champ.is_ladder, which both surfaces ask.
        local is_tb = champ.is_ladder(raw, ws.current_user_data)

        -- Tournament / battle invites are rendered inline by online.gui_script
        -- while the user is ON the online screen. Everywhere else (the lobby and,
        -- crucially, the game screen) this GLOBAL overlay surfaces them so they
        -- are never lost — e.g. a tournament invite arriving during an offline
        -- game still comes through as a top banner.
        if is_tb and app_state.current_screen == "online" then
            return
        end

        -- Two surfaces, chosen by WHAT arrived rather than by where the player
        -- happens to be:
        --   • a plain game request  -> the full dialog, always (a challenge is
        --     a decision, and it is the same decision mid-game as in the lobby)
        --   • tournament / battle / knockout -> the top banner, always
        -- There is no third, smaller surface: the little corner panel that used
        -- to appear mid-game is gone.
        local banner = is_tb and true or false

        local sender = (type(raw) == "table" and type(raw.sender) == "table") and raw.sender or (r.user or {})
        local disp_name = sender.username or (r.user or {}).username or "A player"

        local title, desc
        local kind = nil
        -- Is this strip asking them to JOIN (and pay) or to ACCEPT? Settled by
        -- the shared module from the server's own answer, so this surface and
        -- the online screen's inline strip cannot offer different things for
        -- the same invite.
        local offer = champ.offer(raw, ws.current_user_data)
        if is_tb then
            local tourney = (type(raw) == "table" and type(raw.tournament) == "table") and raw.tournament or {}

            -- WHAT THIS INVITE IS, named once and used for both the title and
            -- the badge. Same call open_banner makes on the online screen, so
            -- the two surfaces label the same invite the same way.
            --
            -- ws.current_user_data is passed so a request whose payload says
            -- nothing useful can still be recognised by its tournament id
            -- against the player's own list.
            kind = champ.kind(tourney, ws.current_user_data)
            if type(raw) == "table" and raw.gameType == "BATTLE" then
                -- A BATTLE request is never the championship, whatever its
                -- document says.
                if kind == "CHAMPIONSHIP" then kind = "BATTLE" end
                -- And if the payload carried no tournament to read at all, the
                -- request type is still enough to label it.
                kind = kind or "BATTLE"
            end

            title = (kind or "TOURNAMENT") .. "  -  " .. tostring(disp_name):upper()

            local amount = tonumber((tourney.stake or raw.stake or r.stake or {}).amount) or 0
            -- A knockout is played to a score cap, not as a series. Shared with
            -- the online screen's inline banner so the same invite is described
            -- the same way on both.
            desc = champ.format_text(tourney, kind)
                .. "   -   " .. (amount > 0 and (commas(amount) .. " Coins") or "Practice Mode")
            disp_name = (type(raw) == "table" and (raw.tournamentName or raw.name)) or "Tournament Match"

            -- A BATTLE is never the championship however many levels its
            -- document happens to carry — checking levels alone would badge
            -- knockouts that share the same shape. champ.kind above already
            -- applies that rule, and champ.offer below is what actually
            -- selects the premium strip.
            --
            -- There was a line here that recomputed it: a GLOBAL assignment
            -- nothing read, calling a global `is_championship` that has never
            -- existed on this surface — the module is required as `champ`. On
            -- a plain TOURNAMENT invite (the one kind that does not
            -- short-circuit) it raised "attempt to call a nil value" inside
            -- on_message, and the invite was lost with it. Removed rather than
            -- corrected: there was nothing for the value it computed to do.
        end

        open_dialog(self, {
            name        = disp_name,
            stake       = r.stake or {},
            request_id  = r.requestId,
            avatar      = sender.avatar or (r.user or {}).avatar,
            opponent_id = (r.user or {})._id,
            h2h         = (type(raw) == "table" and raw.headToHead) or nil,
            banner      = banner,
            badge       = kind,
            title       = title,
            desc        = desc,
            -- `championship` is what selects the premium strip; `joining` only
            -- decides its button and whether a fee is named.
            championship  = is_tb and offer.championship or false,
            joining       = is_tb and offer.joining or false,
            entry_fee     = offer.entry_fee,
            prize         = offer.prize,
            -- The sender's name on its own. The premium strip prints GLOBAL
            -- CHAMPIONSHIP as its own caption, so `title` — which reads
            -- "CHAMPIONSHIP  -  RIVAL" — would say it twice.
            opponent_name = tostring(sender.username
                or (r.user or {}).username or "A player"):upper(),
            accept_label  = is_tb and offer.accept_label or nil,
            decline_label = is_tb and offer.decline_label or nil,
        })


    elseif message_id == hash("cup_invite") then
        -- Never over a live one. A game request has ten seconds and an opponent
        -- waiting on the other end; an invitation to a cup that fills over
        -- hours can wait for the next IDENTIFY replay, which is guaranteed.
        if self.dialog then return end
        local cup_id = tostring((message or {}).cup_id or "")
        if cup_id == "" then return end

        local prize = tonumber(message.prize) or 0
        local seats = ""
        if (tonumber(message.max) or 0) > 0 then
            seats = string.format("   -   %d/%d players", tonumber(message.members) or 0, tonumber(message.max) or 0)
        end

        open_dialog(self, {
            name          = message.name,
            avatar        = message.avatar,
            banner        = true,
            cup_invite    = true,
            cup_id        = cup_id,
            title         = "TEAM CUP  -  " .. (message.owner ~= "" and tostring(message.owner):upper() or "INVITATION"),
            desc          = (prize > 0 and (commas(prize) .. " Coins prize") or "Team cup invitation") .. seats,
            accept_label  = "JOIN",
            -- Not DECLINE. There is no decline endpoint for an invitation and
            -- there should not be one — putting the banner away is not the
            -- same as turning the cup down, and the tile still carries it.
            decline_label = "LATER",
        })

    elseif message_id == hash("party_offer") then
        -- AN OPEN TABLE, EVERYWHERE THE PLAYER IS NOT LOOKING AT THE LOBBY.
        --
        -- Same division tournament and battle invites already run on: the
        -- online screen draws its own inline strip while it is up, and this
        -- global overlay carries the offer everywhere else. Without it a party
        -- was a mode you could only be invited to on one screen.
        --
        -- The message is a WAKE SIGNAL, not a payload. The listing lives on
        -- the socket module — the same place last_game_request does — and
        -- reading it here rather than threading it through msg.post keeps this
        -- surface working off exactly the list the lobby is working off.
        if app_state.current_screen == "online" then return end

        local list = type(ws.available_parties) == "table" and ws.available_parties or {}
        local seated = type(ws.current_party) == "table" and ws.current_party.partyId ~= nil

        -- A STRIP THAT OUTLIVED ITS TABLE. The listing is the whole truth
        -- every time it arrives, so a table missing from it has filled,
        -- expired or been called off — and an offer that taps through to a
        -- refusal is worse than no offer.
        if self.dialog and self.dialog.party then
            local still_open = false
            for _, p in ipairs(list) do
                if tostring(p.partyId or "") == self.dialog.party_id then still_open = true end
            end
            if seated or not still_open then close_dialog(self) end
            return
        end

        -- Never over a live request. Somebody is waiting ten seconds on the
        -- answer to that one; a table is not addressed to this player at all.
        if self.dialog or seated then return end

        local p = list[1]   -- the server sorts soonest-to-close first
        if type(p) ~= "table" then return end
        local pid = tostring(p.partyId or "")
        if pid == "" then return end

        local now_ms = (socket and socket.gettime and socket.gettime() * 1000) or (os.time() * 1000)
        local closes = tonumber(p.closesAt) or 0
        local left   = closes > 0 and math.max(0, (closes - now_ms) / 1000) or 20
        -- Not worth interrupting anybody for. By the time the strip has faded
        -- in and been read the table is dealing.
        if left < 3 then return end

        local entry  = tonumber(p.entry) or 0
        local seats  = tonumber(p.seated) or 0
        local mode   = (tostring(p.mode or "NORMAL"):upper() == "SCORECAP") and "KNOCKOUT" or "NORMAL"

        open_dialog(self, {
            name           = p.hostName,
            avatar         = tonumber(p.hostAvatar) or 1,
            banner         = true,
            party          = true,
            party_id       = pid,
            party_seconds  = left,
            badge          = "PARTY",
            title          = "PARTY  -  " .. string.upper(tostring(p.hostName ~= "" and p.hostName or "A PLAYER")),
            desc           = mode .. "   -   " .. seats .. "/4 seated   -   "
                             .. (entry > 0 and (commas(entry) .. " Coins") or "Free table"),
            accept_label   = "JOIN",
            -- Not DECLINE: there is no decline for a table, and putting the
            -- strip away is not turning anything down.
            decline_label  = "LATER",
        })

    elseif message_id == hash("cup_event") then
        -- Ambient news about a cup this player is already in. No decision, so
        -- no banner: a toast, and it never interrupts whatever they are doing.
        local who  = tostring((message or {}).who or "A player")
        local name = tostring((message or {}).name or "the cup")
        local max  = tonumber(message.max) or 0
        local seats = max > 0 and string.format(" (%d/%d)", tonumber(message.members) or 0, max) or ""
        if message.event == "STARTED" then
            toast.success(name .. " has started - good luck!")
        elseif message.event == "JOINED" then
            toast.info(who .. " joined " .. name .. seats)
        elseif message.event == "LEFT" then
            toast.info(who .. " left " .. name .. seats)
        end

    elseif message_id == hash("party_roster") then
        -- Read off the socket rather than out of `message`: a Defold message
        -- table cannot carry the nested seat list, and ws.current_party is
        -- already exactly what the server last said about this table.
        open_party_table(self, ws.current_party)

    elseif message_id == hash("party_over") then
        -- STARTING and CANCELLED both end the table's time on this surface.
        -- What differs is what the player is told: a start hands over to the
        -- board (controller.script is already listening for game_start), a
        -- cancellation is a toast, because there is nothing left to decide and
        -- a modal saying "that did not happen" is one more thing to dismiss.
        local said = tostring((message or {}).message or "")
        if said ~= "" then toast.info(said) end
        if self.dialog and self.dialog.party_table then close_dialog(self) end

    elseif message_id == hash("party_table_error") then
        -- The table refused the seat — full, already started, not enough
        -- coins. Nothing was taken and there is nothing on screen to unwind,
        -- so it is a toast and not a modal.
        toast.error(tostring((message or {}).message or "That table is not available."))
        -- A refusal naming the table we are SHOWING means the seat we thought
        -- we had is gone. Anything else is about a table we never sat at and
        -- must not close this one.
        local pid = tostring((message or {}).party_id or "")
        if self.dialog and self.dialog.party_table
           and (pid == "" or pid == self.dialog.party_id) then
            close_dialog(self)
        end

    elseif message_id == hash("incoming_clear") then
        -- NEVER THE SEATED TABLE.
        --
        -- These events carry a request id, or none at all — and "none" has
        -- always meant "clear whatever is up", which was fine while everything
        -- up was a request. A table has no request behind it and is ended only
        -- by the server saying it dealt or was called off (party_over), so a
        -- bare clear arriving mid-table would take it off the screen for a
        -- game request it has nothing to do with.
        if self.dialog and self.dialog.party_table then return end

        -- Clear if the event targets the dialog we're showing (or carries no id).
        local rid = message and message.request_id
        if self.dialog and (not rid or rid == "" or rid == self.dialog.request_id) then
            close_dialog(self)
        elseif not self.dialog then
            -- nothing showing; ignore
        end
    end
end

function on_input(self, action_id, action)
    -- Only ever interfere with input while a dialog is actually on screen.
    if not self.dialog then return false end

    if action_id == hash("touch") and action.pressed then
        for i = #self.buttons, 1, -1 do
            local b = self.buttons[i]
            if gui.pick_node(b.node, action.x, action.y) then
                local id = b.id
                local cup = self.dialog and self.dialog.cup_invite and self.dialog.cup_id or nil
                local party = self.dialog and self.dialog.party and self.dialog.party_id or nil
                if id == "accept" then
                    if party then
                        -- A SEAT, TAKEN FROM WHEREVER THEY WERE STANDING.
                        --
                        -- This used to be a toast and nothing else: the table
                        -- itself was drawn by the online screen's search
                        -- dialog, which does not exist on the lobby or the
                        -- profile screen, so a player joining from anywhere
                        -- else waited on one line of text and found out how it
                        -- went when a board appeared.
                        --
                        -- The table now draws itself, on this same overlay and
                        -- therefore on every screen: the first PARTY_ROSTER
                        -- comes back within a frame and open_party_table puts
                        -- the chairs up. So there is nothing to announce here
                        -- — the seat is about to be visible.
                        ws.party_join(party)
                    elseif cup then
                        -- Joining a cup is an HTTP call, not a socket message:
                        -- the cup is owned by the tournament controller, and
                        -- the accept endpoint is the same one the lobby tile
                        -- uses. Answered with a toast either way — the banner
                        -- is already gone by the time the reply lands.
                        local uid = tostring(ws.get_current_user_id() or "")
                        api.accept_team_invitation(cup, uid, function(res)
                            if res.success then
                                local t = (res.data or {}).tournament or {}
                                local u = ws.current_user_data or {}
                                u.myTeamTournamentId = t._id or cup
                                u.myTeamTournamentIsOwner = false
                                ws.current_user_data = u
                                toast.success("You're in " .. tostring(t.name or "the cup") .. "!")
                                -- The server's JOINED broadcast deliberately
                                -- skips the joiner, so nothing else would tell
                                -- the tile behind this banner that its numbers
                                -- moved.
                                pcall(msg.post, "#lobby", "cups_changed")
                            else
                                toast.error((res.data and res.data.error) or res.message
                                    or "Could not join that cup.")
                            end
                        end)
                    elseif self.dialog and self.dialog.request_id and self.dialog.request_id ~= "" then
                        ws.accept_game_request(self.dialog.request_id)
                    end
                    self.dialog = nil
                    app_state.modal_close("incoming")
                    rebuild(self)
                elseif id == "decline" then
                    -- LATER on a cup invitation sends nothing at all. There is
                    -- no decline endpoint and there should not be one: the
                    -- invitation stays on the TEAM CUPS tile, and putting a
                    -- banner away is not the same as turning an invitation
                    -- down.
                    if not cup and not party
                       and self.dialog and self.dialog.request_id and self.dialog.request_id ~= "" then
                        ws.decline_game_request(self.dialog.request_id)
                    end
                    self.dialog = nil
                    app_state.modal_close("incoming")
                    rebuild(self)
                end
                return true
            end
        end
        -- Full dialog is modal: swallow taps anywhere while it is up. The top
        -- banner is non-disruptive, so taps outside its two buttons fall through
        -- to whatever is underneath.
        if self.dialog.banner then return false end
        return true
    end

    -- Full dialog blocks all other input (drags, releases, keys) while visible.
    -- The banner lets everything else through so play continues normally.
    if self.dialog.banner then return false end
    return true
end
