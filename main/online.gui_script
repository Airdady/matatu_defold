-- online.gui_script
-- Online players lobby (multiplayer hub).

local ui        = require("modules.ui")
local config    = require("modules.config")
local app_state = require("modules.app_state")
local ws        = require("modules.websocket_manager")
local api       = require("modules.api_service")
local screen    = require("modules.screen")
local GameMode  = require("modules.game_mode")

local left_panel      = require("modules.online_left")
local center_panel    = require("modules.online_center")
local right_panel     = require("modules.online_right")
local toast           = require("modules.toast")
local champ           = require("modules.championship")
local champ_banner    = require("modules.champ_banner")
-- The opponent's win rate, drawn as a tier pill rather than a percentage. Same
-- module the incoming dialog and the game-over panel use, so one player cannot
-- be a PRO on the invite strip and something else on the result screen.
local rank            = require("modules.rank_badge")
local season_clock    = require("modules.season_clock")
local search_clock    = require("modules.search_clock")
local list_gesture    = require("modules.list_gesture")
local dialog_search   = require("modules.dialog_search")
-- The request dialog, which also draws the party waiting room — same plate,
-- four chairs, the empty ones drawn as empty. See draw_party there.
local dialog_incoming = require("modules.dialog_incoming")

local LOGICAL_W, LOGICAL_H = 1280, 720
local VISIBLE_W, VISIBLE_H = 1280, 720
local EDGE_L, EDGE_R = 0, 1280
local EDGE_B, EDGE_T = 0, 720
local CX, CY = 640, 360

local TAB_QUICK   = 1
local TAB_BATTLES = 2

-- The snd_* components live on the controller object (siblings of #online),
-- so they're addressable with a bare "#snd_..." url from here.
local function play_snd(name)
    pcall(msg.post, "#" .. name, "play_sound")
end
local function stop_snd(name)
    pcall(msg.post, "#" .. name, "stop_sound")
end

-- A staked game costs the stake plus its service charge (mirrors Godot's
-- total_stake = amount + charge). If the wallet can't cover it, callers route the
-- player to the payments dialog instead of firing a request the server rejects.
local function can_afford(stake)
    local s    = stake or {}
    local need = (tonumber(s.amount) or 0) + (tonumber(s.charge) or 0)
    local bal  = tonumber((ws.current_user_data or {}).balance) or 0
    return bal >= need
end

-- ── Colors & Spacing ──────────────────────────────────────────────────────────
local SIDE_RATIO  = 0.30
local SIDE_MARGIN = 20
local CENTER_PAD  = 22
local ROW_H_SM    = 38
local ROW_H_LG    = 36 -- Standings row height (was 44 — too much vertical padding)
local ROW_H_BONUS = 37 -- Season Bonuses row height — a hair roomier than Standings (was 42)
local ROW_H_LIST  = 56
local ROW_GAP     = 5
local HDR_H_TABLE = 30
local SECTION_GAP = 10
local BLOCK_GAP   = 18
local INNER_PAD   = 14

local COL_BG       = vmath.vector4(0.165, 0.145, 0.133, 1.0)
local COL_GLASS    = vmath.vector4(0.04, 0.04, 0.06, 0.70)
local COL_GLASS_HI = vmath.vector4(0.10, 0.10, 0.12, 0.85)
local ROW_EVEN     = vmath.vector4(0.10, 0.10, 0.12, 0.75)
local ROW_ODD      = vmath.vector4(0.07, 0.07, 0.09, 0.60)
local ROW_YOU      = vmath.vector4(0.28, 0.06, 0.06, 0.80)
local TIER_COLORS  = { vmath.vector4(1.00, 0.80, 0.20, 1.0), vmath.vector4(0.70, 0.70, 0.72, 1.0), vmath.vector4(0.80, 0.50, 0.20, 1.0), vmath.vector4(0.11, 0.62, 0.46, 0.85), vmath.vector4(0.35, 0.35, 0.38, 0.55) }

local COL_DIM      = vmath.vector4(0.45, 0.45, 0.45, 1.0)
local COL_MID      = vmath.vector4(0.65, 0.65, 0.65, 1.0)
local COL_BRIGHT   = vmath.vector4(0.88, 0.88, 0.88, 1.0)
local COL_GOLD     = vmath.vector4(1.00, 0.84, 0.20, 1.0)
local COL_WHITE    = vmath.vector4(1.00, 1.00, 1.00, 1.0)
local COL_CREAM    = vmath.vector4(0.98, 0.96, 0.89, 1.0)
local COL_GREEN    = vmath.vector4(0.15, 0.70, 0.25, 1.0)
local COL_RED      = vmath.vector4(0.90, 0.25, 0.25, 1.0)
local COL_CYAN     = vmath.vector4(0.20, 0.90, 1.00, 1.0)

local COL_BORDER     = vmath.vector4(0.25, 0.25, 0.28, 0.50)
local COL_GOLD_BDR   = vmath.vector4(1.00, 0.84, 0.00, 0.55)
local COL_GOLD_BDR_D = vmath.vector4(1.00, 0.84, 0.00, 0.50)
local COL_TIMER_BG   = vmath.vector4(0.05, 0.05, 0.07, 0.85)
local COL_HEADER_BG  = vmath.vector4(0.12, 0.12, 0.14, 1.00)
local COL_BADGE_BG   = vmath.vector4(0.05, 0.05, 0.05, 0.70)
local COL_NAMEID_BG  = vmath.vector4(0.00, 0.00, 0.00, 0.60)
local COL_STAT_BG    = vmath.vector4(0.00, 0.00, 0.00, 0.20)

local STRIPE_OUTER = vmath.vector4(0.169, 0.153, 0.141, 1.0)
local STRIPE_MID   = vmath.vector4(0.039, 0.031, 0.027, 1.0)
local STRIPE_INNER = vmath.vector4(0.337, 0.333, 0.314, 1.0)

local C = {
    SIDE_MARGIN = SIDE_MARGIN, CENTER_PAD = CENTER_PAD, ROW_H_SM = ROW_H_SM, ROW_H_LG = ROW_H_LG, ROW_H_BONUS = ROW_H_BONUS, ROW_H_LIST = ROW_H_LIST, ROW_GAP = ROW_GAP, HDR_H_TABLE = HDR_H_TABLE, SECTION_GAP = SECTION_GAP, BLOCK_GAP = BLOCK_GAP, INNER_PAD = INNER_PAD, COL_BG = COL_BG, COL_GLASS = COL_GLASS, COL_GLASS_HI = COL_GLASS_HI, ROW_EVEN = ROW_EVEN, ROW_ODD = ROW_ODD, ROW_YOU = ROW_YOU, TIER_COLORS = TIER_COLORS, TIER_DIM = TIER_COLORS[5], COL_DIM = COL_DIM, COL_MID = COL_MID, COL_BRIGHT = COL_BRIGHT, COL_GOLD = COL_GOLD, COL_WHITE = COL_WHITE, COL_GREEN = COL_GREEN, COL_RED = COL_RED, COL_CYAN = COL_CYAN, COL_BORDER = COL_BORDER, COL_GOLD_BDR = COL_GOLD_BDR, COL_GOLD_BDR_D = COL_GOLD_BDR_D, COL_TIMER_BG = COL_TIMER_BG, COL_HEADER_BG = COL_HEADER_BG, COL_BADGE_BG = COL_BADGE_BG, COL_NAMEID_BG = COL_NAMEID_BG, COL_STAT_BG = COL_STAT_BG,
}

local function refresh_wh()
    local m = screen.metrics()
    VISIBLE_W, VISIBLE_H = m.VW, m.VH
    EDGE_L, EDGE_R = m.L, m.R
    EDGE_B, EDGE_T = m.B, m.T
    CX, CY = m.CX, m.CY
end

local function commas(n) return (tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")) end

-- Every player must go through the Savings explainer exactly once (ever, not
-- just once per app session) — persisted server-side so it survives a
-- restart. Called the instant the player leaves it any way (a button tap or
-- the background scrim), not just on an explicit "done" action.
local function mark_savings_promo_seen()
    local u = ws.current_user_data
    if not u or u.savingsPromoSeen == true then return end
    u.savingsPromoSeen = true
    local uid = ws.get_current_user_id()
    if uid and uid ~= "" then
        pcall(api.update_profile, uid, { savingsPromoSeen = true }, function() end)
    end
end
-- ban_bars holds node handles into self.nodes, so it dies with them.
local function clear(self) for _, n in ipairs(self.nodes) do pcall(gui.delete_node, n) end; self.nodes, self.buttons, self.ban_bars = {}, {}, nil end
local function track(self, n) self.nodes[#self.nodes+1] = n; return n end
local function txtL(self, x, y, str, font, color) local t = track(self, ui.text(vmath.vector3(x, y, 0), str, font, color)); gui.set_pivot(t, gui.PIVOT_W); return t end
local function txtR(self, x, y, str, font, color) local t = track(self, ui.text(vmath.vector3(x, y, 0), str, font, color)); gui.set_pivot(t, gui.PIVOT_E); return t end

local function mkbtn(self, id, pos, size, label, style, data, font, text_color)
    local bg
    if type(style) == "string" then bg = track(self, ui.btn9(pos, size, style)) else bg = track(self, ui.box(pos, size, style or COL_GLASS_HI)) end
    if label then
        local btn_font = font or (size.y >= 44 and "btn_md" or "btn_sm")
        track(self, ui.text(vmath.vector3(pos.x, pos.y - 3, pos.z), label, btn_font, text_color or COL_CREAM))
    end
    self.buttons[#self.buttons+1] = { node = bg, id = id, data = data }
    return bg
end

local function glass(self, pos, size, style) track(self, ui.box(pos, size, COL_BG)); return track(self, ui.btn9(pos, size, style or "container_bg")) end
local function get_layout() return VISIBLE_W*SIDE_RATIO, VISIBLE_W*SIDE_RATIO, EDGE_L+VISIBLE_W*SIDE_RATIO, EDGE_R-VISIBLE_W*SIDE_RATIO end

local function draw_dividers(self, div_lx, div_rx)
    local function vbar(x, w, col) track(self, ui.box(vmath.vector3(x, CY, 0), vmath.vector3(w, VISIBLE_H, 0), col)) end
    vbar(div_lx + 2, 4, STRIPE_OUTER); vbar(div_lx + 9, 10, STRIPE_MID); vbar(div_lx + 16, 4, STRIPE_INNER)
    vbar(div_rx - 2, 4, STRIPE_OUTER); vbar(div_rx - 9, 10, STRIPE_MID); vbar(div_rx - 16, 4, STRIPE_INNER)
end

-- ── Dialog & UI Helpers passed to submodules ───────────────────────────────────
local DLG_RED, DLG_AV_BG, DLG_SEARCH = vmath.vector4(1.0, 0.40, 0.40, 1.0), vmath.vector4(0.20, 0.20, 0.20, 0.50), vmath.vector4(1.0, 0.84, 0.00, 1.0)
local function with_a(c, a) return vmath.vector4(c.x, c.y, c.z, c.w * (a or 1)) end
local function dlg_avatar(self, x, y, size, avatar_id, a) track(self, ui.pie(vmath.vector3(x, y, 0), size/2 + 6, with_a(DLG_AV_BG, a))); gui.set_color(track(self, ui.avatar(vmath.vector3(x, y, 0), vmath.vector3(size, size, 0), avatar_id)), vmath.vector4(1, 1, 1, a or 1)) end
local function dlg_timer(self, x, y, time_left, max_time, a)
    local frac, R = math.max(0, math.min(1, (time_left or 0) / (max_time or 10))), 34
    local bg = track(self, gui.new_pie_node(vmath.vector3(x, y, 0), vmath.vector3(R*2, R*2, 0))); gui.set_perimeter_vertices(bg, 48); pcall(gui.set_inner_radius, bg, R * 0.80); gui.set_color(bg, vmath.vector4(0.25, 0.25, 0.25, 0.45 * (a or 1)))
    local col = (time_left or 0) <= 3 and COL_RED or COL_CYAN
    local fg = track(self, gui.new_pie_node(vmath.vector3(x, y, 0), vmath.vector3(R*2, R*2, 0))); gui.set_perimeter_vertices(fg, 48); pcall(gui.set_inner_radius, fg, R * 0.80); gui.set_rotation(fg, vmath.vector3(0, 0, 90)); gui.set_fill_angle(fg, frac * 360); gui.set_color(fg, with_a(col, a))
    track(self, ui.text(vmath.vector3(x, y, 0), tostring(math.ceil(time_left or 0)), "title", with_a(col, a)))
end
local function h2h_view(h2h)
    if type(h2h) ~= "table" then return nil end
    local my_id, mine, theirs, opp_id = tostring(ws.get_current_user_id() or ""), 0, 0, nil
    if type(h2h.scores) == "table" then for pid, sc in pairs(h2h.scores) do if tostring(pid) == my_id then mine = tonumber(sc) or 0 else theirs = tonumber(sc) or 0; opp_id = tostring(pid) end end end
    return { p = mine, o = theirs, total = tonumber(h2h.totalGames) or 0, form = (type(h2h.form) == "table" and h2h.form[my_id]) or {}, opp_winrate = (opp_id and type(h2h.ratings) == "table" and type(h2h.ratings[opp_id]) == "table") and tonumber(h2h.ratings[opp_id].winRate) or nil }
end
local function draw_h2h_row(self, cx, y, view, a)
    if not view then return end
    gui.set_pivot(track(self, ui.text(vmath.vector3(cx - 78, y, 0), string.format("H2H %d - %d", view.p or 0, view.o or 0), "small", with_a(COL_GOLD, a))), gui.PIVOT_E)
    local n = math.min(5, #view.form)
    if n == 0 then gui.set_pivot(track(self, ui.text(vmath.vector3(cx - 64, y, 0), "First meeting", "small", with_a(COL_DIM, a))), gui.PIVOT_W); return end
    for i = 1, n do
        local r, col = tostring(view.form[i]), (tostring(view.form[i]) == "W") and COL_GREEN or COL_RED
        local bx = cx - 64 + (i - 1) * 28 + 11
        track(self, ui.box(vmath.vector3(bx, y, 0), vmath.vector3(22, 22, 0), with_a(col, 0.92 * (a or 1))))
        track(self, ui.text(vmath.vector3(bx, y, 0), r, "small", with_a(COL_WHITE, a)))
    end
end

local function make_ctx()
    return { C = C, ui = ui, track = track, txtL = txtL, txtR = txtR, mkbtn = mkbtn, glass = glass, commas = commas, get_layout = get_layout, EDGE_L = EDGE_L, EDGE_R = EDGE_R, EDGE_B = EDGE_B, EDGE_T = EDGE_T, CX = CX, CY = CY, LOGICAL_W = LOGICAL_W, LOGICAL_H = LOGICAL_H, DLG_RED = DLG_RED, DLG_SEARCH = DLG_SEARCH, with_a = with_a, dlg_avatar = dlg_avatar, dlg_timer = dlg_timer, h2h_view = h2h_view, draw_h2h_row = draw_h2h_row }
end

-- ── Banner System ─────────────────────────────────────────────────────────────
-- CHAMPIONSHIP badge, identical to the one incoming.gui_script draws on the
-- global overlay. The two surfaces show the SAME invite — this one while the
-- player is on the online screen, that one everywhere else — so a marking that
-- appeared on only one of them would mean the same request looked like two
-- different things depending on which screen happened to be up.
-- One entry per kind modules/championship.lua can name. Distinct hues rather
-- than one badge colour, because the point of the label is to tell three
-- similar-looking invites apart at a glance — accepting a championship level
-- spends real progress, a knockout is played to a score cap, a battle is a
-- single match.
local BAN_BADGE = {
    CHAMPIONSHIP = { bg = vmath.vector4(0.78, 0.12, 0.16, 1.00), tx = vmath.vector4(1.00, 0.94, 0.94, 1.00) },
    KNOCKOUT     = { bg = vmath.vector4(0.90, 0.42, 0.05, 1.00), tx = vmath.vector4(1.00, 0.96, 0.90, 1.00) },
    BATTLE       = { bg = vmath.vector4(0.16, 0.42, 0.72, 1.00), tx = vmath.vector4(0.94, 0.97, 1.00, 1.00) },
    -- An open table, in the party panel's own violet. Nothing else on this
    -- strip is violet, which is the point: a party is the one invite that did
    -- not come from a person choosing YOU, and it is the one that seats four.
    PARTY        = { bg = vmath.vector4(0.60, 0.25, 0.78, 1.00), tx = vmath.vector4(1.00, 0.96, 1.00, 1.00) },
}

-- WHERE THE INLINE BADGE GOES, AND WHY H2H MOVES FOR IT.
--
-- The right-hand side of the strip is laid out from the right edge: ACCEPT at
-- R-90 and DECLINE at R-225 (both 120 wide, so the buttons start at R-285),
-- with the H2H block anchored at R-430 and running to about anchor+70. That
-- leaves a 75px gap between them — narrower than the word CHAMPIONSHIP, so
-- dropping the badge in as-is would have it overlap the H2H form squares.
--
-- So the H2H anchor shifts left, and ONLY on a banner that carries the badge:
-- every other invite keeps exactly the layout it has today. The badge then sits
-- in the middle of the space that opens up, on the same centre line as the H2H
-- row and the two buttons.
-- The slot reserved is the WIDEST label's, so every badge fits the space the
-- layout test checks — each pill is then drawn at its own width, centred on the
-- same point.
local BAN_H2H_X       = 430   -- from the right edge, unbadged invite
local BAN_H2H_X_CHAMP = 560   -- ...and when a badge needs the room
local BAN_CHAMP_X     = 387   -- midway between the shifted H2H and DECLINE
local BAN_CHAMP_W     = 132
local BAN_CHAMP_H     = 24

-- THE RANK PILL, on the LEFT of the strip and on the title line, where the
-- sender's name is. Height and the gap to the name it belongs to are constants
-- here and in incoming.gui_script for the same reason the figures above are:
-- the two surfaces draw the SAME invite, and the layout test asserts they have
-- not drifted apart.
local BAN_RANK_H      = 22
local BAN_RANK_GAP    = 10


-- SLIDING THE COUNTDOWN BARS, EVERY FRAME.
--
-- The bars were redrawn by rebuild(), and rebuild() only runs when the
-- WHOLE-SECOND counter changes — so a bar that should sweep smoothly across ten
-- seconds jumped in ten steps. Reported as "animating in bits".
--
-- Rebuilding per frame is not the fix: rebuild() tears down and recreates the
-- entire screen, not just the strip. So each fill node is created once and
-- kept, and this resizes them in place. The once-a-second rebuild stays as it
-- was, for the things that really do change only once a second.
local function update_ban_bars(self, dt)
    for _, bar in ipairs(self.ban_bars or {}) do
        local b = bar.b
        if bar.fill ~= nil then
            -- A championship strip: its own animator owns the countdown.
            pcall(champ_banner.animate, bar, dt or 0, b.time_left, b.max_time or 10)
        else
            local frac = math.max(0, math.min(1, (b.time_left or 0) / (b.max_time or 10)))
            local w = bar.w * frac
            gui.set_size(bar.node, vmath.vector3(w, 3, 0))
            -- Grows from the left edge, so the centre moves with the width.
            gui.set_position(bar.node, vmath.vector3(bar.left + w / 2, bar.y, 0))
            gui.set_color(bar.node, frac < 0.3 and COL_RED or COL_GREEN)
        end
    end
end

-- Draws one pill, centred, sized to its label.
local function draw_badge(self, kind, x, y, h, a)
    local col = BAN_BADGE[kind]
    if not col then return end
    local w = champ.badge_width(kind)
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), with_a(col.bg, a)))
    track(self, ui.text(vmath.vector3(x, y, 0), kind, "small", with_a(col.tx, a)))
end

local function draw_banner(self)
    self.ban_bars = {}
    for idx, b in ipairs(self.banners or {}) do
        local bw, slide = VISIBLE_W, (b.y_off or 0) * 132
        -- Keyed on `championship`, NOT on `joining`: those were conflated
        -- once and the design was invisible for it — it fired only for a
        -- player who had not joined, so everybody already in the championship
        -- got the ordinary grey strip. Joining only changes the button.
        local premium = b.championship and true or false
        local bh = premium and champ_banner.HEIGHT or 92
        local half = bh / 2
        local cy, alpha = EDGE_T - 70 - (idx - 1) * 102 + slide - (premium and (bh - 92) / 2 or 0), b.alpha or 1

        if premium then
            -- A CHAMPIONSHIP OFFER IS NOT A GAME REQUEST, and gets its own
            -- surface. Drawn by the shared module so this inline strip and
            -- incoming.gui_script's global overlay render the identical thing
            -- — see the long note in modules/champ_banner.lua for why it is
            -- written once rather than twice.
            local anim = champ_banner.draw({
                track = function(node) return track(self, node) end,
                ui = ui,
                box = { L = EDGE_L, R = EDGE_R, CX = CX },
                button = function(kind, node)
                    self.buttons[#self.buttons + 1] = {
                        node = node,
                        id = (kind == "accept") and "banner_accept" or "banner_decline",
                        data = b.request_id,
                    }
                end,
            }, b, cy, alpha)
            anim.b = b
            self.ban_bars[#self.ban_bars + 1] = anim
        else
            self.buttons[#self.buttons+1] = { node = track(self, ui.box(vmath.vector3(CX, cy, 0), vmath.vector3(bw, bh, 0), vmath.vector4(0.06, 0.10, 0.14, 0.97 * alpha))), id = "banner_block" }
            track(self, ui.box(vmath.vector3(CX, cy + half, 0), vmath.vector3(bw, 3, 0), vmath.vector4(0.2, 0.9, 1.0, alpha)))
            -- Sits ON the top rule, centred — a fixed position rather than
            -- trailing the title, which carries a player name of unpredictable
            -- length while the right-hand side is already crowded by H2H and
            -- the two buttons. No centred badge on the rule: the label sits
            -- inline below, between the H2H block and the buttons. Saying it
            -- twice on one strip is not twice as clear.
            -- Sender avatar (framed disc) on the left of the inline invite bar.
            track(self, ui.box(vmath.vector3(EDGE_L + 48, cy, 0), vmath.vector3(60, 60, 0), vmath.vector4(0.10, 0.14, 0.18, alpha)))
            local b_av = track(self, ui.avatar(vmath.vector3(EDGE_L + 48, cy, 0), vmath.vector3(54, 54, 0), b.avatar or 1))
            gui.set_color(b_av, vmath.vector4(1, 1, 1, alpha))
            -- RANK PILL FIRST, THEN THE NAME.
            --
            -- It LEADS the title line rather than trailing it. Trailing would
            -- put it in the one direction this strip has no room in: the title
            -- ends with a username of unpredictable length, and the space to
            -- its right is already spoken for by the H2H block, the kind badge
            -- and the two buttons — a long name would march the pill straight
            -- into them. Leading it, the pill sits at a fixed x and pushes the
            -- title into the empty middle of the strip instead, which is the
            -- direction that has slack.
            --
            -- Draws nothing and returns 0 for a sender with no rating, so an
            -- unrated invite keeps exactly the title position it has today.
            local rank_w = rank.draw(
                { track = function(n) return track(self, n) end, ui = ui },
                b.opp_winrate,
                EDGE_L + 90 + rank.badge_width(b.opp_winrate) / 2, cy + 20,
                BAN_RANK_H, alpha)
            local title_x = EDGE_L + 90 + (rank_w > 0 and (rank_w + BAN_RANK_GAP) or 0)
            gui.set_pivot(track(self, ui.text(vmath.vector3(title_x, cy + 20, 0), b.title or "GAME REQUEST", "body", vmath.vector4(0.92, 0.96, 1.0, alpha))), gui.PIVOT_W)
            gui.set_pivot(track(self, ui.text(vmath.vector3(EDGE_L + 90, cy - 12, 0), b.desc or "", "small", vmath.vector4(0.42, 0.56, 0.68, alpha))), gui.PIVOT_W)
            -- ONE BUTTON OR TWO, decided by what the strip is FOR.
            --
            -- An arriving invite is a choice and has both. A challenge this
            -- player SENT is not: the answer belongs to the opponent, so there
            -- is nothing here to accept and the only thing the sender can do is
            -- take it back. A greyed-out ACCEPT beside CANCEL would only be a
            -- second way of saying that.
            --
            -- The buttons carry the banner's KEY rather than its request id.
            -- A party offer has no request id — it is a table, not a challenge
            -- addressed to anybody — and keying on the id would have every
            -- open table share the empty string with every other.
            local key = b.key or b.request_id
            if not b.outgoing then
                self.buttons[#self.buttons+1] = { node = track(self, ui.box(vmath.vector3(EDGE_R - 90, cy, 0), vmath.vector3(120, 46, 0), vmath.vector4(0.0, 0.9, 0.63, 0.30 * alpha))), id = "banner_accept", data = key }
                track(self, ui.text(vmath.vector3(EDGE_R - 90, cy, 0), b.accept_label or "ACCEPT", "btn_md", vmath.vector4(1,1,1,alpha)))
            end
            -- On an outgoing strip the single button takes ACCEPT's slot, so
            -- the one thing that can be pressed sits where a thumb already
            -- expects to find a button on this strip.
            local dec_x = b.outgoing and 90 or 225
            self.buttons[#self.buttons+1] = { node = track(self, ui.box(vmath.vector3(EDGE_R - dec_x, cy, 0), vmath.vector3(120, 46, 0), vmath.vector4(0.12, 0.19, 0.27, 0.85 * alpha))), id = "banner_decline", data = key }
            track(self, ui.text(vmath.vector3(EDGE_R - dec_x, cy, 0), b.decline_label or "DECLINE", "btn_md", vmath.vector4(0.82,0.86,0.91,alpha)))
            -- Inline badge: same centre line as H2H and the buttons, in the
            -- space the shifted H2H anchor opens up.
            draw_badge(self, b.badge, EDGE_R - BAN_CHAMP_X, cy, BAN_CHAMP_H, alpha)
            if b.h2h then
                draw_h2h_row(self, EDGE_R - (b.badge and BAN_H2H_X_CHAMP or BAN_H2H_X), cy, h2h_view(b.h2h), alpha)
            end
            -- The fill is created unconditionally, even at zero width, because
            -- update_ban_bars resizes this exact node every frame — a node
            -- created only when there was something to show would not exist on
            -- the frames that need to grow it.
            track(self, ui.box(vmath.vector3(CX, cy - half, 0), vmath.vector3(bw, 3, 0), vmath.vector4(0.12, 0.19, 0.27, alpha)))
            local fill = track(self, ui.box(vmath.vector3(CX - bw/2, cy - half, 0), vmath.vector3(0, 3, 0), COL_GREEN))
            self.ban_bars[#self.ban_bars + 1] = { node = fill, b = b, w = bw, left = CX - bw/2, y = cy - half }
        end
    end
end

-- ── Main Rebuild ──────────────────────────────────────────────────────────────
local rebuild -- Forward declaration

rebuild = function(self)
    clear(self); local _, _, div_lx, div_rx = get_layout(); local ctx = make_ctx()
    track(self, ui.box(vmath.vector3(CX, CY, 0), vmath.vector3(LOGICAL_W*2, LOGICAL_H*2, 0), COL_BG))
    track(self, ui.cover_image(LOGICAL_W, LOGICAL_H, "texture_bg"))
    track(self, ui.box(vmath.vector3((div_lx+div_rx)/2, CY, 0), vmath.vector3(div_rx - div_lx, VISIBLE_H, 0), COL_BG))
    draw_dividers(self, div_lx, div_rx)

    left_panel.draw(self, ctx)
    center_panel.draw(self, ctx)
    right_panel.draw(self, ctx, left_panel)

    draw_banner(self)
end

-- ── ISO-8601 UTC date parsing ──────────────────────────────────────────────────
-- No shared date-parsing utility exists yet in modules/ (checked modules/util.lua),
-- so this small local parser converts "YYYY-MM-DDTHH:MM:SS(.sss)(Z)" into a UTC
-- epoch-seconds integer using a manual days-since-epoch calculation (does NOT rely
-- on os.time's local-timezone interpretation of the table, which would be wrong
-- on any device not set to UTC).
local function days_from_civil(y, m, d)
    -- Howard Hinnant's civil_from_days algorithm, inverted (UTC, proleptic Gregorian).
    y = (m <= 2) and (y - 1) or y
    local era = math.floor((y >= 0 and y or y - 399) / 400)
    local yoe = y - era * 400
    local mp = (m + 9) % 12
    local doy = math.floor((153 * mp + 2) / 5) + d - 1
    local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
    return era * 146097 + doe - 719468
end

local function parse_iso_utc(str)
    if type(str) ~= "string" then return nil end
    local y, mo, d, h, mi, s = str:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
    if not y then return nil end
    local days = days_from_civil(tonumber(y), tonumber(mo), tonumber(d))
    return days * 86400 + tonumber(h) * 3600 + tonumber(mi) * 60 + tonumber(s)
end

-- Wall-clock "now" as UTC epoch seconds, matching parse_iso_utc's epoch base
-- (os.time() already returns a UTC-based Unix epoch across platforms; only the
-- *table→time* direction is locale-sensitive, which is why we avoid it above).
local function now_utc()
    return os.time()
end

-- ── Season Logic ──────────────────────────────────────────────────────────────
-- Server-driven countdown: when ws.current_season_status has been received
-- (pushed right after IDENTIFY), drive the countdown off its real endDate.
-- Falls back to the legacy hardcoded Mon/Wed-noon/Sat cadence (Africa/Nairobi
-- UTC+3) so nothing regresses before the first SEASON_STATUS round-trip.
local function update_season(self)
    local status = ws.current_season_status
    local end_epoch = status and parse_iso_utc(status.endDate)

    if end_epoch then
        local now = now_utc()
        local diff = math.max(0, end_epoch - now)
        self.season_text = diff >= 86400
            and string.format("%dD %02dH %02dM %02dS", math.floor(diff / 86400), math.floor((diff % 86400) / 3600), math.floor((diff % 3600) / 60), diff % 60)
            or string.format("%02dH %02dM %02dS", math.floor(diff / 3600), math.floor((diff % 3600) / 60), diff % 60)
        self.season_target_text = "Season #" .. tostring(status.seasonNumber or "?")

        self.deadline, self.deadline_clock, self.deadline_urgency = "", nil, nil
        if diff <= 86400 then
            self.deadline = "SEASON END"
            local dh = math.floor(diff / 3600)
            self.deadline_clock = string.format("%02d:%02d:%02d", dh, math.floor((diff % 3600) / 60), diff % 60)
            self.deadline_urgency = dh < 1 and "FINAL HOUR!" or (dh < 3 and "Time running out!" or (dh < 6 and "Last chance!" or "Ends soon"))
        end
        return
    end

    -- ── Fallback: hardcoded Mon/Wed-noon/Sat cadence (Africa/Nairobi UTC+3) ──
    local t, now_eat = os.date("!*t", os.time() + 3 * 3600), os.time() + 3 * 3600
    local seconds_today = t.hour * 3600 + t.min * 60 + t.sec
    local midnight_today_eat = now_eat - seconds_today
    local is_phase_1 = (t.wday >= 1 and t.wday <= 3) or (t.wday == 4 and seconds_today < 43200)
    local target_eat = is_phase_1 and (midnight_today_eat + (((4 - t.wday) % 7) * 86400) + 43200) or (midnight_today_eat + (((7 - t.wday) % 7) * 86400) + 86399)
    local diff = math.max(0, target_eat - now_eat)
    self.season_text = diff >= 86400 and string.format("%dD %02dH %02dM %02dS", math.floor(diff/86400), math.floor((diff%86400)/3600), math.floor((diff%3600)/60), diff%60) or string.format("%02dH %02dM %02dS", math.floor(diff/3600), math.floor((diff%3600)/60), diff%60)
    self.season_target_text = is_phase_1 and "Ends Wednesday Midday" or "Ends Saturday Midnight"
    self.deadline, self.deadline_clock, self.deadline_urgency = "", nil, nil
    if (t.wday == 4 and seconds_today < 43200) or (t.wday == 7) then
        self.deadline = t.wday == 4 and "WEDNESDAY" or "SATURDAY"
        local rem = math.max(0, (t.wday == 4 and 43200 or 86400) - seconds_today)
        local dh = math.floor(rem / 3600)
        self.deadline_clock = string.format("%02d:%02d:%02d", dh, math.floor((rem % 3600) / 60), rem % 60)
        self.deadline_urgency = dh < 1 and "FINAL HOUR!" or (dh < 3 and "Time running out!" or (dh < 6 and "Last chance!" or (self.deadline == "WEDNESDAY" and "Ends at midday" or "Ends at midnight")))
    end
end

-- ── Banner Lifecycle ──────────────────────────────────────────────────────────
--
-- EVERY REQUEST ON THIS SCREEN IS THE SAME STRIP. Incoming, outgoing, party.
--
-- The two centred dialogs this replaced were the last modal surfaces in the
-- invite flow: a scrim over the whole lobby, and every screen's on_input
-- returning early behind it for ten seconds. A tournament, battle, knockout or
-- championship invite has been the strip for a long time — same slot, same
-- clock, same buttons — and neither being challenged nor waiting on an answer
-- is worth taking the app away from someone for. The strip already draws all
-- of it; what is added below is three constructors, not three designs.

--- Seconds left on a server deadline, in epoch milliseconds.
--
-- Returns nil when there is no deadline to read, so a caller can tell "no
-- clock" from "no time left" — those want opposite things (fall back to a
-- window of our own, versus close the strip now).
local function ms_left(closes_at)
    local closes = tonumber(closes_at) or 0
    if closes <= 0 then return nil end
    local now_ms = (socket and socket.gettime and socket.gettime() * 1000) or (os.time() * 1000)
    return math.max(0, (closes - now_ms) / 1000)
end

-- Only if the server never said. PARTY_JOIN_WINDOW_MS in be_matatu's
-- partyRules.ts is 20 seconds — twice a game request's window, because a table
-- is waiting for a lobby rather than for one person — and closesAt is what the
-- strip actually counts down. This is the "the payload said nothing" case.
local PARTY_WINDOW_FALLBACK = 20

-- At most two open tables on screen at once. The lobby can have more, and the
-- strips stack downward at 102px each: a third would be pushing the player
-- list off the screen to advertise a table that closes in fifteen seconds.
-- Tables that do not fit are simply not offered — they are NOT marked as
-- offered either, so one still open when a slot frees can take it.
local PARTY_BANNERS_MAX = 2

--- The strip for a challenge THIS PLAYER SENT.
--
-- Same row, same clock, one button. `key` rather than a request id because
-- there is not one: GAME_REQUEST is fire-and-forget, and the server answers
-- with a match or a decline rather than an id to cancel by. Keyed on the
-- opponent instead, which is what a second challenge to the same player would
-- collide with, and exactly what should.
local function open_outgoing_banner(self, u, stake)
    local amount = tonumber((stake or {}).amount) or 0
    local name   = string.upper(tostring(u.username or "OPPONENT"))
    local b = {
        outgoing      = true,
        key           = "out:" .. tostring(u._id or name),
        request_id    = "",
        opponent_id   = u._id and tostring(u._id) or nil,
        title         = "CHALLENGE SENT  -  " .. name,
        desc          = "Waiting for them to accept"
                        .. "   -   " .. (amount > 0 and (commas(amount * 2) .. " Coins pot") or "Practice Mode"),
        avatar        = tonumber(u.avatar) or 1,
        stake         = stake or {},
        time_left     = 10,
        max_time      = 10,
        alpha         = 1,
        y_off         = 0,
        decline_label = "CANCEL",
    }
    self.banners = self.banners or {}
    for _, ex in ipairs(self.banners) do if ex.key == b.key then return end end
    table.insert(self.banners, b)
    if self._active then rebuild(self) end
end

--- The strip for ONE OPEN TABLE, from a PARTY_AVAILABLE listing entry.
local function party_banner_of(p)
    local entry  = tonumber(p.entry) or 0
    local seated = tonumber(p.seated) or 0
    local left   = ms_left(p.closesAt) or PARTY_WINDOW_FALLBACK
    -- KNOCKOUT is what the maker's own form calls SCORECAP, and what the
    -- player chose it by. The wire name is not shown to anybody.
    local mode = (tostring(p.mode or "NORMAL"):upper() == "SCORECAP") and "KNOCKOUT" or "NORMAL"
    return {
        party_id      = tostring(p.partyId or ""),
        key           = "party:" .. tostring(p.partyId or ""),
        -- Not a challenge, so nothing to accept or decline on the socket. The
        -- empty id is what keeps this strip out of every path that answers one.
        request_id    = "",
        entry         = entry,
        closes_at     = tonumber(p.closesAt) or 0,
        title         = "PARTY  -  " .. string.upper(tostring(p.hostName ~= "" and p.hostName or "A PLAYER")),
        desc          = mode .. "   -   " .. seated .. "/4 seated   -   "
                        .. (entry > 0 and (commas(entry) .. " Coins") or "Free table"),
        badge         = "PARTY",
        avatar        = tonumber(p.hostAvatar) or 1,
        accept_label  = "JOIN",
        -- Not DECLINE. Nobody is waiting on an answer — the table fills with
        -- whoever sits down — so putting the strip away is not turning
        -- anything down, and nothing is sent when it is pressed.
        decline_label = "LATER",
        time_left     = left,
        max_time      = math.max(1, left),
        alpha         = 1,
        y_off         = 0,
    }
end

--- Reconcile the open-table strips against the listing the server just sent.
--
-- PARTY_AVAILABLE is the whole truth every time: already filtered to what THIS
-- player can join and sorted soonest-to-close first. So a table missing from it
-- has filled, expired or been called off, and its strip goes — a strip that
-- outlived its table taps through to a refusal, which is the one thing an
-- offer must never do.
--
-- Returns true when anything moved, so the caller can rebuild once rather than
-- once per table.
local function sync_party_banners(self)
    local list = type(ws.available_parties) == "table" and ws.available_parties or {}
    -- Already sitting at a table: the server has stopped offering us others,
    -- and any strip still up is from the frame before we sat down.
    local seated = type(ws.current_party) == "table" and ws.current_party.partyId ~= nil

    local by_id, changed = {}, false
    for _, p in ipairs(list) do
        local pid = tostring(p.partyId or "")
        if pid ~= "" then by_id[pid] = p end
    end

    self.banners = self.banners or {}
    local live = 0
    for i = #self.banners, 1, -1 do
        local b = self.banners[i]
        if b.party_id then
            local p = (not seated) and by_id[b.party_id] or nil
            if not p then
                table.remove(self.banners, i); changed = true
            else
                live = live + 1
                -- The SEAT COUNT is the thing that moves while a strip is up,
                -- and it is the number a player is deciding on. Refreshed in
                -- place so the strip does not restart its clock every time
                -- somebody else sits down.
                local fresh = party_banner_of(p)
                if fresh.desc ~= b.desc then b.desc = fresh.desc; changed = true end
                b.closes_at = fresh.closes_at
            end
        end
    end

    if not seated then
        self._party_offered = self._party_offered or {}
        for _, p in ipairs(list) do
            local pid = tostring(p.partyId or "")
            local room = live < PARTY_BANNERS_MAX
            -- ONCE PER TABLE, EVER. Without that, a player who put the strip
            -- away would have it come back on the next seat change of the
            -- same table — a notification arguing with the person dismissing
            -- it. Marked only when it is actually shown, so a table that had
            -- no room stays offerable.
            if pid ~= "" and room and not self._party_offered[pid] then
                self._party_offered[pid] = true
                table.insert(self.banners, party_banner_of(p))
                live, changed = live + 1, true
                play_snd("snd_notify")
            end
        end
    end

    if #self.banners == 0 then self.banners = nil end
    return changed
end

local function open_banner(self, raw)
    local sender_av = (type(raw.sender) == "table" and tonumber(raw.sender.avatar)) or 1
    local sender_nm = ((type(raw.sender) == "table" and raw.sender.username) or "Opponent"):upper()
    local tourney   = (type(raw.tournament) == "table") and raw.tournament or nil

    -- WHAT THIS INVITE IS, named once and used for both the title and the badge.
    --
    -- ws.current_user_data is passed so an invite whose payload says nothing
    -- useful can still be recognised by its tournament id against the player's
    -- own list. Same call incoming.gui_script makes, so the two surfaces label
    -- the same invite the same way.
    local kind = champ.kind(tourney, ws.current_user_data)
    if (raw.gameType or "") == "BATTLE" then
        -- A BATTLE request is never the championship, whatever its document says.
        if kind == "CHAMPIONSHIP" then kind = "BATTLE" end
        -- And if the payload carried no tournament to read at all, the request
        -- type is still enough to label it. Better a correct BATTLE badge than
        -- a bare strip.
        kind = kind or "BATTLE"
    end

    local stake  = (tourney and tourney.stake) or raw.stake or {}
    local amount = tonumber(stake.amount) or 0

    -- A knockout is played to a score cap, not as a series. Shared with the
    -- global overlay so the same invite is described the same way on both, and
    -- so "Best of 1" cannot come back on one of them.
    local desc = champ.format_text(tourney, kind)
        .. "   -   " .. (amount > 0 and (commas(amount) .. " Coins") or "Practice Mode")

    -- JOIN or ACCEPT? Same shared answer incoming.gui_script uses, so the
    -- global overlay and this inline strip cannot offer different things for
    -- one invite.
    local offer = champ.offer(raw, ws.current_user_data)

    local b = {
        title      = (kind or "TOURNAMENT") .. "  -  " .. sender_nm,
        desc       = desc,
        badge      = kind,
        request_id = raw.requestId or "",
        avatar     = sender_av,
        time_left  = 10,
        max_time   = 10,
        alpha      = 1,
        y_off      = 0,
        h2h        = raw.headToHead,
        -- THE SENDER'S STANDING, carried as the raw win rate rather than as a
        -- rendered string. Both branches of draw_banner turn it into a tier
        -- pill — the ordinary strip inline beside the name, the championship
        -- strip beside the name on its own line — and a pre-formatted
        -- "WR 48%" could only ever have been one of them.
        opp_winrate = (h2h_view(raw.headToHead) or {}).opp_winrate,
        championship  = offer.championship,
        joining       = offer.joining,
        -- The sender's name alone: the premium strip prints GLOBAL
        -- CHAMPIONSHIP itself, so `title` would say it twice.
        opponent_name = sender_nm,
        entry_fee     = offer.entry_fee,
        prize         = offer.prize,
        accept_label  = offer.accept_label,
        decline_label = offer.decline_label,
    }
    self.banners = self.banners or {}; for _, ex in ipairs(self.banners) do if b.request_id ~= "" and ex.request_id == b.request_id then return end end
    table.insert(self.banners, b)
    -- Audible cue for an incoming tournament/battle invite.
    play_snd("snd_notify")
    if self._active then rebuild(self) end
end

-- ── Standard Defold Hooks ─────────────────────────────────────────────────────
function init(self)
    -- Default stake index was hardcoded to 2 (the smallest paid tier in
    -- Matatu's table). Look up this game's own default amount instead
    -- (GameMode.DEFAULT_STAKE_AMOUNT: matatu=200, whot=100, kadi=10) so the
    -- stake app_state starts in sync with online_center.lua's own default
    -- selection, and Whot/Kadi builds don't start pinned to a UGX-derived index.
    local default_idx = 2
    if config.STAKE_LEVELS then
        for idx, lvl in ipairs(config.STAKE_LEVELS) do
            if lvl.amount == GameMode.DEFAULT_STAKE_AMOUNT then
                default_idx = idx
                break
            end
        end
    end
    self.nodes, self.buttons, self.stake_index, self.tab, self.list_scroll, self._tick = {}, {}, default_idx, TAB_QUICK, 0, 0
    app_state.selected_stake = app_state.selected_stake or config.STAKE_LEVELS[self.stake_index]
    -- Plays the "Tap a player..." helper text out as a one-shot typing
    -- animation the first time this screen is shown this session, so a
    -- first-time visitor's eye is drawn to it (see update()/online_center.lua).
    self._tap_hint_active, self._tap_hint_t = true, 0
    refresh_wh(); update_season(self)

    config.check_play_update()
end

function update(self, dt)
    -- A MONOTONIC CLOCK FOR THINGS THAT ANIMATE ACROSS REBUILDS.
    --
    -- One addition a frame. rebuild() deletes and recreates every node on the
    -- screen, so anything that animates has to be able to work out where its
    -- animation had got to — otherwise it restarts from rest each time and,
    -- on the paths that rebuild every frame (the savings promo types itself
    -- out that way), never moves at all.
    self.ui_clock = (self.ui_clock or 0) + dt

    -- A GESTURE THAT OUTLIVED ITS TOUCH IS ABANDONED.
    --
    -- Belt and braces behind the press-ordering fix in on_input: a release can
    -- simply never arrive, and a live gesture is the thing that swallows
    -- input. Four seconds is far longer than any real drag and far shorter
    -- than a player would spend wondering why the screen has stopped
    -- responding.
    if self._gesture and list_gesture.expired(self._gesture, self.ui_clock) then
        print("[ONLINE] abandoning a gesture whose touch never ended")
        list_gesture.cancel(self._gesture)
        self._tap_at = nil
    end

    if not self._active then return end

    local need_rebuild = false

    -- ── Banners (inline tournament/battle invites) ────────────────────────
    if self.banners and #self.banners > 0 then
        local expired = {}
        for _, b in ipairs(self.banners) do
            -- A PARTY STRIP COUNTS DOWN TO THE SERVER'S OWN DEADLINE.
            --
            -- Every other strip owns its clock: ten seconds from when the
            -- invite landed, and the server's request timeout is the same ten.
            -- A table is not ours to time. It closes at closesAt whatever this
            -- screen thinks, and a strip running its own twenty seconds would
            -- drift off it — offering a seat at a table that dealt four
            -- seconds ago, or taking one away that is still filling. So the
            -- deadline is read every frame and the bar is the truth.
            b.time_left = (b.party_id and ms_left(b.closes_at)) or ((b.time_left or 10) - dt)
            local cur_sec = math.floor(math.max(0, b.time_left))
            if cur_sec ~= b._last_sec then
                b._last_sec = cur_sec
                need_rebuild = true
            end

            if b.time_left <= 0 then table.insert(expired, b) end
        end
        -- Smooth: resize the existing fills. The whole-second rebuild above
        -- still happens, for everything that genuinely ticks in seconds.
        pcall(update_ban_bars, self, dt)
        for _, b in ipairs(expired) do
            -- A LAPSED STRIP ANSWERS FOR THE PLAYER — but only where there is
            -- something to answer. An unanswered challenge is declined so the
            -- opponent is not left watching a spinner until the server's own
            -- timeout; a table that closed and a challenge we SENT have nobody
            -- waiting on us, and a decline for either would be a message about
            -- a request that never existed.
            if not b.party_id and not b.outgoing
               and b.request_id and b.request_id ~= "" then
                ws.decline_game_request(b.request_id)
            end
            local key = b.key or b.request_id
            for i = #self.banners, 1, -1 do
                if (self.banners[i].key or self.banners[i].request_id) == key then table.remove(self.banners, i) end
            end
            if #self.banners == 0 then self.banners = nil end
            need_rebuild = true
        end
    end

    -- ── First-time "Tap a player..." typing hint (direct node update, zero rebuild) ─
    if self._tap_hint_active then
        self._tap_hint_t = (self._tap_hint_t or 0) + dt
        local n = math.floor(self._tap_hint_t / 0.035)
        local HINT_TEXT = "Tap a player to request a game. If they decline, try another!"
        if n >= #HINT_TEXT then
            self._tap_hint_active = false
            if self.tap_hint_node then pcall(gui.set_text, self.tap_hint_node, HINT_TEXT) end
        else
            if self.tap_hint_node then pcall(gui.set_text, self.tap_hint_node, string.sub(HINT_TEXT, 1, n) .. "_") end
        end
    end

    -- ── Lottery opponent-search reel ──────────────────────────────────────
    if self.invite_search and not self.invite_search.found then
        local sr = self.invite_search
        -- search_clock owns sr.t and sr.shown: the real elapsed time, and the
        -- number the ring draws, which only ever descends. The reel and the
        -- dots keep their own clocks — neither is corrected by the server, so
        -- neither can jump.
        search_clock.tick(sr, dt)
        sr.spin_t = (sr.spin_t or 0) + dt
        if sr.spin_t >= 0.07 then sr.spin_t = 0; sr.reel_ix = math.random(60); if self.invite_reel_node then pcall(gui.play_flipbook, self.invite_reel_node, "avatar_" .. sr.reel_ix) end end

        -- ONE FRAME OF THE DIALOG, NOT ONE REBUILD OF THE SCREEN.
        --
        -- This used to set need_rebuild twice a second, which tore down and
        -- recreated the ENTIRE online screen — both panels, every row of the
        -- player list, the dividers, the banner — so that a countdown digit
        -- could change and three dots could cycle. Hundreds of gui nodes a
        -- second to animate a string, for as long as the dialog was open.
        --
        -- dialog_search.animate sets the moving parts on the nodes that are
        -- already there. It allocates nothing, and it runs every frame, which
        -- is also the only way the entrance animations can play at all: at two
        -- rebuilds a second a 450ms flight across the dialog got one frame.
        -- A PARTY IS A DIFFERENT DIALOG NOW, and it animates the same way.
        --
        -- Same rule either side: set the handful of nodes that move, and
        -- rebuild only when the thing being drawn actually changes — a chair
        -- filling, a winner being named, the search ending. Rebuilding to
        -- advance a countdown digit is what tore down the whole screen sixty
        -- times a second the last time this was got wrong.
        local key
        if sr.party then
            local d = right_panel.party_wait_state(self)
            dialog_incoming.animate_party(self, d)
            -- The arrival is the event this dialog exists to show, so it gets
            -- the sound the search dialog gives an acceptance.
            local seated = #((d or {}).seats or {})
            if sr._seated_count and seated > sr._seated_count then play_snd("snd_found") end
            sr._seated_count = seated
            key = dialog_incoming.party_key(d)
        else
            dialog_search.animate(self, sr)
            key = dialog_search.structure_key(sr)
        end
        if key ~= sr._layout_key then sr._layout_key = key; need_rebuild = true end
    end

    -- ── Debounced Rebuild Coalescing for rapid socket bursts ──────────────
    if self._rebuild_pending then
        self._rebuild_pending_t = (self._rebuild_pending_t or 0) + dt
        if self._rebuild_pending_t >= 0.08 then
            self._rebuild_pending = false
            self._rebuild_pending_t = 0
            need_rebuild = true
        end
    end

    -- ── The tournaments badge, breathing while the door is open ──────────
    -- Written straight into the node, like the season countdown below and for
    -- the same reason: rebuild() would restart a tween every time, and the
    -- paths that rebuild every frame would hold it at rest forever. Costs one
    -- cosine and one set_scale, and only while the badge says OPEN.
    right_panel.pulse_badge(self, self.ui_clock)

    -- ── Savings promo, typing itself out ─────────────────────────────────
    -- draw_savings_info works out how much of the copy to show from the wall
    -- clock, so this only has to ask for the redraws that make it animate —
    -- and if this loop ever stops running, the card shows its full text
    -- rather than an empty one. That is the failure it used to have: the
    -- timer it read was never advanced by anything, so every line rendered
    -- as the empty string and the promo opened blank.
    if self.savings_info_open and not self._savings_type_done then
        need_rebuild = true
    end

    -- ── Season Bonuses countdown, ticked in place ─────────────────────────
    -- Written straight into the node rather than through need_rebuild: this
    -- changes once a second for the whole time the screen is open, and
    -- rebuild() tears down and recreates every node on the panel. A once-a-
    -- second full rebuild for one short string is the most expensive way to
    -- draw a clock.
    --
    -- Re-read from `self` each time because rebuild() DOES destroy it — the
    -- node this holds after a rebuild is the new one online_left just made,
    -- and pcall covers the frame in between.
    self._bonus_clock_t = (self._bonus_clock_t or 0) + dt
    if self._bonus_clock_t >= season_clock.TICK_SECONDS then
        self._bonus_clock_t = 0
        local secs = season_clock.remaining(ws.current_season_status)
        local txt = season_clock.full(secs)
        if txt ~= self._bonus_clock_text then
            self._bonus_clock_text = txt
            if self.bonus_clock_node then
                pcall(gui.set_text, self.bonus_clock_node, txt)
                -- Repainted alongside the text, from the same rule the panel
                -- built it with (left_panel.clock_color): gold, red in the
                -- final hour, dim once it has passed. Set here rather than
                -- only at build time, or the label would keep its colour
                -- until something else happened to rebuild the panel — and
                -- the whole point of the red is that it arrives exactly when
                -- the deadline does.
                pcall(gui.set_color, self.bonus_clock_node, left_panel.clock_color(C, secs))
            end
        end
    end

    if need_rebuild then rebuild(self); return end

    -- Periodic fallback so the standings panel doesn't go stale (request rank quietly every 20s)
    self._rank_tick = (self._rank_tick or 0) + dt
    if self._rank_tick >= 20 then
        self._rank_tick = 0
        if ws.is_identified then pcall(ws.request_rank) end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("screen_enter") then
        msg.post(".", "acquire_input_focus"); self._active, self.banners, self.list_scroll, self.battle_modal, self.invite_search, app_state.searching_invite, self.savings_info_open, self.savings_add_open, self.savings_plans_open = true, nil, 0, nil, nil, false, nil, nil, nil
        -- Auto-open the Savings explainer (modules/online_right.lua's
        -- draw_savings_info, normally only reached via a small "i" icon a
        -- first-time player would likely never notice) exactly once EVER —
        -- savingsPromoSeen is persisted server-side (see mark_savings_promo_
        -- seen), not just tracked for this app session, so every player goes
        -- through this step once and it never comes back uninvited after
        -- that. It already has a clear CLOSE button (savings_info_close).
        local u = ws.current_user_data or {}
        if u.savingsPromoSeen ~= true then
            self.savings_info_open = true
            self._savings_type_t0, self._savings_type_done = nil, nil
        end
        -- Any table still open when the player walks in. The strips were just
        -- cleared with everything else, and the dedupe means only a table that
        -- has not already been offered — here or on the global overlay — comes
        -- back; without this the lobby shows nothing until the next seat
        -- change anywhere in it.
        sync_party_banners(self)
        refresh_wh(); rebuild(self)
        -- Actively ask for a fresh online-players list every time this
        -- screen is entered — don't just trust whatever's cached from the
        -- last (debounced, purely event-driven) server broadcast, which may
        -- have fired before we were ready to receive it.
        if ws.is_identified then pcall(ws.request_online_users); pcall(ws.request_rank) end
    elseif message_id == hash("ws_match_found") and self.invite_search then
        local gs, me, opp = ws.get_active_game() or {}, tostring(ws.get_current_user_id() or ""), nil
        for k, pl in pairs(gs.players or {}) do if tostring((type(pl) == "table" and (pl._id or pl.id)) or k) ~= me then opp = pl end end
        self.invite_search.found, self.invite_search.reel_ix, self.invite_search.opp_name, app_state.searching_invite = true, (type(opp) == "table" and tonumber(opp.avatar)) or self.invite_search.reel_ix, string.upper(tostring((type(opp) == "table" and opp.username ~= "" and opp.username) or "PLAYER")), false
        -- Stop the looping search cues (snd_suspense is what's actually playing
        -- while searching; snd_notify is stopped defensively too) and play a
        -- distinct "found" sting.
        stop_snd("snd_suspense"); stop_snd("snd_notify"); play_snd("snd_found")
        rebuild(self)
    elseif message_id == hash("ws_search_window") and self.invite_search then
        -- THE SERVER'S WINDOW, MEASURED FROM WHEN IT ARRIVES.
        --
        -- settle_ms is a DURATION, and a duration means "this long from now".
        -- It used to be adopted as `max_time` while sr.t kept running from
        -- when the dialog opened, so the ring drew (max_time - grace) minus an
        -- elapsed time the new number knew nothing about. If the message was
        -- late — and it can be: the server builds an invite per opponent, each
        -- waiting on a head-to-head lookup — it also carried what was LEFT of
        -- the window rather than the whole of it, and the two errors compounded:
        --
        --   fallback 12, grace 0, elapsed 0..2   ->  12, 11, 10
        --   then 8 left, grace 2, elapsed ~2     ->  4
        --
        -- which is the reported jump, and the same arithmetic made the failsafe
        -- fire at ~11s while the server settled at 12 — the dialog closing and
        -- THEN the game opening.
        --
        -- Restarting the clock here fixes both without needing the server to be
        -- punctual: whatever arrives is counted from now, so the ring can only
        -- ever run down. A late message makes the countdown longer, never
        -- shorter, and never jumps backwards.
        local sr = self.invite_search
        if not sr.found and not sr.failed
           and search_clock.adopt(sr, message and message.settle_ms,
                                  message and message.grace_ms,
                                  message and message.invited) then
            if sr.timer_handle then pcall(timer.cancel, sr.timer_handle) end
            sr.timer_handle = timer.delay(
                search_clock.failsafe_delay(sr, right_panel.SEARCH_FAILSAFE_GRACE), false,
                function()
                    if self.invite_search == sr and not sr.found then
                        -- No reason: the shortlist decides what is true.
                        right_panel.fail_invite_search(self, app_state, function() rebuild(self) end, nil)
                    end
                end)
            rebuild(self)
        end
    elseif message_id == hash("ws_search_roster") and self.invite_search then
        -- Somebody accepted. Show them arriving; do NOT close — the window is
        -- still running and the opponent is chosen at the end of it.
        local sr = self.invite_search
        local roster = ws.last_search_roster
        if not sr.failed and type(roster) == "table" then
            -- A PARTY'S CLOCK BELONGS TO THE TABLE, AND THE TABLE RESTATES IT
            -- ON EVERY SEAT.
            --
            -- The ring opened on a twelve-second placeholder — the battle
            -- search's fallback — while a table is open for twenty. So it hit
            -- zero with eight seconds of joining still to go, and sat at zero
            -- while people were still sitting down. PARTY_ROSTER carries the
            -- server's own closesAt as remaining_ms; adopt re-aims the ring at
            -- it from wherever it currently is, so the correction is a change
            -- of rate rather than a jump.
            --
            -- No grace: a table has none. It closes and deals with whoever is
            -- on it, where a battle holds a tail open for answers in flight.
            if sr.party and (tonumber(roster.remaining_ms) or 0) > 0 then
                search_clock.adopt(sr, roster.remaining_ms, 0, nil)
                right_panel.arm_party_failsafe(self, app_state,
                    function() rebuild(self) end, roster.remaining_ms / 1000)
            end
            -- ONE SOUND PER PLAYER, not one per message.
            --
            -- The server re-sends the WHOLE roster on every push, so counting
            -- the list rather than the difference would re-announce everybody
            -- already in it, once per arrival. note_arrivals returns only what
            -- is genuinely new, and stamps each entry with the moment it
            -- landed so the dialog can pop it in.
            local fresh = search_clock.note_arrivals(sr, roster.accepted or {})
            sr.chosen_id = roster.chosen_id
            if fresh > 0 then play_snd("snd_found") end
            rebuild(self)
        end
    elseif message_id == hash("ws_search_failed") and self.invite_search then
        -- No opponent found / declined: play the playful miss transition on the
        -- reel, then close the overlay (fail_invite_search handles the timing).
        right_panel.fail_invite_search(self, app_state, function() rebuild(self) end, message and message.reason)
    elseif message_id == hash("enable") then refresh_wh(); self._active = true
    elseif message_id == hash("disable") then self._active = false; clear(self)
    elseif message_id == hash("ws_identify") then
        if self._active then
            pcall(ws.request_online_users)
            pcall(ws.request_rank)
            self._rebuild_pending = true
        end
    elseif message_id == hash("party_settled") then
        -- The server answered: we are seated at a table, or it did not open.
        --
        -- Either way the OTHER tables stop being offers. Sitting down is what
        -- the server stops offering on, and a strip left over from the frame
        -- before now taps through to a refusal — so it goes here rather than
        -- waiting for the next listing to arrive and say so.
        sync_party_banners(self)
        -- AND SO DO CHALLENGES, IN BOTH DIRECTIONS.
        --
        -- The server retires every request naming a player the moment they
        -- take a seat — the ones they received are declined, the ones they
        -- sent are cancelled — so these strips are answering for requests that
        -- no longer exist. Left up, ACCEPT on one is a tap that can only be
        -- refused, and the refusal reads as the party having gone wrong.
        if type(ws.current_party) == "table" and ws.current_party.partyId and self.banners then
            for i = #self.banners, 1, -1 do
                if not self.banners[i].party_id then table.remove(self.banners, i) end
            end
            if #self.banners == 0 then self.banners = nil end
        end
        if self._active then self._rebuild_pending = true end
    elseif message_id == hash("party_failed") and self.invite_search then
        -- The table did not fill, or it could not be opened. Same ending the
        -- tournament search has, through the same function — the reel plays
        -- its miss and the overlay closes on its own timing.
        right_panel.fail_invite_search(self, app_state, function() rebuild(self) end,
            (message and message.reason) or "Nobody else sat down in time")
    elseif message_id == hash("party_offer") then
        -- AN OPEN TABLE ARRIVES ON THE SAME STRIP EVERY OTHER INVITE DOES.
        --
        -- It used to throw a full-screen PARTY TABLES panel over the lobby the
        -- moment a table opened — a modal, unasked for, for something nobody
        -- had done anything to receive. Every other invite in this app is a
        -- row at the top of the screen that leaves the app working underneath
        -- it, and a table somebody else opened has less claim on the player's
        -- attention than a challenge addressed to them by name, not more.
        --
        -- The panel is gone entirely. Its two jobs both had better homes: the
        -- list of tables is these strips, and the seated view — your table,
        -- its roster, its countdown — is the search dialog a party host
        -- already watches fill, which a guest now joins into as well.
        if self._active and sync_party_banners(self) then self._rebuild_pending = true end
    elseif message_id == hash("party_dismiss") then
        -- The table dealt. Mark the search FOUND rather than just closing it:
        -- that is the beat the tournament dialog plays before a board appears
        -- — the roster settles, the title turns over — and a party that
        -- skipped straight to the board would be the only mode that does.
        -- The board arrives on game_start a moment later regardless.
        if self.invite_search then
            self.invite_search.found = true
            self.invite_search.failed = false
        end
        -- And every open-table strip goes with it: we are in a game now, and
        -- the offers behind it are either the table that just dealt or ones
        -- the server has already stopped sending us.
        if self.banners then
            for i = #self.banners, 1, -1 do if self.banners[i].party_id then table.remove(self.banners, i) end end
            if #self.banners == 0 then self.banners = nil end
        end
        if self._active then self._rebuild_pending = true end
    elseif message_id == hash("layout_changed") or message_id == hash("user_data_updated") or message_id == hash("ws_online_users") or message_id == hash("ws_connected") or message_id == hash("ws_disconnected") then
        if self._active then self._rebuild_pending = true end
        if message_id == hash("ws_online_users") and self._active and ws.is_identified then
            pcall(ws.request_rank)
        end
    elseif message_id == hash("ws_rank_update") then
        if self._active then self._rebuild_pending = true end
    elseif message_id == hash("ws_game_request") then
        -- Plain incoming requests are rendered by the GLOBAL overlay
        -- (main/incoming.gui_script). The inline tournament/battle banner is only
        -- shown while the online screen is actually up; off-screen the global
        -- overlay surfaces tournament/battle invites too, so the banner and its
        -- sound never fire on a hidden screen (which previously played a sound
        -- with no visible notification).
        if self._active then
            local raw = (ws.last_game_request or {}).raw or {}
            if type(raw) == "table" and (raw.gameType == "TOURNAMENT" or raw.gameType == "BATTLE" or raw.tournament) then open_banner(self, raw) end
        end
    elseif message_id == hash("ws_head_to_head") then
        -- THE RECORD BETWEEN THE TWO OF YOU, arriving after the challenge went
        -- out. It used to land on the outgoing dialog; the outgoing strip is
        -- the same request drawn on the same surface as every other, and
        -- draw_banner already renders an h2h row when a banner carries one.
        local d = ws.last_head_to_head or {}
        local oid = tostring(d.opponentId or "")
        if oid ~= "" then
            for _, b in ipairs(self.banners or {}) do
                if b.opponent_id == oid then
                    b.h2h = d.headToHead
                    b.opp_winrate = (h2h_view(d.headToHead) or {}).opp_winrate
                    if self._active then rebuild(self) end
                end
            end
        end
    elseif message_id == hash("ws_request_declined") or message_id == hash("ws_request_cancelled") then
        -- The named request, and any challenge we have out — an unanswered
        -- decline carries no id of ours to match on, and leaving the strip up
        -- after the opponent has said no is worse than closing one strip too
        -- many on a screen that only ever holds one outgoing challenge.
        if self.banners then
            local rid = message and message.request_id
            for i = #self.banners, 1, -1 do
                local b = self.banners[i]
                if b.outgoing or (rid and rid ~= "" and b.request_id == rid) then table.remove(self.banners, i) end
            end
            if #self.banners == 0 then self.banners = nil end
        end
        self.list_scroll = 0; if self._active then rebuild(self) end
    elseif message_id == hash("ws_savings_status") then
        -- SAVINGS_STATUS parked on ws.current_savings_status — nothing to seed
        -- here (the "savings_add" dispatch seeds self.savings_add lazily on
        -- open), just repaint if the SAV. row or an open dialog needs the
        -- fresh numbers.
        if self._active then rebuild(self) end
    elseif message_id == hash("ws_savings_exchange_result") then
        local d = ws.last_savings_exchange or {}
        local sa = self.savings_add
        if sa then
            sa.exchanging = false
            if d.success then
                sa.msg, sa.msg_ok = string.format("Exchanged %s coins to Savings.", commas(tonumber(d.amount) or 0)), true
                -- Balance -> savings is a balance-decreasing action: fly coins
                -- from the CONFIRM EXCHANGE button to the top-right HUD anchor,
                -- sign = "-" (mirrors the coin_delta primitive used by the
                -- daily bonus claim's "+" flow).
                local amt = tonumber(d.amount) or 0
                if amt > 0 then
                    pcall(msg.post, "#coins", "coin_delta", {
                        from = self.savings_exchange_btn_pos or { x = 640, y = 200 },
                        to = { x = 1160, y = 660 },
                        amount = amt,
                        sign = "-",
                    })
                end
            else
                sa.msg, sa.msg_ok = d.message or "Exchange failed", false
                toast.error(sa.msg)
            end
        end
        if self._active then rebuild(self) end
    elseif message_id == hash("ws_savings_settings_updated") then
        local d = ws.last_savings_settings or {}
        local sa = self.savings_add
        if sa then
            sa.saving = false
            if d.success then
                sa.settings_msg, sa.settings_msg_ok = "Auto-charge settings saved.", true
            else
                sa.settings_msg, sa.settings_msg_ok = d.message or "Save failed", false
                toast.error(sa.settings_msg)
            end
        end
        if self._active then rebuild(self) end
    end
end

function on_input(self, action_id, action)
    -- Any modal on top outranks a screen. These components are listed
    -- BEFORE the dialogs in controller.go, so without this they would
    -- consume the tap first and act on it behind an open dialog.
    if app_state.input_blocked() then return false end
    -- All screens are components of ONE game object, so Defold dispatches input
    -- to them in component order — and `online` comes before `payments`/`themes`.
    -- When one of those is layered on top (it stays enabled only to render the
    -- backdrop), the online lobby must NOT eat the tap, or buttons "behind" the
    -- modal fire. Bail unless online is actually the active screen.
    if app_state.current_screen ~= "online" then return false end

    -- A GESTURE CANNOT SURVIVE THE LIST GOING AWAY UNDER IT.
    --
    -- An incoming request banner, a dialog, a tab change — any of them can
    -- land between the press and the release, and the block below is skipped
    -- entirely while one is up. The half-finished gesture would then still be
    -- recorded, and the next release to reach here would be read as a tap on
    -- whatever now occupies that point. Dropped instead.
    if self.battle_modal or self.invite_search or self.banners
        or not self.list_region then
        if self._gesture then list_gesture.cancel(self._gesture) end
        self._tap_at = nil
    end

    -- Handle natural scrolling (Touch Dragging + Mouse Wheel Support)
    if not self.battle_modal and not self.invite_search and not self.banners and self.list_region and action.x and action.y then
        local reg = self.list_region
        local in_reg = action.x >= reg.left and action.x <= reg.right and action.y >= reg.bottom and action.y <= reg.top

        if action_id == hash("touch") then
            -- A PRESS IS ALWAYS THE START OF SOMETHING NEW, so it is tested
            -- before anything else — and this ordering is the bug it fixes.
            --
            -- A release is not guaranteed to arrive: a touch interrupted by a
            -- system gesture, a notification shade, a second finger or the app
            -- being backgrounded can end without one, leaving a gesture live.
            -- The drag branch below reads `not action.released`, and a PRESS is
            -- also not a release — so with a stale gesture the next press
            -- anywhere on screen was consumed as a drag and swallowed, and
            -- every button on the lobby stopped responding until something
            -- happened to clear it.
            --
            -- Nothing usually did. The cancel at the top of on_input only fires
            -- when there is no list_region, which is the case when the list is
            -- EMPTY — so a quiet lobby healed itself and a busy one stayed
            -- stuck, which is why this looked related to how many players were
            -- online.
            if action.pressed then
                if in_reg then
                    -- Swallowed (return true) so it cannot reach the button
                    -- loop below, which acts on action.pressed. What this touch
                    -- turns out to be is decided at the release.
                    self._gesture = self._gesture or {}
                    list_gesture.press(self._gesture, action.y, self.ui_clock)
                    return true
                end
                -- Outside the list. Whatever was in flight is over, and this
                -- press belongs to a button — so drop the gesture and fall
                -- through rather than eating the tap.
                if self._gesture then list_gesture.cancel(self._gesture) end
            elseif list_gesture.active(self._gesture) and not action.released then
                local d = list_gesture.move(self._gesture, action.y)
                if d ~= 0 then
                    -- Sign is '+' so the content follows the finger.
                    self.list_scroll = (self.list_scroll or 0) + d
                    rebuild(self)
                end
                return true
            elseif action.released and list_gesture.active(self._gesture) then
                if list_gesture.release(self._gesture) ~= "tap" then return true end
                -- A TAP. The row is picked from where the finger came UP,
                -- rather than from a node remembered at the press: rebuild()
                -- destroys and recreates every node in this list, so a handle
                -- held across even one frame can refer to something that no
                -- longer exists. Nothing moved below the slop, so it is the
                -- same row either way.
                self._tap_at = { x = action.x, y = action.y }
            end
        elseif action_id == hash("scroll_up") and in_reg then
            self.list_scroll = (self.list_scroll or 0) - 40; rebuild(self); return true
        elseif action_id == hash("scroll_down") and in_reg then
            self.list_scroll = (self.list_scroll or 0) + 40; rebuild(self); return true
        end
    end

    -- Button Interactions
    --
    -- Two ways in. Everything outside the scrolling list still acts on press,
    -- which is what makes the nav bar and the dialogs feel immediate. A row
    -- INSIDE the list arrives here only once its touch has been released
    -- without turning into a scroll, carrying the point it was released at.
    local tap_x, tap_y
    if action_id == hash("touch") then
        if self._tap_at then
            tap_x, tap_y, self._tap_at = self._tap_at.x, self._tap_at.y, nil
        elseif action.pressed then
            tap_x, tap_y = action.x, action.y
        end
    end
    if tap_x then
        for i = #self.buttons, 1, -1 do
            local b = self.buttons[i]
            if gui.pick_node(b.node, tap_x, tap_y) then
                local id = b.id
                if id == "tab_quick" then self.tab, self.list_scroll = TAB_QUICK, 0; rebuild(self)
                elseif id == "tab_battles" then self.tab, self.list_scroll = TAB_BATTLES, 0; rebuild(self)
                elseif type(id) == "string" and id:sub(1,6) == "stake_" then
                    local candidate = config.STAKE_LEVELS[b.data]
                    if not can_afford(candidate) then
                        msg.post("#controller", "goto_payments")
                    else
                        self.stake_index = b.data; app_state.selected_stake = candidate; ws.update_stake(candidate); rebuild(self)
                    end
                elseif id == "challenge" then
                    local u = b.data or {}
                    -- A SEAT OUTRANKS A CHALLENGE, and the tap is refused here
                    -- rather than by the server.
                    --
                    -- The server declines a request from a player holding a
                    -- party seat — it has to, it is the only side that knows
                    -- — but a refusal that arrives as a round trip reads as a
                    -- failure. This is a rule the client already knows: we are
                    -- looking at our own table's roster while we tap.
                    if type(ws.current_party) == "table" and ws.current_party.partyId then
                        toast.info("You are at a party table")
                        return true
                    end
                    local sd, ex = nil, nil
                    if self.tab == TAB_BATTLES and type(u.myBattle) == "table" then
                        sd = type(u.myBattle.stake) == "table" and u.myBattle.stake or { amount = tonumber(u.myBattle.stakeAmount) or 0 }
                        ex = { gameType = "TOURNAMENT", tournamentId = u.myBattle._id or u.myBattle.id, rules = u.myBattle.rules }
                    else
                        sd = type(u.stake) == "table" and u.stake or { amount = tonumber((u.stake or {}).amount) or 0 }
                    end
                    if not can_afford(sd) then
                        msg.post("#controller", "goto_payments")
                    else
                        ws.send_game_request({ _id=u._id, username=u.username, isAI=u.isAI, avatar=u.avatar }, sd, ex); open_outgoing_banner(self, u, sd); ws.request_head_to_head(u._id)
                    end
                elseif id == "banner_accept" or id == "banner_decline" then
                    -- THREE KINDS OF STRIP, ONE PAIR OF BUTTONS.
                    --
                    -- What a press MEANS is a property of the strip, not of
                    -- the button, so the banner is found first and answered on
                    -- its own terms: a challenge is accepted or declined on
                    -- the socket, a table is joined or simply put away, and a
                    -- challenge we sent has only the second half.
                    local hit
                    for _, ban in ipairs(self.banners or {}) do
                        if (ban.key or ban.request_id) == b.data then hit = ban end
                    end
                    if hit then
                        if hit.party_id then
                            if id == "banner_accept" then
                                -- Straight into the same dialog the host of a
                                -- table watches it fill in. Nothing is sent
                                -- for LATER: there is no decline for a table,
                                -- and inventing one would tell the server
                                -- about a decision the player did not make.
                                right_panel.join_party_search(self, app_state, function() rebuild(self) end, {
                                    party_id  = hit.party_id,
                                    entry     = hit.entry,
                                    closes_at = hit.closes_at,
                                })
                            end
                        elseif hit.outgoing then
                            -- CANCEL. GAME_REQUEST is fire-and-forget — there
                            -- is no id to withdraw by — so this takes the
                            -- strip down and stops the player waiting on a
                            -- row. An opponent who answers a moment later
                            -- still lands on the board, exactly as they did
                            -- when this was a dialog. Nothing to send.
                        elseif hit.request_id and hit.request_id ~= "" then
                            if id == "banner_accept" then ws.accept_game_request(hit.request_id)
                            else ws.decline_game_request(hit.request_id) end
                        end
                    end
                    for j = #(self.banners or {}), 1, -1 do
                        if (self.banners[j].key or self.banners[j].request_id) == b.data then table.remove(self.banners, j) end
                    end
                    if self.banners and #self.banners == 0 then self.banners = nil end
                    self.list_scroll = 0; rebuild(self)
                elseif id == "nav_lobby" then msg.post("#controller", "goto_lobby")
                elseif id == "nav_payments" then msg.post("#controller", "goto_payments")
                elseif id == "nav_themes" then msg.post("#controller", "goto_themes")
                elseif id == "nav_tournaments" then msg.post("#controller", "goto_tournaments")
                elseif id == "nav_support" then msg.post("#controller", "goto_support")
                elseif id == "nav_account" then msg.post("#controller", "goto_profile")
                elseif id == "savings_info" then
                    -- Cleared so the copy types itself out again on a
                    -- deliberate re-open, not just the first automatic one.
                    self._savings_type_t0, self._savings_type_done = nil, nil
                    self.savings_info_open = true; rebuild(self)
                elseif id == "savings_info_close" or id == "savings_info_block" then
                    mark_savings_promo_seen()
                    self.savings_info_open = false; rebuild(self)
                elseif id == "savings_try_it" then
                    -- Continue the same story into the "how" instead of just
                    -- closing the explainer — see draw_savings_plans.
                    mark_savings_promo_seen()
                    self.savings_info_open = false
                    self.savings_plans_open = true
                    rebuild(self)
                elseif id == "savings_plans_close" or id == "savings_plans_block" then
                    self.savings_plans_open = false; rebuild(self)
                elseif id == "savings_plans_start" then
                    self.savings_plans_open = false
                    -- Hand off to the real controls already built on the
                    -- payments SAVE COINS tab (screen_enter there consumes
                    -- this once) instead of duplicating them in the promo.
                    app_state.open_payments_tab = "SAVE COINS"
                    msg.post("#controller", "goto_payments")
                elseif id == "savings_add" then
                    if not self.savings_add then
                        -- Seed from the parked SAVINGS_STATUS payload so the
                        -- toggle reflects the player's actual current
                        -- preference rather than always defaulting to OFF.
                        local st = ws.current_savings_status or {}
                        local ac = type(st.autoCharge) == "table" and st.autoCharge or {}
                        self.savings_add = {
                            exchange_amount = 100,
                            autocharge_enabled = ac.enabled and true or false,
                            autocharge_amount = tonumber(ac.amount) or 5,
                        }
                    end
                    self.savings_add_open = true; rebuild(self)
                elseif id == "savings_add_close" or id == "savings_add_block" then self.savings_add_open = false; rebuild(self)
                elseif id == "savings_exchange_minus" or id == "savings_exchange_plus" then
                    local sa = self.savings_add
                    if sa and not sa.exchanging then
                        -- Backend-driven bounds/step (SAVINGS_STATUS.exchangeConfig),
                        -- with the same fallback used while drawing this dialog.
                        local cfg = (ws.current_savings_status or {}).exchangeConfig
                        local emin, emax, estep = 100, 5000, 100
                        if type(cfg) == "table" then
                            emin  = tonumber(cfg.min)  or emin
                            emax  = tonumber(cfg.max)  or emax
                            estep = tonumber(cfg.step) or estep
                        end
                        local bal = tonumber((ws.current_user_data or {}).balance) or 0
                        local lo, hi = emin, math.max(emin, math.min(emax, bal))
                        local step = (id == "savings_exchange_plus") and estep or -estep
                        sa.exchange_amount = math.max(lo, math.min(hi, (sa.exchange_amount or lo) + step))
                        rebuild(self)
                    end
                elseif id == "savings_exchange_confirm" then right_panel.savings_exchange_confirm(self, function() rebuild(self) end)
                elseif id == "savings_autocharge_off" then
                    local sa = self.savings_add
                    if sa and not sa.saving then sa.autocharge_enabled = false; rebuild(self) end
                elseif id == "savings_autocharge_on" then
                    local sa = self.savings_add
                    if sa and not sa.saving then sa.autocharge_enabled = true; rebuild(self) end
                elseif type(id) == "string" and id:match("^savings_autocharge_amt_") then
                    local sa = self.savings_add
                    if sa and not sa.saving then
                        local amt = tonumber(id:match("_(%d+)$"))
                        if amt then sa.autocharge_amount = amt; rebuild(self) end
                    end
                elseif id == "savings_autocharge_save" then right_panel.savings_autocharge_save(self, function() rebuild(self) end)
                elseif id == "nav_invite" then if right_panel.start_invite_search(self, app_state, function() rebuild(self) end, b.data) then play_snd("snd_suspense") end
                elseif id == "create_battle" then
                    local ct = (b.data or "NORMAL")
                    if tostring(ct):upper() == "ELIMINATION" then ct = "KNOCKOUT" end
                    self.battle_modal = { editing = false, type = ct, stake_i = 1, fmt_i = 1, elim_i = 1, players = "AUTO" }
                    if tostring(ct):upper() == "KNOCKOUT" then self.battle_modal.estake_i = 1; self.battle_modal.cap_i = right_panel.KNOCKOUT_DEFAULT_CAP_I end
                    rebuild(self)
                elseif id == "update_battle" then
                    local T  = b.data or "NORMAL"
                    local mb = right_panel.battle_of_type(ws.current_user_data or {}, T) or {}
                    local btype = (tostring(mb.matchType or T or "NORMAL"):upper())
                    if btype == "ELIMINATION" then btype = "KNOCKOUT" end
                    local amt = tonumber(mb.stakeAmount) or tonumber((mb.stake or {}).amount) or 0
                    local fmtv = tonumber(mb.matchFormat) or 3
                    local s_i, f_i, elim_i, estake_i, cap_i = 1, 1, 1, 1, right_panel.KNOCKOUT_DEFAULT_CAP_I
                    -- HOW THE PARTY IS WON, read back off the stored battle.
                    --
                    -- These two were simply not seeded, so reopening the form
                    -- always showed NORMAL however the party had been saved —
                    -- and submitting then quietly wrote NORMAL back over the
                    -- host's real choice. (The server was dropping the field
                    -- too; see be_matatu's partyRules.ts. Both halves had to
                    -- be fixed for either to be visible.)
                    local pmode, pcap_i = nil, right_panel.PARTY_DEFAULT_CAP_I
                    if btype == "NORMAL" then
                        for j, t in ipairs(right_panel.BATTLE_TIERS) do if t.amount == amt then s_i = j; break end end
                        for j, fdef in ipairs(right_panel.BATTLE_TIERS[s_i].formats) do if fdef.games == fmtv then f_i = j; break end end
                    elseif btype == "KNOCKOUT" then
                        -- STAKED chamber: map stake amount -> estake_i, scoreCap -> cap_i.
                        for j, a in ipairs(right_panel.KNOCKOUT_STAKES) do if a == amt then estake_i = j; break end end
                        local capv = tonumber(mb.scoreCap) or 200
                        for j, a in ipairs(right_panel.KNOCKOUT_CAPS) do if a == capv then cap_i = j; break end end
                    else
                        -- PARTY's selector is the entry fee.
                        for j, a in ipairs(right_panel.PARTY_TIERS) do if a == amt then elim_i = j; break end end
                        -- `partyMode` is what the server stores and sends;
                        -- `mode` is the name the client submits under. Read
                        -- both, so this works against a server of either age.
                        pmode = right_panel.party_mode_of({ pmode = mb.partyMode or mb.mode })
                        local pcapv = tonumber(mb.scoreCap) or right_panel.PARTY_CAPS[right_panel.PARTY_DEFAULT_CAP_I]
                        for j, a in ipairs(right_panel.PARTY_CAPS) do if a == pcapv then pcap_i = j; break end end
                    end
                    local players = mb.players
                    if type(players) == "table" then players = #players end
                    self.battle_modal = { editing = true, id = tostring(mb._id or mb.id or ""), type = btype,
                        stake_i = s_i, fmt_i = f_i, elim_i = elim_i, estake_i = estake_i, cap_i = cap_i,
                        pmode = pmode, pcap_i = pcap_i, players = players or "AUTO" }; rebuild(self)
                elseif id == "bm_type_normal" or id == "bm_type_knock" or id == "bm_type_party" then
                    local bm = self.battle_modal
                    if bm and not bm.submitting then
                        bm.type = (id == "bm_type_party") and "PARTY" or (id == "bm_type_knock") and "KNOCKOUT" or "NORMAL"
                        bm.stake_i = bm.stake_i or 1; bm.fmt_i = bm.fmt_i or 1; bm.elim_i = bm.elim_i or 1; bm.players = bm.players or "AUTO"
                        bm.estake_i = bm.estake_i or 1; bm.cap_i = bm.cap_i or right_panel.KNOCKOUT_DEFAULT_CAP_I
                        bm.pcap_i = bm.pcap_i or right_panel.PARTY_DEFAULT_CAP_I
                        rebuild(self)
                    end
                elseif id == "bm_close" then self.battle_modal, self.list_scroll = nil, 0; rebuild(self)
                elseif id == "bm_fee_minus" or id == "bm_fee_plus" then
                    local bm = self.battle_modal
                    if bm and not bm.submitting then
                        local step = (id == "bm_fee_plus") and 1 or -1
                        local bt = tostring(bm.type or "NORMAL"):upper()
                        if bt == "ELIMINATION" then bt = "KNOCKOUT" end
                        if bt == "KNOCKOUT" then
                            bm.estake_i = math.max(1, math.min(#right_panel.KNOCKOUT_STAKES, (bm.estake_i or 1) + step))
                        elseif bt == "PARTY" then
                            bm.elim_i = math.max(1, math.min(#right_panel.PARTY_TIERS, (bm.elim_i or 1) + step))
                        else
                            bm.stake_i = math.max(1, math.min(#right_panel.BATTLE_TIERS, (bm.stake_i or 1) + step))
                            bm.fmt_i = math.min(bm.fmt_i or 1, #right_panel.BATTLE_TIERS[bm.stake_i].formats)
                        end
                        rebuild(self)
                    end
                elseif id == "bm_cap_minus" or id == "bm_cap_plus" then
                    local bm = self.battle_modal
                    local bm_t = bm and tostring(bm.type or "NORMAL"):upper() or ""
                    if bm_t == "ELIMINATION" then bm_t = "KNOCKOUT" end
                    if bm and not bm.submitting and bm_t == "KNOCKOUT" then
                        local step = (id == "bm_cap_plus") and 1 or -1
                        bm.cap_i = math.max(1, math.min(#right_panel.KNOCKOUT_CAPS, (bm.cap_i or right_panel.KNOCKOUT_DEFAULT_CAP_I) + step))
                        rebuild(self)
                    end
                elseif id == "bm_fmt_minus" or id == "bm_fmt_plus" then
                    local bm = self.battle_modal
                    if bm and not bm.submitting then bm.fmt_i = math.max(1, math.min(#right_panel.BATTLE_TIERS[bm.stake_i or 1].formats, (bm.fmt_i or 1) + (id == "bm_fmt_plus" and 1 or -1))); rebuild(self) end
                -- The AUTO/2/3/4 player-count stepper is gone. A party table
                -- fills for twenty seconds and plays with whoever is seated, so
                -- a number to choose only implied the host could hold the table
                -- open for a fourth who might never come — the exact wait the
                -- fixed window exists to remove. bm_submit still sends "AUTO".
                elseif id == "bm_pmode_normal" or id == "bm_pmode_cap" then
                    local bm = self.battle_modal
                    if bm and not bm.submitting then
                        bm.pmode = (id == "bm_pmode_cap") and "SCORECAP" or "NORMAL"
                        rebuild(self)
                    end
                elseif id == "bm_pcap_minus" or id == "bm_pcap_plus" then
                    local bm = self.battle_modal
                    if bm and not bm.submitting then
                        local step = (id == "bm_pcap_plus") and 1 or -1
                        bm.pcap_i = math.max(1, math.min(#right_panel.PARTY_CAPS,
                            (bm.pcap_i or right_panel.PARTY_DEFAULT_CAP_I) + step))
                        rebuild(self)
                    end
                elseif id == "bm_submit" then right_panel.bm_submit(self, function() rebuild(self) end)

                elseif id == "nav_team_bracket" then right_panel.open_team_bracket(self, function() rebuild(self) end)
                elseif id == "tbr_close" then self.team_bracket_modal = nil; rebuild(self)
                elseif id == "tbr_advance" then right_panel.tbr_advance(self, b.data, function() rebuild(self) end)
                elseif id == "tbr_drop" then right_panel.tbr_drop(self, b.data, function() rebuild(self) end)
                end
                return true
            end
        end
    end
    return false
end