----------------------------------------------------------------------
-- game.script
-- Thin lifecycle shell. Owns the engine callbacks (init/update/on_input/
-- on_message), input hit-testing, the stale-lock watchdogs, and the
-- self.* dispatch table that wires the pure-Lua modules together.
----------------------------------------------------------------------
local sound = require "modules.sound"
local ws    = require "modules.websocket_manager"
local app   = require "modules.app_state"

local util  = require "modules.game_util"
local BL    = require "modules.board_layout"
local CV    = require "modules.card_view"
local RE    = require "modules.rules_eval"
local GS    = require "modules.game_state"
local GF    = require "modules.game_flow"
local DC    = require "modules.disconnect_events"

local OnlineHandler = require "modules.online_handler"
local OfflineHandler = require "modules.offline_handler"
local Tut   = require "modules.tutorial"
local TL    = require "modules.turn_locks"

-- Tutorial hooks are always pcall-guarded so a walkthrough bug can never break play.
local function tut(name, ...)
    local f = Tut[name]
    if f then pcall(f, ...) end
end

local notify_gui = util.notify_gui
local log        = util.log

-- FORWARD DECLARATIONS. Both are defined much further down, but update() and
-- on_message() are compiled ABOVE those definitions and call them.
--
-- This is not tidiness — without the declarations those calls compile to
-- GLOBAL lookups (Lua resolves names lexically at compile time, and a `local
-- function` declared on a later line is simply not in scope on an earlier
-- one), and the globals do not exist. Every one of them was `attempt to call a
-- nil value`.
--
-- What that broke, specifically: update()'s two next-round watchdogs. They are
-- the ONLY things that release a parked next round when the normal route (the
-- round banner reporting itself finished) doesn't run — and they errored out
-- instead of releasing. Worse, the error aborts the REST of update() for that
-- frame, and the online game-over watchdog runs later in the same function, so
-- once a watchdog started firing every frame the game-over sequence stopped
-- being processed at all: the board sat there with the result already known.
local start_new_online_game
local release_round_hold

----------------------------------------------------------------------
-- Script Properties
----------------------------------------------------------------------
go.property("gui_hud", msg.url("#game"))
go.property("gui_suit", msg.url("#suit_select"))
go.property("gui_over", msg.url("#gameover"))

----------------------------------------------------------------------
-- Sound definitions
----------------------------------------------------------------------
local SND = {
    SoundShuffle    = "snd_shuffle",
    SoundDraw       = "snd_draw",
    MoveDeck        = "snd_move_deck",
    SoundPlay       = "snd_play",
    SoundPlayCut    = "snd_play_cut",
    SoundPlay20     = "snd_play20",
    SoundPlay30     = "snd_play30",
    SoundPlayJoker  = "snd_play50",
    SoundWinAlt     = "snd_win",
    SoundLose       = "snd_lose",
    SoundCondense   = "snd_condense",
    SoundRequestSuit= "snd_pick",
    SoundAlertTimer = "snd_alert",
    SoundInvalid    = "snd_invalid",
}

local function play_sound(_, name)
    if not name then return end
    if sound and sound.enabled == false then return end
    local comp = SND[name] or name
    pcall(msg.post, "#" .. comp, "play_sound")
end

----------------------------------------------------------------------
-- Input lock reconciliation
----------------------------------------------------------------------
local function reconcile_input_locks(self)
    if not self.online_mode then return end
    if not self.is_player_turn() then return end

    local server_busy = self.is_processing_move
        or (#self.move_queue > 0)
        or self.is_waiting_for_server_response
        or self.is_animating
        or ((self._gs_anim_locks or 0) > 0)
        or (self.current_turn_actions and #self.current_turn_actions > 0)

    if server_busy then return end

    if self.waiting then
        self.waiting = false
        RE.pre_validate_hand(self)
    end
    if self.is_local_action_locked then
        self.is_local_action_locked = false
    end
end

----------------------------------------------------------------------
-- Initialization & self.* API wiring
----------------------------------------------------------------------
function init(self)
    msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })
    math.randomseed(os.time())
    msg.post(".", "acquire_input_focus")

    self.gui_hud  = msg.url("#game")
    self.gui_suit = msg.url("#suit_select")
    self.gui_over = msg.url("#gameover")

    self.Z_HAND = BL.Z_HAND
    self.Z_PILE = BL.Z_PILE
    self.Z_FLY  = BL.Z_FLY
    self.Z_CUT  = BL.Z_CUT
    self.CARD_SCALE_F = BL.CARD_SCALE_F
    
    self.emoji_popover_open = false -- Tracks popover state to block deck hits

    self.pending_game_over_data = nil
    self._game_over_settle_time = 0
    self._game_over_absolute_timeout = 0
    self._gs_anim_locks = 0
    self._is_processing_game_over = false -- Safely lock game over to prevent duplicate triggers
    -- Set the instant the server says the game ended (ws_game_over), well
    -- before self.game_over itself flips true — that only happens once the
    -- watchdog settles and process_game_over_queue's own 1.2s delay elapses.
    -- Without this, board/hand cards stayed tappable for that whole window
    -- (most noticeable when the OPPONENT won, since the board sits idle).
    self.input_locked_for_game_over = false
    -- Held from the instant GAME_OVER lands until the flip, the count and the
    -- round banner have all finished. start_new_online_game parks an incoming
    -- next round behind it; without that the server's immediate next-round push
    -- rebuilds the board out from under the reveal.
    self.round_transition_busy = false
    self._pending_next_deadline = nil
    app.unlock_board()

    -- ---- self.* dispatch table -------------------------------------------
    self.play_sound       = function(name) play_sound(self, name) end
    self.set_face         = CV.set_face
    self.set_back         = CV.set_back
    self.spawn_card       = CV.spawn_card
    self.calc_spacing     = function(n, scale_f) return BL.calc_spacing(self, n, scale_f) end
    self.top_played       = function() return RE.top_played(self) end
    self.is_cutting_match = function(rec) return RE.is_cutting_match(self, rec) end
    self.hand_score       = function(hand) return RE.hand_score(hand) end

    self.position_hands   = function(animate) BL.position_hands(self, animate) end
    
    self.animate_to_pile = function(rec, is_player, on_done)
        self._gs_anim_locks = self._gs_anim_locks + 1
        CV.animate_to_pile(self, rec, is_player, function(...)
            self._gs_anim_locks = math.max(0, self._gs_anim_locks - 1)
            if on_done then on_done(...) end
        end)
    end

    self.draw_to_hand = function(hand, is_player, count, done, opts)
        self._gs_anim_locks = self._gs_anim_locks + 1
        GF.draw_to_hand(self, hand, is_player, count, function(...)
            self._gs_anim_locks = math.max(0, self._gs_anim_locks - 1)
            if done then done(...) end
        end, opts)
    end

    self.reshuffle_deck = function(done)
        self._gs_anim_locks = self._gs_anim_locks + 1
        GF.reshuffle_deck(self, function(...)
            self._gs_anim_locks = math.max(0, self._gs_anim_locks - 1)
            if done then done(...) end
        end)
    end

    self.animate_shuffle = function(cards, done)
        self._gs_anim_locks = self._gs_anim_locks + 1
        CV.animate_shuffle(self, cards, function(...)
            self._gs_anim_locks = math.max(0, self._gs_anim_locks - 1)
            if done then done(...) end
        end)
    end

    self.trigger_play_effects = function(rec, is_last) RE.trigger_play_effects(self, rec, is_last) end
    self.evaluate_play    = function(rec, hand) return RE.evaluate_play(self, rec, hand) end
    self.play_card        = function(rec, is_player, result) GF.play_card(self, rec, is_player, result) end
    self.has_playable     = function(hand) return RE.has_playable(self, hand) end

    self.next_turn        = function() GF.next_turn(self) end
    self.check_post_draw  = function(frozen_penalty) GF.check_post_draw(self, frozen_penalty) end
    self.end_game         = function(player_won, is_cut, backend_results) GF.end_game(self, player_won, is_cut, backend_results) end
    self.pre_validate_hand = function() RE.pre_validate_hand(self) end

    self.activate_turn = function()
        log("Activating turn for player")
        if not self.online_mode then
            self.current_turn = "player"
        end
        self.waiting = false
        self.current_turn_actions = {}
        self.player_has_drawn = false
        self.is_local_action_locked = false
        notify_gui(self.gui_hud, "skip", { show = false })
        RE.pre_validate_hand(self)
    end

    self.deactivate_turn = function()
        log("Deactivating turn for player")
        if not self.online_mode then
            self.current_turn = "ai"
        end
        self.waiting = true
        self.player_has_drawn = false
        notify_gui(self.gui_hud, "skip", { show = false })
        RE.pre_validate_hand(self)
    end

    -- CALLED SIX TO EIGHT TIMES A FRAME, so it must not allocate.
    --
    -- It used to run tostring() on both ids on every call. Those are string
    -- allocations, and at 60fps that is several hundred a second thrown away
    -- for a comparison whose inputs almost never change — GC pressure produced
    -- by the watchdogs that only exist to notice when nothing is happening.
    --
    -- The conversions are memoised on the raw values instead, so a string is
    -- built only when an id actually changes. The identity fast path above it
    -- covers the common case (both already strings and equal) without touching
    -- the memo at all.
    local ct_raw, ct_str, me_raw, me_str
    self.is_player_turn = function()
        if not self.online_mode then
            return self.current_turn == "player"
        end
        local gs = self.game_state
        local ct = gs and gs.currentTurn
        if ct == nil then return false end
        local me = self.my_player_id
        if ct == me then return true end
        if ct ~= ct_raw then ct_raw, ct_str = ct, tostring(ct) end
        if me ~= me_raw then me_raw, me_str = me, tostring(me) end
        return ct_str == me_str
    end
    -- ----------------------------------------------------------------------

    -- Update layout first to calculate positions
    BL.update_layout(self)
    
    -- CRITICAL FIX: Initialize background with multiple retry attempts
    BL.init_background(self)

    GS.fresh_state(self)
    self.active = false
end

----------------------------------------------------------------------
-- Deferred Game Over dispatcher (Sequenced Step-by-Step)
----------------------------------------------------------------------
local function process_game_over_queue(self, results)
    print("[DEBUG] process_game_over_queue executing. self.game_over=" .. tostring(self.game_over))
    if not self.online_mode or self.game_over or self._is_processing_game_over then 
        print("[DEBUG] Ignoring game over processing because already game_over, offline, or processing.")
        return 
    end

    -- Lock to ensure we perform this sequence exactly once
    self._is_processing_game_over = true

    -- Step 1: Update UI Standings & Scoreboard (Triggers Flip/Dots animations)
    if type(results.rank) == "table" and #results.rank > 0 then
        notify_gui(self.gui_hud, "update_standings", { ranks = OnlineHandler.slim_ranks(results.rank) })
    end

    OnlineHandler.process_scoreboard(self, {
        gameType = results.gameType,
        tournamentId = (type(results.tournamentData) == "table" and results.tournamentData.id) or nil,
        gameOverState = results,
    })
    
    if results.isMatchComplete == true or results.tournamentCompleted == true then
        self._sb_series_key, self._sb_tid = nil, nil
        self._final_state_locked = false
    end
    
    -- Step 2: Brief beat for the scoreboard flip to visibly start BEFORE
    -- flipping cards / round transitions (was 1.2s — trimmed so game over
    -- reads as instant; the card-reveal flip is the only intentional wait).
    local is_cut = results.isCut or (results.reason == "CUTTING_CARD")

    timer.delay(0.5, false, function()
        -- Start Step 3: Flip cards and display round transitions cleanly
        self.end_game((results.winner == self.my_player_id), is_cut, results)
        
        -- Release lock
        self._is_processing_game_over = false
    end)
end

----------------------------------------------------------------------
-- Watchdogs (online only): release stale locks the moment it's our turn
----------------------------------------------------------------------
function update(self, dt)
    -- Tutorial: while a "play this card" step is active, follow the scripted
    -- card's live position and feed its rect to the spotlight overlay. World and
    -- GUI both use the 1280x720 logical space, so the card position maps directly.
    -- The is_active() check is OUTSIDE the pcall, and that is the whole point.
    -- `pcall(function() ... end)` allocates a fresh closure every time it is
    -- reached, so with the check inside, every frame of every game built and
    -- threw away a closure for a tutorial that is not running — 60 allocations
    -- a second of pure garbage, feeding exactly the collector pauses that show
    -- up as an intermittent hitch mid-animation.
    if Tut.is_active() then
    pcall(function()
        local hl = Tut.current()
        if not (hl and hl.screen == "game" and hl.target == "card" and hl.v) then return end
        for _, c in ipairs(self.player_hand or {}) do
            if c.id and tonumber(c.v) == tonumber(hl.v) and tostring(c.s) == tostring(hl.s) then
                local p = go.get_position(c.id)
                Tut.show_rect(p.x, p.y, BL.TARGET_W * 1.15, BL.TARGET_H * 1.15)
                return
            end
        end
    end)
    end

    -- BUG FIX: Round story watchdog shouldn't default to 0 for deadline
    if self.round_story_active then
        if not self.round_story_deadline then
            self.round_story_deadline = socket.gettime() + 8.5
        end
        
        if socket.gettime() > self.round_story_deadline then
            print("[ROUND-STORY] watchdog released the next-round hold safely")
            -- The whole hold goes, not just round_story_active:
            -- start_new_online_game parks on EITHER flag, so releasing one
            -- would have it re-park the very state this just unparked and
            -- stall until the 12s backstop below instead of the 8.5s this
            -- watchdog is for.
            release_round_hold(self)
        end
    else
        self.round_story_deadline = nil
    end

    -- Parked-round watchdog. Holding the next round back is only safe if
    -- something is guaranteed to let it go, and this is the last of those: for
    -- the case where no path ever reports the transition finishing (the hud gui
    -- is gone, the screen was torn down mid-reveal, a game-over that never
    -- reaches end_game). Deliberately longer than the whole sequence plus the
    -- round-story watchdog above, so it never pre-empts the normal route.
    if self._pending_next_state and self._pending_next_deadline
        and socket.gettime() > self._pending_next_deadline then
        print("[ROUND-TRANSITION] watchdog released a parked next round")
        release_round_hold(self, true)
    end

    if self.online_mode then
        -- Game Over Queue Watchdog: Wait for final moves & animations to settle
        if self.pending_game_over_data then
            self._game_over_absolute_timeout = (self._game_over_absolute_timeout or 0) + dt
            
            local has_active_anims = (self._gs_anim_locks > 0) or self.is_animating
            
            if (#self.move_queue == 0 and not self.is_processing_move and not has_active_anims) or (self._game_over_absolute_timeout > 6.0) then
                self._game_over_settle_time = (self._game_over_settle_time or 0) + dt

                -- Short grace only: the settle condition above already
                -- guarantees the move queue is drained and no animations are
                -- running, so this just absorbs one-frame flickers between
                -- chained animations. Game over should feel instant — the
                -- only intentional wait before the modal is the opponent
                -- card-reveal flip itself (see end_game / flip_ai_hand).
                if self._game_over_settle_time >= 0.25 or self._game_over_absolute_timeout > 6.0 then
                    print("[DEBUG] Game Over Watchdog firing! Triggering process_game_over_queue.")
                    local results = self.pending_game_over_data
                    self.pending_game_over_data = nil
                    self._game_over_settle_time = 0
                    self._game_over_absolute_timeout = 0
                    self._gs_anim_locks = 0
                    process_game_over_queue(self, results)
                end
            else
                self._game_over_settle_time = 0
            end
        end

        if #self.move_queue == 0 then
            if self.is_processing_move then
                self.stuck_count = (self.stuck_count or 0) + dt
                if self.stuck_count > 3.5 then
                    print("[DEBUG] Watchdog resetting is_processing_move lock!")
                    self.is_processing_move = false
                    self.stuck_count = 0
                end
            else
                self.stuck_count = 0
            end
        end

        if self.is_player_turn() and not self.is_processing_move and #self.move_queue == 0 and not self.is_waiting_for_server_response then
            if self.waiting then
                print("[DEBUG] Watchdog releasing self.waiting lock! (Turn activated by state)")
                self.waiting = false
                RE.pre_validate_hand(self)
            end

            -- THE ONE PER-TURN LOCK THAT HAD NO WATCHDOG AT ALL.
            --
            -- player_has_drawn means "this player has already drawn during
            -- THIS turn". Every other lock here (waiting above, is_animating
            -- and is_local_action_locked below) gets a frame-independent
            -- watchdog; this one's only reset was the false->true edge of
            -- now_my_turn further down update(). An edge is sampled once a
            -- frame, and two state updates — the opponent's play (which can
            -- itself trigger a reshuffle: game_flow.lua's reshuffle_deck runs
            -- ~1.3s of settling once the deck empties) and the turn coming
            -- back to us — can land in the SAME frame when that settle
            -- resolves synchronously. When that happens the intermediate "not
            -- my turn" is never observed, the edge never fires, and the flag
            -- survives from the previous turn.
            --
            -- Ordinarily that costs nothing: the player can still play a
            -- card. With a PENALTY pending — exactly what a reshuffle-forcing
            -- draw leaves behind — drawing is the only legal move there is,
            -- so a stale flag refuses every tap and the whole hand reads as
            -- "disabled", right after the reshuffle that triggered it.
            --
            -- Safe to clear here precisely because of what this block already
            -- guarantees: it is our turn, nothing is processing, the queue is
            -- empty and nothing is awaited from the server. A draw actually in
            -- flight (is_animating or is_local_action_locked) fails every one
            -- of those, so a flag still set in this state can only describe a
            -- draw that already finished — i.e. a previous turn's.
            if self.player_has_drawn and not self.is_animating and not self.is_local_action_locked then
                print("[DEBUG] Watchdog clearing stale player_has_drawn (previous turn's draw)")
                self.player_has_drawn = false
                RE.pre_validate_hand(self)
            end
        end

        if self.is_player_turn() and not self.is_processing_move and #self.move_queue == 0 and self.is_animating then
            self.anim_stuck = (self.anim_stuck or 0) + dt
            if self.anim_stuck > 3.5 then
                print("[DEBUG] Watchdog clearing stuck is_animating lock!")
                self.is_animating = false
                self.anim_stuck = 0
                RE.pre_validate_hand(self)
            end
        else
            self.anim_stuck = 0
        end

        if self.is_player_turn() and not self.is_processing_move and #self.move_queue == 0
           and not self.is_animating and not self.waiting and not self.is_suit_selection_active
           and self.is_local_action_locked and not self.is_waiting_for_server_response then
            self.lock_stuck = (self.lock_stuck or 0) + dt
            if self.lock_stuck > 3.5 then
                print("[DEBUG] Watchdog clearing stuck is_local_action_locked!")
                self.is_local_action_locked = false
                self.lock_stuck = 0
                RE.pre_validate_hand(self)
            end
        else
            self.lock_stuck = 0
        end

        self._diag_t = (self._diag_t or 0) + dt
        if self._diag_t >= 1.0 then
            self._diag_t = 0
            if not self.game_over and self.is_player_turn()
               and (self.waiting or self.is_animating or self.is_suit_selection_active or self.is_processing_move or self.is_local_action_locked) then
                print(string.format(
                    "[STUCK?] is_my_turn=true but blocked -> waiting=%s animating=%s suit_sel=%s proc=%s locked=%s drew=%s pending_srv=%s queue=%d currentTurn=%s my_id=%s",
                    tostring(self.waiting), tostring(self.is_animating),
                    tostring(self.is_suit_selection_active), tostring(self.is_processing_move),
                    tostring(self.is_local_action_locked), tostring(self.player_has_drawn),
                    tostring(self.is_waiting_for_server_response), #self.move_queue,
                    tostring(self.game_state and self.game_state.currentTurn), tostring(self.my_player_id)))
            end
        end
    end

    -- Became my turn (online OR offline): release the per-turn locks the instant
    -- the turn flips to the player. This MUST run in both modes — while it lived
    -- inside the online-only block above, an offline hand stayed locked after the
    -- AI moved (is_local_action_locked was never cleared) and the player froze.
    if not self.game_over then
        local now_my_turn = self.is_player_turn()
        if now_my_turn and not self._was_my_turn then
            msg.post(".", "acquire_input_focus")
            self.player_has_drawn = false
            self.is_local_action_locked = false
            self.is_waiting_for_server_response = false
            self.waiting = false
            self.current_turn_actions = {}
            RE.pre_validate_hand(self)

            -- No special-card toasts here. A General Market or a pending
            -- Pick Two/Three used to raise a bottom-left toast at turn start
            -- explaining what to do; they are gone by request. The board
            -- itself still carries the state — the deck is the only legal
            -- target and the penalty count is on the HUD — so this only
            -- removes the prose, not the information.
        end
        self._was_my_turn = now_my_turn
    end

    if self.t4 and not self.online_mode and not self.game_over then
        if self.current_turn == "player" and not self.is_animating
           and not self.is_suit_selection_active and self.is_local_action_locked
           and (self._gs_anim_locks or 0) == 0 then
            self.t4_lock_stuck = (self.t4_lock_stuck or 0) + dt
            if self.t4_lock_stuck > 1.2 then
                self.is_local_action_locked = false
                self.t4_lock_stuck = 0
                RE.pre_validate_hand(self)
            end
        else
            self.t4_lock_stuck = 0
        end
    end
end

----------------------------------------------------------------------
-- Input hit-testing
----------------------------------------------------------------------
local HALF_W = BL.TARGET_W / 2
local HALF_H = BL.TARGET_H / 2

local function hit(card, x, y)
    if not card or not card.id then return false end
    local p = go.get_position(card.id)
    return math.abs(x - p.x) <= (HALF_W * 1.5) and math.abs(y - p.y) <= (HALF_H * 1.5)
end

local function get_logical_touch(action)
    local ok, ww, wh = pcall(window.get_size)
    if not ok or ww == 0 or wh == 0 then return action.x, action.y end

    local sx, sy = action.screen_x, action.screen_y
    if not sx or not sy then return action.x, action.y end

    local logical_aspect = BL.LOGICAL_W / BL.LOGICAL_H
    local screen_aspect = ww / wh

    if screen_aspect > logical_aspect then
        local view_w = wh * logical_aspect
        local offset_x = (ww - view_w) / 2
        local nx = (sx - offset_x) / view_w * BL.LOGICAL_W
        local ny = (sy / wh) * BL.LOGICAL_H
        return nx, ny
    else
        local view_h = ww / logical_aspect
        local offset_y = (wh - view_h) / 2
        local nx = (sx / ww) * BL.LOGICAL_W
        local ny = (sy - offset_y) / view_h * BL.LOGICAL_H
        return nx, ny
    end
end

----------------------------------------------------------------------
-- Safe Shake Animation
----------------------------------------------------------------------
-- Offline elimination-chamber/quick-bracket (tournament4.lua) starts a 30s
-- AFK timer the instant the human's turn begins and force-eliminates them —
-- completely independent of score/cap — if `turn_timer_seq` still matches
-- when it fires. That bump previously only happened once the play's full
-- flight/resolution reached game_flow.lua's after_play_settled / tournament4
-- advance() (~0.42s+ after the tap), so a legal tap landing right at the
-- 29.6-30.0s mark could still get force-eliminated even though the player
-- had already acted in time. Cancel the pending timer the instant the tap
-- is ACCEPTED instead of waiting for it to fully resolve.
local function t4_cancel_afk_timer(self)
    if self.t4 then
        self.t4.turn_timer_seq = (self.t4.turn_timer_seq or 0) + 1
    end
end

local function safe_shake_card(self, card)
    if not card or not card.id then return end
    
    go.cancel_animations(card.id, "position.x")
    
    local idx = 1
    for i, c in ipairs(self.player_hand) do
        if c.id == card.id then idx = i; break end
    end
    
    local spacing = self.calc_spacing(#self.player_hand)
    local start_x = self.CENTER.x - ((#self.player_hand - 1) * spacing) / 2.0
    local true_x = start_x + (idx - 1) * spacing
    
    local p = go.get_position(card.id)
    p.x = true_x
    go.set_position(p, card.id)
    
    go.animate(card.id, "position.x", go.PLAYBACK_ONCE_PINGPONG, true_x + 18, go.EASING_INOUTSINE, 0.08, 0, function()
        if card.id then
            local final_p = go.get_position(card.id)
            final_p.x = true_x
            go.set_position(final_p, card.id)
        end
    end)
    
    play_sound(self, "SoundInvalid")
end

----------------------------------------------------------------------
-- Two-finger spread → fan out the played-card history; release restores it.
-- Mirrors the Godot InputManager pinch gesture (spread past a threshold from
-- the initial finger gap triggers the view).
----------------------------------------------------------------------
local PINCH_SPREAD_THRESHOLD = 40   -- screen px of extra spread to trigger

local function touch_dist(a, b)
    local dx, dy = (a.x or 0) - (b.x or 0), (a.y or 0) - (b.y or 0)
    return math.sqrt(dx * dx + dy * dy)
end

local function handle_history_pinch(self, action)
    local pts = {}
    for _, t in ipairs(action.touch or {}) do
        if not t.released then pts[#pts + 1] = t end
    end

    local can_view = (#pts >= 2) and not self.game_over
        and self.played_cards and #self.played_cards > 0
        and not self.is_animating and not self.is_suit_selection_active

    if can_view then
        if self._pinch_active then
            return true
        end
        local d = touch_dist(pts[1], pts[2])
        if not self._pinch_start_dist then
            self._pinch_start_dist = d
        elseif d > self._pinch_start_dist + PINCH_SPREAD_THRESHOLD then
            self._pinch_active = true
            CV.start_history_view(self)
            tut("on_history_viewed")   -- completes the PLAY_HISTORY_PINCH step
        end
        return true   -- swallow taps while two fingers are down
    end

    -- Fewer than two fingers (or blocked): close the fan if it was open.
    self._pinch_start_dist = nil
    if self._pinch_active then
        self._pinch_active = false
        CV.end_history_view(self)
    end
    return false
end

function on_input(self, action_id, action)
    if not self.active then return end
    -- A dialog is on top (incoming game request, game over, the network
    -- overlay). game.script is listed BEFORE those in controller.go, so
    -- without this the board would act on taps meant for the dialog.
    if app.input_blocked() then return false end

    -- The pinch-to-view-history gesture needs two simultaneous touch points,
    -- which only arrive on the TOUCH_MULTI action ("multitouch") with
    -- action.touch populated. The single-finger mouse "touch" action never
    -- carries a second point, so the pinch is handled here exclusively.
    if action_id == hash("multitouch") then
        handle_history_pinch(self, action)
        return true
    end

    if action_id ~= hash("touch") then return end

    -- While the two-finger history view is open, swallow the emulated
    -- single-finger taps so a card isn't played mid-pinch.
    if self._pinch_active then return true end

    if not action.pressed then return end

    -- The game is over — in ANY mode and any game type. Nothing on the board
    -- is playable, and the tap is swallowed rather than passed down. Checked
    -- BEFORE reconcile_input_locks, which exists to hand control back to a
    -- live turn and has no business running on a finished game.
    if app.board_locked or self.game_over or self.input_locked_for_game_over then
        return true
    end

    reconcile_input_locks(self)

    if self.is_processing_move or self.emoji_popover_open then
        return true
    end

    -- Online: gameplay stays locked until the backend broadcasts START (every
    -- player ready). Swallow taps while we're holding after our deal.
    if self.online_mode and self._await_start then
        return true
    end

    local x, y = get_logical_touch(action)

    local hit_card = nil
    for i = #self.player_hand, 1, -1 do
        if hit(self.player_hand[i], x, y) then
            hit_card = self.player_hand[i]
            break
        end
    end

    if hit_card then
        if not self.is_player_turn() or self.waiting or self.is_local_action_locked or self.is_suit_selection_active then
            safe_shake_card(self, hit_card)
            return true
        end

        -- Tutorial: gate taps to the one scripted card for the current step.
        -- Scoped to online_mode — the walkthrough is always an online scripted
        -- game, so this can never lock cards in an offline / vs-AI game.
        local blocked = false
        pcall(function() blocked = self.online_mode and Tut.is_active() and not Tut.is_card_allowed(hit_card.v, hit_card.s) end)
        if blocked then
            safe_shake_card(self, hit_card)
            return true
        end

        local result = RE.evaluate_play(self, hit_card, self.player_hand)
        if result.valid then
            self.is_local_action_locked = true
            t4_cancel_afk_timer(self)
            self.play_card(hit_card, true, result)

            -- Do NOT re-open the lock here. It used to unlock optimistically
            -- ~0.1s after any 8/Jack play (a raw card-VALUE guess at "this
            -- grants another turn"), but the card's fly-to-pile animation
            -- takes ~0.42s (card_view.lua's animate_to_pile) and the actual
            -- skip/hold-on/general-market resolution — including whether
            -- this player even keeps control at all — only happens in
            -- game_flow.lua's after_play_settled, once that flight lands.
            -- Unlocking early let a fast second tap slip in while the first
            -- card was still mid-flight and turn control hadn't actually
            -- been resolved yet: in 4-player games this let the human play
            -- an extra full card as themselves before tournament4.apply_skip
            -- had even stepped the turn away, and — since a raw card VALUE
            -- was used instead of the real result type — it also mis-fired
            -- for an ordinary (non-special) "11" card in Whot, which has no
            -- skip effect at all. after_play_settled (for 2-player
            -- Hold-On/Skip/General-Market continuations) and
            -- tournament4.begin_turn (once control legitimately returns to
            -- the human seat) are the only places that re-open this lock now.
        else
            safe_shake_card(self, hit_card)
        end
        return true
    end

    if #self.deck > 0 then
        local deck_top = self.deck[#self.deck]
        -- deck_top can be a RECORD whose game object has already been
        -- deleted (a stale card that slipped into self.deck instead of
        -- being filtered out during a reshuffle merge) — go.get_position on
        -- a deleted id raises "Instance (null) not found", which hit every
        -- tap on the deck once such a card reached the top: an error
        -- spamming the log on every draw attempt until the app was
        -- restarted. Falls back to the deck's own fixed slot.
        local ok, p = pcall(go.get_position, deck_top.id)
        if not ok then p = self.DECK_POS end
        if math.abs(x - p.x) <= 120 and math.abs(y - p.y) <= 150 then
            -- The shared gate in front of everything a deck tap can mean. It
            -- now also refuses while a card is still flying INTO the hand,
            -- which is the difference between one card and two when a second
            -- tap lands during that flight — see modules/turn_locks.lua for
            -- how the other flags came to be cleared out from under it.
            if not TL.board_may_touch_deck(self) then
                return true
            end

            -- Offline General Market: the human owes the opponent's 14 a trip
            -- to the deck, and control returns to whoever played it once the
            -- card is in hand. Online, the same debt is tracked server-side
            -- (pendingMarketDraw) and settled by the ordinary draw path below,
            -- which already ends the turn and lets the server hand control back.
            local market = (not self.online_mode) and self.pending_market_draw or nil
            if market and market.who == "player" then
                self.pending_market_draw = nil
                self.is_local_action_locked = true
                t4_cancel_afk_timer(self)
                local return_to = market.return_to
                self.draw_to_hand(self.player_hand, true, market.count or 1, function()
                    self.current_turn = return_to
                    if return_to == "ai" then
                        OfflineHandler.do_ai_turn(self, true)
                    else
                        self.is_local_action_locked = false
                        RE.pre_validate_hand(self)
                    end
                end)
                return true
            end

            local penalty = RE.get_active_penalty(self)

            if penalty > 0 then
                if self.player_has_drawn then return true end
                self.player_has_drawn = true
                self.is_local_action_locked = true
                t4_cancel_afk_timer(self)
                local n = penalty

                self.active_penalty = 0
                if self.online_mode and self.game_state then
                    self.game_state.activePenaltyCount = 0
                end

                if self.online_mode then
                    self.draw_to_hand(self.player_hand, true, n, function()
                        self.deactivate_turn()
                        OnlineHandler.end_turn(self)
                    end)
                else
                    self.draw_to_hand(self.player_hand, true, n, function() self.next_turn() end)
                end
            elseif not self.player_has_drawn then
                self.player_has_drawn = true
                self.is_local_action_locked = true
                t4_cancel_afk_timer(self)

                local penalty_at_draw = RE.get_active_penalty(self)
                RE.pre_validate_hand(self)

                self.draw_to_hand(self.player_hand, true, 1, function()
                    self.check_post_draw(penalty_at_draw)
                end)
            end
            return true
        end
    end
end

----------------------------------------------------------------------
-- Replay (rematch) request lifecycle
----------------------------------------------------------------------
local REPLAY_TIMEOUT = 10.0

local function replay_failed(self, reason)
    if not self.awaiting_replay and not self._awaiting_round_continuation then return end
    self.awaiting_replay = false
    self._awaiting_round_continuation = false
    log("Replay/continuation not answered (" .. tostring(reason) .. ") — returning to lobby")
    notify_gui(self.gui_over, "reset_hud")
    msg.post("#controller", "goto_online")
end

-- Assigns the forward-declared local above (see the note at the top of the
-- file) — NOT a new local, and not a global.
function start_new_online_game(self, state, is_explicit_start_event)
    print("[DEBUG] start_new_online_game triggered! explicit_start=" .. tostring(is_explicit_start_event))
    if type(state) ~= "table" or next(state) == nil then
        print("[DEBUG] Aborting start_new_online_game: Invalid state.")
        return
    end
    -- The next round's real state actually arrived — whatever continuation
    -- accept we were waiting on clearly succeeded, so any later stray
    -- GAME_REQUEST_DECLINED can't be about this transition anymore.
    self._awaiting_round_continuation = false
    -- Park the next round until the current one has finished ENDING: the flip,
    -- the counting, and the round-complete banner.
    --
    -- round_story_active alone is not that window — it only begins AFTER the
    -- flip and the count are already done, so a state arriving during the
    -- reveal passed straight through and rebuilt the board underneath it. On
    -- the way past it also cleared pending_game_over_data, so for that round
    -- the flip and count never ran at all: the new game initializes first and
    -- the scoring animation plays over the top of it, or not at all.
    --
    -- That used to be rare enough to miss. It is now the NORMAL case: the
    -- server sets the next round up the moment the last one is decided and
    -- pushes it immediately, so it routinely arrives mid-reveal. Parking is
    -- what keeps that speed from being visible.
    --
    -- pending_game_over_data is named here as well as the two flags, and not
    -- because it adds a case they miss — ws_game_over sets it and the hold in
    -- the same breath. It is here so that the ONE thing this park exists to
    -- prevent is stated where the decision is made: a result that has been
    -- received but not yet shown must never be dropped on the floor by a new
    -- game arriving. Below, the "clearing stale pending_game_over_data" branch
    -- does exactly that, and every time it ran a player watched a game end with
    -- no reveal, no count and no dialog. Anything reaching it now is a genuine
    -- leftover, not a live result.
    if self.round_story_active or self.round_transition_busy
        or self.pending_game_over_data then
        print("[DEBUG] start_new_online_game deferred: round transition in progress")
        ws.active_game_state = state
        self._pending_next_state = state
        -- Backstop for a transition that never reports finishing (see update).
        -- Holding the next round back is only safe while something is
        -- guaranteed to let it go.
        self._pending_next_deadline = socket.gettime() + 12.0
        return
    end
    
    local new_id = tostring(state.id or state.gameId or "")

    -- A DIFFERENT GAME ID WHILE THIS ONE IS STILL BEING PLAYED MEANS THE ROUND
    -- IS OVER AND THE SERVER HAS MOVED ON — even though GAME_OVER has not
    -- reached us yet.
    --
    -- This is the ordering hole the round_transition_busy check above cannot
    -- see. endGame arranges the continuation at endGame.ts:418 and does not
    -- broadcast GAME_OVER until ~:980, several hundred lines of awaited work
    -- later — so the next round's START routinely arrives FIRST. At that moment
    -- nothing has told this client the round ended, round_transition_busy is
    -- still false, and the build ran immediately. The reveal and the count then
    -- arrived afterwards, onto a board that had already been re-dealt.
    --
    -- Worse, it reached the "clearing stale pending_game_over_data" path below,
    -- which is how a round could end with no flip and no count at all.
    --
    -- Nothing else produces this shape. The server refuses a player a second
    -- game while they are in one (isPlayerInActiveGame), so a new id arriving
    -- mid-game is a round continuation and nothing else. Treat its arrival as
    -- the start of the transition — that is exactly what it is — and hold it
    -- until the ending has played out in order: reveal, count, banner, then
    -- this.
    --
    -- Liveness is judged on the BOARD, not on online_game_id alone: that id is
    -- only ever cleared by ws_resync, so it outlives a game the player has left
    -- and would otherwise park the first round of their next one for 12s.
    -- SAME SERIES ONLY. A different game id is not enough on its own.
    --
    -- The guard is about a round CONTINUING — the next round of the series
    -- already on screen. An unrelated game that happens to arrive while a board
    -- is still up is not that, and parking one held a completely different
    -- match behind the 12s backstop with a stale board in front of it. That is
    -- the "switching from knockout to tournament takes long to initialize".
    --
    -- Asked through OnlineHandler.continues_series so this agrees with the two
    -- places that already decide the same question — game_flow's board-furniture
    -- teardown and start_game's scoreboard reset. Three different notions of
    -- "same series" is exactly how the scoreboard and the board disagree about
    -- which match they are showing.
    local has_live_board = #(self.player_hand or {}) > 0 or #(self.ai_hand or {}) > 0
    if new_id ~= "" and has_live_board and not self.game_over
        and self.online_game_id ~= "" and new_id ~= tostring(self.online_game_id)
        and OnlineHandler.continues_series(self, state) then
        print("[DEBUG] start_new_online_game deferred: next round arrived before GAME_OVER")
        ws.active_game_state = state
        self._pending_next_state = state
        self.round_transition_busy = true
        self._pending_next_deadline = socket.gettime() + 12.0
        return
    end

    if new_id ~= "" and new_id == tostring(self.online_game_id) and not self.game_over then
        print("[DEBUG] Aborting start_new_online_game: ID matching in-progress game.")
        -- If this is the START event hitting an already-dealt board, unlock it!
        if is_explicit_start_event then
            print("[DEBUG] Explicit START event unlocks the board!")
            self._await_start = false
            if self.is_player_turn() then
                self.is_local_action_locked = false
                self.waiting = false
                RE.pre_validate_hand(self)
            end
        end
        return
    end
    
    print("[DEBUG] Proceeding to GF.start_game. ID: " .. tostring(new_id))

    -- --- BUG FIX: CLEAR LEFTOVER GAME OVER STATE ---
    if self.pending_game_over_data then
        print("[DEBUG] WARNING: Clearing stale pending_game_over_data because a new game is starting!")
        self.pending_game_over_data = nil
        self._game_over_settle_time = 0
        self._game_over_absolute_timeout = 0
        self._gs_anim_locks = 0
    end
    self.input_locked_for_game_over = false
    self._is_processing_game_over = false -- Free processing lock
    -- A new game/round is starting: the board is live again.
    app.unlock_board()
    
    -- Flush move queue to prevent ghost moves carrying into the next round
    self.move_queue = self.move_queue or {}
    if #self.move_queue > 0 then
        print("[DEBUG] WARNING: Flushing " .. #self.move_queue .. " stale moves from queue on new game start!")
        self.move_queue = {}
    end
    ws.take_moves() -- flush any parked inbox moves too!
    -- ------------------------------------------------

    self.awaiting_replay = false
    ws.active_game_state = state
    GF.start_game(self)
    
    if is_explicit_start_event then
        self._await_start = false
    end
    
    if self.online_mode and ws.current_user_data then
        if ws.current_user_data.rank then
            notify_gui(self.gui_hud, "update_standings", { ranks = ws.current_user_data.rank })
        end
    end
    
    if self._ai_notice then
        notify_gui(self.gui_hud, "ai_takeover_notice", self._ai_notice)
    end
end

-- THE ROUND HAS FINISHED ENDING. Let whatever was waiting on it through.
--
-- The hold is taken the instant GAME_OVER lands (see ws_game_over) and covers
-- the whole ending — the reveal, the count, the round banner — because the
-- server now pushes the next round immediately and it routinely arrives in the
-- middle of that. Releasing it is a single act with three parts (drop the
-- flags, drop the backstop, build anything parked), and every caller that did
-- it by hand got a different subset of them right.
--
-- Returns whether a parked game was actually built, so a caller that was about
-- to ask for a game of its own can tell that one is already here.
--
-- Assigns the forward-declared local at the top of the file.
function release_round_hold(self, force_finish)
    self.round_transition_busy = false
    self.round_story_active    = false
    self.round_story_deadline  = nil
    self._pending_next_deadline = nil

    GF.finish_round_transition(self, force_finish)

    local pending = self._pending_next_state
    self._pending_next_state = nil
    if not pending then return false end

    start_new_online_game(self, pending, false)
    return true
end

----------------------------------------------------------------------
-- Message routing
----------------------------------------------------------------------
function on_message(self, message_id, message, sender)
    if message_id == hash("register_gui") then
        if message.id == "hud" then self.gui_hud = sender
        elseif message.id == "suit" then self.gui_suit = sender
        elseif message.id == "over" then self.gui_over = sender
        end

    elseif message_id == hash("screen_enter") then
        self.active = true
        app.game_active = true
        -- Screen-awake is set once, app-wide, in controller.script's init —
        -- no need to (re-)set it per screen.
        self.awaiting_replay = false
        msg.post(".", "acquire_input_focus")
        GF.start_game(self)
        
        if self.online_mode and ws.current_user_data then
            if ws.current_user_data.balance then
                notify_gui(self.gui_hud, "update_balance", { balance = ws.current_user_data.balance })
            end
            if ws.current_user_data.rank then
                notify_gui(self.gui_hud, "update_standings", { ranks = ws.current_user_data.rank })
            end
        end

        if self._ai_notice then
            notify_gui(self.gui_hud, "ai_takeover_notice", self._ai_notice)
        end

    elseif message_id == hash("ws_new_game_start") then
        print("[DEBUG] Received ws_new_game_start message.")
        start_new_online_game(self, message.state or ws.get_active_game(), true)

    elseif message_id == hash("round_story_done") then
        -- The round banner has finished. The round has finished ending: release
        -- the hold and build whatever the server pushed while it was up.
        release_round_hold(self)

    elseif message_id == hash("round_hold_release") then
        -- NOTHING IS CONTINUING — the game is over for good (game_flow's
        -- end_game, non-continuation branch).
        --
        -- ws_game_over takes the hold for EVERY online game over, because at
        -- that moment nobody knows yet whether a next round is coming. When it
        -- isn't, no round banner runs, so round_story_done — the only route
        -- that used to release it — never fires and the hold simply stayed set
        -- for as long as the player remained on the game screen.
        --
        -- Everything the player did next then landed on a client that believed
        -- a round transition was still in progress: the next game they started
        -- was parked by start_new_online_game, which meant GF.start_game never
        -- ran, which meant the game-over dialog was never told to close, the
        -- scoreboard/chamber were never rebuilt for the new mode, and the board
        -- only appeared when the 12s backstop finally fired. That is the
        -- "dialogue never closes, old table stays up, new game takes forever"
        -- report, and it is one flag.
        release_round_hold(self)

    elseif message_id == hash("ws_round_complete") then
        print("[DEBUG] Received ws_round_complete message.")
        if self.online_mode then
            start_new_online_game(self, ws.get_active_game(), false)
        end

    elseif message_id == hash("disable") then
        self.active = false
        app.game_active = false
        -- Screen-awake stays on app-wide (see controller.script init) — do
        -- not re-enable dimming just because the player left the game screen.
        self._knockout_scores = nil
        self._knockout_history = nil
        self._knockout_round = 0
        self._seq = (self._seq or 0) + 1
        self.round_story_active = false
        self.round_story_deadline = nil
        self._pending_next_state = nil
        -- Leaving the screen ends any transition in progress along with it.
        -- Left set, this would park the first round of the NEXT game the player
        -- starts, with nothing on screen to ever release it.
        self.round_transition_busy = false
        self._pending_next_deadline = nil

        self.pending_game_over_data = nil
        self._game_over_settle_time = 0
        self._game_over_absolute_timeout = 0
        self._is_processing_game_over = false
        self.input_locked_for_game_over = false
        -- Leaving the game screen: drop the lock so it cannot follow the
        -- player into the next match.
        app.unlock_board()

        notify_gui(self.gui_suit, "reset_hud")
        notify_gui(self.gui_over, "reset_hud")
        -- leaving = the screen is being torn down, not a board being rebuilt.
        -- This is the one reset that must take the avatars and turn-timer rings
        -- down with it, so they cannot strand themselves over the lobby.
        notify_gui(self.gui_hud, "reset_hud", { leaving = true })
        self.awaiting_replay = false
        self._sb_active, self._sb_format, self._sb_stage = false, nil, nil
        self._sb_p, self._sb_o = nil, nil
        self._sb_series_key, self._sb_tid = nil, nil
        self._final_state_locked = false
        self._h2h = nil
        GS.destroy_all(self)

        -- BACK TO THE PLAYER'S OWN THEME.
        --
        -- OnlineHandler.start_game overrides app_state.theme with the MATCH's
        -- theme (the higher-priced of the two players', shared so both see the
        -- same board) for as long as this screen is showing that game. Leaving
        -- it is screen-scoped: re-derive from the player's own account data the
        -- same way sign-in does, rather than trying to remember and restore
        -- whatever it was before the match started — that would drift the moment
        -- sync_theme_from_user or next_theme ran for any other reason while a
        -- game was open.
        --
        -- The pin has to be released FIRST: while it is set sync_theme_from_user
        -- deliberately stands down, which is what stops a mid-game IDENTIFY
        -- resetting the board to the viewer's own theme.
        app.clear_match_theme()
        app.sync_theme_from_user(ws.current_user_data)

    elseif message_id == hash("layout_changed") then
        BL.update_layout(self)

    elseif message_id == hash("play_sound") then
        local snd_name = message.sound or message[hash("sound")]
        if snd_name then self.play_sound(snd_name) end

    elseif message_id == hash("suit_selected") then
        self.chosen_suit = message.suit
        self.play_sound("SoundRequestSuit")
        self.is_suit_selection_active = false
        t4_cancel_afk_timer(self)
        tut("on_suit_selected")
        notify_gui(self.gui_hud, "suit_badge", { suit = message.suit })
        RE.pre_validate_hand(self)

        if self.online_mode then
            self.deactivate_turn()
            OnlineHandler.end_turn(self)
        else
            notify_gui(self.gui_suit, "suit_select", { mode = "close" })
            self.next_turn()
        end

    elseif message_id == hash("skip_pressed") then
        if self.is_player_turn() and not self.waiting and not self.is_animating then
            notify_gui(self.gui_hud, "skip", { show = false })
            self.is_local_action_locked = true
            t4_cancel_afk_timer(self)
            if self.online_mode then
                self.deactivate_turn()
                OnlineHandler.end_turn(self)
            else
                self.next_turn()
            end
        end

    elseif message_id == hash("ws_timer_update") then
        if self.online_mode then OnlineHandler.sync_timers(self, message.data) end

    elseif message_id == hash("timer_expired") then
        if self.online_mode then return end
        if self.t4 then
            if self.is_player_turn() and not self.is_animating and not self.game_over then
                notify_gui(self.gui_hud, "skip", { show = false })
                require("modules.tournament4").advance(self)
            end
            return
        end
        if self.is_player_turn() and not self.waiting and not self.is_animating and not self.game_over then
            notify_gui(self.gui_hud, "skip", { show = false })
            self.end_game(false, false)
        end

    elseif message_id == hash("replay") then
        -- PLAY AGAIN is the player saying they are finished with the result.
        -- If a game was already parked behind it — they accepted one while the
        -- last round was still counting out — this is the moment to build it,
        -- rather than making them wait out the rest of the minimum-show window
        -- for a dialog they have just dismissed.
        --
        -- And if that is what happened, we are DONE: the game they are asking
        -- for is the one that just went onto the board. Falling through would
        -- send a rematch request on top of a live game, which is a second game
        -- for a player the server already considers busy.
        if release_round_hold(self) then return end

        if self.online_mode then
            local stake = { amount = 100, charge = 10 }
            if self.game_state and self.game_state.stake then
                stake = self.game_state.stake
            end

            local opp_data = {
                _id = self.opponent_id,
                username = "Opponent",
                avatar = 1
            }
            if self.game_state and self.game_state.players and self.game_state.players[self.opponent_id] then
                local p = self.game_state.players[self.opponent_id]
                opp_data.username = p.username or "Opponent"
                opp_data.avatar = p.avatar or 1
                opp_data.isAI = p.isAI or false
            end

            local extra_data = nil
            if self.game_state then
                local is_tourney = false
                local t_id = self.game_state.tournamentId or self._sb_tid
                
                if self.game_state.gameType == "TOURNAMENT" or self.game_state.gameType == "BATTLE" or t_id or self.game_state.tournament then
                    is_tourney = true
                end
                
                if is_tourney then
                    if not t_id and type(self.game_state.tournament) == "table" then
                        t_id = self.game_state.tournament.id or self.game_state.tournament._id
                    end
                    
                    extra_data = {
                        gameType = "TOURNAMENT",
                        tournamentId = t_id
                    }
                end

                if self.game_state.rules then
                    extra_data = extra_data or {}
                    extra_data.rules = self.game_state.rules
                end
            end

            ws.send_game_request(opp_data, stake, extra_data)

            self.awaiting_replay = true
            local seq = self._seq
            timer.delay(REPLAY_TIMEOUT, false, function()
                if seq == self._seq then replay_failed(self, "timeout") end
            end)
        else
            local series = 1
            if app.offline_game then
                series = app.offline_game.series or (app.offline_game.config and app.offline_game.config.series) or app.ai_series or 1
            end

            local target = math.floor(series / 2) + 1
            local p_wins = app.series_p_wins or 0
            local ai_wins = app.series_ai_wins or 0

            if p_wins >= target or ai_wins >= target then
                app.series_p_wins = 0
                app.series_ai_wins = 0
            end
            GF.start_game(self)
        end

    elseif message_id == hash("exit_to_lobby") then
        if self.online_mode then
            msg.post("#controller", "goto_online")
        else
            msg.post("#controller", "goto_lobby")
        end

    elseif message_id == hash("ws_resync") then
        if self.online_mode then
            log("RESYNC requested: " .. tostring(message and message.reason))
            self._dc_waiting_for = nil
            self.online_game_id = ""
            GF.start_game(self)
            notify_gui(self.gui_hud, "conn_overlay", {
                show = true,
                title = "SYNCING BOARD",
                subtitle = "Restoring your game from the server…",
            })
            local seq = self._seq
            timer.delay(1.4, false, function()
                if seq == self._seq then
                    notify_gui(self.gui_hud, "conn_overlay", { show = false })
                end
            end)
        end

    elseif message_id == hash("ws_game_move") then
        if self.online_mode then
            local moves = ws.take_moves()
            for _, it in ipairs(moves) do
                table.insert(self.move_queue, { type = "MOVE", move = it.move, state = it.state })
            end
            OnlineHandler.pump_move_queue(self)
        end

    elseif message_id == hash("ws_network_quality") then
        notify_gui(self.gui_hud, "network_quality", message)

    elseif message_id == hash("ws_rank_updated") then
        notify_gui(self.gui_hud, "update_standings", { ranks = message.ranks })

    elseif message_id == hash("ws_user_data_updated") then
        local data = message.data or message
        if data.balance then
            notify_gui(self.gui_hud, "update_balance", { balance = tonumber(data.balance) or 0 })
        end
        if data.rank then
            notify_gui(self.gui_hud, "update_standings", { ranks = data.rank })
        end

    elseif message_id == hash("ws_game_over") then
        self._dc_waiting_for = nil
        notify_gui(self.gui_hud, "conn_overlay", { show = false })
        
        print("[DEBUG] Received ws_game_over message! Deferring execution via watchdog...")
        if self.online_mode and not self.game_over then
            self.pending_game_over_data = ws.last_game_over or {}
            self._game_over_absolute_timeout = 0
            self._game_over_settle_time = 0
            -- Lock input NOW, not several seconds from now when self.game_over
            -- finally flips true — the watchdog above waits for the move
            -- queue/animations to settle before even starting the reveal
            -- sequence, and that sequence has its own delays on top. Without
            -- this, board/hand cards stayed tappable the whole time the
            -- "opponent won" result was already known but not yet shown.
            self.input_locked_for_game_over = true
            -- The transition starts HERE, not when end_game eventually runs.
            -- Everything between this point and the banner finishing is the
            -- round ending, and the next round must not be built during it —
            -- which, now that the server pushes it immediately, is exactly when
            -- it tends to arrive.
            self.round_transition_busy = true
            app.lock_board()
        end

    elseif message_id == hash("ws_replay_declined") then
        if self.online_mode and (self.awaiting_replay or self._awaiting_round_continuation) then
            replay_failed(self, (message and message.reason) or "declined")
        end

    elseif message_id == hash("ws_player_dc") then
        -- Surface the disconnect to the player with the grace countdown instead
        -- of silently letting their turn time out while nothing visibly happens.
        if self.online_mode and not self.game_over then
            local who = tostring((message and message.player_id) or "")

            -- Never raise the "waiting for THEM" dialog over our OWN drop; our
            -- own connection loss is handled by ws_net_down. See
            -- modules/disconnect_events.lua for why this is checked rather
            -- than assumed from the server's send ordering.
            if DC.is_self(who, self.my_player_id) then return end

            -- Remember WHO we are waiting on, so a reconnect belonging to
            -- somebody else cannot dismiss this dialog early.
            self._dc_waiting_for = (who ~= "" and who) or tostring(self.opponent_id or "")

            local name = "Your opponent"
            if self.game_state and self.game_state.players then
                local p = self.game_state.players[self._dc_waiting_for]
                if p and p.username and p.username ~= "" then name = p.username end
            end

            local grace = tonumber((message and message.grace)) or 30
            notify_gui(self.gui_hud, "conn_overlay", {
                show = true,
                title = "OPPONENT DISCONNECTED",
                subtitle = name .. " lost connection — waiting for them to return…",
                grace = grace,
            })

            -- NEVER LET THIS DIALOG OUTLIVE THE GRACE IT IS COUNTING DOWN.
            --
            -- Dismissal otherwise depends entirely on a PLAYER_RECONNECTED (or
            -- a game over) actually arriving. If one is dropped — the very
            -- network trouble this dialog is about makes that the likeliest
            -- moment for it — the countdown reaches zero and the scrim just
            -- stays, swallowing every tap for the rest of the game. The
            -- overlay's own update() stops the counter at 0 but leaves the
            -- scrim enabled, so nothing else would ever take it down.
            --
            -- By the time the grace has elapsed the server has resolved this
            -- one way or the other: the game is over on timeout, or they are
            -- back. Either way there is nothing left to wait for, so drop it.
            -- The small margin lets a reconnect landing right on the boundary
            -- win normally.
            local waiting_for = self._dc_waiting_for
            local seq = self._seq
            timer.delay(grace + 2.0, false, function()
                if seq ~= self._seq then return end
                -- Only clear the wait we started: a newer disconnect has its
                -- own timer and its own countdown to run.
                if self._dc_waiting_for ~= waiting_for then return end
                self._dc_waiting_for = nil
                notify_gui(self.gui_hud, "conn_overlay", { show = false })
            end)
        end

    elseif message_id == hash("ws_player_rc") then
        -- Only the player we are actually waiting on can dismiss this (an
        -- unattributed reconnect counts — see disconnect_events.should_dismiss
        -- for why that asymmetry is deliberate).
        if DC.should_dismiss(self._dc_waiting_for, message and message.player_id) then
            self._dc_waiting_for = nil
            notify_gui(self.gui_hud, "conn_overlay", { show = false })
        end
        -- Opponent reconnected: refresh the turn rings so the active player shows.
        -- self.game_state is whatever we last had BEFORE the disconnect, so its
        -- turnExpiresAt is already in the past — sync_timers would clamp the
        -- remaining time to 0 and the pie would come back enabled but empty
        -- (invisible) instead of showing whose turn it actually is.
        --
        -- Read from ws.active_game_state rather than off this message.
        -- websocket_manager parks the state there before emitting, and a
        -- gameState cannot travel through msg.post anyway — it overflows the
        -- serialisation buffer and throws inside the ws listener, which is what
        -- used to stop this whole handler from ever running.
        if self.online_mode and not self.game_over then
            local fresh = (type(ws.active_game_state) == "table"
                and next(ws.active_game_state) ~= nil and ws.active_game_state)
            if fresh then self.game_state = fresh end
            OnlineHandler.sync_timers(self, self.game_state or {})
        end

    elseif message_id == hash("ws_ai_played") then
        local mode = (message and message.mode) or "SINGLE_MOVE"
        if mode == "TAKEOVER" then
            self._ai_notice = { mode = "TAKEOVER", moves = (message and message.moves) or 0 }
        end
        notify_gui(self.gui_hud, "ai_takeover_notice", {
            mode = mode,
            moves = (message and message.moves) or 0,
            max = (message and message.max) or 3,
        })

    elseif message_id == hash("ai_notice_ack") then
        self._ai_notice = nil

    elseif message_id == hash("send_emoji") then
        if self.online_mode and message and message.emoji then
            ws.send_emoji(message.emoji, message.sound, self.opponent_id)
        end

    elseif message_id == hash("emoji_state") then
        self.emoji_popover_open = message.open

    elseif message_id == hash("ws_emoji") then
        local sender = tostring((message and message.sender) or "")
        notify_gui(self.gui_hud, "emoji_received", {
            emoji = (message and message.emoji) or "joy",
            sound = (message and message.sound) or "",
            is_me = (sender ~= "" and sender == tostring(self.my_player_id)),
        })

    elseif message_id == hash("ws_net_down") then
        -- global network dialog handles the visual

    elseif message_id == hash("ws_net_up") then
        -- Our own socket is back. Whatever the overlay was showing — our
        -- outage or a wait on the opponent — IDENTIFY has just resynced us,
        -- and PLAYER_DISCONNECTED will raise the dialog again on the next
        -- grace tick if they are genuinely still gone.
        self._dc_waiting_for = nil
        notify_gui(self.gui_hud, "conn_overlay", { show = false })
        -- Reconnected: re-assert the turn timer from the freshest known state so
        -- the active player's pie ring reappears. self.game_state is whatever
        -- we had BEFORE this client dropped offline, so its turnExpiresAt is
        -- already in the past — sync_timers would clamp remaining time to 0
        -- and the pie would come back enabled but empty (invisible) on both
        -- avatars instead of showing whose turn it is. IDENTIFY (which every
        -- reconnect runs) keeps ws.active_game_state current, so prefer that.
        if self.online_mode and not self.game_over then
            local fresh = type(ws.active_game_state) == "table" and next(ws.active_game_state) ~= nil and ws.active_game_state
            if fresh then self.game_state = fresh end
            OnlineHandler.sync_timers(self, self.game_state or {})
        end

    elseif message_id == hash("ws_net_failed") then
        if self.online_mode then
            local seq = self._seq
            timer.delay(2.5, false, function()
                if seq == self._seq then msg.post("#controller", "goto_online") end
            end)
        end
    end
end