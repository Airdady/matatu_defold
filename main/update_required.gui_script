-- update_required.gui_script
-- TERMINAL update screen: the server has refused this build as too old, so
-- nothing the app can do will get a useful answer out of it.
--
-- Why this exists next to the Google Play In-App Updates flow in
-- gameservices/src/InAppUpdateDefold.java rather than instead of it: that API
-- is best-effort by design. A staged rollout hides the update from users not
-- yet in the rollout; the Play Store app answers getAppUpdateInfo() from a
-- cache it refreshes on its own schedule; an install that did not come from
-- Play is never eligible at all. All three report "no update available" to a
-- client that is genuinely out of date, which is why a release reaches some
-- players and not others. Play's flow stays as the good path — it updates in
-- place without leaving the app — and this is the floor underneath it.
--
-- Deliberately NOT dismissable and deliberately not a "dialog": there is no
-- app behind it to go back to. Priority sits above every other modal
-- (including `incoming` at 100) because a game request that can never be
-- accepted must not cover it.

local ws        = require("modules.websocket_manager")
local api       = require("modules.api_service")
local config    = require("modules.config")
local F         = require("modules.fonts")
local app_state = require("modules.app_state")

local LOGICAL_W, LOGICAL_H = 1280, 720

local C_SCRIM  = vmath.vector4(0.043, 0.051, 0.063, 1.0) -- near-opaque: nothing behind this is usable
local C_PANEL  = vmath.vector4(0.086, 0.098, 0.118, 1.0) -- #16191E
local C_ACCENT = vmath.vector4(0.949, 0.702, 0.020, 1.0) -- #F2B305
local C_BODY   = vmath.vector4(0.788, 0.812, 0.839, 1.0) -- #C9CFD6
local C_MUTED  = vmath.vector4(0.55, 0.59, 0.64, 1)
local C_WHITE  = vmath.vector4(1, 1, 1, 1)
local C_DARK   = vmath.vector4(0.082, 0.094, 0.110, 1.0)

local function box(pos, size, color)
    local n = gui.new_box_node(pos, size)
    gui.set_color(n, color)
    return n
end

local function text(pos, str, px, color, role)
    role = role or F.MODAL
    local n = gui.new_text_node(pos, str)
    gui.set_font(n, role.name)
    gui.set_scale(n, vmath.vector3(F.scale(role, px), F.scale(role, px), 1))
    gui.set_color(n, color or C_WHITE)
    return n
end

-- Where to send the player. The server may name a URL (an AppRelease document
-- can point somewhere else entirely); otherwise build the Play listing for
-- whatever package this build actually shipped as, which is what keeps matatu
-- and matatu_nap pointing at their own listings without a second code path.
local function store_url(self)
    if self.store_url and self.store_url ~= "" then return self.store_url end
    local pkg = config.APP_PACKAGE or ""
    if pkg == "" then return "https://play.google.com/store" end
    return "https://play.google.com/store/apps/details?id=" .. pkg
end

local function build(self)
    self.scrim = box(vmath.vector3(LOGICAL_W/2, LOGICAL_H/2, 0), vmath.vector3(5000, 5000, 0), C_SCRIM)
    gui.set_adjust_mode(self.scrim, gui.ADJUST_STRETCH)

    local pw, ph = 560, 300
    self.panel = box(vmath.vector3(0, 0, 0), vmath.vector3(pw, ph, 0), C_PANEL)
    gui.set_parent(self.panel, self.scrim)
    gui.set_adjust_mode(self.panel, gui.ADJUST_FIT)

    self.strip = box(vmath.vector3(0, ph/2 - 3, 0), vmath.vector3(pw, 6, 0), C_ACCENT)
    gui.set_parent(self.strip, self.panel)

    self.title = text(vmath.vector3(0, 96, 0), "UPDATE REQUIRED", 26, C_WHITE, F.MODAL_BOLD)
    gui.set_parent(self.title, self.panel)

    self.body = text(vmath.vector3(0, 46, 0), "A new version is required to keep playing.", 19, C_BODY)
    gui.set_parent(self.body, self.panel)

    -- What they have vs what they need. Without this the screen is unfalsifiable
    -- from the player's side ("I DID update") and unfalsifiable from ours.
    self.versions = text(vmath.vector3(0, 8, 0), "", 15, C_MUTED)
    gui.set_parent(self.versions, self.panel)

    self.hint = text(vmath.vector3(0, -22, 0), "Your account and coins are safe.", 15, C_MUTED)
    gui.set_parent(self.hint, self.panel)

    self.update_btn = box(vmath.vector3(0, -92, 0), vmath.vector3(260, 56, 0), C_ACCENT)
    gui.set_parent(self.update_btn, self.panel)
    self.update_lbl = text(vmath.vector3(0, -2, 0), "UPDATE NOW", 20, C_DARK, F.MODAL_BOLD)
    gui.set_parent(self.update_lbl, self.update_btn)

    gui.set_enabled(self.scrim, false)
end

local function version_line(self)
    local mine = tostring(config.APP_VERSION or "?")
    if (config.APP_BUILD or 0) > 0 then
        mine = mine .. " (" .. tostring(config.APP_BUILD) .. ")"
    end
    if self.required and self.required ~= "" then
        -- "Update to" rather than "Latest" — "Latest" reads as an optional
        -- newer build, not the actual minimum this player must clear. What
        -- they need to hear is the requirement, not a suggestion.
        return "You have " .. mine .. "  •  Update to " .. self.required
    end
    return "You have " .. mine
end

local function show(self, d)
    d = d or {}
    if d.message and d.message ~= "" then gui.set_text(self.body, d.message) end
    -- minVersionName is the actual gate requirement (checkVersion's floor —
    -- see be_matatu's appVersion.ts). latestVersionName is purely
    -- informational ("the build currently live on Play") and is only a
    -- fallback here for the rare case a floor is enforced by build number
    -- alone, with no human-readable minimum to show.
    self.required = d.minVersionName or d.latestVersionName or ""
    self.store_url = d.storeUrl or ""
    gui.set_text(self.versions, version_line(self))

    gui.set_enabled(self.scrim, true)
    -- Above `incoming` (100): a game request that can never be accepted must
    -- not sit on top of the reason it can't be.
    app_state.modal_open("update_required", 200)
    -- The board underneath is unreachable too — no card may be played from a
    -- session the server will not answer.
    app_state.lock_board()
end

function init(self)
    msg.post(".", "acquire_input_focus")
    gui.set_render_order(15)
    build(self)

    local ME = msg.url("#")

    -- Two independent ways in, because the two transports fail independently:
    -- a player sitting in the lobby may only ever touch REST, and one mid-game
    -- may only ever touch the socket.
    self._token = ws.on("update_required", function(d)
        msg.post(ME, "show_update", d or {})
    end)
    api.on_update_required = function(d)
        msg.post(ME, "show_update", d or {})
    end
end

function final(self)
    if self._token then ws.off(self._token) end
    api.on_update_required = nil
end

function on_message(self, message_id, message)
    if message_id == hash("show_update") then
        show(self, message)
    end
end

function on_input(self, action_id, action)
    if not gui.is_enabled(self.scrim) then return false end

    if action_id == hash("touch") and action.pressed then
        if gui.pick_node(self.update_btn, action.x, action.y) then
            sys.open_url(store_url(self))
            -- Do NOT hide the screen. Play may take a moment to open, the
            -- player may come straight back, and until the app is actually
            -- updated this is still the only true state.
        end
    end

    -- Swallow EVERYTHING, including the Android back button. There is no
    -- screen behind this to return to, and letting back through would drop
    -- the player into an app whose every request is refused.
    return true
end
