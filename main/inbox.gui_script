-- inbox.gui_script — the floating chat bubble, and the message centre behind it.
--
-- Support moved off email. A player taps the bubble on the right, writes, and
-- the message reaches an operator with their user id and phone number attached
-- (see be_matatu's services/inbox.ts). The reply comes back over this socket,
-- or as a push if the app is closed.
--
-- THE SAME PANEL IS THE INBOX. A support reply, a bonus notice and an
-- announcement all land in one list with one unread badge, because a player
-- looking for "that message about my bonus" should not have to remember which
-- of two places it went.
--
-- A NOTIFICATION LAYER, LIKE THE TOAST. Never registered in controller's
-- SCREENS list, so screen navigation never enables or disables it and the
-- bubble survives every screen. Unlike the toast it DOES take input — but only
-- while it is open, and it releases focus the moment it closes, so a closed
-- bubble can never eat a tap meant for the board underneath.
local ui        = require("modules.ui")
local screen    = require("modules.screen")
local app_state = require("modules.app_state")
local ws        = require("modules.websocket_manager")
local inbox     = require("modules.inbox")

local LOGICAL_W, LOGICAL_H = 1280, 720

-- Same palette as the toast and the profile screen, so this reads as part of
-- the app rather than as an OS-style overlay dropped on top of it.
local P_BG      = vmath.vector4(0.082, 0.063, 0.051, 1)
local P_PANEL   = vmath.vector4(0.106, 0.086, 0.070, 1)
local P_BORDER  = vmath.vector4(0.165, 0.129, 0.102, 1)
local P_CREAM   = vmath.vector4(0.957, 0.925, 0.843, 1)
local P_DIM     = vmath.vector4(0.62, 0.59, 0.54, 1)
local P_GOLD    = vmath.vector4(0.784, 0.573, 0.165, 1)
local P_MINE    = vmath.vector4(0.145, 0.196, 0.161, 1)
local P_THEIRS  = vmath.vector4(0.129, 0.110, 0.094, 1)
local P_BADGE   = vmath.vector4(0.820, 0.231, 0.231, 1)
local P_SCRIM   = vmath.vector4(0, 0, 0, 0.78)

-- THE BUBBLE SITS ON THE RIGHT, clear of the bottom edge so a gesture bar
-- cannot swallow it. Anchored right so it stays on the edge of a wider screen
-- instead of drifting into the middle of the board.
local BUBBLE_R, BUBBLE_B = 26, 120
local BUBBLE_SIZE = 68

local PANEL_W, PANEL_H = 520, 620
local ROW_GAP = 10
local COMPOSER_H = 84

-- ── node bookkeeping ────────────────────────────────────────────────────────
--
-- Every node except the bubble itself is rebuilt on each change, the same way
-- the online screen rebuilds its list: a panel that patches nodes in place
-- drifts out of step with the state it is drawing.
local function track(self, n)
    self.nodes[#self.nodes + 1] = n
    return n
end

local function clear(self)
    for _, n in ipairs(self.nodes or {}) do pcall(gui.delete_node, n) end
    self.nodes = {}
    self.buttons = {}
end

local function btn(self, id, pos, size, label, font, bg)
    local b = track(self, ui.box(pos, size, bg or P_PANEL))
    track(self, ui.box(pos, vmath.vector3(size.x - 4, size.y - 4, 0), P_BORDER))
    track(self, ui.text(pos, label, font or "body", P_CREAM))
    self.buttons[#self.buttons + 1] = { node = b, id = id }
    return b
end

-- ── the bubble ──────────────────────────────────────────────────────────────

local function build_bubble(self)
    local x = LOGICAL_W - BUBBLE_R - BUBBLE_SIZE / 2
    local y = BUBBLE_B + BUBBLE_SIZE / 2

    self.bubble = gui.new_box_node(vmath.vector3(x, y, 0),
        vmath.vector3(BUBBLE_SIZE, BUBBLE_SIZE, 0))
    gui.set_color(self.bubble, P_BG)
    gui.set_xanchor(self.bubble, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.bubble, gui.ANCHOR_BOTTOM)

    self.bubble_ring = gui.new_box_node(vmath.vector3(x, y, 0),
        vmath.vector3(BUBBLE_SIZE - 5, BUBBLE_SIZE - 5, 0))
    gui.set_color(self.bubble_ring, P_GOLD)
    gui.set_xanchor(self.bubble_ring, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.bubble_ring, gui.ANCHOR_BOTTOM)

    self.bubble_inner = gui.new_box_node(vmath.vector3(x, y, 0),
        vmath.vector3(BUBBLE_SIZE - 11, BUBBLE_SIZE - 11, 0))
    gui.set_color(self.bubble_inner, P_BG)
    gui.set_xanchor(self.bubble_inner, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.bubble_inner, gui.ANCHOR_BOTTOM)

    -- A glyph rather than an atlas image, so the bubble cannot come up blank
    -- on a build whose atlas is missing the icon.
    self.bubble_icon = gui.new_text_node(vmath.vector3(x, y - 1, 0), "✉")
    gui.set_font(self.bubble_icon, "subtitle2")
    gui.set_color(self.bubble_icon, P_GOLD)
    gui.set_xanchor(self.bubble_icon, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.bubble_icon, gui.ANCHOR_BOTTOM)

    -- The badge. Its own nodes so the count can change without rebuilding the
    -- bubble, which is what lets it appear the instant INBOX_UNREAD lands.
    local bx, by = x + BUBBLE_SIZE / 2 - 8, y + BUBBLE_SIZE / 2 - 8
    self.badge = gui.new_box_node(vmath.vector3(bx, by, 0), vmath.vector3(26, 26, 0))
    gui.set_color(self.badge, P_BADGE)
    gui.set_xanchor(self.badge, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.badge, gui.ANCHOR_BOTTOM)
    self.badge_text = gui.new_text_node(vmath.vector3(bx, by, 0), "")
    gui.set_font(self.badge_text, "small")
    gui.set_color(self.badge_text, P_CREAM)
    gui.set_xanchor(self.badge_text, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.badge_text, gui.ANCHOR_BOTTOM)

    gui.set_enabled(self.badge, false)
    gui.set_enabled(self.badge_text, false)
end

local function refresh_badge(self)
    local show = inbox.has_unread(self.state) and not self.open
    pcall(gui.set_enabled, self.badge, show)
    pcall(gui.set_enabled, self.badge_text, show)
    if show then pcall(gui.set_text, self.badge_text, inbox.badge_text(self.state)) end
end

-- Hidden until the player is actually signed in and connected: a support
-- bubble on a screen where nothing can be sent is a button that does nothing.
local function bubble_should_show()
    if app_state.current_screen == "auth" then return false end
    return ws.is_identified == true
end

local function refresh_bubble(self)
    local show = bubble_should_show()
    for _, n in ipairs({ self.bubble, self.bubble_ring, self.bubble_inner, self.bubble_icon }) do
        pcall(gui.set_enabled, n, show)
    end
    if not show then
        pcall(gui.set_enabled, self.badge, false)
        pcall(gui.set_enabled, self.badge_text, false)
    else
        refresh_badge(self)
    end
end

-- ── the panel ───────────────────────────────────────────────────────────────

-- Text wrapped by hand, because a gui text node does not wrap. Conservative
-- character count rather than measured width: a line that runs off the panel
-- is unreadable, and one that breaks early is merely narrow.
local function wrap(text, per_line)
    local out, line = {}, ""
    for word in tostring(text or ""):gmatch("%S+") do
        if line == "" then
            line = word
        elseif #line + #word + 1 <= per_line then
            line = line .. " " .. word
        else
            out[#out + 1] = line
            line = word
        end
    end
    if line ~= "" then out[#out + 1] = line end
    if #out == 0 then out[1] = "" end
    return out
end

local CHARS_PER_LINE = 42
local LINE_H = 18

local function draw_panel(self)
    local cx, cy = LOGICAL_W / 2, LOGICAL_H / 2

    local scrim = track(self, ui.box(vmath.vector3(cx, cy, 0),
        vmath.vector3(LOGICAL_W * 2, LOGICAL_H * 2, 0), P_SCRIM))
    self.buttons[#self.buttons + 1] = { node = scrim, id = "scrim" }

    track(self, ui.box(vmath.vector3(cx, cy, 0), vmath.vector3(PANEL_W, PANEL_H, 0), P_BORDER))
    track(self, ui.box(vmath.vector3(cx, cy, 0), vmath.vector3(PANEL_W - 4, PANEL_H - 4, 0), P_BG))

    local top = cy + PANEL_H / 2
    track(self, ui.text(vmath.vector3(cx, top - 30, 0), "MESSAGES", "title", P_GOLD))
    btn(self, "close", vmath.vector3(cx + PANEL_W / 2 - 34, top - 30, 0),
        vmath.vector3(44, 40, 0), "X", "body")

    -- The thread. Newest at the BOTTOM, which is how a conversation reads, and
    -- the view is pinned there — a chat that opens at the top makes the player
    -- scroll to find what they came for.
    local list_top = top - 62
    local list_bottom = cy - PANEL_H / 2 + COMPOSER_H + 12
    local avail = list_top - list_bottom

    local msgs = self.state.messages
    if #msgs == 0 then
        track(self, ui.text(vmath.vector3(cx, (list_top + list_bottom) / 2, 0),
            self.state.loaded and "No messages yet." or "Loading...", "small", P_DIM))
    end

    -- Laid out from the bottom up, so the newest message is always fully on
    -- screen and older ones fall off the top rather than the other way round.
    local y = list_bottom + 6
    for i = #msgs, 1, -1 do
        local m = msgs[i]
        local mine = inbox.is_mine(m)
        local lines = wrap(m.body, CHARS_PER_LINE)
        local h = #lines * LINE_H + 30
        if y + h > list_top then break end

        local bw = PANEL_W - 60
        local bx = mine and (cx + 14) or (cx - 14)
        local box_cy = y + h / 2
        track(self, ui.box(vmath.vector3(bx, box_cy, 0),
            vmath.vector3(bw - 28, h, 0), mine and P_MINE or P_THEIRS))

        local tx = bx - (bw - 28) / 2 + 12
        local ly = box_cy + h / 2 - 14
        track(self, ui.text(vmath.vector3(tx + 60, ly, 0),
            inbox.sender_label(m), "small", mine and P_DIM or P_GOLD))
        ly = ly - 18
        for _, line in ipairs(lines) do
            track(self, ui.text(vmath.vector3(tx + 100, ly, 0), line, "small", P_CREAM))
            ly = ly - LINE_H
        end

        y = y + h + ROW_GAP
    end

    -- Composer.
    local comp_cy = cy - PANEL_H / 2 + COMPOSER_H / 2 + 6
    local field = track(self, ui.box(vmath.vector3(cx - 40, comp_cy, 0),
        vmath.vector3(PANEL_W - 140, 52, 0), P_PANEL))
    self.buttons[#self.buttons + 1] = { node = field, id = "field" }

    local draft = self.draft or ""
    local shown = draft
    if shown == "" then shown = self.typing and "|" or "Write a message..." end
    -- Only the tail is drawn: a long draft would otherwise run out of the box
    -- and the player would lose sight of what they are typing.
    if #shown > CHARS_PER_LINE then shown = "..." .. shown:sub(-CHARS_PER_LINE) end
    track(self, ui.text(vmath.vector3(cx - 40, comp_cy, 0), shown, "small",
        draft == "" and P_DIM or P_CREAM))

    btn(self, "send", vmath.vector3(cx + PANEL_W / 2 - 52, comp_cy, 0),
        vmath.vector3(84, 52, 0), self.state.sending and "..." or "SEND", "body")

    if self.state.error then
        track(self, ui.text(vmath.vector3(cx, comp_cy + 44, 0),
            self.state.error, "small", P_BADGE))
    end
end

local function rebuild(self)
    clear(self)
    if self.open then draw_panel(self) end
    refresh_bubble(self)
end

-- ── open / close ────────────────────────────────────────────────────────────

local function open_panel(self)
    self.open = true
    self.state.error = nil
    msg.post(".", "acquire_input_focus")

    -- Cleared LOCALLY and the server told separately: waiting for the round
    -- trip leaves a badge sitting over an open inbox, which reads as the app
    -- not having noticed.
    local ids = inbox.unread_ids(self.state)
    inbox.mark_all_read(self.state)
    if #ids > 0 then pcall(ws.mark_inbox_read, ids) else pcall(ws.mark_inbox_read, nil) end

    pcall(ws.fetch_inbox, nil, nil)
    rebuild(self)
end

local function close_panel(self)
    self.open = false
    self.typing = false
    pcall(gui.hide_keyboard)
    msg.post(".", "release_input_focus")
    rebuild(self)
end

local function do_send(self)
    local ok, textOrErr = inbox.compose_check(self.draft)
    if not ok then
        self.state.error = textOrErr
        return rebuild(self)
    end
    self.state.error = nil
    self.state.sending = true
    self.draft = ""
    pcall(ws.send_inbox_message, textOrErr)
    rebuild(self)
end

-- ── lifecycle ───────────────────────────────────────────────────────────────

function init(self)
    self.nodes, self.buttons = {}, {}
    self.state = inbox.new()
    self.open, self.draft, self.typing = false, "", false
    screen.apply(self)
    build_bubble(self)
    rebuild(self)
end

function final(self)
    clear(self)
    pcall(msg.post, ".", "release_input_focus")
end

function on_message(self, message_id, message)
    if message_id == hash("ws_inbox_unread") then
        inbox.set_unread(self.state, message and message.unread)
        if self.open then inbox.mark_all_read(self.state) end
        rebuild(self)

    elseif message_id == hash("ws_inbox_history") then
        local page = ws.last_inbox_page or {}
        inbox.merge_history(self.state, page.messages or {})
        if not self.open then inbox.set_unread(self.state, ws.inbox_unread) end
        rebuild(self)

    elseif message_id == hash("ws_inbox_message") then
        local m = ws.last_inbox_message
        if m then
            inbox.append(self.state, m)
            -- Read on arrival only if they are looking at it. Otherwise the
            -- badge stands, and the server keeps its own count either way.
            if self.open then
                inbox.mark_all_read(self.state)
                pcall(ws.mark_inbox_read, nil)
            else
                inbox.set_unread(self.state, ws.inbox_unread)
                pcall(msg.post, "#snd_ping", "play_sound")
            end
        end
        rebuild(self)

    elseif message_id == hash("ws_inbox_sent") then
        local d = ws.last_inbox_sent or {}
        self.state.sending = false
        if d.success and d.message then
            inbox.append(self.state, d.message)
            self.state.error = nil
        else
            -- The draft is NOT restored silently: the player watched it leave
            -- the box. Telling them why is the only honest thing left.
            self.state.error = tostring(d.error or "Could not send. Try again.")
        end
        rebuild(self)

    elseif message_id == hash("ws_identify") or message_id == hash("screen_changed") then
        rebuild(self)
    end
end

function on_input(self, action_id, action)
    -- A CLOSED BUBBLE NEVER EATS A TAP. Input focus is only held while the
    -- panel is open (see open_panel/close_panel), and even then the bubble
    -- itself is the one node checked when it is not.
    if not self.open then
        if action_id == hash("touch") and action.pressed and bubble_should_show() then
            if self.bubble and gui.pick_node(self.bubble, action.x, action.y) then
                open_panel(self)
                return true
            end
        end
        return false
    end

    -- Device keyboard, the same way team_tournament takes text: the native IME
    -- brings autocorrect and the player's own layout.
    if action_id == hash("text") then
        if #self.draft < inbox.MAX_BODY then self.draft = self.draft .. tostring(action.text or "") end
        rebuild(self)
        return true
    elseif action_id == hash("backspace") and (action.pressed or action.repeated) then
        self.draft = self.draft:sub(1, -2)
        rebuild(self)
        return true
    elseif action_id == hash("enter") and action.pressed then
        do_send(self)
        return true
    end

    if action_id ~= hash("touch") or not action.pressed then return true end

    for i = #self.buttons, 1, -1 do
        local b = self.buttons[i]
        if gui.pick_node(b.node, action.x, action.y) then
            if b.id == "close" or b.id == "scrim" then
                close_panel(self)
            elseif b.id == "send" then
                do_send(self)
            elseif b.id == "field" then
                self.typing = true
                pcall(gui.show_keyboard, gui.KEYBOARD_TYPE_DEFAULT, false)
                rebuild(self)
            end
            return true
        end
    end

    -- Swallowed: the panel is modal, and a tap that falls through it acts on
    -- the screen behind an open dialog.
    return true
end
