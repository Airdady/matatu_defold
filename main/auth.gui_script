-- auth.gui_script
local ui        = require("modules.ui")
local app_state = require("modules.app_state")
local screen    = require("modules.screen")

local LOGICAL_W, LOGICAL_H = 1280, 720
local VISIBLE_W, VISIBLE_H = 1280, 720
local CX, CY = 640, 360

-- Palette
local C_ACCENT     = vmath.vector4(0.502, 0.255, 0.118, 1)
local C_STATE      = vmath.vector4(0.6, 0.6, 0.6, 1)
local C_CREAM      = vmath.vector4(0.973, 0.925, 0.859, 1)

local function refresh_wh()
    local m = screen.metrics()
    VISIBLE_W, VISIBLE_H = m.VW, m.VH
    CX, CY = m.CX, m.CY
end

local function clear(self)
    for _, n in ipairs(self.nodes) do pcall(gui.delete_node, n) end
    self.nodes, self.buttons = {}, {}
end
local function track(self, n) self.nodes[#self.nodes+1] = n return n end

local function ktext(self, pos, str, px, color)
    return track(self, ui.text(pos, str, "body", color, px / 26))
end

local function build_auth(self)
    track(self, ui.cover(LOGICAL_W, LOGICAL_H, vmath.vector4(0, 0, 0, 1)))
    local b = track(self, ui.cover_image(LOGICAL_W, LOGICAL_H, "texture_bg"))
    gui.set_color(b, vmath.vector4(1, 1, 1, 0.5))
    track(self, ui.cover(LOGICAL_W, LOGICAL_H, vmath.vector4(0, 0, 0, 0.55)))

    local cb = track(self, ui.box(vmath.vector3(44, 720 - 40, 0), vmath.vector3(56, 56, 0), vmath.vector4(0, 0, 0, 0.001)))
    ktext(self, vmath.vector3(44, 720 - 40, 0), "X", 26, C_STATE)
    self.buttons[#self.buttons+1] = { node = cb, id = "cancel" }

    ktext(self, vmath.vector3(CX, CY + 140, 0), "SIGN IN", 32, C_CREAM)

    local s = app_state.auth_state
    if s == "error" and app_state.auth_error ~= "" then
        ktext(self, vmath.vector3(CX, CY + 90, 0), tostring(app_state.auth_error):upper(), 18, vmath.vector4(1, 0.4, 0.4, 1))
    elseif s ~= "error" then
        ktext(self, vmath.vector3(CX, CY + 90, 0), "Connecting...", 20, C_STATE)
    end

    -- SIGN IN WITH GOOGLE — a real button, which this screen did not have.
    --
    -- Sign-in used to be silent and only silent: the comment here said so, and
    -- the screen offered nothing but a status line and, eventually, TRY AGAIN.
    -- That was a reasonable design for Play Games, where an interactive prompt
    -- was a last resort. It is the wrong one for Firebase, where the account
    -- picker is the ordinary way a person signs in and is the thing that
    -- CREATES the consent a silent attempt can only ever reuse.
    --
    -- It is the primary action on the screen, drawn filled, because a player
    -- who has got this far has already waited through a silent attempt that
    -- did not work.
    local gy = CY + 10
    local gb = track(self, ui.box(vmath.vector3(CX, gy, 0), vmath.vector3(320, 64, 0), vmath.vector4(1, 1, 1, 1)))
    -- The G, in Google's blue, standing in for the mark. Deliberately not an
    -- imitation of the official button: the brand guidelines are specific
    -- about the real one, and a near-miss is worse than an honest plain button.
    ktext(self, vmath.vector3(CX - 120, gy, 0), "G", 30, vmath.vector4(0.259, 0.522, 0.957, 1))
    ktext(self, vmath.vector3(CX + 16, gy, 0), "SIGN IN WITH GOOGLE", 20, vmath.vector4(0.13, 0.13, 0.13, 1))
    self.buttons[#self.buttons+1] = { node = gb, id = "google_signin" }

    if s == "error" then
        local btn = track(self, ui.box(vmath.vector3(CX, CY - 60, 0), vmath.vector3(280, 52, 0), C_ACCENT))
        ktext(self, vmath.vector3(CX, CY - 60, 0), "TRY AGAIN", 20, C_CREAM)
        self.buttons[#self.buttons+1] = { node = btn, id = "retry_silent_login" }
    end

    -- The other credential, offered here at all times — including while this
    -- screen still says "Connecting...".
    --
    -- This screen is where a player ends up when Google sign-in is not working
    -- for them, and the one thing it could not do until now was let them stop
    -- waiting on it. Some devices have no Google account at all, and no amount
    -- of retrying invents one; a phone number does not go through Google at
    -- all.
    local py = (s == "error") and (CY - 130) or (CY - 70)
    local pb = track(self, ui.box(vmath.vector3(CX, py, 0), vmath.vector3(300, 56, 0), vmath.vector4(0.784, 0.580, 0.235, 1)))
    track(self, ui.box(vmath.vector3(CX, py, 0), vmath.vector3(296, 52, 0), vmath.vector4(0.05, 0.04, 0.03, 1)))
    ktext(self, vmath.vector3(CX, py, 0), "USE PHONE NUMBER", 20, C_CREAM)
    self.buttons[#self.buttons+1] = { node = pb, id = "phone_signin" }
end

function init(self)
    self.nodes, self.buttons = {}, {}
    refresh_wh()
end

function on_message(self, message_id, message, sender)
    if message_id == hash("enable") then
        self._active = true
    elseif message_id == hash("disable") then
        self._active = false
        clear(self)
    elseif message_id == hash("layout_changed") then
        refresh_wh()
        if self._active then clear(self) build_auth(self) end
    elseif message_id == hash("screen_enter") then
        refresh_wh()
        self._active = true
        msg.post(".", "acquire_input_focus")
        app_state.auth_state = "idle"
        clear(self)
        build_auth(self)
    elseif message_id == hash("auth_state_changed") then
        if app_state.auth_state == "done" then
            app_state.auth_state = "idle"
            if self._active then
                clear(self)
                self._active = false
                -- No release_input_focus: it is a game-OBJECT message and
                -- every screen is a component on the same object, so it drops
                -- input for ALL of them. self._active already gates this
                -- screen's own on_input, which is what the rest do.
                msg.post("#controller", "play_online")
            end
            return
        end
        if self._active then clear(self) build_auth(self) end
    end
end

function on_input(self, action_id, action)
    if action_id == hash("touch") and action.pressed then
        for i = #self.buttons, 1, -1 do
            local b = self.buttons[i]
            if b.node and gui.pick_node(b.node, action.x, action.y) then
                if b.id == "cancel" then
                    msg.post("#controller", "auth_cancel")
                elseif b.id == "google_signin" then
                    msg.post("#controller", "google_signin")
                elseif b.id == "retry_silent_login" then
                    msg.post("#controller", "auth_retry_silent_login")
                elseif b.id == "phone_signin" then
                    self._active = false
                    msg.post("#controller", "goto_phone_login")
                end
                return true
            end
        end
    end
    return false
end