-- =============================================================================
--  lobby.gui_script  —  Matatu "Fight Lobby" Full-Screen Tile Grid
--
--  Redesigned to match the dark, textured, bordered aesthetic.
-- =============================================================================

local ui         = require("modules.ui")
local app_state  = require("modules.app_state")
local game_logic = require("modules.game_logic")
local ws         = require("modules.websocket_manager")
local screen      = require("modules.screen")
local akira       = require("modules.akira")
local GameMode    = require("modules.game_mode")
local api         = require("modules.api_service")
local toast       = require("modules.toast")

-- ---------------------------------------------------------------------------
-- Shared lobby components. The look, the drawing primitives, the two tile
-- shapes, the season countdown and the open-cups rail each live in their own
-- module under modules/lobby/ — this file keeps the screen's state machine,
-- its overlays and its input handling.
-- ---------------------------------------------------------------------------
local T      = require("modules.lobby.theme")
local D      = require("modules.lobby.draw")
local Tiles  = require("modules.lobby.tiles")
local Season = require("modules.lobby.season")
local Cups   = require("modules.lobby.cups")

-- Local aliases keep the rest of this file reading as it did before the split.
local track     = D.track
local clear     = D.clear
local set_pivot = D.set_pivot
local text_sh   = D.text_sh
local mkbtn     = D.btn
local commas    = D.commas

local C_CREAM, C_RED, C_DARKRED = T.CREAM, T.RED, T.DARKRED
local C_GOLD, C_BORDER, C_TILE  = T.GOLD, T.BORDER, T.TILE
local C_DARK, C_TRANSP, C_MUTED = T.DARK, T.TRANSP, T.MUTED
local C_COPPER, C_TAN           = T.GOLD, T.GOLD
local C_U_TEAM, C_DISABLED      = T.TEAM, T.DISABLED

local CONSENT_PANEL, CONSENT_ACCENT = T.CONSENT_PANEL, T.CONSENT_ACCENT
local CONSENT_BODY_C, CONSENT_DARK  = T.CONSENT_BODY, T.CONSENT_DARK
local CONSENT_NEUTRAL, CONSENT_DONE = T.CONSENT_NEUTRAL, T.CONSENT_DONE

local LOGICAL_W, LOGICAL_H = T.LOGICAL_W, T.LOGICAL_H
local GUTTER, PADDING, HEADER_H = T.GUTTER, T.PADDING, T.HEADER_H

local STATE_LOBBY     = T.STATE_LOBBY
local STATE_AI_SELECT = T.STATE_AI_SELECT
local STATE_TOURNEY   = T.STATE_TOURNEY
local STATE_TEAM_JOIN = T.STATE_TEAM_JOIN
local STATE_TEAM_MENU = T.STATE_TEAM_MENU

-- Canvas, mirrored from the theme so this file's own layout maths reads the
-- same numbers the components do. refresh_wh() below keeps both in step.
local VW, VH = T.VW, T.VH
local EDGE_L, EDGE_R, EDGE_B, EDGE_T = T.EDGE_L, T.EDGE_R, T.EDGE_B, T.EDGE_T
local CX, CY = T.CX, T.CY

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------
local function refresh_wh()
    local m  = screen.metrics()
    T.refresh(m)
    VW, VH   = m.VW, m.VH
    EDGE_L, EDGE_R = m.L, m.R
    EDGE_B, EDGE_T = m.B, m.T
    CX, CY   = m.CX, m.CY
end

-- "Cup rules": mirrors computeSuggestedLevels in be_matatu's
-- tournament.controller.js exactly (ceil(log2(players)) clamped to 3-7) so
-- the number shown here while the owner is still choosing max players
-- always matches what the server will actually create.
local function suggested_levels(max_players)
    local n = math.max(2, tonumber(max_players) or 2)
    local lv = math.ceil(math.log(n) / math.log(2))
    if lv < 3 then lv = 3 end
    if lv > 7 then lv = 7 end
    return lv
end

-- Percent-encodes a string for safe use inside a mailto: URL's query
-- string (subject=/body=) — spaces, newlines and punctuation all need
-- escaping there, unlike a plain wa.me/share URL elsewhere in this file.
local function url_encode(str)
    str = tostring(str or "")
    str = str:gsub("\r?\n", "\r\n")
    str = str:gsub("([^%w %-%_%.%~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
    str = str:gsub(" ", "%%20")
    return str
end

local update_lobby_season = Season.update

local mode_tile = Tiles.mode
local util_tile = Tiles.util

-- ---------------------------------------------------------------------------
-- Overlays (Tutorial, Consent, AI, Tournament)
-- ---------------------------------------------------------------------------
local Overlays = require("modules.lobby.overlays")

local tutorial_seen      = Overlays.tutorial_seen
local mark_tutorial_seen = Overlays.mark_tutorial_seen
local draw_tutorial      = Overlays.tutorial
local draw_consent       = Overlays.consent
local draw_ai_select     = Overlays.ai_select
local draw_tournament    = Overlays.tournament
local draw_team_menu     = Overlays.team_menu
local draw_team_join     = Overlays.team_join
local TUTORIAL_PAGES     = Overlays.TUTORIAL_PAGES
local INSTALL_STEPS      = Overlays.INSTALL_STEPS
local INSTALL_DURATION   = Overlays.INSTALL_DURATION
local TEAM_CODE_MAX      = Overlays.TEAM_CODE_MAX

-- Forward reference: the rail's loader repaints once its request lands.
local rebuild_ref

local my_owned_cup = Cups.my_owned_cup
local function load_team_cups(self)
    Cups.load(self, function(s2) rebuild_ref(s2) end)
end

-- ---------------------------------------------------------------------------
-- Main Rebuild
-- ---------------------------------------------------------------------------
local function rebuild(self)
    clear(self)

    -- Textured Background Layer (Landscape, no over-scaling)
    track(self, ui.cover(LOGICAL_W, LOGICAL_H, vmath.vector4(0, 0, 0, 1)))
    track(self, ui.cover_image(LOGICAL_W, LOGICAL_H, "texture_bg"))
    
    -- Subtle dark wash to ensure text pops and matches the screenshot perfectly
    track(self, ui.cover(LOGICAL_W, LOGICAL_H, vmath.vector4(0.04, 0.03, 0.02, 0.70)))

    -- Geometry Setup
    local grid_l = EDGE_L + PADDING
    local grid_r = EDGE_R - PADDING

    local util_h = 56
    local grid_b = EDGE_B + PADDING + util_h + GUTTER
    local grid_t = EDGE_T - PADDING - HEADER_H

    -- Right rail: open team cups. Its width is reserved out of the grid so
    -- the mode tiles shrink to make room rather than being overdrawn.
    local RAIL_W, show_rail, rail_l = Cups.reserve(grid_l, grid_r)
    if show_rail then grid_r = rail_l - GUTTER end

    local grid_w = grid_r - grid_l
    local grid_h = grid_t - grid_b

    -- Row A (top, bigger): PLAY ONLINE + TEAM CUPS — the two
    -- real-money/online modes, both prominent. Row B (bottom, smaller): the
    -- three offline-vs-AI modes, secondary to both tiles above them.
    local row_a_h  = math.floor((grid_h - GUTTER) * 0.62)
    local row_b_h  = grid_h - row_a_h - GUTTER
    local row_a_cy = grid_b + row_b_h + GUTTER + row_a_h / 2
    local row_b_cy = grid_b + row_b_h / 2

    -- Row A split: PLAY ONLINE gets the bigger share, TEAM CUPS is
    -- second-biggest right beside it.
    local play_w  = math.floor((grid_w - GUTTER) * 0.58)
    local team_w  = grid_w - play_w - GUTTER
    local play_cx = grid_l + play_w / 2
    local team_cx = grid_l + play_w + GUTTER + team_w / 2

    -- Row B split: three equal offline-mode tiles (remainder width goes to
    -- the last one so there's no rounding gap at the right edge).
    local off_w1   = math.floor((grid_w - GUTTER * 2) / 3)
    local off_w3   = grid_w - off_w1 * 2 - GUTTER * 2
    local off_1_cx = grid_l + off_w1 / 2
    local off_2_cx = grid_l + off_w1 + GUTTER + off_w1 / 2
    local off_3_cx = grid_l + off_w1 * 2 + GUTTER * 2 + off_w3 / 2

    -- -----------------------------------------------------------------------
    -- Top Header
    -- -----------------------------------------------------------------------
    local h_y = EDGE_T - PADDING - 20

    -- Left Red Marker + Brand
    local n_red = track(self, ui.box(vmath.vector3(grid_l + 2, h_y - 6, 0), vmath.vector3(4, 30, 0), C_RED))
    set_pivot(n_red, gui.PIVOT_W)
    
    local n_m = track(self, ui.text(vmath.vector3(grid_l + 16, h_y, 0), GameMode.TITLE, "title", C_CREAM))
    set_pivot(n_m, gui.PIVOT_W)
    pcall(gui.set_scale, n_m, vmath.vector3(1.1, 1.1, 1))

    local n_ocg = track(self, ui.text(vmath.vector3(grid_l + 16, h_y - 32, 0), "ONLINE CARD GAME", "small", C_MUTED))
    set_pivot(n_ocg, gui.PIVOT_W)

    -- Right Guest Status. Explicit ~= "" check (not just truthiness) —
    -- username is no longer auto-filled from Google Play Games at signup,
    -- so a signed-in-but-not-yet-named user has username == "", which is
    -- truthy in Lua and would otherwise blank out the header and wrongly
    -- read "RANKED ACCOUNT" instead of prompting sign-in.
    local has_username = ws.current_user_data and ws.current_user_data.username and ws.current_user_data.username ~= ""
    local user_txt = has_username and ws.current_user_data.username or "GUEST"
    local sub_txt  = has_username and "RANKED ACCOUNT" or "TAP 'PLAY ONLINE' TO SIGN IN"

    local n_guest = track(self, ui.text(vmath.vector3(grid_r, h_y, 0), user_txt, "title", C_CREAM))
    set_pivot(n_guest, gui.PIVOT_E)

    local n_sign = track(self, ui.text(vmath.vector3(grid_r, h_y - 32, 0), sub_txt, "small", vmath.vector4(0.4, 0.4, 0.4, 1)))
    set_pivot(n_sign, gui.PIVOT_E)

    -- The "SEASON ENDS IN" countdown now lives inside the PLAY ONLINE tile
    -- (see mode_tile's season_countdown block below) instead of here, so it
    -- reads in context with the mode it applies to.

    -- -----------------------------------------------------------------------
    -- Tile 1: PLAY ONLINE
    -- -----------------------------------------------------------------------
    local cta_text = "PLAY NOW"
    local sub_text = "Real players • Live coin stakes"
    local is_connecting = app_state.auth_state == "sending" or app_state.auth_state == "verifying"
    
    if is_connecting then
        cta_text = "CONNECTING..."
        sub_text = "Authenticating with Google Play Games..."
    elseif app_state.auth_state == "error" then
        cta_text = "TRY AGAIN"
        sub_text = app_state.auth_error ~= "" and tostring(app_state.auth_error):upper() or "CONNECTION FAILED"
    end

    mode_tile(self, {
        x = play_cx, y = row_a_cy, w = play_w, h = row_a_h,
        accent      = C_RED,
        top_left    = "LIVE",
        blink_tl    = true,
        top_left_2  = "MULTI PLAYER",
        title       = "PLAY ONLINE",
        sub         = sub_text,
        season_countdown = self.season_text,
        season_deadline  = self.season_deadline_text,
        cta_label   = cta_text,
        btn_id      = "play_online",
    })

    -- -----------------------------------------------------------------------
    -- Tile 2: TEAM CUPS — second-biggest, right beside PLAY ONLINE
    -- and above the offline modes. CREATE and JOIN are their own buttons
    -- directly on the tile so both are reachable in a single tap, instead
    -- of tapping the tile to open a separate CREATE/JOIN BY CODE picker
    -- first (STATE_TEAM_MENU / draw_team_menu are still used for the
    -- has_team_tournament case below, since there is nothing to create or
    -- join once you are already in one). CREATE now opens the dedicated
    -- team-tournament screen rather than an in-lobby dialog.
    -- -----------------------------------------------------------------------
    local has_team_tournament = ws.current_user_data and ws.current_user_data.myTeamTournamentId
        and tostring(ws.current_user_data.myTeamTournamentId) ~= ""

    -- A player may own only ONE cup (the backend rejects a second), so once
    -- they do, CREATE is meaningless and the tile switches to running the cup
    -- they already have: START it, or JOIN somebody else's.
    local my_cup = my_owned_cup(self)
    local owns_cup = my_cup ~= nil
    local cup_started = owns_cup and my_cup.started

    local team_children
    if owns_cup then
        -- The owner's cup is run entirely from this tile — it is deliberately
        -- absent from the open-cups rail, so there is one place to manage it
        -- rather than two that can disagree. BRACKET opens the full drawing,
        -- which carries the rest of the controls (remove player, delete).
        team_children = {
            { id = cup_started and "team_standings" or "team_cup_start",
              label = cup_started and "BRACKET" or "START CUP", style = "primary_btn" },
            { id = "team_standings", label = "MANAGE", style = "secondary_btn" },
        }
    elseif not has_team_tournament then
        team_children = {
            { id = "team_menu_create", label = "CREATE", style = "primary_btn" },
            { id = "team_menu_join",   label = "JOIN",   style = "secondary_btn" },
        }
    end

    local team_sub
    if owns_cup then
        -- Everything the owner needs to see at a glance: name, state, how
        -- full it is and what it pays.
        team_sub = string.format("%s • %s • %d/%d • %s %s",
            tostring(my_cup.name or "Your cup"),
            cup_started and "RUNNING" or "NOT STARTED",
            tonumber(my_cup.members) or 0, tonumber(my_cup.maxPlayers) or 0,
            commas(my_cup.grandPrize or 0), tostring(GameMode.CURRENCY_CODE or ""))
    elseif has_team_tournament then
        team_sub = "You're in one — manage it"
    else
        team_sub = "Fund a prize, invite your team"
    end

    mode_tile(self, {
        x = team_cx, y = row_a_cy, w = team_w, h = row_a_h,
        accent      = C_U_TEAM,
        top_left    = "ONLINE",
        top_left_2  = "TEAM",
        title       = "TEAM CUPS",
        sub         = team_sub,
        cta_label   = (has_team_tournament and not owns_cup) and "OPEN" or nil,
        btn_id      = (has_team_tournament and not owns_cup) and "team_action_open" or nil,
        child_buttons = team_children,
    })

    -- -----------------------------------------------------------------------
    -- Tile 3: QUICK PLAY
    -- -----------------------------------------------------------------------
    mode_tile(self, {
        x = off_1_cx, y = row_b_cy, w = off_w1, h = row_b_h,
        accent   = C_GOLD,
        top_left = "OFFLINE",
        title    = "QUICK PLAY",
        sub      = "One deal vs the bot",
        btn_id   = "quick_play",
    })

    -- -----------------------------------------------------------------------
    -- Tile 4: BATTLE AI
    -- -----------------------------------------------------------------------
    mode_tile(self, {
        x = off_2_cx, y = row_b_cy, w = off_w1, h = row_b_h,
        accent   = C_GOLD,
        top_left = "OFFLINE",
        title    = "BATTLE AI",
        sub      = "Best-of series vs the bot",
        btn_id   = "battle_ai",
    })

    -- -----------------------------------------------------------------------
    -- Tile 5: TOURNAMENT
    -- -----------------------------------------------------------------------
    mode_tile(self, {
        x = off_3_cx, y = row_b_cy, w = off_w3, h = row_b_h,
        accent   = C_GOLD,
        top_left = "OFFLINE",
        title    = "TOURNAMENT",
        sub      = "One human • three AI • bracket",
        btn_id   = "quick_tournament",
    })

    -- -----------------------------------------------------------------------
    -- Utility strip
    -- -----------------------------------------------------------------------
    local util_cy  = EDGE_B + PADDING + util_h / 2
    local has_account = ws.current_user_data
        and ws.current_user_data.username
        and ws.current_user_data.username ~= ""
        
    local util_defs = {
        { id = "rules_open",   label = "RULES"   },
        { id = "share",        label = "SHARE"   },
        { id = "help_open",    label = "HELP"    },
        { id = "contact_open", label = "CONTACT" },
    }
    -- Card themes (Dragon/Batman/etc. skins) are a Matatu-only customization;
    -- Whot ships a single fixed card set, so the button has nothing to open.
    if GameMode.is_matatu() then
        table.insert(util_defs, 4, { id = "theme_open", label = "THEME",
            disabled = not has_account, locked_hint = "SIGN IN", disabled_id = "theme_locked" })
    end
    local n_util  = #util_defs
    local util_tw = math.floor((grid_w - GUTTER * (n_util - 1)) / n_util)

    for i, u in ipairs(util_defs) do
        local ux = grid_l + (i - 1) * (util_tw + GUTTER) + util_tw / 2
        util_tile(self, {
            x = ux, y = util_cy, w = util_tw, h = util_h,
            label = u.label, btn_id = u.id,
            disabled = u.disabled, locked_hint = u.locked_hint, disabled_id = u.disabled_id,
        })
    end

    -- ---------------------------------------------------------------------
    -- Right rail: open team cups (modules/lobby/cups.lua)
    -- ---------------------------------------------------------------------
    if show_rail then
        Cups.draw(self, rail_l, RAIL_W, grid_t)
    else
        self.team_rail_node = nil
    end
    local deco = track(self, gui.new_box_node(vmath.vector3(grid_r + 4, util_cy, 0), vmath.vector3(44, 44, 0)))
    pcall(gui.play_flipbook, deco, hash("diamonds"))
    gui.set_color(deco, vmath.vector4(0.5, 0.5, 0.5, 1))

    -- -----------------------------------------------------------------------
    -- Draw Active Overlays on top of the main Lobby UI
    -- -----------------------------------------------------------------------
    if self.state == STATE_AI_SELECT then
        draw_ai_select(self)
    elseif self.state == STATE_TOURNEY then
        draw_tournament(self)
    elseif self.state == STATE_TEAM_MENU then
        draw_team_menu(self)
    elseif self.state == STATE_TEAM_JOIN then
        draw_team_join(self)
    end

    draw_tutorial(self)
    draw_consent(self)
end

-- ---------------------------------------------------------------------------
-- State machine & Input Handlers
-- ---------------------------------------------------------------------------
local function set_state(self, new_state)
    -- Leaving the JOIN-by-code dialog must drop the device keyboard, whichever
    -- route got us out (BACK, a successful join, or a state change elsewhere);
    -- otherwise the IME stays up over the lobby.
    if self.state == STATE_TEAM_JOIN and new_state ~= STATE_TEAM_JOIN then
        if self.team_join then self.team_join.focus = nil end
        pcall(gui.hide_keyboard)
    end
    self.state = new_state
    rebuild(self)
end

-- Shared by the "play_online" tile tap and the TEAM CUPS menu's
-- "CREATE" option, both of which need the same sign-in-if-needed-then-
-- route-to-online dance before anything else can happen.
local function go_online(self)
    if app_state.auth_state == "sending" or app_state.auth_state == "verifying" then
        return -- Block multiple taps whilst already attempting connection
    end

    local has_account = ws.current_user_data and ws.current_user_data.username and ws.current_user_data.username ~= ""

    -- If they are a guest AND the auth state hasn't succeeded, trigger the Google Play sign in.
    if not has_account and app_state.auth_state ~= "done" then
        app_state.auth_state = "sending"
        msg.post("#controller", "auth_retry_silent_login") -- Re-uses controller's native login routing
        rebuild(self)
    else
        -- Already have an account/authenticated, proceed immediately
        msg.post("#controller", "play_online")
    end
end

local function handle(self, b)
    -- Prevent clicks from falling through the overlays
    if b.id == "consent_block" or b.id == "tut_block" or b.id == "dialog_block" then return end

    if     b.id == "consent_install" then self.consent_phase = "installing"; self._install_t = 0; rebuild(self); return
    elseif b.id == "consent_done"    then self.consent_active = false; rebuild(self); return
    elseif b.id == "consent_later"   then self.consent_active = false; rebuild(self); return
    end

    if     b.id == "tut_skip"   then self.tutorial_active = false; mark_tutorial_seen(); rebuild(self); return
    elseif b.id == "tut_back"   then self.tut_page = math.max(1, (self.tut_page or 1) - 1); rebuild(self); return
    elseif b.id == "tut_next"   then
        if (self.tut_page or 1) >= #TUTORIAL_PAGES then self.tutorial_active = false; mark_tutorial_seen()
        else self.tut_page = (self.tut_page or 1) + 1 end
        rebuild(self); return
    end

    if b.id == "noop" or b.id == "theme_locked" then return end

    if b.id == "help_open" then self.state = STATE_LOBBY; self.tut_page, self.tutorial_active = 1, true; rebuild(self); return
    elseif b.id == "rules_open" then self.state = STATE_LOBBY; self.tut_page, self.tutorial_active = 3, true; rebuild(self); return
    elseif b.id == "support" then pcall(function() local config = require("modules.config"); sys.open_url(config.BASE_URL .. "/support") end); return
    elseif b.id == "share" then pcall(function() local config = require("modules.config"); sys.open_url("https://wa.me/?text=Play%20" .. GameMode.BRAND .. "%20with%20me!%20https%3A%2F%2F" .. config.DOMAIN) end); return
    elseif b.id == "contact_open" then pcall(function()
        local me = ws.current_user_data or {}
        local uname = (me.username and me.username ~= "") and me.username or "Not set"
        local phone = (me.phoneNumber and me.phoneNumber ~= "") and me.phoneNumber or "Not set"
        local acct  = (me._id and me._id ~= "") and me._id or "Unknown"
        local subject = GameMode.BRAND .. " Support"
        local body = "Please describe your issue below:\r\n\r\n\r\n\r\n---\r\nUsername: " .. uname
            .. "\r\nPhone: " .. phone
            .. "\r\nAccount ID: " .. acct
        sys.open_url("mailto:matatu.league@gmail.com?subject=" .. url_encode(subject) .. "&body=" .. url_encode(body))
    end); return
    elseif b.id == "theme_open" then msg.post("#controller", "goto_themes"); return end

    if b.id == "play_online" then
        go_online(self)

    elseif b.id == "quick_play" then
        app_state.mode = "offline"
        local me = ws.current_user_data or {}
        app_state.offline_game = game_logic.new({
            human_id = "you", ai_id = "ai", human_name = me.username or "You", human_avatar = me.avatar or 1,
            ai_name = GameMode.BOT, ai_avatar = 2, rules = "JOKERS", series = 1, p_wins = 0, ai_wins = 0
        })
        msg.post("#controller", "goto_game")
    elseif b.id == "battle_ai"        then set_state(self, STATE_AI_SELECT)
    elseif b.id == "quick_tournament" then set_state(self, STATE_TOURNEY)
    elseif b.id == "back_to_lobby"    then set_state(self, STATE_LOBBY)

    elseif b.id == "ai_series" then app_state.ai_series = b.data; set_state(self, STATE_AI_SELECT)
    elseif b.id == "start_ai" then
        app_state.mode = "offline"
        local me = ws.current_user_data or {}
        app_state.offline_game = game_logic.new({
            human_id = "you", ai_id = "ai", human_name = me.username or "You", human_avatar = me.avatar or 1,
            ai_name = GameMode.BOT, ai_avatar = 2, rules = "JOKERS", series = app_state.ai_series or 3, p_wins = 0, ai_wins = 0
        })
        msg.post("#controller", "goto_game")

    elseif b.id == "t4_mode" then app_state.t4_mode = b.data; set_state(self, STATE_TOURNEY)
    elseif b.id == "chamber_threshold" then app_state.chamber_threshold = b.data; set_state(self, STATE_TOURNEY)
    elseif b.id == "start_tournament" then
        app_state.tournament_size = 4
        app_state.mode = ((app_state.t4_mode or "bracket") == "chamber") and "chamber4" or "tournament4"
        msg.post("#controller", "goto_game")

    elseif b.id == "team_action_open" then
        set_state(self, STATE_TEAM_MENU)

    elseif b.id == "team_cup_start" then
        -- b.data is set when the tap came from a rail card; the tile's own
        -- START has none and falls back to the player's owned cup.
        local cup = b.data and { _id = b.data } or my_owned_cup(self)
        local uid = tostring((ws.current_user_data or {})._id or "")
        if not cup then
            toast.error("Could not find your cup.")
        elseif self.cup_starting then
            return -- already in flight; a second tap must not double-post
        else
            self.cup_starting = true
            api.start_team_tournament(cup._id, uid, function(res)
                self.cup_starting = false
                if res.success then
                    toast.success("Cup started — good luck!")
                    load_team_cups(self)
                else
                    local err = (res.data and res.data.error) or res.message
                        or "Could not start the cup."
                    toast.error(err)
                    -- A refusal is usually "not enough players yet", which the
                    -- refreshed member count on the tile then explains.
                    load_team_cups(self)
                end
            end)
        end

    elseif b.id == "team_cup_delete" then
        -- Deleting refunds the escrowed prize but drops the cup for everyone
        -- who joined, so it takes a second tap to confirm rather than going
        -- through on one.
        local id = tostring(b.data or "")
        local uid = tostring((ws.current_user_data or {})._id or "")
        if id == "" or uid == "" then
            toast.error("Could not find that cup.")
        elseif self.cup_delete_confirm ~= id then
            self.cup_delete_confirm = id
            toast.show("Tap DELETE again to cancel this cup.")
        elseif not self.cup_deleting then
            self.cup_deleting = true
            self.cup_delete_confirm = nil
            api.delete_team_tournament(id, uid, function(res)
                self.cup_deleting = false
                if res.success then
                    local refund = tonumber((res.data or {}).refunded) or 0
                    toast.success(refund > 0
                        and ("Cup deleted — " .. commas(refund) .. " refunded.")
                        or "Cup deleted.")
                    local u = ws.current_user_data or {}
                    if refund > 0 then u.balance = (tonumber(u.balance) or 0) + refund end
                    u.myTeamTournamentId = nil
                    u.myTeamTournamentIsOwner = nil
                    ws.current_user_data = u
                else
                    toast.error((res.data and res.data.error) or res.message
                        or "Could not delete the cup.")
                end
                load_team_cups(self)
            end)
        end

    elseif b.id == "team_standings" or b.id == "team_cup_standings" then
        local id = b.data
        if not id then
            local cup = my_owned_cup(self)
            id = cup and cup._id or (ws.current_user_data or {}).myTeamTournamentId
        end
        if not id or tostring(id) == "" then
            toast.error("No cup to show standings for yet.")
        else
            app_state.standings_cup_id = tostring(id)
            msg.post("#controller", "goto_standings")
        end
    elseif b.id == "team_menu_create" then
        -- The create/edit form is now its OWN screen rather than the
        -- STATE_TEAM_CREATE dialog that used to live here: the dialog had to
        -- size itself from a stack of per-row constants and still overflowed
        -- the 720px canvas once its invite-code keyboard was open. Leaving
        -- app_state.team_edit nil opens a blank CREATE form.
        local has_account = ws.current_user_data and ws.current_user_data.username and ws.current_user_data.username ~= ""
        if not has_account then
            toast.error("Sign in first — tap PLAY ONLINE.")
            return
        end
        app_state.team_edit = nil
        msg.post("#controller", "goto_team_tournament")
    elseif b.id == "team_cup_up" then
        self.team_cups_off = math.max(0, (self.team_cups_off or 0) - 1)
        rebuild(self)
    elseif b.id == "team_cup_down" then
        self.team_cups_off = (self.team_cups_off or 0) + 1
        rebuild(self)
    elseif b.id == "team_cup_join" then
        -- The card carries the tournament's own invitation code, so joining
        -- from the rail reuses the exact same by-code endpoint as typing it.
        local has_account = ws.current_user_data and ws.current_user_data.username
            and ws.current_user_data.username ~= ""
        if not has_account then
            toast.error("Sign in first — tap PLAY ONLINE.")
            return
        end
        local code = tostring(b.data or "")
        if code == "" then
            toast.error("This cup has no invite code — ask the owner.")
            return
        end
        api.join_team_tournament({ userId = ws.current_user_data._id, code = code }, function(res)
            if res.success then
                local t = (res.data or {}).tournament or {}
                local u = ws.current_user_data or {}
                u.myTeamTournamentId = t._id
                ws.current_user_data = u
                toast.success("Joined " .. tostring(t.name or "the team cup") .. "!")
                load_team_cups(self)
            else
                toast.error(res.message or "Could not join that cup.")
            end
        end)
    elseif b.id == "team_menu_join" then
        local has_account = ws.current_user_data and ws.current_user_data.username and ws.current_user_data.username ~= ""
        if not has_account then
            toast.error("Sign in first — tap PLAY ONLINE.")
            return
        end
        self.team_join = { code = "" }
        set_state(self, STATE_TEAM_JOIN)
    elseif b.id == "tj_focus" then
        local tj = self.team_join or { code = "" }
        self.team_join = tj
        tj.focus = true
        tj.msg = nil
        -- KEYBOARD_TYPE_DEFAULT: codes mix letters and digits, so the plain
        -- text IME is right; a numeric pad could not enter them.
        pcall(gui.show_keyboard, gui.KEYBOARD_TYPE_DEFAULT, false)
        rebuild(self)
    elseif b.id == "team_join_submit" then
        local tj = self.team_join or { code = "" }
        self.team_join = tj
        local uid = (ws.current_user_data or {})._id
        if not uid or uid == "" then
            tj.msg, tj.msg_ok = "Sign in first.", false
            rebuild(self)
        elseif tj.code == "" then
            tj.msg, tj.msg_ok = "Enter an invitation code.", false
            rebuild(self)
        elseif not tj.submitting then
            tj.submitting = true
            rebuild(self)
            api.join_team_tournament({ userId = uid, code = tj.code }, function(result)
                local cur = self.team_join
                if not cur then return end
                cur.submitting = false
                if result.success then
                    cur.msg, cur.msg_ok = "Joined! Good luck.", true
                    toast.success("Joined the team cup!")
                    local joined = result.data and result.data.tournament
                    if joined and joined._id then
                        local u = ws.current_user_data or {}
                        u.myTeamTournamentId = joined._id
                        u.myTeamTournamentIsOwner = false
                        ws.current_user_data = u
                    end
                    -- lobby has no self._active flag (see load_team_cups);
                    -- gating on one meant the dialog never repainted, so the
                    -- result message and the JOINING... state never cleared.
                    if self.nodes then rebuild(self) end
                    timer.delay(1.0, false, function()
                        if self.team_join == cur then set_state(self, STATE_LOBBY) end
                    end)
                else
                    local err = (result.data and result.data.error) or result.message or "Could not join. Check the code and try again."
                    cur.msg, cur.msg_ok = err, false
                    toast.error(err)
                    if self.nodes then rebuild(self) end
                end
            end)
        end

    end
end

-- ---------------------------------------------------------------------------
-- Lifecycle
-- ---------------------------------------------------------------------------
function init(self)
    self.nodes, self.buttons = {}, {}
    self.state               = STATE_LOBBY
    self.tut_page            = 1
    self.tutorial_active     = not tutorial_seen()
    self.consent_active      = not akira.installed()
    self.consent_phase       = "ask"
    self._season_tick        = 0

    -- Force idle state on boot so it waits for user interaction
    app_state.auth_state     = "idle"

    refresh_wh()
    update_lobby_season(self)

    if not app_state.ai_series          then app_state.ai_series          = 3        end
    if not app_state.tournament_size    then app_state.tournament_size    = 4        end
    if not app_state.t4_mode            then app_state.t4_mode            = "bracket" end
    -- Seeded from the game's own ladder rather than a flat 200: Whot opens at
    -- 100 (see CAPS_BY_GAME in draw_tourney).
    if not app_state.chamber_threshold then
        app_state.chamber_threshold = GameMode.is_matatu() and 200 or 100
    end

    msg.post(".", "acquire_input_focus")
    rebuild(self)
end

function update(self, dt)
    self._season_tick = (self._season_tick or 0) + dt
    if self._season_tick >= 1 then
        self._season_tick = 0
        local prev = self.season_text
        update_lobby_season(self)
        if self.season_text ~= prev then rebuild(self) end
    end

    if self.consent_active and self.consent_phase == "installing" then
        self._install_t = (self._install_t or 0) + dt
        local p = math.min(1, self._install_t / INSTALL_DURATION)
        if self._install_fill then gui.set_size(self._install_fill, vmath.vector3(math.max(1, 480 * p), 10, 0)) end
        if self._install_pct then gui.set_text(self._install_pct, string.format("%d%%", math.floor(p * 100))) end
        if self._install_status then
            local label = INSTALL_STEPS[1].label
            if     p >= 0.75 then label = INSTALL_STEPS[3].label
            elseif p >= 0.40 then label = INSTALL_STEPS[2].label end
            gui.set_text(self._install_status, label)
        end
        if p >= 1 then
            akira.set_installed()
            self.consent_phase   = "done"
            self._install_fill   = nil
            self._install_pct    = nil
            self._install_status = nil
            rebuild(self)
        end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("screen_enter") then
        -- Force idle state when entering lobby so it always waits for user click
        app_state.auth_state = "idle"
        
        refresh_wh()
        update_lobby_season(self)
        set_state(self, self.state or STATE_LOBBY)
        -- Refreshed on entry rather than polled: coming back from creating or
        -- joining a cup is exactly when the rail is stale.
        load_team_cups(self)
        
    elseif message_id == hash("enable") or message_id == hash("layout_changed") then
        -- No cup refetch here: controller.show() always posts screen_enter
        -- alongside enable, and a mere layout_changed shouldn't hit the network.
        refresh_wh()
        update_lobby_season(self)
        set_state(self, self.state or STATE_LOBBY)
        
    elseif message_id == hash("disable") then
        clear(self)
        
    elseif message_id == hash("auth_state_changed") then
        -- Just repaint. This used to post "play_online" whenever sign-in
        -- completed, which force-navigated to the online screen — fine when
        -- the player had actually tapped PLAY ONLINE, but wrong now that boot
        -- signs in silently on its own: every cold start would have yanked
        -- them off the lobby. The controller already routes the deliberate
        -- case (route_after_auth honours self._explicit_online), so a silent
        -- sign-in correctly leaves the player exactly where they are.
        if app_state.auth_state == "done" then
            app_state.auth_state = "idle"
        end
        rebuild(self) -- Will dynamically change the button text to connection/error states
    end
end

rebuild_ref = rebuild

function on_input(self, action_id, action)
    -- Device keyboard, while the JOIN-by-code field holds focus. Codes are
    -- uppercase alphanumeric, so anything else the IME emits is dropped rather
    -- than sent to a backend that would only reject it.
    local tj = (self.state == STATE_TEAM_JOIN) and self.team_join or nil
    if tj and tj.focus then
        if action_id == hash("text") then
            for ch in tostring(action.text or ""):gmatch("[%a%d]") do
                if #tj.code >= TEAM_CODE_MAX then break end
                tj.code = tj.code .. ch:upper()
            end
            tj.msg = nil
            rebuild(self)
            return true
        elseif action_id == hash("backspace") and (action.pressed or action.repeated) then
            tj.code = tj.code:sub(1, -2)
            tj.msg = nil
            rebuild(self)
            return true
        elseif action_id == hash("enter") and action.pressed then
            handle(self, { id = "team_join_submit" })
            return true
        end
    end

    if action_id ~= hash("touch") then return false end

    -- Drag-to-scroll the team-cup rail. Handled BEFORE the button sweep so a
    -- drag that starts on a JOIN button scrolls instead of joining, but a
    -- clean tap (no accumulated movement) still falls through to the button.
    local rail = self.team_rail_node
    if rail then
        if action.pressed and gui.pick_node(rail, action.x, action.y) then
            self._rail_drag = { moved = 0, acc = 0 }
        elseif self._rail_drag and not action.released then
            local d = self._rail_drag
            local dy = action.dy or 0
            d.moved = d.moved + math.abs(dy)
            d.acc = d.acc + dy
            local step = self.team_rail_step or 94
            -- Dragging UP (negative dy) reveals later entries.
            while d.acc <= -step do
                d.acc = d.acc + step
                self.team_cups_off = (self.team_cups_off or 0) + 1
                rebuild(self)
            end
            while d.acc >= step do
                d.acc = d.acc - step
                self.team_cups_off = math.max(0, (self.team_cups_off or 0) - 1)
                rebuild(self)
            end
            if d.moved > 8 then return true end
        elseif self._rail_drag and action.released then
            local dragged = self._rail_drag.moved > 8
            self._rail_drag = nil
            if dragged then return true end
        end
    end

    if action.pressed then
        for i = #self.buttons, 1, -1 do
            local b = self.buttons[i]
            if b.node and gui.pick_node(b.node, action.x, action.y) then
                handle(self, b)
                return true
            end
        end
    end
    return false
end
