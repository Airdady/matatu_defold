local ws           = require("modules.websocket_manager")
local api          = require("modules.api_service")
local app_state    = require("modules.app_state")
local fbauth       = require("modules.firebase_auth")
local gameservices = require("modules.gameservices")

local SCREENS = { "lobby", "auth", "profile", "online", "themes", "payments", "tournaments", "team_tournament", "standings", "game" }

-- Debug trail for the sign-in/connect pipeline (boot silent-login, "Play
-- Online" tap, Firebase callback, backend verify, WS identify) — every step logs
-- here so a stuck/looping session can be diagnosed from device logs instead
-- of guessed at.
-- Never let the debug trail be the thing that kills the pipeline it is there
-- to explain. A nil where a %d/%f was expected makes string.format raise, and
-- because these calls sit inside handle_auth_result and the retry path, that error
-- unwinds the callback and the retry timer is never scheduled — the app then
-- sits on "connecting..." forever. Logging is best-effort by construction.
local function auth_debug(fmt, ...)
    local ok, line = pcall(string.format, "[AUTH-DEBUG] " .. fmt, ...)
    print(ok and line or ("[AUTH-DEBUG] " .. tostring(fmt) .. " <unformattable args>"))
end

local function show(self, screen)
    if screen ~= "game" then
        pcall(msg.post, "#coins", "coin_clear")
        app_state.mode = "offline"
    end
    for _, s in ipairs(SCREENS) do
        if s == screen then
            msg.post("#" .. s, "enable")
            msg.post("#" .. s, "screen_enter")
        elseif (screen == "payments" or screen == "themes") and s == "online" then
        else
            msg.post("#" .. s, "disable")
        end
    end
    if screen == "game" then
        msg.post("#game_logic", "screen_enter")
    else
        msg.post("#game_logic", "disable")
    end

    -- Every screen here is a gui component on THIS one game object, and
    -- acquire/release_input_focus are game-OBJECT messages: a single screen
    -- releasing drops the whole object off the input stack and kills input
    -- for all of them. Screens each acquire on their own screen_enter, which
    -- leaves the app one stray release away from being completely dead — as
    -- happened when the standings screen released on disable. Re-acquiring
    -- here makes the object's presence on the input stack a property of
    -- routing rather than of any individual screen's behaviour. Posted last
    -- so it lands after the per-screen enable/disable above.
    msg.post(".", "acquire_input_focus")

    self.screen = screen
    app_state.current_screen = screen
end

local function route_after_auth(self)
    local user = ws.current_user_data or {}
    app_state.sync_theme_from_user(user)
    
    if ws.active_game_state and next(ws.active_game_state or {}) ~= nil then
        app_state.mode = "online"
        show(self, "game")
    elseif not app_state.profile_complete(user) then
        show(self, "profile")
    elseif self._explicit_online then
        self._explicit_online = false
        show(self, "online")
    elseif self.screen == "auth" then
        show(self, "online")
    end
end

local function identify_and_connect(user)
    if type(user) ~= "table" then return end
    ws.current_user_data = user
    local token = user.idToken or user.token or ""
    if token ~= "" then api.set_auth_token(token) end
    api.save_session(user)

    local id = user._id or user.localId or ""
    auth_debug("identify_and_connect: id=%s username=%s", tostring(id), tostring(user.username))
    if id ~= "" then
        ws.identify(id, user.username or "Player",
            { amount = user.balance or 0, charge = 0 }, "UG")
    end
    ws.connect()
end

local function is_logged_in()
    return ws.current_user_data and type(ws.current_user_data._id) == "string" and ws.current_user_data._id ~= ""
end

-- Set ONLY by identify_success, cleared by clear_session. This is the app's
-- one true "connected" signal, and it is deliberately not is_logged_in():
-- current_user_data is populated the moment a payload arrives — from a cached
-- session at boot, or from the backend verify — well before the socket has
-- accepted it. Treating that as connected is what let a rejected IDENTIFY
-- read as a success and sit on "connecting..." indefinitely.
--
-- File-local rather than on self, because clear_session() has no self and it
-- is one of the two places that must reset it.
local identify_ok = false

local function clear_session()
    -- The session is gone, so the next connect attempt is a fresh one and the
    -- deadline must be allowed to arm again. Left true, a single successful
    -- identify at boot would disable the deadline for the whole app run.
    identify_ok = false
    ws.current_user_data = nil
    pcall(api.set_auth_token, "")
    pcall(api.save_session, {})
    pcall(ws.disconnect) -- Sever the stale socket connection to prevent rapid-fire auth errors

    -- Deliberately NOT calling fbauth.logout() here. This used to wipe the
    -- cached sign-in state on every auth_required/identify_error (even ones as
    -- mundane as "Connection failed" — a plain network hiccup, not an identity
    -- problem), which forced a full interactive sign-in prompt the next time
    -- regardless of how solid the player's actual login was. Clearing only our
    -- own local session/token is enough to stop a broken identify from
    -- looping; try_silent_login's fbauth.silent_login() can then still succeed
    -- silently next time using the still-valid Firebase session,
    -- re-authenticating in the background exactly as intended, instead of
    -- re-prompting every single time.

    for _, s in ipairs({ "online", "themes", "payments", "tournaments", "profile", "lobby" }) do
        pcall(msg.post, "#" .. s, "user_data_updated")
    end
end

-- Sign-in is ALWAYS silent — there is no manual "SIGN IN" button anywhere in
-- the UI.
--
-- This used to be three attempts 1.5s apart. All three therefore landed
-- inside the same ~5-second window at app start, which is exactly the window
-- most likely to be bad: Play Services still warming up on a cold boot, or
-- the radio still reassociating. After that it set auth_state = "error"
-- permanently, turning the lobby's PLAY NOW into "TRY AGAIN" with nothing
-- ever retrying behind it — the player's only route back was to tap it.
--
-- Google sign-in fails for plenty of reasons that have nothing to do with the
-- player and mostly clear themselves given a little time:
--   * Play Services not yet initialised at cold start (very common)
--   * no network, or a captive portal
--   * Play Services out of date / disabled / missing (some devices, and most
--     emulators)
--   * no Google account on the device at all
--   * a cached credential that has gone stale (account removed, app data
--     cleared) — silent sign-in keeps failing until that cache is dropped
--   * the build's SHA-1 / OAuth client not registered for this package, which
--     fails for EVERY user of that build and is the one case retrying cannot
--     fix — which is why firebase_auth.classify now names it 'broken' and the
--     ladder stops rather than retrying it forever
--
-- So: back off over minutes rather than seconds, keep going, and stay quiet
-- about it. The retry is now open-ended with an exponential delay, and the
-- error state is reserved for a player who actually asked to go online.
-- The first three delays are deliberately short: the phone fallback is offered
-- on the third failure, and it has to land inside the 10 second deadline below
-- rather than after it. 0 + 1 + 2 puts the third attempt around t=3s, leaving
-- room for the round trips themselves. The long tail is for the retries that
-- keep running quietly UNDERNEATH the phone screen, where being patient costs
-- the player nothing.
local SILENT_LOGIN_BACKOFF = { 1, 2, 6, 12, 30, 60 }  -- last entry repeats

-- THE ESCALATION LADDER
--
-- Retrying the same silent sign-in over and over only helps the failures that
-- heal by themselves (Play Services still waking up, no network yet). It does
-- nothing at all for the two that keep coming back in device logs — a cached
-- credential that has gone stale, and a sign-in that succeeds while handing
-- back an empty server auth code. Both reproduce identically forever, because
-- silent_login() replays exactly the state that produced them.
--
-- So each rung does something DIFFERENT rather than the same thing later:
--
--   1..2  retry silent. Covers everything transient, costs nothing.
--   3     full cleanup — drop the local session AND log out of Firebase/Google, so the
--         next silent attempt has no cached anything to replay.
--   4     Google's own interactive sign-in. Once per run. This is the rung
--         that fixes "the cache is not the problem, the account state is":
--         the player picks an account, grants consent, and a real server auth
--         code comes back.
--   5+    offer the phone number instead, and keep retrying silently
--         underneath in case Google sign-in recovers on its own.
--
-- A sign-in that returns NO AUTH CODE skips straight past rung 1: there is
-- nothing transient about it, so it forces a fresh Google session on the spot
-- (see force_fresh_auth_session) instead of waiting three attempts to try the
-- one thing that can change the answer.
local CLEANUP_AFTER_ATTEMPTS = 2
local PHONE_AFTER_ATTEMPTS   = 3

-- A HARD DEADLINE, because counting attempts is not enough.
--
-- An attempt that never calls back is not a failure the ladder can count, so
-- no attempt-based rule can bound it — and that is exactly the shape of the
-- stall being reported: sign-in or the backend verify goes out, nothing comes
-- back, and the counter sits where it is while the lobby reads CONNECTING
-- forever.
--
-- So there are two independent triggers for the phone fallback and whichever
-- fires first wins: PHONE_AFTER_ATTEMPTS failed attempts, or this many
-- seconds of wall clock since connecting began. The clock covers the WHOLE
-- pipeline — Google sign-in, the backend verify, and the socket identify
-- — because a hang anywhere in it looks identical to the player.
local CONNECT_DEADLINE_SECONDS = 10

-- The interactive Google sheet gets its own, much longer window. The 10s rule
-- above is there to bound a player staring at CONNECTING with nothing visibly
-- happening; a player reading an account picker is not in that state, and
-- dropping the phone screen on top of Google's own UI would be worse than the
-- stall. Still bounded, so an abandoned sheet ends somewhere.
local INTERACTIVE_DEADLINE_SECONDS = 60

-- Interactive Google sign-in is NOT on the automatic ladder any more. A sheet
-- the player has to read and tap through cannot fit inside a 10 second budget,
-- and racing it against the phone screen would put two things in front of them
-- at once. It still fires when the player taps PLAY ONLINE — they are present
-- and waiting, so there is no deadline to violate.

-- Clamp at BOTH ends. The upper clamp is the "last entry repeats" rule; the
-- lower one matters just as much, because a caller reaching here with attempt
-- 0 (or nil) would index SILENT_LOGIN_BACKOFF[0] -> nil, and a nil delay both
-- fails to format in the log line and blows up timer.delay. The retry would
-- never be scheduled and sign-in would stall permanently.
local function silent_login_delay(attempt)
    local i = math.max(1, math.min(tonumber(attempt) or 1, #SILENT_LOGIN_BACKOFF))
    return SILENT_LOGIN_BACKOFF[i]
end

-- A retry parked on a timer is not an attempt in flight. Anything that wants
-- to start a fresh attempt right now (the player tapping PLAY ONLINE, focus
-- returning to the app) cancels the pending one first so the two cannot run
-- as a pair.
local function cancel_silent_login_retry(self)
    if self._silent_login_timer then
        pcall(timer.cancel, self._silent_login_timer)
        self._silent_login_timer = nil
    end
end

-- Put the number keypad on screen. No guards at all — this is the routing
-- half, shared by the automatic fallback below and by the player choosing
-- phone sign-in outright from the lobby or the auth screen.
local function show_phone_login(self)
    show(self, "profile")
    -- And tell it to ASK for a number rather than work it out. The profile
    -- screen picks its mode from whether the cached user has an _id, which on
    -- the fallback path it does — the session simply does not work. Without
    -- this it would show the ordinary profile step and the player would still
    -- have no route online. Posted after show() so it lands after
    -- screen_enter's own decide_step.
    msg.post("#profile", "phone_login_required")
end

-- Show the phone number as the way in. Once per run, and never over a session
-- that already works. Returns whether it actually did anything, so callers can
-- log the reason that won rather than guessing.
--
-- This is the AUTOMATIC route only — the app deciding, after the ladder has
-- run out, that Google sign-in is not going to work here. The player asking for it
-- deliberately goes through goto_phone_login below and is subject to none of
-- these guards: "once per run" describes how often the app may interrupt
-- somebody, not how often somebody may choose.
local function offer_phone_login(self, why)
    if self._offered_phone_login then return false end
    -- identify_ok, NOT is_logged_in(). A cached session at boot makes
    -- is_logged_in() true immediately, so guarding on it here would refuse to
    -- offer the fallback on precisely the path that stalls: cached session
    -- present, IDENTIFY rejected, nothing usable behind it.
    if identify_ok then return false end
    self._offered_phone_login = true
    auth_debug("offering phone sign-in — %s", tostring(why))
    show_phone_login(self)
    return true
end

local function cancel_connect_deadline(self)
    if self._connect_deadline_timer then
        pcall(timer.cancel, self._connect_deadline_timer)
        self._connect_deadline_timer = nil
    end
end

-- Armed once when connecting begins and left to run. Deliberately NOT re-armed
-- by each attempt: a deadline that restarts every time the thing it is timing
-- makes another attempt is not a deadline, and would never expire on the exact
-- retry loop it exists to bound.
-- seconds/force are for the interactive sheet: while the player is reading a
-- Google account picker they are not stuck, so the 10s rule would be measuring
-- the wrong thing and would drop the phone screen on top of the sheet.
local function arm_connect_deadline(self, seconds, force)
    if self._connect_deadline_timer and not force then return end
    if self._offered_phone_login then return end
    -- _identify_ok rather than is_logged_in() for the same reason the callback
    -- below uses it: a cached session populates current_user_data before the
    -- socket has accepted it, and that boot-time auto-identify failing is the
    -- exact case in the reported log. is_logged_in() here would decline to arm
    -- the deadline on the one path that most needs it.
    if identify_ok then return end
    cancel_connect_deadline(self)
    local window = tonumber(seconds) or CONNECT_DEADLINE_SECONDS
    auth_debug("arming %ds connect deadline", window)
    self._connect_deadline_timer = timer.delay(window, false, function()
        self._connect_deadline_timer = nil
        -- identify_ok, not is_logged_in(): current_user_data is populated the
        -- moment a payload arrives, well before the socket has accepted it, so
        -- is_logged_in() would call a half-finished connect a success and let
        -- the stall through. Only identify_success means connected.
        if identify_ok then return end
        offer_phone_login(self, string.format("still not connected after %ds", window))
    end)
end

-- Forward-declared, because it and the retry ladder call each other: a
-- failure here re-enters handle_login_failure, and that schedules another
-- try_silent_login. Declared local rather than left global so it does not
-- leak into every other script's environment.
local handle_auth_result

local function try_silent_login(self)
    cancel_silent_login_retry(self)
    arm_connect_deadline(self)
    self._silent_login_inflight = true
    self._silent_login_attempts = (self._silent_login_attempts or 0) + 1
    auth_debug("try_silent_login: attempt %d", self._silent_login_attempts)
    -- Only claim the CTA when the player is actually waiting on this. A
    -- background attempt must leave the lobby reading PLAY NOW.
    if self._explicit_online then
        app_state.auth_state = "sending"
        app_state.auth_error = ""
        msg.post("#lobby", "auth_state_changed")
    end
    -- handle_auth_result is defined below and captured through this forward
    -- local, because the two call each other: a failure here re-enters the
    -- ladder, and the ladder schedules another attempt.
    fbauth.silent_login(function(result) handle_auth_result(self, result) end)
end

-- Invalidate the cached credential so the NEXT silent attempt has to build a
-- new one. Narrower than background_auth_cleanup: it touches the sign-in
-- session only, leaving any local session and socket alone, which is what
-- makes it safe to run on the specific failure where the cache is the known
-- suspect rather than one possibility among many.
--
-- Allowed more than once, but only a couple of times — if two forced refreshes
-- in a row still produce no auth code, the cache was never the problem and
-- the ladder should move on to interactive sign-in rather than keep spending
-- the player's Google session on it.
local MAX_FORCED_REFRESHES = 2
local function force_fresh_auth_session(self)
    local n = (self._forced_refreshes or 0)
    if n >= MAX_FORCED_REFRESHES then return false end
    self._forced_refreshes = n + 1
    auth_debug("force_fresh_auth_session: dropping the cached credential (%d/%d)",
        n + 1, MAX_FORCED_REFRESHES)
    -- Drops the Firebase session AND the Google one behind it, so the next
    -- attempt has to build a credential rather than replay the one that just
    -- failed.
    pcall(fbauth.logout)
    return true
end

-- Drop everything that could be making silent sign-in fail, then retry from
-- clean. Runs at most once per app run: if a stale cached credential is the
-- problem this fixes it, and if it is not, doing it repeatedly just costs the
-- player their session for nothing.
local function background_auth_cleanup(self)
    if self._auth_cleanup_done then return false end
    self._auth_cleanup_done = true
    auth_debug("background_auth_cleanup: clearing local session and auth cache")

    pcall(api.set_auth_token, "")
    pcall(api.clear_session)
    pcall(ws.disconnect)
    -- The one place signing out is the right move. Everywhere else it is
    -- wrong (it forces an interactive prompt next time), but by here silent
    -- sign-in has failed several times in a row and the cached credential is
    -- the most likely culprit — a stale one fails silently forever.
    pcall(fbauth.logout)
    return true
end

-- opts.force_refresh — this failure is one that cannot heal on its own, so
-- invalidate the cached Google credential before the next attempt rather than
-- replaying the state that just produced it.
local function handle_login_failure(self, error_message, opts)
    opts = opts or {}
    local attempts = self._silent_login_attempts or 0
    auth_debug("handle_login_failure: %s (attempt %d)", tostring(error_message), attempts)

    -- This attempt is over. Leaving the flag set — which is what used to
    -- happen on every path except the two below — permanently latched the
    -- app: try_silent_login sets it, nothing cleared it again, and from then
    -- on every PLAY ONLINE tap hit the "already in flight, ignoring duplicate
    -- tap" branch and did nothing at all. The lobby sat on CONNECTING with a
    -- button that no longer responded.
    self._silent_login_inflight = false

    -- The player is waiting: escalate to the interactive sheet rather than
    -- making them watch a silent retry they cannot see. Same rung as 4 below,
    -- reached sooner because someone is actually looking at it.
    local waiting = self._explicit_online and attempts >= 2
    if waiting then
        auth_debug("handle_login_failure: player is waiting, escalating to interactive login")
        self._explicit_online = false
        app_state.auth_state = "sending"
        app_state.auth_error = ""
        msg.post("#lobby", "auth_state_changed")
    end

    -- Rung 0 — this failure cannot heal by itself, so change something before
    -- the next attempt instead of replaying it. Runs immediately, not after a
    -- attempt budget: a sign-in that returns no auth code returns no auth code
    -- every time until the cached credential behind it is gone.
    local forced_before = self._forced_refreshes or 0
    if opts.force_refresh then force_fresh_auth_session(self) end

    -- Rung 3 — >= rather than ==: the counter is reset by explicit taps and by
    -- the identify-error recovery path, so an exact match is a window that can
    -- be stepped straight over. background_auth_cleanup is already once-per-run.
    if attempts >= CLEANUP_AFTER_ATTEMPTS then
        background_auth_cleanup(self)
    end

    -- Google's own sign-in UI.
    --
    -- WHY THIS CANNOT BE OPTIONAL, and why retrying silently is not a fallback
    -- for it: a server auth code is issued against a CONSENT GRANT. Silent
    -- sign-in can only ever re-use a grant that already exists — by
    -- definition it cannot create one, because creating one means showing the
    -- player a screen. So a player who has never granted offline access to
    -- this OAuth client gets, forever:
    --
    --     sign-in SUCCEEDS  (that needs only the app_id)
    --     auth code is EMPTY  (that needs the grant)
    --
    -- which is indistinguishable, from inside the app, from a backend fault.
    -- No number of retries changes it. No amount of clearing caches changes
    -- it. Only the interactive sheet can.
    --
    -- This is what splits users on an IDENTICAL build: whoever has the grant
    -- works, whoever does not never will. Fresh installs, new devices, a new
    -- Google account, cleared app data — all land on the wrong side of
    -- it, which is why it reads as "new users cannot log in".
    --
    -- So a missing auth code escalates here on its own, after one cheap forced
    -- refresh has failed to explain it as a stale token. It does NOT wait for
    -- the player to tap PLAY ONLINE — a first-run player has no reason to
    -- suspect a tap is what is needed, and the previous version of this file
    -- required exactly that.
    --
    -- forced_before, captured above rather than read now: force_fresh_auth_
    -- session has already run for THIS failure, so reading the counter here
    -- would open the sheet in the same pass that dropped the cached token and
    -- never give the cheap fix its one attempt.
    local consent_needed = opts.missing_auth_code and forced_before >= 1

    -- _phone_login_chosen: the player went to the number keypad deliberately
    -- rather than being sent there. Google's sheet must not open on top of a
    -- screen they picked, and the silent retry below must not sign them in as
    -- somebody else while they are still typing.
    local go_interactive = fbauth.available and not identify_ok
        and not self._phone_login_chosen
        and (waiting or (consent_needed and not self._interactive_login_done))

    -- Rung 3 — Google sign-in is not working on this device. Offer the phone
    -- number, rather than retrying silently forever behind a lobby the player
    -- cannot take online. The other trigger for this is the wall-clock
    -- deadline; whichever gets here first wins and the other is a no-op.
    --
    -- Suppressed while Google's sheet is up, in this pass and in the queued
    -- retries behind it: dropping the profile screen on top of an account
    -- picker the player is mid-way through is worse than the wait.
    if attempts >= PHONE_AFTER_ATTEMPTS and not go_interactive
       and not self._interactive_open then
        offer_phone_login(self, string.format("%d failed sign-in attempts", attempts))
    end

    if go_interactive then
        self._interactive_login_done = true
        self._interactive_open = true
        auth_debug("opening interactive Google sign-in (%s) after %d attempts",
            consent_needed and "no auth code — consent cannot be granted silently"
                           or "player is waiting", attempts)
        self._silent_login_inflight = true
        -- No silent retry armed alongside this one. A silent_login() firing
        -- while the player is part-way through Google's own sign-in is a real
        -- hazard — two sign-in flows into one callback — and the ladder does
        -- not need it here: the sheet produces a callback that re-enters this
        -- function, and the deadline below catches the case where it never
        -- does.
        --
        -- Which is why the deadline gets a longer window rather than none. The
        -- 10s rule exists to bound a player staring at CONNECTING with nothing
        -- happening; someone reading an account picker is not in that state.
        cancel_silent_login_retry(self)
        arm_connect_deadline(self, INTERACTIVE_DEADLINE_SECONDS, true)
        fbauth.login(function(result) handle_auth_result(self, result) end)
    elseif self._phone_login_chosen then
        -- The player is on the keypad because they chose to be. Retrying
        -- underneath is what the automatic fallback wants (Google sign-in might
        -- recover), but here it would resolve an argument the player has
        -- already settled — and a silent success routes straight past the
        -- screen they are typing into. PLAY NOW restarts Google sign-in if
        -- they change their mind.
        auth_debug("handle_login_failure: phone sign-in was chosen, standing down")
    else
        -- Keep trying, quietly and for as long as the app is open. Nothing
        -- here sets auth_state = "error": a background attempt that fails is
        -- not something to put in front of the player, and the previous
        -- behaviour of doing so is what left the lobby stuck on TRY AGAIN.
        local delay = silent_login_delay(attempts)
        auth_debug("handle_login_failure: retrying silently in %.1fs", delay)
        cancel_silent_login_retry(self)
        self._silent_login_timer = timer.delay(delay, false, function()
            self._silent_login_timer = nil
            try_silent_login(self)
        end)
    end
end

-- Every sign-in answer, silent or interactive, arrives here.
--
-- It replaces the old GPGS callback, and is a great deal shorter than what it
-- replaces for one reason: there is no longer a second thing that can go wrong
-- after a successful sign-in. GPGS could sign a player in perfectly and then
-- hand back an empty server auth code — a whole failure branch of its own, with
-- its own forced-refresh and its own escalation, because signing in was never
-- the goal; a code the backend could redeem was. Firebase either returns an ID
-- token or it returns a named error. There is no in-between state to handle.
handle_auth_result = function(self, result)
    result = type(result) == "table" and result or
        { success = false, code = "no-result", error = "Sign-in returned nothing" }

    local kind = fbauth.classify(result)
    auth_debug("handle_auth_result: success=%s code=%s kind=%s",
        tostring(result.success), tostring(result.code), kind)

    -- Whatever the outcome, Google's sheet is no longer on screen — this
    -- callback IS its result. Cleared before any branch below so the phone
    -- fallback stops being suppressed the moment the player is back looking at
    -- our own UI.
    self._interactive_open = false

    if not result.success then
        -- THE BUILD IS WRONG, not the device and not the player. A mismatched
        -- OAuth client or a missing config value fails for every user of the
        -- build, and no amount of retrying will change it. The old flow
        -- treated this exactly like a network blip and retried it forever,
        -- quietly, which is why "it just says connecting" had no answer in the
        -- logs. Go straight to the number, and say why in the log.
        if kind == "broken" then
            auth_debug("handle_auth_result: BUILD MISCONFIGURED (%s) — %s",
                tostring(result.code), tostring(result.error))
            self._silent_login_inflight = false
            offer_phone_login(self, "sign-in is not configured for this build")
            return
        end

        -- Nothing is wrong: no account on the device, no cached session, or
        -- the player closed the picker. The ladder still runs, because the
        -- player may be waiting on it, but this is not an error to report.
        handle_login_failure(self, result.error or "Couldn't sign in. Check your connection and try again.")
        return
    end

    -- "" is TRUTHY in Lua, so a bare `if result.id_token then` would send an
    -- empty token to the backend as though it were real and burn the attempt
    -- on a request that could only ever 401.
    local token = result.id_token
    local have_token = type(token) == "string" and token ~= ""
    if not have_token then
        handle_login_failure(self, "Signed in but no token was returned",
            { force_refresh = true })
        return
    end

    -- Fresh budget. Sign-in just proved it works on this device, so a failure
    -- hours from now (token expiry, account switch) deserves the full
    -- escalation again rather than inheriting an exhausted budget from boot.
    self._silent_login_attempts = 0
    self._forced_refreshes = 0
    self._interactive_login_done = false

    app_state.auth_state = "verifying"
    msg.post("#lobby", "auth_state_changed")

    api.firebase_login(token, function(res)
        self._silent_login_inflight = false
        auth_debug("api.firebase_login callback: success=%s message=%s isNewUser=%s",
            tostring(res.success), tostring(res.message),
            tostring(res.data and res.data.isNewUser))

        if res.success and type(res.data) == "table" then
            local user = res.data.user or res.data
            if res.data.token then user.token = res.data.token end
            -- See app_state.phone_complete(): a user matched by their actual
            -- Google identity (not the device/email fallback, not a brand-new
            -- account) has no legacy phone-only account left to migrate, so the
            -- mandatory phone step can skip them entirely.
            user.matchedByGoogleId = res.data.matchedByGoogleId and true or false

            if type(user) == "table" and (user._id or user.localId) then
                identify_and_connect(user)
                if res.data.isNewUser then
                    msg.post("#signup_bonus", "show_signup_bonus", { amount = tonumber(user.balance) or 500 })
                end
                app_state.auth_state = "done"
                msg.post("#lobby", "auth_state_changed")
                route_after_auth(self)
                return
            end
        end

        -- Firebase accepted us but our own backend did not (user deleted
        -- server-side, a 5xx, a dropped request). Wipe the local session so
        -- nothing keeps sending a broken payload, then go back through the
        -- same backed-off retry as every other failure.
        --
        -- force_refresh ONLY on a 4xx, and this is where Firebase is a real
        -- improvement on what it replaces. Under GPGS a 4xx meant the auth
        -- code itself was spent, so the cached Google session had to be
        -- destroyed or the next attempt would reproduce it exactly. A Firebase
        -- ID token is not single-use — a 4xx here means expired or revoked,
        -- and a fresh token is one refresh away rather than a whole new
        -- interactive sign-in.
        local sc = tonumber(res.status_code) or 0
        local token_rejected = sc >= 400 and sc < 500
        clear_session()

        if token_rejected then
            -- Try a refresh before spending the session. Only if that also
            -- fails does the ladder go near dropping the credential.
            auth_debug("backend rejected the token (%d) — refreshing before escalating", sc)
            fbauth.refresh_token(function(refreshed)
                if refreshed and refreshed.success and (refreshed.id_token or "") ~= "" then
                    handle_auth_result(self, refreshed)
                else
                    handle_login_failure(self, res.message or "Backend auth failed",
                        { force_refresh = true })
                end
            end)
            return
        end

        handle_login_failure(self, res.message or "Backend auth failed")
    end)
end

function init(self)
    self.screen = "lobby"
    self.tokens = {}

    -- Keep the screen awake for as long as the app is open, not just during
    -- a match — set once here and never re-enabled (see game.script, which
    -- used to flip this back on leaving the game screen).
    pcall(window.set_dim_mode, window.DIMMING_OFF)

    -- Google Play in-app update check, as early as possible (this is the
    -- app's actual bootstrap script — the sole game object in main.collection,
    -- see game.project's [bootstrap] section). No-ops off Android. Called
    -- again from lobby.gui_script's init as a belt-and-suspenders second
    -- attempt in case Play Services isn't ready yet at this very first call.
    gameservices.check_update()

    for _, s in ipairs(SCREENS) do
        msg.post("#" .. s, "disable")
    end

    -- Re-check whenever the app comes back to the foreground, not just at
    -- cold start. Coming back to the foreground is the single best moment
    -- to retry a failed sign-in: the player has usually just fixed the reason
    -- it failed (turned wifi on, updated Play Services, added an account, or
    -- simply moved somewhere with signal). Without this the retry sits on
    -- its backoff timer, which by then can be a full minute out.
    window.set_listener(function(_, event)
        if event ~= window.WINDOW_EVENT_FOCUS_GAINED then return end

        -- Only when there is no session and nothing already in flight, so this
        -- never piles a second attempt on top of a running one.
        -- Not while the player is on the number keypad by their own choice:
        -- coming back from the SMS app or the contacts list is the most
        -- likely reason focus returns there, and signing them in with Google
        -- at that moment would throw away what they were mid-way through.
        if fbauth.available and not is_logged_in() and not self._silent_login_inflight
           and not self._phone_login_chosen then
            auth_debug("focus regained with no session — retrying silent sign-in")
            try_silent_login(self)
        end
    end)

    local cached = api.load_session()
    if cached and (cached._id or "") ~= "" then
        local token = cached.idToken or cached.token or ""
        if token ~= "" then api.set_auth_token(token) end
        ws.current_user_data = cached

        -- Auto-identify/connect right away using the cached session, so the
        -- player is marked online (registered in the backend's live clients
        -- map) the instant they reach the lobby — no explicit "Play Online"
        -- tap required just to be seen as online, and no fresh login on
        -- every app open since the cached user id (originally resolved via
        -- Google sign-in + this device's id) is reused as-is.
        --
        -- Deliberately NOT setting self._restore_pending here: that flag is
        -- reserved for the "Play Online" tap's explicit reconnect flow
        -- (flips the button to "CONNECTING..." and force-navigates to
        -- "online" once identified) — this boot-time connect stays silent
        -- and must never yank the player off the lobby screen on its own.
        -- If it fails (no network yet, cold start race), the socket layer's
        -- own reconnect backoff retries automatically; nothing here blocks
        -- or gates the lobby UI on the outcome.
        auth_debug("init: cached session found, auto-identifying to mark online")
        -- Armed before the connect, not after: this is the path the reported
        -- stall took — cached session, auto-identify, IDENTIFY rejected, and
        -- then a silent-login rebuild that never landed.
        arm_connect_deadline(self)
        identify_and_connect(cached)

        -- Mandatory profile fields (avatar/username, and phone number for
        -- Matatu) are re-checked against the CACHED data immediately —
        -- no need to wait on the network round trip above. Without this,
        -- closing the app right after signing up and reopening it landed
        -- back on the lobby and silently skipped the still-incomplete
        -- profile/phone step, since the boot-time connect above
        -- deliberately never force-navigates on its own (see the comment
        -- above it) — this check is what makes an incomplete profile
        -- un-bypassable across a cold restart, not just within one session.
        if not app_state.profile_complete(cached) then
            show(self, "profile")
        else
            show(self, "lobby")
        end
    else
        -- No local session cached: sign in SILENTLY right now. Sign-in in
        -- this app is always automatic — there is no manual "SIGN IN" button
        -- anywhere in the UI — so waiting for a "Play Online" tap left a
        -- fresh install with no session at all, and every authenticated call
        -- it made in the meantime went out with no user behind it.
        -- try_silent_login retries on its own and gives up quietly, so this
        -- can never block or gate the lobby.
        auth_debug("init: no cached session, starting silent sign-in")
        show(self, "lobby")
        if fbauth.available then
            try_silent_login(self)
        else
            -- Firebase sign-in is not available at all: an editor/desktop run,
            -- or a build where the extension failed to initialise. There is
            -- nothing to retry, so go straight to the phone sign-in rather
            -- than sitting signed out forever.
            offer_phone_login(self, "Google sign-in is not available on this device")
        end
    end

    local function forward(evt, target, notification)
        table.insert(self.tokens, ws.on(evt, function()
            msg.post(target, notification)
        end))
    end

    table.insert(self.tokens, ws.on("identify_success", function()
        self._identify_recoveries = 0
        -- The only signal that means CONNECTED. Everything earlier — a token,
        -- a user payload, a socket that opened — can still be followed by a
        -- rejection, so the deadline stays armed until this fires.
        identify_ok = true
        cancel_connect_deadline(self)
        if self._restore_pending then
            self._restore_pending = false
            app_state.auth_state = "idle"
            msg.post("#lobby", "auth_state_changed")
            route_after_auth(self)
            return
        end
        -- Repaint the lobby even on the silent path. Only the explicit
        -- "Play Online" flow above used to, which was harmless while nothing
        -- on the tile depended on being connected — but the LOGIN WITH PHONE
        -- backup is shown until ws.is_identified, so without this a player
        -- who signed in silently at boot would keep being offered a second
        -- way to sign in until something else happened to rebuild.
        msg.post("#lobby", "auth_state_changed")

        -- Silent boot-time identify (no explicit "Play Online" tap): still
        -- auto-resume an in-progress game. IDENTIFY's own response already
        -- carries the active game state when there is one (see
        -- websocket_manager.lua, ws.active_game_state gets set from it
        -- directly), so this needs no extra round trip — closing the app
        -- mid-game and reopening it should drop the player straight back
        -- into that game, never onto the lobby waiting for another tap.
        if self.screen ~= "game" and ws.active_game_state and next(ws.active_game_state or {}) ~= nil then
            app_state.mode = "online"
            show(self, "game")
        end
    end))

    local function intercept_for_search(self_)
        if app_state.searching_tournament and self_.screen == "tournaments" then
            app_state.searching_tournament = false
            pcall(msg.post, "#snd_suspense", "stop_sound")
            pcall(msg.post, "#snd_found", "play_sound")
            msg.post("#tournaments", "ws_match_found")
            timer.delay(1.8, false, function()
                if self_.screen == "tournaments" then show(self_, "game") end
            end)
            return true
        end
        if app_state.searching_invite and self_.screen == "online" then
            app_state.searching_invite = false
            msg.post("#online", "ws_match_found")
            timer.delay(1.8, false, function()
                if self_.screen == "online" then show(self_, "game") end
            end)
            return true
        end
        return false
    end

    table.insert(self.tokens, ws.on("game_start", function(gs)
        if type(gs) == "table" and next(gs) ~= nil then ws.active_game_state = gs end
        app_state.mode = "online"
        if intercept_for_search(self) then return end
        if self.screen ~= "game" then show(self, "game") else msg.post("#game_logic", "ws_new_game_start") end
    end))

    table.insert(self.tokens, ws.on("game_request_accepted", function(gs)
        if type(gs) == "table" and next(gs) ~= nil then ws.active_game_state = gs end
        app_state.mode = "online"
        if intercept_for_search(self) then return end
        local is_round_continuation = (self.screen == "game") and app_state.game_active
        if self.screen ~= "game" then show(self, "game") else msg.post("#game_logic", "ws_new_game_start") end
        if not is_round_continuation then
            local stake = (type(gs) == "table" and type(gs.stake) == "table" and tonumber(gs.stake.amount)) or 500
            -- A zero-stake game (AI trial battle, free match) has no real pot
            -- to show — skip the bundle entirely instead of sitting a "0
            -- coins" bundle on screen for the whole game.
            if stake > 0 then
                pcall(msg.post, "#coins", "coin_collect_pot", {
                    amount  = stake * 2,
                    sources = { { x = 150, y = 64 }, { x = 150, y = 656 } },
                    center  = { x = 640, y = 360 },
                })
                -- Keep in sync with main/coins.gui_script's POT_REST_X.
                pcall(msg.post, "#coins", "coin_pot_to", { x = 220, y = 360 })
            end
        end
    end))

    local function broadcast(evt)
        table.insert(self.tokens, ws.on(evt, function(user)
            -- Persist the freshest server data to the local session cache
            -- every time it changes, not just at the 4 explicit action
            -- points (login, phone-link, profile save, logout) that used to
            -- be the only callers of api.save_session. Without this, a game
            -- result, coin purchase, or any other backend-driven balance/
            -- points/rank change only ever updated the in-memory
            -- ws.current_user_data — the on-disk cache kept whatever was
            -- last explicitly saved, so the next cold start's silent
            -- auto-identify re-seeded ws.current_user_data from that same
            -- increasingly stale snapshot instead of the real current state.
            local fresh = user or ws.current_user_data
            if type(fresh) == "table" and (fresh._id or "") ~= "" then
                pcall(api.save_session, fresh)
            end

            for _, s in ipairs({ "online", "themes", "payments", "tournaments", "profile" }) do
                msg.post("#" .. s, "user_data_updated")
            end
            -- The game screen has no generic user_data_updated handler (it's
            -- driven message-by-message, not a full refresh-on-demand like
            -- the others) — forward just the balance/rank fields it does
            -- understand so the on-board balance goes live the moment the
            -- backend pushes a fresh one (e.g. right after a new game's
            -- stake is deducted), instead of only updating at screen_enter
            -- or when the round/match ends.
            user = user or ws.current_user_data or {}
            if user.balance ~= nil or user.rank ~= nil then
                msg.post("#game_logic", "ws_user_data_updated", { balance = user.balance, rank = user.rank })
            end
        end))
    end
    broadcast("user_updated")

    -- Successful DEPOSIT gets the full celebration instead of a silent
    -- refresh: close the payments dialog, then shower coins up from the
    -- bottom of the screen into the BAL display (coin sound per landing)
    -- while the balance figure itself counts up coin by coin — the coins
    -- overlay owns that stepped count-up and fires the final
    -- user_data_updated broadcast itself once the exact total lands (see
    -- coin_deposit in main/coins.gui_script). Everything else (withdrawals,
    -- failed/refunded transactions) keeps the plain instant refresh.
    table.insert(self.tokens, ws.on("transaction_completed", function(d)
        d = type(d) == "table" and d or {}
        local new_bal = tonumber(d.newBalance)
        local on_money_screens = (self.screen == "payments" or self.screen == "online")
        if tostring(d.type or "") == "buy" and new_bal and on_money_screens then
            local old_bal = tonumber((ws.current_user_data or {}).balance) or 0
            local gained = new_bal - old_bal
            if self.screen == "payments" then show(self, "online") end
            if gained > 0 then
                pcall(msg.post, "#coins", "coin_deposit", {
                    amount = gained, from_balance = old_bal, to_balance = new_bal,
                })
                return
            end
        end
        for _, s in ipairs({ "online", "themes", "payments", "tournaments", "profile" }) do
            msg.post("#" .. s, "user_data_updated")
        end
        if new_bal then
            msg.post("#game_logic", "ws_user_data_updated", { balance = new_bal })
        end
    end))

    table.insert(self.tokens, ws.on("tournament_no_opponents", function(d)
        pcall(msg.post, "#snd_suspense", "stop_sound")
        pcall(msg.post, "#snd_fail", "play_sound")
        local reason = (type(d) == "table" and d.message) or "No opponents available right now"
        if app_state.searching_invite then msg.post("#online", "ws_search_failed", { reason = reason }) else msg.post("#tournaments", "ws_search_failed", { reason = reason }) end
    end))

    table.insert(self.tokens, ws.on("head_to_head", function() msg.post("#online", "ws_head_to_head") end))

    forward("online_users",           "#online", "ws_online_users")
    forward("rank_update",            "#online", "ws_rank_update")
    forward("connected",              "#online", "ws_connected")
    forward("disconnected",           "#online", "ws_disconnected")
    forward("identify_success",       "#online", "ws_identify")
    forward("connection_error",       "#online", "ws_error")
    forward("game_request",           "#online", "ws_game_request")
    forward("game_request_declined",  "#online", "ws_request_declined")
    forward("game_request_cancelled", "#online", "ws_request_cancelled")
    forward("savings_status",           "#online", "ws_savings_status")
    forward("savings_exchange_result",  "#online", "ws_savings_exchange_result")
    forward("savings_settings_updated", "#online", "ws_savings_settings_updated")

    -- The other half of showing LOGIN WITH PHONE until ws.is_identified: a
    -- drop clears that flag, and a player sitting on the lobby when it happens
    -- needs the backup back. Only "#online" was told before, which is the one
    -- screen they are not on.
    forward("disconnected",           "#lobby", "auth_state_changed")

    forward("savings_status",           "#payments", "ws_savings_status")
    forward("savings_exchange_result",  "#payments", "ws_savings_exchange_result")
    forward("savings_settings_updated", "#payments", "ws_savings_settings_updated")

    table.insert(self.tokens, ws.on("auth_required", function()
        clear_session()
        -- An expired session is precisely what a silent sign-in fixes, and it
        -- needs no input from the player. This used to stop dead on
        -- "Session expired. Try again." with nothing retrying behind it, so
        -- the only way back was for the player to notice the CTA had changed
        -- and tap it. Rebuild in the background instead.
        if fbauth.available then
            self._silent_login_attempts = 0
            try_silent_login(self)
        end
        msg.post("#lobby", "auth_state_changed")
        if self.screen ~= "lobby" then show(self, "lobby") end
    end))
    -- A failed IDENTIFY means the cached id is no good to the server (stale
    -- session from a reinstall/another environment, or a reply that never
    -- came). Clearing it is only half the job: sign-in here is always
    -- automatic, so re-run the silent login straight away and rebuild a
    -- valid session, rather than leaving the player signed out with a
    -- CONNECTING screen and no button to press. Bounded so a server that
    -- rejects every identify can't spin.
    local MAX_IDENTIFY_RECOVERIES = 2
    table.insert(self.tokens, ws.on("identify_error", function()
        clear_session()
        self._identify_recoveries = (self._identify_recoveries or 0) + 1
        if fbauth.available and self._identify_recoveries <= MAX_IDENTIFY_RECOVERIES then
            auth_debug("identify_error: rebuilding session via silent login (%d/%d)",
                self._identify_recoveries, MAX_IDENTIFY_RECOVERIES)
            self._silent_login_attempts = 0
            try_silent_login(self)
        elseif fbauth.available then
            -- Past the fast-recovery budget. The cap exists so a server that
            -- rejects every identify cannot spin — it does NOT mean give up:
            -- hand over to the backed-off silent retry, which is slow enough
            -- to be harmless and keeps running for as long as the app is open.
            auth_debug("identify_error: past fast recovery, handing to backoff retry")
            background_auth_cleanup(self)
            timer.delay(silent_login_delay(CLEANUP_AFTER_ATTEMPTS), false, function()
                try_silent_login(self)
            end)
        end
        if self.screen ~= "lobby" then show(self, "lobby") end
    end))

    forward("resync",                "#game_logic", "ws_resync")
    forward("game_move",             "#game_logic", "ws_game_move")
    forward("game_over",             "#game_logic", "ws_game_over")
    forward("round_complete",        "#game_logic", "ws_round_complete")

    table.insert(self.tokens, ws.on("player_disconnected", function(info)
        info = info or {}
        msg.post("#game_logic", "ws_player_dc", { grace = info.grace or 30, player_id = info.player_id or "" })
    end))
    table.insert(self.tokens, ws.on("player_reconnected", function(info)
        info = info or {}
        -- Carry the fresh gameState PLAYER_RECONNECTED delivers along with it —
        -- without it game.script falls back to its own stale pre-disconnect
        -- game_state (expired turnExpiresAt), which is why the turn-timer pie
        -- ends up stuck invisible after a reconnect (see ws_player_rc there).
        msg.post("#game_logic", "ws_player_rc", { player_id = info.player_id or "", state = info.state })
    end))

    table.insert(self.tokens, ws.on("disconnected",      function() msg.post("#game_logic", "ws_net_down") end))
    table.insert(self.tokens, ws.on("connected",         function() msg.post("#game_logic", "ws_net_up") end))
    table.insert(self.tokens, ws.on("reconnect_failed",  function() msg.post("#game_logic", "ws_net_failed") end))

    table.insert(self.tokens, ws.on("emoji", function(sender, content, sound)
        msg.post("#game_logic", "ws_emoji", { sender = sender or "", emoji = content or "joy", sound = sound or "" })
    end))

    table.insert(self.tokens, ws.on("ai_played_for_you", function(info)
        info = info or {}
        msg.post("#game_logic", "ws_ai_played", { mode = info.mode or "SINGLE_MOVE", moves = info.moves or 0, max = info.max or 3 })
    end))

    table.insert(self.tokens, ws.on("game_request_declined", function(reason)
        msg.post("#game_logic", "ws_replay_declined", { reason = tostring(reason or "Declined") })
        if app_state.searching_tournament or app_state.searching_invite then
            pcall(msg.post, "#snd_suspense", "stop_sound")
            pcall(msg.post, "#snd_fail", "play_sound")
        end
        if app_state.searching_invite then msg.post("#online", "ws_search_failed", { reason = tostring(reason or "Declined") }) else msg.post("#tournaments", "ws_search_failed", { reason = tostring(reason or "Declined") }) end
    end))
end

function on_message(self, message_id, message, sender)
    if message_id == hash("goto_lobby") then
        -- Leaving the keypad ends the choice that stood Google sign-in down. It
        -- does not restart sign-in by itself — nothing is scheduled any more —
        -- but PLAY NOW and the next return to the foreground are free to try
        -- again, which is what stops backing out of phone login from leaving
        -- the player signed out with nothing working behind the lobby.
        self._phone_login_chosen = false
        show(self, "lobby")
    elseif message_id == hash("goto_game") then show(self, "game")
    elseif message_id == hash("goto_online") then
        if is_logged_in() then show(self, "online") else show(self, "lobby") end
    elseif message_id == hash("goto_themes") then
        if is_logged_in() then show(self, "themes") else show(self, "lobby") end
    elseif message_id == hash("goto_payments") then
        if is_logged_in() then show(self, "payments") else show(self, "lobby") end
    elseif message_id == hash("goto_tournaments") then
        if is_logged_in() then show(self, "tournaments") else show(self, "lobby") end
    elseif message_id == hash("goto_team_tournament") then
        -- Full-screen create/edit form for a team tournament. The caller sets
        -- app_state.team_edit beforehand to open in EDIT mode; leaving it nil
        -- opens a blank CREATE form.
        if is_logged_in() then show(self, "team_tournament") else show(self, "lobby") end
    elseif message_id == hash("goto_standings") then
        -- Interactive bracket/standings for one team cup. The caller sets
        -- app_state.standings_cup_id beforehand.
        if is_logged_in() then show(self, "standings") else show(self, "lobby") end
    elseif message_id == hash("goto_profile") then
        if is_logged_in() then show(self, "profile") else show(self, "lobby") end
    elseif message_id == hash("goto_auth") then show(self, "auth")

    elseif message_id == hash("goto_phone_login") then
        -- The player picked the number instead of Google. This is an
        -- auth method in its own right, not a fallback, so none of the
        -- fallback's guards apply: not "once per run", not "only if Google
        -- has already failed", not "only if there is no session".
        auth_debug("goto_phone_login: player chose phone sign-in")
        self._phone_login_chosen = true
        -- Nothing armed behind this screen. A parked silent retry firing
        -- while they type would either navigate them away mid-entry or drop
        -- the automatic fallback on top of the screen they already asked for.
        cancel_silent_login_retry(self)
        cancel_connect_deadline(self)
        self._offered_phone_login = true
        self._explicit_online = false
        app_state.auth_state = "idle"
        msg.post("#lobby", "auth_state_changed")
        show_phone_login(self)

    elseif message_id == hash("play_online") then
        self._explicit_online = true
        -- Tapping PLAY NOW is how a player changes their mind back: Firebase
        -- is live again from here, including the retries the phone
        -- choice stood down.
        self._phone_login_chosen = false
        auth_debug("play_online tapped: user_id=%s socket_connected=%s is_identified=%s inflight=%s",
            tostring(ws.current_user_data and ws.current_user_data._id), tostring(ws.socket_connected),
            tostring(ws.is_identified), tostring(self._silent_login_inflight))
            
        if ws.current_user_data and (ws.current_user_data._id or "") ~= "" then
            if ws.socket_connected and ws.is_identified then
                route_after_auth(self)
            elseif ws.socket_connected then
                -- Socket is up but the IDENTIFY round-trip that just got
                -- queued/sent in on_connected() hasn't come back yet (a real
                -- window seen in device logs: "connected" then a tap ~700ms
                -- later still shows is_identified=false). Routing to "online"
                -- on socket_connected alone would drop the player into the
                -- lobby before the server has actually registered them,
                -- making the game look "connected" while requests/matches
                -- silently fail. Wait for the same identify_success signal
                -- the not-yet-connected branch below already waits on.
                self._restore_pending = true
                app_state.auth_state = "verifying"
                msg.post("#lobby", "auth_state_changed")
                -- Both of these branches sit on identify_success, which is
                -- exactly the signal that can fail to arrive. The deadline is
                -- what stops CONNECTING... from being permanent.
                arm_connect_deadline(self)
            else
                self._restore_pending = true
                -- Visually switch the lobby button to "CONNECTING..."
                app_state.auth_state = "verifying"
                msg.post("#lobby", "auth_state_changed")
                arm_connect_deadline(self)
                -- ACTUALLY trigger the connection now that the button was tapped
                identify_and_connect(ws.current_user_data)
            end
            return
        end
        -- The tap on "Play Online" IS the trigger for sign-in — no separate
        -- auth screen/dialog is shown for this. The player stays exactly
        -- where they are while handle_auth_result resolves in the background;
        -- once identify_and_connect succeeds, route_after_auth() (called
        -- from handle_auth_result) takes them straight to "online" since
        -- self._explicit_online is already set above.
        if fbauth.available then
            if self._silent_login_inflight then
                auth_debug("play_online: a silent-login attempt is already in flight, ignoring duplicate tap")
            else
                self._silent_login_attempts = 0
                try_silent_login(self)
            end
        else
            auth_debug("play_online: Firebase auth not available on this device")
        end

    elseif message_id == hash("google_signin") then
        -- The account picker, asked for by name.
        --
        -- Deliberately NOT routed through try_silent_login. A silent attempt
        -- is the thing that has already failed by the time anybody taps this,
        -- and it cannot create the consent grant the interactive flow exists
        -- to obtain — retrying it reproduces the same nothing. This is also
        -- the only route in on a device where no Google account is signed in
        -- yet, because the picker is where one gets added.
        if fbauth.available then
            self._phone_login_chosen = false
            self._interactive_open = true
            self._interactive_login_done = true
            self._silent_login_inflight = true
            self._silent_login_attempts = 0
            self._forced_refreshes = 0
            app_state.auth_state = "sending"
            app_state.auth_error = ""
            msg.post("#lobby", "auth_state_changed")
            cancel_silent_login_retry(self)
            arm_connect_deadline(self, INTERACTIVE_DEADLINE_SECONDS, true)
            fbauth.login(function(result) handle_auth_result(self, result) end)
        else
            auth_debug("google_signin: Firebase auth not available on this device")
            offer_phone_login(self, "Google sign-in is not available on this device")
        end

    elseif message_id == hash("auth_retry_silent_login") then
        -- The only tappable thing on the auth screen (shown only for the
        -- auth_required/identify_error recovery path, not for play_online):
        -- retries the same silent flow with a fresh budget — never a
        -- manual/interactive Google sign-in prompt.
        if fbauth.available and not self._silent_login_inflight then
            self._phone_login_chosen = false
            self._silent_login_attempts = 0
            try_silent_login(self)
        end

    elseif message_id == hash("auth_cancel") then
        app_state.auth_state = "idle"
        msg.post("#lobby", "auth_state_changed")
        show(self, "lobby")

    elseif message_id == hash("phone_login") then
        -- Sign in by phone number — the way in when Google sign-in cannot
        -- work at all. No code, no second step: the server validates the
        -- number, finds or creates the account, and answers with a session.
        -- Two possible answers now, signed in or an error.
        local phone = message.phoneNumber or ""
        if phone == "" then
            msg.post("#profile", "phone_link_result", { ok = false, message = "Enter a phone number." })
            return
        end
        auth_debug("phone_login: signing in with %s", phone)
        api.phone_login({ phoneNumber = phone }, function(result)
            local data = type(result.data) == "table" and result.data or {}
            if result.success and data.token then
                local user = type(data.user) == "table" and data.user or {}
                user.token = data.token
                auth_debug("phone_login: signed in (new=%s)", tostring(data.isNewUser))
                -- Stop the background retry: we have a session now, and
                -- a silent sign-in landing later would replace this one. The
                -- parked timer has to be cancelled too — clearing the flags
                -- alone leaves a retry still scheduled to fire.
                cancel_silent_login_retry(self)
                self._silent_login_attempts = 0
                self._silent_login_inflight = false
                -- The choice has been honoured. If THIS session goes wrong
                -- later the ordinary ladder should be free to run again.
                self._phone_login_chosen = false
                pcall(ws.disconnect)
                identify_and_connect(user)
                app_state.auth_state = "done"
                msg.post("#lobby", "auth_state_changed")
                msg.post("#profile", "phone_link_result", { ok = true })
                route_after_auth(self)
                return
            end
            msg.post("#profile", "phone_link_result",
                { ok = false, message = result.message or "Could not sign in with that number." })
        end)

    elseif message_id == hash("link_phone") then
        local phone = message.phoneNumber or ""
        if phone == "" then
            msg.post("#profile", "phone_link_result", { ok = false, message = "Enter a phone number." })
            return
        end
        api.link_phone({ phoneNumber = phone }, function(result)
            if result.success and type(result.data) == "table" then
                local data = result.data
                local merged_user = type(data.user) == "table" and data.user or {}
                if data.merged then
                    if data.token then merged_user.token = data.token end
                    -- Account identity changed to the OLD (now-linked)
                    -- account — cleanly drop the current socket (still
                    -- identified server-side as the just-superseded
                    -- duplicate) and reconnect fresh as the migrated
                    -- account, exactly like a normal login.
                    pcall(ws.disconnect)
                    identify_and_connect(merged_user)
                else
                    -- No old account found — the phone number was just
                    -- saved onto the current (already-authenticated)
                    -- account; merge the returned fields in without
                    -- touching the session identity.
                    local u = ws.current_user_data or {}
                    for k, v in pairs(merged_user) do u[k] = v end
                    ws.current_user_data = u
                    api.save_session(u)
                end
                msg.post("#profile", "phone_link_result", { ok = true, merged = data.merged and true or false })
            else
                msg.post("#profile", "phone_link_result", { ok = false, message = result.message or "Could not link phone number." })
            end
        end)

    elseif message_id == hash("profile_save") then
        local user = ws.current_user_data or {}
        local payload = {
            username    = message.username,
            avatar      = message.avatar,
            phoneNumber = user.phoneNumber or user.phone or "",
        }
        local uid = user._id or user.localId or ""
        api.update_profile(uid, payload, function(result)
            if result.success then
                local data = result.data or {}
                local merged = data.user or data.data or data
                if type(merged) ~= "table" then merged = {} end
                for k, v in pairs(merged) do user[k] = v end
                user.username    = message.username
                user.avatar      = message.avatar
                ws.current_user_data = user
                api.save_session(user)

                for _, s in ipairs({ "online", "themes", "payments", "tournaments", "profile", "lobby" }) do
                    msg.post("#" .. s, "user_data_updated")
                end
                app_state.username_suggestions = {}
                msg.post("#profile", "profile_saved", { ok = true })
                show(self, "online")
            else
                local rdata = result.data
                app_state.username_suggestions = (type(rdata) == "table" and rdata.suggestions) or {}
                msg.post("#profile", "profile_saved", { ok = false, message = result.message or "Save failed" })
            end
        end)

    elseif message_id == hash("theme_purchase") then
        local uid = (ws.current_user_data or {})._id or ""
        api.purchase_theme(uid, message.theme_id, function(result)
            msg.post("#themes", "theme_action_result", { ok = result.success, message = result.message })
        end)
    elseif message_id == hash("theme_switch") then
        local uid = (ws.current_user_data or {})._id or ""
        api.switch_theme(uid, message.theme_id, function(result)
            if result.success then app_state.theme = message.theme_id end
            msg.post("#themes", "theme_action_result", { ok = result.success, message = result.message })
        end)

    elseif message_id == hash("submit_payment") then
        local user = ws.current_user_data or {}
        local payload = { phoneNumber = message.phone, amount = message.amount, type = message.ptype, _id = user._id or "" }
        api.send_transaction(payload, function(result) msg.post("#payments", "payment_result", { ok = result.success, message = result.message }) end)

    elseif message_id == hash("validate_phone") then
        -- Realtime name-enquiry for the payments dialog: ask the backend who owns
        -- this number so we can show the name before any money moves.
        local user = ws.current_user_data or {}
        local phone = message.phone
        api.validate_phone({ phoneNumber = phone, _id = user._id or "" }, function(result)
            local d = result.data or {}
            msg.post("#payments", "phone_validated", {
                phone   = phone,
                valid   = d.valid == true,
                names   = d.names or "",
                message = d.message or result.message or "",
            })
        end)

    elseif message_id == hash("remove_phone") then
        -- Delete a saved number from the account; refresh local cache from the
        -- server's authoritative list.
        local user = ws.current_user_data or {}
        api.delete_phone({ _id = user._id or "", phoneNumber = message.phone }, function(result)
            local d = result.data or {}
            if result.success and type(d.phoneNumbers) == "table" then
                ws.current_user_data.phoneNumbers = d.phoneNumbers
                ws.current_user_data.phoneNumber = d.phoneNumber
            end
            msg.post("#payments", "user_data_updated")
        end)

    elseif message_id == hash("tournament_play") then
        pcall(msg.post, "#snd_suspense", "play_sound")
        ws.send_game_request({}, message.stake, { gameType = "TOURNAMENT", tournamentId = message.tournament_id, tournamentName = message.tournament_name, rules = "JOKERS" })

    elseif message_id == hash("connect_online") then
        if not ws.socket_connected then ws.connect() end
    elseif message_id == hash("disconnect_online") then
        ws.disconnect()
    end
end

function final(self)
    for _, t in ipairs(self.tokens) do ws.off(t) end
end