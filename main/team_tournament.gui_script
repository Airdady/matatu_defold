-- team_tournament.gui_script — full-screen CREATE / EDIT for a team cup.
--
-- Replaces the cramped STATE_TEAM_CREATE dialog that used to live inside
-- lobby.gui_script. That panel sized itself from a stack of per-row constants
-- and still overflowed the 720px canvas once its invite-code keyboard was
-- expanded, which is why that keyboard had to be collapsible and SUBMIT kept
-- sliding off-screen.
--
-- Text entry uses the DEVICE keyboard (gui.show_keyboard + the "text" /
-- "backspace" input actions), not a hand-drawn QWERTY grid: the native IME
-- brings autocorrect, long-press accents and the user's own layout, and it
-- frees the canvas the fake keyboard used to eat.
--
-- Visual language follows profile.gui_script for consistency: flat luxury-dark
-- base, "texture_bg" cover image, 3-stripe header divider, and layered
-- three-border panels/buttons drawn from plain boxes — deliberately NO
-- slice-9 button artwork (ui.btn9), so every control is crafted here.
--
-- Game-agnostic: matatu, whot and kadi all route here. Only the currency
-- label, prize step and the `rules` value sent to the backend differ.
--
-- FIELDS — mirror POST /tournaments/team (be_matatu
-- common/controllers/tournament.controller.js createTeamTournament):
--   userId          required  — the owner, taken from the session
--   grandPrizeCoins required  — > 0 and <= owner balance (escrowed on create)
--   name            optional  — defaults to 'Team Cup' server-side
--   maxPlayers      optional  — clamped 2..128, default 8
--   gamesPerLevel   optional  — must be 1 | 3 | 5, default 3
--   invitationCode  optional  — 3-16 A-Z0-9, must be unique; blank = generated
--   inviteUsernames optional  — unknown names come back as notFoundUsernames
--   rules           optional  — per game

local ui        = require("modules.ui")
local app_state = require("modules.app_state")
local ws        = require("modules.websocket_manager")
local api       = require("modules.api_service")
local screen    = require("modules.screen")
local toast     = require("modules.toast")
local GameMode  = require("modules.game_mode")

local LOGICAL_W, LOGICAL_H = 1280, 720
local VISIBLE_W, VISIBLE_H = 1280, 720
local CX, CY = 640, 360
local EDGE_L, EDGE_R, EDGE_B, EDGE_T = 0, 1280, 0, 720

-- Palette lifted from profile.gui_script so the two screens read as one system.
local P_BG        = vmath.vector4(0.042, 0.033, 0.027, 1)
local P_PANEL     = vmath.vector4(0.082, 0.063, 0.051, 1)
local P_GOLD      = vmath.vector4(0.784, 0.573, 0.165, 1)
local P_GOLD_LIGHT= vmath.vector4(0.941, 0.753, 0.376, 1)
local P_CREAM     = vmath.vector4(0.957, 0.925, 0.843, 1)
local P_MUTED     = vmath.vector4(0.455, 0.400, 0.325, 1)
local P_BADGE_BG  = vmath.vector4(0.157, 0.118, 0.078, 1)
local P_B_OUTER   = vmath.vector4(0.027, 0.020, 0.016, 1)
local P_B_MID     = vmath.vector4(0.012, 0.008, 0.008, 1)
local P_ERROR     = vmath.vector4(0.820, 0.231, 0.231, 1)
local P_SUCCESS   = vmath.vector4(0.275, 0.624, 0.388, 1)
local P_DARK_TXT  = vmath.vector4(0.06, 0.045, 0.02, 1)
local P_TRANSP    = vmath.vector4(0, 0, 0, 0)

local STRIPE_OUTER = vmath.vector4(0.169, 0.153, 0.141, 1.0)
local STRIPE_MID   = vmath.vector4(0.039, 0.031, 0.027, 1.0)
local STRIPE_INNER = vmath.vector4(0.337, 0.333, 0.314, 1.0)

-- Backend contract constants. Keep in lockstep with createTeamTournament.
local MIN_PLAYERS, MAX_PLAYERS = 2, 128
local GPL_OPTIONS              = { 1, 3, 5 }
local CODE_MIN, CODE_MAX       = 3, 16
local NAME_MAX                 = 32
local USERNAME_MAX             = 20
local MAX_INVITES              = 12
local MAX_SUGGESTIONS          = 5

local PRIZE_STEP_BY_GAME = { MATATU = 500, WHOT = 200, KADI = 20 }
local PRIZE_STEP = PRIZE_STEP_BY_GAME[GameMode.GAME] or 500

-- Entry fee steps in tenths of a prize step: a fee is what one player pays to
-- enter, not what the whole pot is worth, so the prize step is far too coarse
-- for it. FEE_MAX matches the server's own ceiling.
local FEE_STEP = math.max(1, math.floor(PRIZE_STEP / 10))
local FEE_MAX  = 1000000

local F_NAME, F_CODE, F_INVITE = "name", "code", "invite"

-- Debounce autocomplete so a fast typist fires one request, not one per key.
-- Short enough that the list keeps up with typing; long enough that a fast
-- typist does not fire a request per keystroke.
local SUGGEST_DEBOUNCE = 0.18

local function refresh_wh()
    local m = screen.metrics()
    VISIBLE_W, VISIBLE_H = m.VW, m.VH
    EDGE_L, EDGE_R, EDGE_B, EDGE_T = m.L, m.R, m.B, m.T
    CX, CY = m.CX, m.CY
end

local function commas(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

-- Mirrors computeSuggestedLevels(): ceil(log2(n)) clamped 3..7. Shown live so
-- the owner sees the bracket depth their player count implies BEFORE paying.
local function suggested_levels(max_players)
    local n = math.max(2, tonumber(max_players) or 2)
    return math.max(3, math.min(7, math.ceil(math.log(n) / math.log(2))))
end

local function balance()
    return math.floor(tonumber((ws.current_user_data or {}).balance) or 0)
end

local function my_id()
    return tostring((ws.current_user_data or {})._id or "")
end

local function rules_for_game()
    if GameMode.is_whot and GameMode.is_whot() then return "WHOT" end
    if GameMode.GAME == "KADI" then return "KADI" end
    return "JOKERS"
end

----------------------------------------------------------------------
-- node bookkeeping + crafted (image-free) primitives
----------------------------------------------------------------------
local function track(self, node)
    self.nodes[#self.nodes + 1] = node
    return node
end

local function clear(self)
    for _, n in ipairs(self.nodes or {}) do pcall(gui.delete_node, n) end
    self.nodes, self.buttons = {}, {}
end

-- The three-border recipe from profile.gui_script's gold_avatar_frame /
-- framed(): accent ring, dark outer, darker mid, then the fill. Every button
-- and panel on this screen is built from it, so nothing needs button art.
local function framed3(self, x, y, w, h, accent, fill)
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), accent))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 2, h - 2, 0), P_B_OUTER))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 6, h - 6, 0), P_B_MID))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 10, h - 10, 0), fill))
end

local function btn(self, id, x, y, w, h, label, kind, data, enabled)
    local on = enabled ~= false
    local accent, fill, txt
    if not on then
        accent, fill, txt = P_MUTED, P_B_MID, P_MUTED
    elseif kind == "primary" then
        accent, fill, txt = P_GOLD_LIGHT, P_GOLD, P_DARK_TXT
    elseif kind == "danger" then
        accent, fill, txt = P_ERROR, P_B_OUTER, P_ERROR
    else
        accent, fill, txt = P_GOLD, P_BADGE_BG, P_CREAM
    end
    framed3(self, x, y, w, h, accent, fill)
    track(self, ui.text(vmath.vector3(x, y, 0), label, "btn_md", txt))
    if on then
        local hit = track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), P_TRANSP))
        self.buttons[#self.buttons + 1] = { node = hit, id = id, data = data }
    end
end

-- Crafted checkbox: the same three-border recipe as the buttons, with a
-- filled inner square when ticked. No artwork.
local function checkbox(self, id, x, y, w, h, label, checked)
    framed3(self, x, y, w, h, checked and P_GOLD_LIGHT or P_GOLD, P_B_OUTER)
    local bx = x - w / 2 + 20
    framed3(self, bx, y, 22, 22, checked and P_GOLD_LIGHT or P_MUTED,
        checked and P_GOLD or P_B_MID)
    if checked then
        track(self, ui.box(vmath.vector3(bx, y, 0), vmath.vector3(8, 8, 0), P_DARK_TXT))
    end
    track(self, ui.text(vmath.vector3(bx + 20, y, 0), label, "small",
        checked and P_CREAM or P_MUTED))
    gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
    local hit = track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), P_TRANSP))
    self.buttons[#self.buttons + 1] = { node = hit, id = id }
end

-- Tapping a field focuses it AND raises the device keyboard.
local function field(self, id, x, y, w, h, value, placeholder, focused)
    framed3(self, x, y, w, h, focused and P_GOLD_LIGHT or P_GOLD, P_B_OUTER)
    local shown = (value ~= "" and value) or placeholder
    track(self, ui.text(vmath.vector3(x - w / 2 + 14, y, 0), shown, "small",
        (value ~= "") and P_CREAM or P_MUTED))
    gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
    if focused then
        -- Caret: shows the field is live even when it's still empty.
        track(self, ui.box(vmath.vector3(x + w / 2 - 16, y, 0), vmath.vector3(2, h - 20, 0), P_GOLD_LIGHT))
    end
    local hit = track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), P_TRANSP))
    self.buttons[#self.buttons + 1] = { node = hit, id = "focus", data = id }
end

----------------------------------------------------------------------
-- state
----------------------------------------------------------------------
local function fresh_form()
    return {
        edit_id     = nil,
        -- Which half of the form is on screen. 1 = the cup's settings,
        -- 2 = who is invited to it. Split because all of this on one screen
        -- did not fit: the entry fee stepper ended up UNDERNEATH the create
        -- button (drawn later, so it took the taps — the fee row looked
        -- disabled) and the owner-plays checkbox was pushed off the bottom
        -- of the screen entirely.
        step        = 1,
        name        = "",
        prize       = PRIZE_STEP * 2,
        max_players = 8,
        gpl_i       = 2,
        code        = "",
        owner_plays = false,
        -- Entry fee: off by default, so a cup created without touching this
        -- behaves exactly as team cups always have — the owner funds the whole
        -- prize and joining is free. When on, every player pays `entry_fee` to
        -- join and it goes into the prize pot, not to the owner.
        fee_on      = false,
        fee         = 0,
        -- Set for EDIT when somebody has already paid: the fee cannot change
        -- after that (the server refuses it), so the row is shown but inert
        -- rather than offering a change that will bounce.
        fee_locked  = false,
        invites     = {},
        -- Already on the cup when this form was opened for EDIT: everyone
        -- invited and still awaiting a reply. Kept SEPARATE from `invites`
        -- (which is names typed in this sitting and sent on submit) because
        -- these are already on the server — re-sending them would be noise,
        -- and their X has to WITHDRAW rather than just forget them locally.
        existing    = {},
        invite_buf  = "",
        focus       = nil,
        suggestions = {},
        suggest_t   = nil,
        suggest_for = nil,
        searching   = false,
        searched    = nil,   -- the query the current `suggestions` answer
        submitting  = false,
        msg         = nil,
        msg_ok      = false,
        locked      = false,
    }
end

local function set_msg(self, text, ok)
    self.form.msg = text
    self.form.msg_ok = ok and true or false
end

local function open_keyboard(self, which)
    self.form.focus = which
    -- KEYBOARD_TYPE_DEFAULT: the invite code is alphanumeric and usernames can
    -- be anything, so the plain text IME is right for all three fields.
    pcall(gui.show_keyboard, gui.KEYBOARD_TYPE_DEFAULT, false)
end

local function close_keyboard(self)
    self.form.focus = nil
    -- Leaving stale suggestions up under a dismissed keyboard looks like the
    -- field is still live.
    self.form.suggestions, self.form.searching = {}, false
    pcall(gui.hide_keyboard)
end

----------------------------------------------------------------------
-- draw
----------------------------------------------------------------------
local function rebuild(self)
    clear(self)
    if not self._active then return end
    local f = self.form
    local editing = f.edit_id ~= nil

    -- Base + texture cover, same as profile.
    track(self, ui.cover(LOGICAL_W, LOGICAL_H, P_BG))
    local bg = track(self, gui.new_box_node(vmath.vector3(CX, CY, 0),
        vmath.vector3(VISIBLE_W, VISIBLE_H, 0)))
    gui.set_texture(bg, "ui")
    pcall(gui.play_flipbook, bg, "texture_bg")

    -- Header + 3-stripe divider.
    local hdr_h = 80
    track(self, ui.box(vmath.vector3(CX, EDGE_T - hdr_h / 2, 0),
        vmath.vector3(VISIBLE_W, hdr_h, 0), vmath.vector4(0, 0, 0, 0.45)))
    local d_y = EDGE_T - hdr_h - 9
    track(self, ui.box(vmath.vector3(CX, d_y + 7, 0), vmath.vector3(VISIBLE_W, 4, 0), STRIPE_OUTER))
    track(self, ui.box(vmath.vector3(CX, d_y, 0), vmath.vector3(VISIBLE_W, 10, 0), STRIPE_MID))
    track(self, ui.box(vmath.vector3(CX, d_y - 7, 0), vmath.vector3(VISIBLE_W, 4, 0), STRIPE_INNER))

    local hy = EDGE_T - hdr_h / 2
    btn(self, "back", EDGE_L + 78, hy, 116, 46, "BACK", "secondary")
    track(self, ui.text(vmath.vector3(CX, hy, 0),
        (editing and "EDIT TEAM CUP" or "CREATE TEAM CUP")
            .. ((f.step or 1) == 1 and "  ·  1 OF 2" or "  ·  2 OF 2"), "subtitle2", P_GOLD))
    track(self, ui.text(vmath.vector3(EDGE_R - 26, hy, 0),
        commas(balance()) .. " " .. tostring(GameMode.CURRENCY_CODE or ""), "small", P_GOLD_LIGHT))
    gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_E)

    local col_w  = math.min(500, (EDGE_R - EDGE_L) * 0.42)
    local left   = EDGE_L + (CX - EDGE_L) * 0.52
    local right  = CX + (EDGE_R - CX) * 0.48  -- reassigned to CX in step 2
    local y      = d_y - 34
    local ROW    = 46
    local GAP    = 18
    -- The column the settings are currently being drawn into; moved to the
    -- right half partway down (see the SECOND COLUMN switch below).
    local col    = left
    local step   = f.step or 1

    local function label(cx_, text, col)
        track(self, ui.text(vmath.vector3(cx_ - col_w / 2, y, 0), text, "small", col or P_MUTED))
        gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
        y = y - 20
    end

    if step == 1 then
    -- ── NAME ────────────────────────────────────────────────────────────
    label(col, "TOURNAMENT NAME (optional)")
    field(self, F_NAME, col, y - ROW / 2, col_w, ROW, f.name, "TEAM CUP", f.focus == F_NAME)
    y = y - ROW - GAP

    -- ── GRAND PRIZE ─────────────────────────────────────────────────────
    label(col, "GRAND PRIZE  (funded from your balance)")
    local over = f.prize > balance()
    local mid_w = col_w - 116
    btn(self, "prize_minus", col - col_w / 2 + 28, y - ROW / 2, 48, ROW, "-", "secondary", nil, not editing)
    framed3(self, col, y - ROW / 2, mid_w, ROW, over and P_ERROR or P_GOLD, P_B_OUTER)
    track(self, ui.text(vmath.vector3(col, y - ROW / 2, 0),
        commas(f.prize) .. "  " .. tostring(GameMode.CURRENCY_CODE or ""), "body",
        over and P_ERROR or P_GOLD_LIGHT))
    btn(self, "prize_plus", col + col_w / 2 - 28, y - ROW / 2, 48, ROW, "+", "secondary", nil, not editing)
    y = y - ROW - 4
    if editing then
        track(self, ui.text(vmath.vector3(col, y - 9, 0),
            "Escrowed at creation — cannot be changed.", "small", P_MUTED))
    elseif over then
        track(self, ui.text(vmath.vector3(col, y - 9, 0),
            "More than your balance.", "small", P_ERROR))
    end
    y = y - 18 - GAP


    -- SECOND COLUMN. Invites have moved to step 2, so step 1 has the full
    -- width — and needs it: stacked in one column these rows ran off the
    -- bottom of the screen and under the footer button.
    col = right
    y   = d_y - 34

    -- ── MAX PLAYERS ─────────────────────────────────────────────────────
    label(col, "MAX PLAYERS")
    btn(self, "players_minus", col - col_w / 2 + 28, y - ROW / 2, 48, ROW, "-", "secondary", nil, not f.locked)
    framed3(self, col, y - ROW / 2, mid_w, ROW, P_GOLD, P_B_OUTER)
    track(self, ui.text(vmath.vector3(col, y - ROW / 2, 0), tostring(f.max_players), "body", P_CREAM))
    btn(self, "players_plus", col + col_w / 2 - 28, y - ROW / 2, 48, ROW, "+", "secondary", nil, not f.locked)
    y = y - ROW - 4
    track(self, ui.text(vmath.vector3(col, y - 9, 0),
        string.format("Bracket depth: %d levels", suggested_levels(f.max_players)), "small", P_MUTED))
    y = y - 18 - GAP

    -- ── GAMES PER LEVEL ─────────────────────────────────────────────────
    label(col, "GAMES PER LEVEL (to advance)")
    local seg_w = (col_w - 24) / #GPL_OPTIONS
    for i, v in ipairs(GPL_OPTIONS) do
        local sx = col - col_w / 2 + seg_w / 2 + (i - 1) * (seg_w + 12)
        btn(self, "gpl", sx, y - ROW / 2, seg_w, ROW, "Best of " .. v,
            (f.gpl_i == i) and "primary" or "secondary", i, not f.locked)
    end
    y = y - ROW - GAP

    -- ── INVITE CODE ─────────────────────────────────────────────────────
    label(col, string.format("INVITE CODE (optional, %d-%d letters/numbers)", CODE_MIN, CODE_MAX))
    field(self, F_CODE, col, y - ROW / 2, col_w, ROW, f.code, "AUTO-GENERATED", f.focus == F_CODE)
    y = y - ROW

    y = y - 10
    -- ── ENTRY FEE ───────────────────────────────────────────────────────
    -- Off by default. Ticking it charges every player this much to join, and
    -- the money goes into the PRIZE, not to the owner — so a cup cannot be
    -- used to collect coins, and the pot the winner takes grows with the field.
    local fee_editable = not f.fee_locked
    checkbox(self, "fee_toggle", col, y - ROW / 2, col_w, ROW,
        "Charge an entry fee to join", f.fee_on)
    y = y - ROW

    if f.fee_on then
        y = y - 6
        local fee_over = f.fee <= 0
        btn(self, "fee_minus", col - col_w / 2 + 28, y - ROW / 2, 48, ROW, "-",
            "secondary", nil, fee_editable)
        framed3(self, col, y - ROW / 2, mid_w, ROW,
            fee_over and P_ERROR or P_GOLD, P_B_OUTER)
        track(self, ui.text(vmath.vector3(col, y - ROW / 2, 0),
            commas(f.fee) .. "  " .. tostring(GameMode.CURRENCY_CODE or ""), "body",
            fee_over and P_ERROR or P_GOLD_LIGHT))
        btn(self, "fee_plus", col + col_w / 2 - 28, y - ROW / 2, 48, ROW, "+",
            "secondary", nil, fee_editable)
        y = y - ROW - 4
        local note
        if f.fee_locked then
            note = "Players have already paid — the fee cannot be changed."
        elseif fee_over then
            note = "Set an amount, or untick for a free cup."
        else
            note = "Each player pays this to join. It goes into the prize."
        end
        track(self, ui.text(vmath.vector3(col, y - 9, 0), note, "small",
            (f.fee_locked or fee_over) and P_MUTED or P_WIN))
        y = y - 18
    end

    y = y - 10
    -- The owner funds the prize either way; this decides whether they also
    -- compete for it. Locked once players have joined, like the rest of the
    -- structure — the bracket has already been built around the field. The
    -- owner never pays the entry fee: they funded the prize.
    checkbox(self, "owner_plays", col, y - ROW / 2, col_w, ROW,
        "I'll play in this cup too", f.owner_plays)
    y = y - ROW

    if f.locked then
        track(self, ui.text(vmath.vector3(col, y - 16, 0),
            "Players have joined — structure is locked.", "small", P_MUTED))
    end

    end

    -- ── STEP 2: invites ─────────────────────────────────────────────────
    -- Centred: alone on the screen it has no reason to sit in the right half.
    if step == 2 then
    right = CX
    local ry = d_y - 34
    track(self, ui.text(vmath.vector3(right - col_w / 2, ry, 0),
        string.format("INVITE BY USERNAME  (%d/%d)", #f.invites, MAX_INVITES), "small", P_MUTED))
    gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
    ry = ry - 20

    -- While the field is live, DONE sits beside ADD so dismissing the keyboard
    -- is a visible, one-tap action. Without it the only way out was the OS back
    -- gesture, which is what made this field so hard to leave.
    local typing = f.focus == F_INVITE
    local add_w  = typing and 84 or 96
    local done_w = 78
    local fld_w  = col_w - add_w - (typing and (done_w + 8) or 0) - 20
    field(self, F_INVITE, right - col_w / 2 + fld_w / 2, ry - ROW / 2, fld_w, ROW,
        f.invite_buf, "TYPE A USERNAME", typing)
    btn(self, "invite_add", right - col_w / 2 + fld_w + 10 + add_w / 2, ry - ROW / 2,
        add_w, ROW, "ADD", "primary", nil,
        f.invite_buf ~= "" and #f.invites < MAX_INVITES)
    if typing then
        btn(self, "invite_done", right + col_w / 2 - done_w / 2, ry - ROW / 2,
            done_w, ROW, "DONE", "secondary")
    end
    ry = ry - ROW - 8

    -- Suggestion list. It now reports what it is DOING — searching, nothing
    -- found, or a set of hits — instead of silently rendering nothing, which
    -- read as a broken field.
    local SUG_H = 42
    local function sug_note(msg, col)
        track(self, ui.text(vmath.vector3(right - col_w / 2 + 4, ry - 16, 0), msg, "small", col))
        gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
        ry = ry - 30
    end

    if typing and f.searching then
        sug_note("Searching...", P_MUTED)
    elseif #f.suggestions > 0 then
        for i, uname in ipairs(f.suggestions) do
            if i > MAX_SUGGESTIONS then break end
            local sy = ry - SUG_H / 2
            track(self, ui.panel9(vmath.vector3(right, sy, 0),
                vmath.vector3(col_w, SUG_H, 0), "container_bg"))

            -- Show the part you typed in the bright accent and the rest in
            -- cream, so it is obvious WHY each row matched.
            local typed = #f.invite_buf
            local head  = uname:sub(1, typed)
            local tail  = uname:sub(typed + 1)
            local tx = right - col_w / 2 + 16
            local hn = track(self, ui.text(vmath.vector3(tx, sy, 0), head, "body", P_GOLD_LIGHT))
            gui.set_pivot(hn, gui.PIVOT_W)
            if tail ~= "" then
                -- Approximate advance for the body face, enough to butt the
                -- two halves together without measuring glyphs.
                local tn = track(self, ui.text(
                    vmath.vector3(tx + #head * 26 * 0.55, sy, 0), tail, "body", P_CREAM))
                gui.set_pivot(tn, gui.PIVOT_W)
            end

            local pn = track(self, ui.text(vmath.vector3(right + col_w / 2 - 16, sy, 0),
                "+ ADD", "small", P_GOLD))
            gui.set_pivot(pn, gui.PIVOT_E)

            local hit = track(self, ui.box(vmath.vector3(right, sy, 0),
                vmath.vector3(col_w, SUG_H, 0), P_TRANSP))
            self.buttons[#self.buttons + 1] = { node = hit, id = "suggest_pick", data = uname }
            ry = ry - SUG_H - 6
        end
        ry = ry - 4
    elseif typing and f.searched == f.invite_buf and f.invite_buf ~= "" then
        sug_note('No player found for "' .. f.invite_buf .. '" — ADD invites them anyway.', P_MUTED)
    end

    -- Invitations already outstanding on this cup, shown first so editing a
    -- live cup opens with its real roster. Their X calls the backend's revoke
    -- rather than just dropping the name locally: these are already sent, so
    -- forgetting them here would not un-invite anybody.
    for i, e in ipairs(f.existing or {}) do
        local cy_ = ry - 18
        framed3(self, right, cy_, col_w, 36, P_MUTED, P_BADGE_BG)
        track(self, ui.text(vmath.vector3(right - col_w / 2 + 16, cy_, 0), e.username, "small", P_CREAM))
        gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
        track(self, ui.text(vmath.vector3(right + col_w / 2 - 56, cy_, 0), "INVITED", "small", P_MUTED))
        gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_E)
        btn(self, "invite_revoke", right + col_w / 2 - 28, cy_, 40, 28, "X", "danger", i)
        ry = ry - 40
    end

    if #f.invites == 0 and #(f.existing or {}) == 0 then
        track(self, ui.text(vmath.vector3(right, ry - 16, 0),
            "No invites yet — anyone with the code can still join.", "small", P_MUTED))
        ry = ry - 36
    elseif #f.invites > 0 then
        for i, uname in ipairs(f.invites) do
            local cy_ = ry - 18
            framed3(self, right, cy_, col_w, 36, P_GOLD, P_BADGE_BG)
            track(self, ui.text(vmath.vector3(right - col_w / 2 + 16, cy_, 0), uname, "small", P_CREAM))
            gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
            btn(self, "invite_del", right + col_w / 2 - 28, cy_, 40, 28, "X", "danger", i)
            ry = ry - 40
        end
    end

    end

    -- ── FOOTER ──────────────────────────────────────────────────────────
    local foot_y = EDGE_B + 46
    if f.msg then
        track(self, ui.text(vmath.vector3(CX, foot_y + 46, 0), f.msg, "small",
            f.msg_ok and P_SUCCESS or P_ERROR))
    end
    if step == 1 then
        -- Nothing is created yet. This only moves to the invite step, so the
        -- label says so rather than implying the cup is about to exist.
        btn(self, "step_next", CX, foot_y, 360, 56, "NEXT: INVITE PLAYERS", "primary")
    else
        local lbl
        if f.submitting then lbl = editing and "SAVING..." or "CREATING..."
        else lbl = editing and "SAVE CHANGES" or "CREATE TOURNAMENT" end
        btn(self, "step_back", EDGE_L + 92, foot_y, 150, 56, "BACK", "secondary", nil, not f.submitting)
        btn(self, "submit", CX + 80, foot_y, 320, 56, lbl, "primary", nil, not f.submitting)
    end
end

----------------------------------------------------------------------
-- text entry (device keyboard)
----------------------------------------------------------------------
local function limit_for(focus)
    if focus == F_NAME then return NAME_MAX end
    if focus == F_CODE then return CODE_MAX end
    return USERNAME_MAX
end

local function request_suggestions(self)
    local f = self.form
    local q = f.invite_buf
    -- One character is enough to start suggesting. Waiting for two meant the
    -- list sat empty through the first keystroke and the field felt dead.
    if #q < 1 then
        f.suggestions, f.searching, f.searched = {}, false, nil
        return
    end
    f.suggest_for = q
    f.searching = true
    api.search_usernames(q, my_id(), function(res)
        -- Drop a reply that arrived after the query moved on, so a slow
        -- earlier request can't overwrite newer suggestions.
        if self.form ~= f or f.suggest_for ~= q then return end
        f.searching = false
        f.searched  = q
        local out = {}
        for _, u in ipairs(((res or {}).data or {}).usernames or {}) do
            local dup = false
            for _, v in ipairs(f.invites) do
                if tostring(v):upper() == tostring(u):upper() then dup = true end
            end
            for _, e in ipairs(f.existing or {}) do
                if e.username:upper() == tostring(u):upper() then dup = true end
            end
            if not dup then out[#out + 1] = u end
            if #out >= MAX_SUGGESTIONS then break end
        end
        f.suggestions = out
        if self._active then rebuild(self) end
    end)
end

local function push_text(self, str)
    local f = self.form
    if not f.focus then return end
    local lim = limit_for(f.focus)
    for ch in tostring(str or ""):gmatch(".") do
        if f.focus == F_NAME then
            if #f.name < lim then f.name = f.name .. ch end
        elseif f.focus == F_CODE then
            -- The controller uppercases and strips non-alphanumerics anyway;
            -- doing it here keeps what's shown identical to what's stored.
            if ch:match("[%w]") and #f.code < lim then f.code = f.code .. ch:upper() end
        else
            if #f.invite_buf < lim then f.invite_buf = f.invite_buf .. ch end
        end
    end
    if f.focus == F_INVITE then f.suggest_t = SUGGEST_DEBOUNCE end
end

local function pop_char(self)
    local f = self.form
    if not f.focus then return end
    if f.focus == F_NAME then f.name = f.name:sub(1, -2)
    elseif f.focus == F_CODE then f.code = f.code:sub(1, -2)
    else
        f.invite_buf = f.invite_buf:sub(1, -2)
        f.suggest_t = SUGGEST_DEBOUNCE
    end
end

----------------------------------------------------------------------
-- submit
----------------------------------------------------------------------
-- The settings, checked on leaving STEP 1.
--
-- Separate from validate() below because a message about the grand prize is
-- useless on the invite step, where the prize field is not on screen to fix.
-- Submit still runs the whole of validate(), so nothing is checked only here.
local function validate_settings(self)
    local f = self.form
    if not f.edit_id then
        if f.prize <= 0 then return "A grand prize amount is required." end
        if f.prize > balance() then return "Insufficient balance for that grand prize." end
    end
    if f.code ~= "" and (#f.code < CODE_MIN or #f.code > CODE_MAX) then
        return string.format("Invite code must be %d-%d letters/numbers.", CODE_MIN, CODE_MAX)
    end
    if f.max_players < MIN_PLAYERS or f.max_players > MAX_PLAYERS then
        return string.format("Players must be between %d and %d.", MIN_PLAYERS, MAX_PLAYERS)
    end
    if f.fee_on and f.fee <= 0 then
        return "Set an entry fee amount, or untick it for a free cup."
    end
    return nil
end

local function validate(self)
    local f = self.form
    if not f.edit_id then
        if f.prize <= 0 then return "A grand prize amount is required." end
        if f.prize > balance() then return "Insufficient balance for that grand prize." end
    end
    if f.code ~= "" and (#f.code < CODE_MIN or #f.code > CODE_MAX) then
        return string.format("Invite code must be %d-%d letters/numbers.", CODE_MIN, CODE_MAX)
    end
    if f.max_players < MIN_PLAYERS or f.max_players > MAX_PLAYERS then
        return string.format("Players must be between %d and %d.", MIN_PLAYERS, MAX_PLAYERS)
    end
    -- Ticked but left at nothing. Submitting that would create a cup that
    -- claims to charge and does not, so it is caught here rather than being
    -- quietly saved as free.
    if f.fee_on and f.fee <= 0 then
        return "Set an entry fee amount, or untick it for a free cup."
    end
    return nil
end

local function add_invite(self)
    local f = self.form
    local uname = f.invite_buf:gsub("^%s+", ""):gsub("%s+$", "")
    if uname == "" or #f.invites >= MAX_INVITES then return end
    for _, v in ipairs(f.invites) do
        if v:upper() == uname:upper() then
            set_msg(self, "Already on the invite list.", false)
            rebuild(self)
            return
        end
    end
    -- ...and against the ones already sent, or the owner would re-invite
    -- somebody the cup is already waiting on.
    for _, e in ipairs(f.existing or {}) do
        if e.username:upper() == uname:upper() then
            set_msg(self, e.username .. " has already been invited.", false)
            f.invite_buf = ""
            f.suggestions = {}
            rebuild(self)
            return
        end
    end
    f.invites[#f.invites + 1] = uname
    f.invite_buf = ""
    f.suggestions = {}
    set_msg(self, nil, false)
    rebuild(self)
end

local function on_created(self, res)
    local f = self.form
    f.submitting = false
    if not res.success then
        set_msg(self, res.message or "Could not create the tournament.", false)
        rebuild(self)
        return
    end

    local missing = (res.data or {}).notFoundUsernames
    if type(missing) == "table" and #missing > 0 then
        toast.info("Not found: " .. table.concat(missing, ", "))
    end

    local t = (res.data or {}).tournament or {}
    if t.invitationCode then
        toast.success("Created. Invite code: " .. tostring(t.invitationCode))
    else
        toast.success("Team tournament created.")
    end

    if t._id then
        ws.current_user_data = ws.current_user_data or {}
        ws.current_user_data.myTeamTournamentId = t._id
        -- online_right's bracket modal reads this to decide whether to show
        -- the owner-only admin controls; the creator is always the owner.
        ws.current_user_data.myTeamTournamentIsOwner = true
    end
    close_keyboard(self)
    msg.post("#controller", "goto_lobby")
end

local function submit(self)
    local f = self.form
    if f.submitting then return end

    local err = validate(self)
    if err then set_msg(self, err, false); rebuild(self); return end

    local uid = my_id()
    if uid == "" then set_msg(self, "Sign in first.", false); rebuild(self); return end

    f.submitting = true
    set_msg(self, nil, false)
    rebuild(self)

    if f.edit_id then
        local payload = {
            name = (f.name ~= "" and f.name) or nil,
            maxPlayers = f.max_players,
            -- Sent on update too, so a fee added or removed before anybody has
            -- paid actually takes. The server refuses a change once somebody
            -- has, which is what fee_locked mirrors in the form.
            entryFee = f.fee_on and f.fee or 0,
            matchFormat = GPL_OPTIONS[f.gpl_i],
        }
        api.update_tournament(f.edit_id, payload, function(res)
            if res.success and #f.invites > 0 then
                api.invite_team_tournament(f.edit_id,
                    { userId = uid, usernames = f.invites }, function(ires)
                        f.submitting = false
                        local missing = (ires.data or {}).notFoundUsernames
                        if type(missing) == "table" and #missing > 0 then
                            toast.info("Not found: " .. table.concat(missing, ", "))
                        end
                        toast.success("Tournament updated.")
                        close_keyboard(self)
                        msg.post("#controller", "goto_lobby")
                    end)
            else
                f.submitting = false
                if res.success then
                    toast.success("Tournament updated.")
                    close_keyboard(self)
                    msg.post("#controller", "goto_lobby")
                else
                    set_msg(self, res.message or "Could not save changes.", false)
                    rebuild(self)
                end
            end
        end)
        return
    end

    api.create_team_tournament({
        userId          = uid,
        name            = (f.name ~= "" and f.name) or nil,
        grandPrizeCoins = f.prize,
        entryFee        = f.fee_on and f.fee or 0,
        maxPlayers      = f.max_players,
        gamesPerLevel   = GPL_OPTIONS[f.gpl_i],
        invitationCode  = (f.code ~= "" and f.code) or nil,
        inviteUsernames = (#f.invites > 0) and f.invites or nil,
        rules           = rules_for_game(),
        ownerPlays      = f.owner_plays,
    }, function(res) on_created(self, res) end)
end

----------------------------------------------------------------------
-- lifecycle
----------------------------------------------------------------------
function init(self)
    self.nodes, self.buttons = {}, {}
    self.form = fresh_form()
    refresh_wh()
end

function update(self, dt)
    if not self._active then return end
    local f = self.form
    if f.suggest_t then
        f.suggest_t = f.suggest_t - dt
        if f.suggest_t <= 0 then
            f.suggest_t = nil
            request_suggestions(self)
        end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("screen_enter") then
        refresh_wh()
        msg.post(".", "acquire_input_focus")
        self._active = true
        -- Seeded by the caller for EDIT; cleared here so a later CREATE can
        -- never inherit a stale tournament id.
        local seed = app_state.team_edit
        -- Which step to open on, if the caller asked for one. Cleared with the
        -- seed so a later CREATE opens at the beginning like anything else.
        local seed_step = app_state.team_edit_step
        app_state.team_edit = nil
        app_state.team_edit_step = nil
        self.form = fresh_form()
        if type(seed) == "table" and seed._id then
            local f = self.form
            f.edit_id     = seed._id
            f.name        = tostring(seed.name or "")
            f.prize       = math.floor(tonumber((seed.grandPrize or {}).value) or 0)
            f.max_players = math.floor(tonumber(seed.maxPlayers) or 8)
            f.code        = tostring(seed.invitationCode or "")
            f.locked      = (tonumber(seed.joinedCount) or 0) > 1
            -- EVERY field the cup actually has, not just some of them. An
            -- update form that opens at defaults does not merely look wrong —
            -- it SAVES those defaults, so a field the seed skipped is silently
            -- reset by the act of editing anything else.
            --
            -- owner_plays was exactly that: it was never seeded, so an owner
            -- who had opted into their own cup found the box unticked on every
            -- edit, and saving took them off the bracket they built.
            f.fee         = math.floor(tonumber(seed.entryFee) or 0)
            f.fee_on      = f.fee > 0
            f.fee_locked  = seed.entryFeeLocked and true or false
            f.owner_plays = seed.ownerPlays and true or false
            if seed_step == 2 then f.step = 2 end
            -- Pre-populate the invite list with the invitations already
            -- outstanding, so editing a live cup opens showing who has been
            -- asked rather than an empty box that reads as "nobody invited".
            for _, p in ipairs(seed.pending or {}) do
                if p and p.username then
                    f.existing[#f.existing + 1] =
                        { username = tostring(p.username), playerId = tostring(p.playerId or "") }
                end
            end
            for i, v in ipairs(GPL_OPTIONS) do
                if v == tonumber(seed.matchFormat) then f.gpl_i = i end
            end
        end
        rebuild(self)
    elseif message_id == hash("enable") then
        self._active = true
        rebuild(self)
    elseif message_id == hash("disable") then
        self._active = false
        -- Leaving the screen must take the IME with it, or it stays up over
        -- whatever screen comes next.
        close_keyboard(self)
        clear(self)
    elseif message_id == hash("layout_changed") or message_id == hash("user_data_updated") then
        refresh_wh()
        if self._active then rebuild(self) end
    end
end

function on_input(self, action_id, action)
    -- Any modal on top outranks a screen. These components are listed
    -- BEFORE the dialogs in controller.go, so without this they would
    -- consume the tap first and act on it behind an open dialog.
    if app_state.input_blocked() then return false end
    if not self._active then return end
    local f = self.form

    -- Device keyboard events.
    if action_id == hash("text") then
        push_text(self, action.text)
        rebuild(self)
        return true
    elseif action_id == hash("backspace") and (action.pressed or action.repeated) then
        pop_char(self)
        rebuild(self)
        return true
    elseif action_id == hash("enter") and action.pressed then
        -- ENTER commits and DISMISSES. It used to add the invite and leave the
        -- keyboard up, so the only way to get rid of it was the OS back
        -- gesture — the field was effectively a trap once you started typing.
        if f.focus == F_INVITE then add_invite(self) end
        close_keyboard(self)
        rebuild(self)
        return true
    end

    if action_id ~= hash("touch") or not action.pressed then return false end

    -- Touch coordinates go to pick_node untouched, as on every other screen.
    -- Nodes are laid out in the same space screen.metrics() reports, so there
    -- is nothing to convert; scaling by VW/LOGICAL_W dragged every tap toward
    -- x=0 in proportion to its distance from the origin, which quietly made
    -- the right-hand column (invite field, suggestions) unhittable on any
    -- viewport wider than 16:9.
    for i = #self.buttons, 1, -1 do
        local b = self.buttons[i]
        if gui.pick_node(b.node, action.x, action.y) then
            if b.id == "back" then
                close_keyboard(self)
                msg.post("#controller", "goto_lobby")
            elseif b.id == "focus" then
                open_keyboard(self, b.data)
                if b.data ~= F_INVITE then f.suggestions = {} end
                rebuild(self)
            elseif b.id == "prize_minus" then
                f.prize = math.max(0, f.prize - PRIZE_STEP); rebuild(self)
            elseif b.id == "prize_plus" then
                f.prize = f.prize + PRIZE_STEP; rebuild(self)
            elseif b.id == "players_minus" then
                f.max_players = math.max(MIN_PLAYERS, f.max_players - 1); rebuild(self)
            elseif b.id == "players_plus" then
                f.max_players = math.min(MAX_PLAYERS, f.max_players + 1); rebuild(self)
            elseif b.id == "step_next" then
                -- Checked before moving on, not at submit: an error about the
                -- prize is no use on a screen with no prize field.
                local err = validate_settings(self)
                if err then
                    set_msg(self, err, false)
                else
                    close_keyboard(self)
                    set_msg(self, nil, false)
                    f.step = 2
                end
                rebuild(self)
                return
            elseif b.id == "step_back" then
                close_keyboard(self)
                set_msg(self, nil, false)
                f.step = 1
                rebuild(self)
                return
            elseif b.id == "fee_toggle" then
                if not f.fee_locked then
                    f.fee_on = not f.fee_on
                    -- Ticking it on with nothing set opens at one step rather
                    -- than at zero, which would submit as "free" and read as
                    -- the tick having done nothing.
                    if f.fee_on and f.fee <= 0 then f.fee = FEE_STEP end
                    if not f.fee_on then f.fee = 0 end
                end
            elseif b.id == "fee_minus" then
                if not f.fee_locked then
                    f.fee = math.max(0, f.fee - FEE_STEP)
                end
            elseif b.id == "fee_plus" then
                if not f.fee_locked then
                    f.fee = math.min(FEE_MAX, f.fee + FEE_STEP)
                end
            elseif b.id == "owner_plays" then
                if not f.locked then f.owner_plays = not f.owner_plays end
                rebuild(self)
            elseif b.id == "gpl" then
                f.gpl_i = b.data; rebuild(self)
            elseif b.id == "suggest_pick" then
                f.invite_buf = tostring(b.data)
                add_invite(self)
            elseif b.id == "invite_add" then
                add_invite(self)
            elseif b.id == "invite_done" then
                close_keyboard(self)
                rebuild(self)
            elseif b.id == "invite_del" then
                table.remove(f.invites, b.data); rebuild(self)
            elseif b.id == "invite_revoke" then
                -- An invitation the server already holds: withdraw it there,
                -- and only drop the row once that succeeded.
                local e = (f.existing or {})[b.data]
                if e and not f.revoking then
                    f.revoking = true
                    api.revoke_team_invitation(f.edit_id, my_id(), e.playerId, function(res)
                        f.revoking = false
                        if res.success then
                            for i, v in ipairs(f.existing) do
                                if v.playerId == e.playerId then table.remove(f.existing, i) break end
                            end
                            toast.success("Invitation to " .. e.username .. " withdrawn.")
                        else
                            toast.error((res.data and res.data.error) or res.message
                                or "Could not withdraw that invitation.")
                        end
                        rebuild(self)
                    end)
                end
            elseif b.id == "submit" then
                close_keyboard(self)
                submit(self)
            end
            return true
        end
    end

    -- A tap that hit nothing dismisses the keyboard, the way every other text
    -- field on a phone behaves. Returns true so the tap is spent on closing
    -- rather than also acting on whatever is underneath.
    if f.focus then
        close_keyboard(self)
        rebuild(self)
        return true
    end
    return false
end
