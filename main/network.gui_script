-- network.gui_script
-- GLOBAL network dialog: lives on the controller object above every screen
-- (render order 15), so a connection problem surfaces anywhere in the app —
-- lobby, game, payments, themes... Flat design consistent with the Akira
-- dialogs: sharp rectangles, accent strip, no shadows.
--
-- States:
--   reconnecting — socket dropped, automatic retries running (spinner dots)
--   offline      — retries exhausted: explains + RETRY button

local ws        = require("modules.websocket_manager")
local F         = require("modules.fonts")
local app_state = require("modules.app_state")
local conn_plan = require("modules.connection_plan")

local LOGICAL_W, LOGICAL_H = 1280, 720

local C_PANEL  = vmath.vector4(0.086, 0.098, 0.118, 1.0) -- #16191E
local C_ACCENT = vmath.vector4(0.949, 0.702, 0.020, 1.0) -- #F2B305
local C_RED    = vmath.vector4(0.902, 0.290, 0.235, 1.0) -- #E64A3C
local C_BODY   = vmath.vector4(0.788, 0.812, 0.839, 1.0) -- #C9CFD6
local C_WHITE  = vmath.vector4(1, 1, 1, 1)
local C_DARK   = vmath.vector4(0.082, 0.094, 0.110, 1.0)
local C_GREEN  = vmath.vector4(0.298, 0.804, 0.396, 1.0) -- #4CCD65

local function box(pos, size, color)
    local n = gui.new_box_node(pos, size)
    gui.set_color(n, color)
    return n
end

local function text(pos, str, px, color, role)
    role = role or F.MODAL
    local n = gui.new_text_node(pos, str)
    gui.set_font(n, role.name)
    gui.set_scale(n, vmath.vector3(F.scale(role, px), F.scale(role, px), 1))
    gui.set_color(n, color or C_WHITE)
    return n
end

local function build(self)
    self.scrim = box(vmath.vector3(LOGICAL_W/2, LOGICAL_H/2, 0), vmath.vector3(5000, 5000, 0), vmath.vector4(0, 0, 0, 0.78))
    gui.set_adjust_mode(self.scrim, gui.ADJUST_STRETCH)

    local pw, ph = 520, 240
    self.panel = box(vmath.vector3(0, 0, 0), vmath.vector3(pw, ph, 0), C_PANEL)
    gui.set_parent(self.panel, self.scrim)
    gui.set_adjust_mode(self.panel, gui.ADJUST_FIT)

    self.strip = box(vmath.vector3(0, ph/2 - 3, 0), vmath.vector3(pw, 6, 0), C_ACCENT)
    gui.set_parent(self.strip, self.panel)

    self.title = text(vmath.vector3(0, 64, 0), "CONNECTION LOST", 26, C_WHITE, F.MODAL_BOLD)
    gui.set_parent(self.title, self.panel)

    self.body = text(vmath.vector3(0, 22, 0), "Reconnecting", 19, C_BODY)
    gui.set_parent(self.body, self.panel)

    self.hint = text(vmath.vector3(0, -14, 0), "Please reconnect before the grace period expires.", 15,
        vmath.vector4(0.55, 0.59, 0.64, 1))
    gui.set_parent(self.hint, self.panel)

    self.retry_btn = box(vmath.vector3(0, -72, 0), vmath.vector3(200, 52, 0), C_ACCENT)
    gui.set_parent(self.retry_btn, self.panel)
    self.retry_lbl = text(vmath.vector3(0, -2, 0), "RETRY", 20, C_DARK, F.MODAL_BOLD)
    gui.set_parent(self.retry_lbl, self.retry_btn)

    gui.set_enabled(self.scrim, false)
end

-- Small unobtrusive connection-status pill, top-right. Used on the lobby and in
-- OFFLINE games, where the full-screen dialog is unwanted. Anchored top-right
-- but nudged down/left so it stays clear of the in-game exit button corner.
local BADGE_H = 28

-- The pill widens per state so the longest label ("RECONNECTING…") is never
-- cramped, while shorter states ("ONLINE"/"OFFLINE") stay compact.
local function badge_width_for(mode)
    if mode == "reconnecting" then return 168 end
    if mode == "connecting" then return 150 end
    if mode == "update_required" then return 128 end
    if mode == "blocked" then return 148 end
    if mode == "offline" then return 110 end
    return 102 -- online / connected
end

-- Resize the pill and re-place its dot + label, keeping the right edge anchored.
local function layout_badge(self, bw)
    gui.set_size(self.badge, vmath.vector3(bw, BADGE_H, 0))
    gui.set_position(self.badge, vmath.vector3(LOGICAL_W - bw/2 - 18, LOGICAL_H - BADGE_H/2 - 56, 0))
    gui.set_position(self.badge_dot, vmath.vector3(-bw/2 + 15, 0, 0))
    gui.set_position(self.badge_lbl, vmath.vector3(-bw/2 + 30, -1, 0))
end

local function build_badge(self)
    local bw = badge_width_for("connected")
    -- Anchor to the top-right corner; offset keeps it clear of the exit button.
    self.badge = box(vmath.vector3(LOGICAL_W - bw/2 - 18, LOGICAL_H - BADGE_H/2 - 56, 0),
        vmath.vector3(bw, BADGE_H, 0), C_PANEL)
    gui.set_pivot(self.badge, gui.PIVOT_CENTER)
    gui.set_xanchor(self.badge, gui.ANCHOR_RIGHT)
    gui.set_yanchor(self.badge, gui.ANCHOR_TOP)
    gui.set_adjust_mode(self.badge, gui.ADJUST_FIT)

    self.badge_dot = box(vmath.vector3(-bw/2 + 15, 0, 0), vmath.vector3(8, 8, 0), C_GREEN)
    gui.set_parent(self.badge_dot, self.badge)

    -- Left-aligned so the dot + label read as one tidy group at any width.
    self.badge_lbl = text(vmath.vector3(-bw/2 + 30, -1, 0), "ONLINE", 12, C_BODY)
    gui.set_pivot(self.badge_lbl, gui.PIVOT_W)
    gui.set_parent(self.badge_lbl, self.badge)

    gui.set_enabled(self.badge, false)
end

-- Drive the top-right badge to a state and reveal it. Mirrors the dialog modes
-- plus a "connected" green state. Returns nothing.
local function show_badge(self, mode)
    if mode == "offline" then
        gui.set_color(self.badge_dot, C_RED)
        gui.set_text(self.badge_lbl, "OFFLINE")
        gui.set_color(self.badge_lbl, C_BODY)
    elseif mode == "connected" then
        gui.set_color(self.badge_dot, C_GREEN)
        gui.set_text(self.badge_lbl, "ONLINE")
        gui.set_color(self.badge_lbl, C_BODY)
    elseif mode == "update_required" then
        -- Not a network state at all. Showing RECONNECTING… here is how a
        -- player sat watching a spinner that was never going to resolve.
        gui.set_color(self.badge_dot, C_RED)
        gui.set_text(self.badge_lbl, "UPDATE APP")
        gui.set_color(self.badge_lbl, C_BODY)
    elseif mode == "blocked" then
        gui.set_color(self.badge_dot, C_RED)
        gui.set_text(self.badge_lbl, "UNAVAILABLE")
        gui.set_color(self.badge_lbl, C_BODY)
    elseif mode == "connecting" then
        -- The link is up (or coming up) and we are waiting on the server —
        -- a different thing from having dropped, and a different thing to
        -- debug from the log.
        gui.set_color(self.badge_dot, C_ACCENT)
        gui.set_text(self.badge_lbl, "CONNECTING…")
        gui.set_color(self.badge_lbl, C_BODY)
    else -- reconnecting
        gui.set_color(self.badge_dot, C_ACCENT)
        gui.set_text(self.badge_lbl, "RECONNECTING…")
        gui.set_color(self.badge_lbl, C_BODY)
    end
    layout_badge(self, badge_width_for(mode))
    self._badge_mode = mode
    gui.set_enabled(self.badge, true)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    gui.set_render_order(15)
    self._mode = nil
    self._dots_t = 0
    self._badge_mode = nil
    self._badge_hide_t = nil
    build(self)
    build_badge(self)

    -- WS callbacks run in the socket owner's (controller) context — post back
    -- to THIS component through a URL captured here, in our own context.
    -- During ONLINE play we drive the full-screen dialog; on the lobby and in
    -- OFFLINE games we only update the small top-right badge.
    local ME = msg.url("#")
    local function notify(mode)
        if app_state.mode == "online" then
            msg.post(ME, "net_show", { mode = mode })
        else
            msg.post(ME, "net_badge", { mode = mode })
        end
    end

    -- ONE SUBSCRIPTION, TO WHAT THE CONNECTION IS ACTUALLY DOING.
    --
    -- Reported: a "RECONNECTING…" badge appears and the app sends nothing to
    -- the backend for a minute or more.
    --
    -- This used to listen to `disconnected` and `connection_error` and show a
    -- spinner for either. on_disconnected emits `disconnected` BEFORE deciding
    -- whether it is going to reconnect — and in three cases it decides not to:
    -- a manual teardown, a build the server has refused, and a blocked
    -- account. The last stays silent for fifteen minutes. So the badge
    -- promised a reconnect that had already been ruled out, and there was
    -- nothing on screen or in the code that could tell the difference.
    --
    -- websocket_manager now publishes a resolved status derived from the same
    -- state its reconciler plans from, so the spinner cannot disagree with the
    -- loop about whether anything is in flight.
    local function apply_status(status)
        -- Intentional disconnect+reconnect cycles happen during the Firebase
        -- auth flow and are not a network problem worth showing.
        local auth = app_state.auth_state or "idle"
        if auth == "sending" or auth == "verifying" then return end

        if status == "online" then
            msg.post(ME, "net_hide")
            msg.post(ME, "net_badge", { mode = "connected" })
        elseif status == "signed_out" then
            -- No socket is wanted, so nothing is broken.
            msg.post(ME, "net_hide")
            msg.post(ME, "net_badge", { mode = "hide" })
        else
            -- connecting / reconnecting / offline / blocked / update_required
            notify(status)
        end
    end

    self._tokens = {
        ws.on("connection_status", apply_status),
        -- Kept only to close the dialog the instant the socket comes up,
        -- rather than on the next status publish.
        ws.on("connected", function()
            msg.post(ME, "net_hide")
        end),
    }

    -- The status may already be interesting before the first publish — this
    -- component is built when its screen loads, which can be long after the
    -- connection settled into whatever it is doing.
    apply_status(ws.connection_status())
end

function final(self)
    for _, t in ipairs(self._tokens or {}) do ws.off(t) end
    app_state.modal_close("network")
end

-- EVERY STATE SAYS WHAT IT IS, AND THE RETRY BUTTON APPEARS WHERE RETRYING
-- IS THE ANSWER.
--
-- There used to be two branches — "offline" and everything else — so a
-- refused build and a blocked account both rendered as "CONNECTION LOST /
-- Reconnecting…", with a spinner, with no retry, and with nothing actually
-- reconnecting behind it.
local function apply_mode(self, mode)
    self._mode = mode
    gui.set_enabled(self.scrim, true)
    app_state.modal_open("network")

    if mode == "offline" then
        gui.set_text(self.title, "YOU ARE OFFLINE")
        gui.set_color(self.strip, C_RED)
        gui.set_text(self.body, "Couldn't reach the server.")
        gui.set_text(self.hint, "Check your internet connection, then retry.")
        gui.set_enabled(self.retry_btn, true)

    elseif mode == "update_required" then
        -- Terminal. Retrying re-runs the same handshake and is refused
        -- identically, so offering the button would be a lie.
        gui.set_text(self.title, "UPDATE REQUIRED")
        gui.set_color(self.strip, C_RED)
        gui.set_text(self.body, "This version is no longer supported.")
        gui.set_text(self.hint, "Update the app from the Play Store to keep playing.")
        gui.set_enabled(self.retry_btn, false)

    elseif mode == "blocked" then
        -- Not permanent, but the app deliberately stays quiet between checks
        -- (APP_OFFLINE_RECHECK_SECONDS). Saying so is the whole point: this is
        -- the state that spent fifteen minutes pretending to reconnect.
        gui.set_text(self.title, "ACCOUNT UNAVAILABLE")
        gui.set_color(self.strip, C_RED)
        gui.set_text(self.body, "The server isn't accepting this account.")
        gui.set_text(self.hint, "We'll check again shortly. Contact support if this persists.")
        gui.set_enabled(self.retry_btn, true)

    else
        -- connecting / reconnecting: something IS in flight.
        gui.set_text(self.title, "CONNECTION LOST")
        gui.set_color(self.strip, C_ACCENT)
        gui.set_text(self.body, "Reconnecting")
        gui.set_text(self.hint, "Please reconnect before the grace period expires.")
        gui.set_enabled(self.retry_btn, false)
    end
end

function update(self, dt)
    -- The spinner is a promise that something is in flight. conn_plan owns
    -- which statuses that is true for, so it cannot drift from the loop.
    if conn_plan.status_is_active(self._mode) and gui.is_enabled(self.scrim) then
        self._dots_t = (self._dots_t or 0) + dt
        local dots = string.rep(".", 1 + (math.floor(self._dots_t * 2) % 3))
        gui.set_text(self.body, "Reconnecting" .. dots)
    end

    -- Auto-hide the green "connected" badge a short moment after reconnect.
    if self._badge_hide_t then
        self._badge_hide_t = self._badge_hide_t - dt
        if self._badge_hide_t <= 0 then
            self._badge_hide_t = nil
            self._badge_mode = nil
            gui.set_enabled(self.badge, false)
        end
    end
end

function on_message(self, message_id, message)
    if message_id == hash("net_show") then
        -- Full dialog supersedes the badge (online play only).
        self._badge_hide_t = nil
        self._badge_mode = nil
        gui.set_enabled(self.badge, false)
        apply_mode(self, (message and message.mode) or "reconnecting")
    elseif message_id == hash("net_hide") then
        self._mode = nil
        gui.set_enabled(self.scrim, false)
        app_state.modal_close("network")
    elseif message_id == hash("net_badge") then
        local mode = (message and message.mode) or "reconnecting"
        -- Signed out: no socket is wanted, so there is nothing to report.
        if mode == "hide" then
            self._badge_hide_t = nil
            self._badge_mode = nil
            gui.set_enabled(self.badge, false)
            return
        end
        -- When online the dialog owns the UI; keep the badge hidden.
        if app_state.mode == "online" then
            self._badge_hide_t = nil
            self._badge_mode = nil
            gui.set_enabled(self.badge, false)
            return
        end
        show_badge(self, mode)
        -- Green/connected badge fades out after a couple of seconds; a problem
        -- state stays put until it resolves.
        self._badge_hide_t = (mode == "connected") and 2.0 or nil
    end
end

function on_input(self, action_id, action)
    if not gui.is_enabled(self.scrim) then return false end
    if action_id == hash("touch") and action.pressed then
        if gui.is_enabled(self.retry_btn)
            and gui.pick_node(self.retry_btn, action.x, action.y) then
            if self._mode == "blocked" then
                -- Spend the probe NOW rather than making the player wait out
                -- the rest of the fifteen-minute window. Only the server
                -- accepting an identify clears the latch for real; this just
                -- lets the app ask again immediately.
                apply_mode(self, "connecting")
                ws.recheck_app_offline_now()
                ws.retry_connection()
            elseif self._mode == "offline" then
                apply_mode(self, "reconnecting")
                ws.retry_connection()
            end
        end
    end
    -- Modal: swallow EVERYTHING while visible, not just touch+pressed — a
    -- release/drag/other action used to fall through to `return false` here,
    -- reaching the background even with "CONNECTION LOST" on screen.
    return true
end
