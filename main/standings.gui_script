-- standings.gui_script — interactive standings / bracket chart for one team cup.
--
-- Answers, at a glance: who cleared which stage, who they faced there, and the
-- series score. Data comes from GET /tournaments/team/:id/bracket, which
-- returns each competitor's levelResults (stage, stage name, opponent,
-- both scores, outcome) plus clearedLevel — how far they actually GOT, which
-- is not the same as currentLevel, because a beaten player is reset to level 1
-- and would otherwise look like they never progressed.
--
-- Layout: a stage-per-column chart on the left, and a detail panel on the
-- right showing the selected player's full run. Tapping any chip in the chart
-- selects that player; tapping a stage header filters the chart to it.
--
-- Visual language follows profile.gui_script / team_tournament.gui_script:
-- flat luxury-dark base, "texture_bg" cover, 3-stripe divider and crafted
-- three-border panels — no slice-9 button artwork.

local ui        = require("modules.ui")
local app_state = require("modules.app_state")
local ws        = require("modules.websocket_manager")
local api       = require("modules.api_service")
local screen    = require("modules.screen")
local toast     = require("modules.toast")
local GameMode  = require("modules.game_mode")

local LOGICAL_W, LOGICAL_H = 1280, 720
local VISIBLE_W, VISIBLE_H = 1280, 720
local CX, CY = 640, 360
local EDGE_L, EDGE_R, EDGE_B, EDGE_T = 0, 1280, 0, 720

local P_BG         = vmath.vector4(0.042, 0.033, 0.027, 1)
local P_PANEL      = vmath.vector4(0.082, 0.063, 0.051, 1)
local P_GOLD       = vmath.vector4(0.784, 0.573, 0.165, 1)
local P_GOLD_LIGHT = vmath.vector4(0.941, 0.753, 0.376, 1)
local P_CREAM      = vmath.vector4(0.957, 0.925, 0.843, 1)
local P_MUTED      = vmath.vector4(0.455, 0.400, 0.325, 1)
local P_BADGE_BG   = vmath.vector4(0.157, 0.118, 0.078, 1)
local P_B_OUTER    = vmath.vector4(0.027, 0.020, 0.016, 1)
local P_B_MID      = vmath.vector4(0.012, 0.008, 0.008, 1)
local P_WIN        = vmath.vector4(0.275, 0.624, 0.388, 1)
local P_LOSS       = vmath.vector4(0.820, 0.231, 0.231, 1)
local P_DARK_TXT   = vmath.vector4(0.06, 0.045, 0.02, 1)
local P_TRANSP     = vmath.vector4(0, 0, 0, 0)

local STRIPE_OUTER = vmath.vector4(0.169, 0.153, 0.141, 1.0)
local STRIPE_MID   = vmath.vector4(0.039, 0.031, 0.027, 1.0)
local STRIPE_INNER = vmath.vector4(0.337, 0.333, 0.314, 1.0)

local CHIP_H, CHIP_GAP = 34, 6
local COL_MIN_W        = 150

local function refresh_wh()
    local m = screen.metrics()
    VISIBLE_W, VISIBLE_H = m.VW, m.VH
    EDGE_L, EDGE_R, EDGE_B, EDGE_T = m.L, m.R, m.B, m.T
    CX, CY = m.CX, m.CY
end

local function commas(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local function my_id()
    return tostring((ws.current_user_data or {})._id or "")
end

----------------------------------------------------------------------
-- node bookkeeping + crafted primitives
----------------------------------------------------------------------
local function track(self, node)
    self.nodes[#self.nodes + 1] = node
    return node
end

local function clear(self)
    for _, n in ipairs(self.nodes or {}) do pcall(gui.delete_node, n) end
    self.nodes, self.buttons = {}, {}
end

local function framed3(self, x, y, w, h, accent, fill)
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), accent))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 2, h - 2, 0), P_B_OUTER))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 6, h - 6, 0), P_B_MID))
    track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w - 10, h - 10, 0), fill))
end

local function btn(self, id, x, y, w, h, label, kind, data, enabled)
    local on = enabled ~= false
    local accent, fill, txt
    if not on then
        accent, fill, txt = P_MUTED, P_B_MID, P_MUTED
    elseif kind == "primary" then
        accent, fill, txt = P_GOLD_LIGHT, P_GOLD, P_DARK_TXT
    else
        accent, fill, txt = P_GOLD, P_BADGE_BG, P_CREAM
    end
    framed3(self, x, y, w, h, accent, fill)
    track(self, ui.text(vmath.vector3(x, y, 0), label, "btn_md", txt))
    if on then
        local hit = track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), P_TRANSP))
        self.buttons[#self.buttons + 1] = { node = hit, id = id, data = data }
    end
end

local function label_w(self, x, y, text, font, col)
    track(self, ui.text(vmath.vector3(x, y, 0), text, font or "small", col or P_MUTED))
    gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_W)
end

----------------------------------------------------------------------
-- data helpers
----------------------------------------------------------------------

-- Every player who contested `level`, with the row for that stage. This is
-- what "who passed which stage" reads off: a player appears in a stage column
-- only once they have actually played there, and the row says whether they
-- went through.
local function contenders_at(self, level)
    local out = {}
    for _, p in ipairs((self.cup or {}).players or {}) do
        for _, r in ipairs(p.levelResults or {}) do
            if tonumber(r.level) == level then
                out[#out + 1] = { player = p, result = r }
                break
            end
        end
    end
    table.sort(out, function(a, b)
        if a.result.won ~= b.result.won then return a.result.won end
        return tostring(a.player.username) < tostring(b.player.username)
    end)
    return out
end

local function find_player(self, pid)
    for _, p in ipairs((self.cup or {}).players or {}) do
        if tostring(p.playerId) == tostring(pid) then return p end
    end
    return nil
end

local function stage_name(self, level)
    local levels = (self.cup or {}).levels or {}
    local l = levels[level]
    return (l and l.name) or ("Level " .. tostring(level))
end

----------------------------------------------------------------------
-- draw
----------------------------------------------------------------------
local function rebuild(self)
    clear(self)
    if not self._active then return end

    track(self, ui.cover(LOGICAL_W, LOGICAL_H, P_BG))
    local bg = track(self, gui.new_box_node(vmath.vector3(CX, CY, 0),
        vmath.vector3(VISIBLE_W, VISIBLE_H, 0)))
    gui.set_texture(bg, "ui")
    pcall(gui.play_flipbook, bg, "texture_bg")

    -- Header + 3-stripe divider.
    local hdr_h = 76
    track(self, ui.box(vmath.vector3(CX, EDGE_T - hdr_h / 2, 0),
        vmath.vector3(VISIBLE_W, hdr_h, 0), vmath.vector4(0, 0, 0, 0.45)))
    local d_y = EDGE_T - hdr_h - 9
    track(self, ui.box(vmath.vector3(CX, d_y + 7, 0), vmath.vector3(VISIBLE_W, 4, 0), STRIPE_OUTER))
    track(self, ui.box(vmath.vector3(CX, d_y, 0), vmath.vector3(VISIBLE_W, 10, 0), STRIPE_MID))
    track(self, ui.box(vmath.vector3(CX, d_y - 7, 0), vmath.vector3(VISIBLE_W, 4, 0), STRIPE_INNER))

    local hy = EDGE_T - hdr_h / 2
    btn(self, "back", EDGE_L + 78, hy, 116, 46, "BACK", "secondary")

    local cup = self.cup
    local title = cup and tostring(cup.name or "Team Cup") or "STANDINGS"
    track(self, ui.text(vmath.vector3(CX, hy + 8, 0), string.upper(title), "subtitle2", P_GOLD))
    if cup then
        local sub = string.format("%s  •  %s %s  •  best of %d",
            cup.started and "RUNNING" or "NOT STARTED",
            commas((cup.grandPrize or {}).value or 0),
            tostring(GameMode.CURRENCY_CODE or ""),
            tonumber(cup.matchFormat) or 3)
        track(self, ui.text(vmath.vector3(CX, hy - 16, 0), sub, "small", P_MUTED))
    end
    btn(self, "refresh", EDGE_R - 78, hy, 116, 46, "REFRESH", "secondary", nil, not self.loading)

    if self.loading then
        track(self, ui.text(vmath.vector3(CX, CY, 0), "Loading standings...", "body", P_MUTED))
        return
    end
    if not cup then
        track(self, ui.text(vmath.vector3(CX, CY + 10, 0),
            self.err or "Could not load this cup.", "body", P_LOSS))
        return
    end

    local total = tonumber(cup.totalLevels) or #(cup.levels or {})
    if total < 1 then total = 1 end

    -- Right: detail panel for the selected player. Reserved first so the
    -- chart columns lay out inside what's left.
    local body_t = d_y - 22
    local body_b = EDGE_B + 24
    local det_w  = math.floor(math.max(260, math.min(360, (EDGE_R - EDGE_L) * 0.26)))
    local det_l  = EDGE_R - 24 - det_w
    local chart_l, chart_r = EDGE_L + 24, det_l - 18

    ------------------------------------------------------------------
    -- Chart: one column per stage
    ------------------------------------------------------------------
    local shown_levels = {}
    if self.focus_level then
        shown_levels[1] = self.focus_level
    else
        for l = 1, total do shown_levels[#shown_levels + 1] = l end
    end

    local n_cols = #shown_levels
    local chart_w = chart_r - chart_l
    local col_gap = 10
    local col_w = math.floor((chart_w - col_gap * (n_cols - 1)) / math.max(1, n_cols))

    -- Too many stages to fit legibly: fall back to one stage at a time so
    -- columns never collapse into unreadable slivers.
    if col_w < COL_MIN_W and not self.focus_level then
        self.focus_level = math.min(total, math.max(1, self.focus_level or 1))
        rebuild(self)
        return
    end

    for ci, level in ipairs(shown_levels) do
        local cl = chart_l + (ci - 1) * (col_w + col_gap)
        local ccx = cl + col_w / 2

        -- Stage header doubles as a filter toggle.
        framed3(self, ccx, body_t - 17, col_w, 34,
            (self.focus_level == level) and P_GOLD_LIGHT or P_GOLD, P_BADGE_BG)
        track(self, ui.text(vmath.vector3(ccx, body_t - 17, 0),
            string.upper(stage_name(self, level)), "small", P_CREAM))
        local hh = track(self, ui.box(vmath.vector3(ccx, body_t - 17, 0),
            vmath.vector3(col_w, 34, 0), P_TRANSP))
        self.buttons[#self.buttons + 1] = { node = hh, id = "stage", data = level }

        local rows = contenders_at(self, level)
        local y = body_t - 34 - 12

        if #rows == 0 then
            track(self, ui.text(vmath.vector3(ccx, y - 14, 0), "not played yet", "small", P_MUTED))
        end

        for _, row in ipairs(rows) do
            if y - CHIP_H < body_b then break end
            local p, r = row.player, row.result
            local cy_ = y - CHIP_H / 2
            local mine = tostring(p.playerId) == my_id()
            local sel  = tostring(self.selected or "") == tostring(p.playerId)

            local accent = r.won and P_WIN or P_LOSS
            if sel then accent = P_GOLD_LIGHT end
            framed3(self, ccx, cy_, col_w, CHIP_H, accent,
                mine and P_BADGE_BG or P_PANEL)

            local nm = tostring(p.username or "Player")
            if #nm > 12 then nm = nm:sub(1, 11) .. "." end
            if p.isChampion then nm = nm .. " *" end
            label_w(self, cl + 10, cy_, nm, "small", mine and P_GOLD_LIGHT or P_CREAM)

            -- The series score at THIS stage, from this player's side.
            local sc = string.format("%d-%d", tonumber(r.myScore) or 0, tonumber(r.opponentScore) or 0)
            track(self, ui.text(vmath.vector3(cl + col_w - 10, cy_, 0), sc, "small",
                r.won and P_WIN or P_LOSS))
            gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_E)

            local hit = track(self, ui.box(vmath.vector3(ccx, cy_, 0),
                vmath.vector3(col_w, CHIP_H, 0), P_TRANSP))
            self.buttons[#self.buttons + 1] = { node = hit, id = "pick", data = p.playerId }

            y = y - CHIP_H - CHIP_GAP
        end
    end

    -- Stage paging, shown only when the chart is filtered to a single stage.
    if self.focus_level then
        btn(self, "stage_prev", chart_l + 46, body_b + 20, 84, 32, "< PREV", "secondary",
            nil, self.focus_level > 1)
        btn(self, "stage_all", chart_l + 150, body_b + 20, 110, 32, "ALL STAGES", "secondary")
        btn(self, "stage_next", chart_l + 262, body_b + 20, 84, 32, "NEXT >", "secondary",
            nil, self.focus_level < total)
    end

    ------------------------------------------------------------------
    -- Detail panel: the selected player's full run
    ------------------------------------------------------------------
    local dcx = det_l + det_w / 2
    framed3(self, dcx, (body_t + body_b) / 2, det_w, body_t - body_b, P_GOLD, P_PANEL)

    local p = self.selected and find_player(self, self.selected) or nil
    local dy = body_t - 22

    if not p then
        track(self, ui.text(vmath.vector3(dcx, dy, 0), "PLAYER RUN", "small", P_GOLD))
        track(self, ui.text(vmath.vector3(dcx, dy - 30, 0), "Tap any player", "small", P_MUTED))
        track(self, ui.text(vmath.vector3(dcx, dy - 50, 0), "to see their run.", "small", P_MUTED))
    else
        track(self, ui.text(vmath.vector3(dcx, dy, 0),
            string.upper(tostring(p.username or "Player")), "subtitle2", P_GOLD_LIGHT))
        dy = dy - 26

        local cleared = tonumber(p.clearedLevel) or 0
        local standing
        if p.isChampion then
            standing = "CHAMPION"
        elseif cleared >= 1 then
            standing = "Reached " .. stage_name(self, math.min(total, cleared + 1))
        else
            standing = "No stage cleared yet"
        end
        track(self, ui.text(vmath.vector3(dcx, dy, 0), standing, "small",
            p.isChampion and P_GOLD or P_MUTED))
        dy = dy - 26

        local wins, losses = 0, 0
        for _, r in ipairs(p.levelResults or {}) do
            if r.won then wins = wins + 1 else losses = losses + 1 end
        end
        track(self, ui.text(vmath.vector3(dcx, dy, 0),
            string.format("%d won  •  %d lost", wins, losses), "small", P_CREAM))
        dy = dy - 24

        if #(p.levelResults or {}) == 0 then
            track(self, ui.text(vmath.vector3(dcx, dy - 16, 0), "No matches played yet.", "small", P_MUTED))
        end

        for _, r in ipairs(p.levelResults or {}) do
            if dy - 56 < body_b + 10 then break end
            local rc = dy - 28
            framed3(self, dcx, rc, det_w - 24, 52, r.won and P_WIN or P_LOSS, P_BADGE_BG)
            label_w(self, det_l + 22, rc + 12,
                string.upper(tostring(r.levelName or stage_name(self, r.level))), "small",
                r.won and P_WIN or P_LOSS)
            label_w(self, det_l + 22, rc - 8,
                "vs " .. tostring(r.opponentUsername or "Player"), "small", P_CREAM)
            track(self, ui.text(vmath.vector3(det_l + det_w - 22, rc - 8, 0),
                string.format("%d - %d", tonumber(r.myScore) or 0, tonumber(r.opponentScore) or 0),
                "small", P_CREAM))
            gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_E)
            track(self, ui.text(vmath.vector3(det_l + det_w - 22, rc + 12, 0),
                r.won and "PASSED" or "OUT", "small", r.won and P_WIN or P_LOSS))
            gui.set_pivot(self.nodes[#self.nodes], gui.PIVOT_E)
            dy = dy - 60
        end
    end
end

----------------------------------------------------------------------
-- load
----------------------------------------------------------------------
local function load(self)
    local id = self.cup_id
    if not id or id == "" then
        self.loading, self.err = false, "No cup selected."
        rebuild(self)
        return
    end
    self.loading, self.err = true, nil
    rebuild(self)
    api.get_team_tournament_bracket(id, function(res)
        if not self._active then return end
        self.loading = false
        if res.success then
            self.cup = res.data
            -- Default the detail panel to the viewer, so the screen opens on
            -- the run they care about most rather than on an empty panel.
            if not self.selected then
                local me = find_player(self, my_id())
                self.selected = me and me.playerId or nil
            end
        else
            self.cup = nil
            self.err = (res.data and res.data.error) or res.message or "Could not load this cup."
        end
        rebuild(self)
    end)
end

----------------------------------------------------------------------
-- lifecycle
----------------------------------------------------------------------
function init(self)
    self.nodes, self.buttons = {}, {}
    refresh_wh()
end

function on_message(self, message_id, message, sender)
    if message_id == hash("screen_enter") then
        refresh_wh()
        msg.post(".", "acquire_input_focus")
        self._active = true
        self.cup_id = tostring(app_state.standings_cup_id or "")
        self.cup, self.selected, self.focus_level, self.err = nil, nil, nil, nil
        load(self)
    elseif message_id == hash("enable") then
        refresh_wh()
        self._active = true
        rebuild(self)
    elseif message_id == hash("disable") then
        self._active = false
        msg.post(".", "release_input_focus")
        clear(self)
    elseif message_id == hash("layout_changed") then
        refresh_wh()
        rebuild(self)
    end
end

function on_input(self, action_id, action)
    if not self._active then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    -- Raw coordinates, as on every other screen — see the note in
    -- team_tournament.gui_script about why these must not be scaled.
    for i = #self.buttons, 1, -1 do
        local b = self.buttons[i]
        if gui.pick_node(b.node, action.x, action.y) then
            if b.id == "back" then
                msg.post("#controller", "goto_lobby")
            elseif b.id == "refresh" then
                load(self)
            elseif b.id == "pick" then
                -- Tapping the already-selected player clears the selection,
                -- so the panel can be dismissed without leaving the screen.
                if tostring(self.selected or "") == tostring(b.data) then
                    self.selected = nil
                else
                    self.selected = b.data
                end
                rebuild(self)
            elseif b.id == "stage" then
                self.focus_level = (self.focus_level == b.data) and nil or b.data
                rebuild(self)
            elseif b.id == "stage_all" then
                self.focus_level = nil
                rebuild(self)
            elseif b.id == "stage_prev" then
                self.focus_level = math.max(1, (self.focus_level or 1) - 1)
                rebuild(self)
            elseif b.id == "stage_next" then
                self.focus_level = (self.focus_level or 1) + 1
                rebuild(self)
            end
            return true
        end
    end
    return false
end
