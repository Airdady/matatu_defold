-- standings.gui_script — the team cup's BRACKET.
--
-- A drawing, not a table: one column per stage, match boxes holding both
-- competitors and the series score, and elbow connectors running from each
-- match to the next stage — so who beat whom, and how far each player got,
-- reads at a glance.
--
-- Two views, one screen:
--   • BEFORE the cup starts there are no matches to draw, so it shows the
--     ROSTER instead — who has accepted, and who was invited and has not.
--     An empty bracket told the owner nothing about the six invitations still
--     outstanding.
--   • ONCE started it becomes the bracket drawing described above.
--
-- Open to everyone in the cup. The OWNER additionally gets the controls that
-- run it: START while it is still gathering, INVITE more players, WITHDRAW an
-- unaccepted invitation, REMOVE a player, and DELETE the cup.
--
-- Data comes from GET /tournaments/team/:id/bracket:
--   rounds[]  — pairings per stage, each decided series appearing ONCE
--   players[] — every entrant with levelResults, clearedLevel, isChampion
--   pending[] — invited, not yet accepted (allowedUsers minus players)
--   canStart  — the server's own start rule, so the button can be disabled
--               with a reason instead of the owner discovering it by refusal
-- clearedLevel is used rather than currentLevel: a beaten player is reset to
-- level 1 and would otherwise look like they never progressed.
--
-- Visual language: flat luxury-dark base, "texture_bg" cover, 3-stripe header
-- divider, and the SAME slice-9 atlas art the rest of the app uses —
-- container_bg / container_bg_active for panels, primary_btn / secondary_btn
-- for controls. It used to hand-draw a three-border frame out of four nested
-- boxes, which made the bracket look like a different product from the lobby
-- it is opened from.

local ui        = require("modules.ui")
local app_state = require("modules.app_state")
local ws        = require("modules.websocket_manager")
local api       = require("modules.api_service")
local screen    = require("modules.screen")
local toast     = require("modules.toast")
local GameMode  = require("modules.game_mode")

local LOGICAL_W, LOGICAL_H = 1280, 720
local VISIBLE_W, VISIBLE_H = 1280, 720
local CX, CY = 640, 360
local EDGE_L, EDGE_R, EDGE_B, EDGE_T = 0, 1280, 0, 720

local P_BG         = vmath.vector4(0.042, 0.033, 0.027, 1)
local P_GOLD       = vmath.vector4(0.784, 0.573, 0.165, 1)
local P_GOLD_LIGHT = vmath.vector4(0.941, 0.753, 0.376, 1)
local P_CREAM      = vmath.vector4(0.957, 0.925, 0.843, 1)
local P_MUTED      = vmath.vector4(0.455, 0.400, 0.325, 1)
local P_B_OUTER    = vmath.vector4(0.027, 0.020, 0.016, 1)
local P_WIN        = vmath.vector4(0.275, 0.624, 0.388, 1)
local P_LOSS       = vmath.vector4(0.820, 0.231, 0.231, 1)
local P_LINE       = vmath.vector4(0.300, 0.250, 0.180, 1)
local P_DARK_TXT   = vmath.vector4(0.06, 0.045, 0.02, 1)
local P_TRANSP     = vmath.vector4(0, 0, 0, 0)
-- List-item fills. Flat, and only just lighter than the column behind them —
-- enough to separate one row from the next without competing with it.
local ROW_FILL     = vmath.vector4(0.000, 0.000, 0.000, 0.30)
local ROW_MINE     = vmath.vector4(0.235, 0.176, 0.075, 0.55)

local STRIPE_OUTER = vmath.vector4(0.169, 0.153, 0.141, 1.0)
local STRIPE_MID   = vmath.vector4(0.039, 0.031, 0.027, 1.0)
local STRIPE_INNER = vmath.vector4(0.337, 0.333, 0.314, 1.0)

-- Bracket geometry
local SEAT_H     = 26          -- one competitor row inside a match box
local MATCH_H    = SEAT_H * 2 + 6
local MATCH_GAP  = 14
local COL_GAP    = 34
local COL_MIN_W  = 168
local COL_MAX_W  = 240

local function refresh_wh()
    local m = screen.metrics()
    VISIBLE_W, VISIBLE_H = m.VW, m.VH
    EDGE_L, EDGE_R, EDGE_B, EDGE_T = m.L, m.R, m.B, m.T
    CX, CY = m.CX, m.CY
end

local function commas(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local function my_id() return tostring((ws.current_user_data or {})._id or "") end

-- Percent-encode for the share URL. Cup names are free text, so spaces and
-- punctuation would otherwise produce a malformed link.
local function url_encode(str)
    str = tostring(str or ""):gsub("([^%w%-%_%.%~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
    return str
end

local function short(name, n)
    name = tostring(name or "Player")
    if #name > n then return name:sub(1, n - 1) .. "." end
    return name
end

-- "<cup name> CUP", uppercased. A cup already named "…Cup" keeps its own
-- wording rather than becoming "ADA CUP CUP".
local function cup_title(cup)
    local name = tostring((cup or {}).name or "")
    if name == "" then return "TEAM CUP" end
    name = string.upper(name)
    if name:match("%f[%w]CUP$") then return name end
    return name .. " CUP"
end

----------------------------------------------------------------------
-- primitives
----------------------------------------------------------------------
local function track(self, node) self.nodes[#self.nodes + 1] = node; return node end
local function clear(self)
    for _, n in ipairs(self.nodes or {}) do pcall(gui.delete_node, n) end
    self.nodes, self.buttons = {}, {}
end

local function box(self, x, y, w, h, c)
    return track(self, ui.box(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), c))
end
local function text(self, x, y, s, font, c)
    return track(self, ui.text(vmath.vector3(x, y, 0), s, font, c))
end
local function text_w(self, x, y, s, font, c)
    local n = text(self, x, y, s, font, c); gui.set_pivot(n, gui.PIVOT_W); return n
end
local function text_e(self, x, y, s, font, c)
    local n = text(self, x, y, s, font, c); gui.set_pivot(n, gui.PIVOT_E); return n
end

-- Container art, matching the lobby and the stake pickers. This screen used to
-- hand-draw a three-border frame out of four nested boxes; the rest of the app
-- uses the slice-9 atlas art, so the bracket looked like a different product.
-- `tint` keeps the per-state colouring the frames carried (gold for a normal
-- row, brighter for your own, muted for a pending one).
local function panel(self, x, y, w, h, tint, anim)
    local n = track(self, ui.panel9(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0),
        anim or "container_bg"))
    if tint then gui.set_color(n, tint) end
    return n
end

-- Slice-9 button art. primary_btn / secondary_btn are the same two faces the
-- lobby's CREATE / JOIN use, so a control means the same thing everywhere.
local function btn_art(self, x, y, w, h, anim, tint)
    local n = track(self, ui.btn9(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0), anim))
    if tint then gui.set_color(n, tint) end
    return n
end

-- Pick the largest button font that actually FITS, instead of always reaching
-- for btn_md. btn_md is 30px tall, so it overflowed every button shorter than
-- that ("WITHDRAW" in a 28px pill), and a 14-character label like
-- "INVITE PLAYERS" ran past the edges of a 190px one. Ordered largest first;
-- the first that fits both axes wins.
--
-- CHAR_W is a per-character advance estimate. The display faces here (Teko /
-- Rajdhani) are condensed, so ~0.55em is a safe over-estimate — erring high
-- means a label drops a size rather than overflowing.
local BTN_FONTS = { { "btn_md", 30 }, { "btn_sm", 25 }, { "small", 20 } }
local CHAR_W    = 0.55
local BTN_PAD_X = 26   -- breathing room inside a button, left + right
local BTN_PAD_Y = 12

local function fit_font(label, w, h)
    local n = #tostring(label or "")
    local avail_w, avail_h = w - BTN_PAD_X, h - BTN_PAD_Y
    for _, f in ipairs(BTN_FONTS) do
        if f[2] <= avail_h and n * f[2] * CHAR_W <= avail_w then return f[1] end
    end
    return "small"
end

-- Smallest box that comfortably holds `label` at `font_size`, never below
-- `min_w`. Lets callers size a button to its text rather than guessing.
local function btn_w(label, font_size, min_w)
    return math.max(min_w or 0,
        math.ceil(#tostring(label or "") * font_size * CHAR_W) + BTN_PAD_X)
end

-- All three button faces, used the way the rest of the app uses them:
--   primary_btn   the one action this screen most wants you to take
--   secondary_btn a real alternative sitting beside it
--   default_btn   neutral chrome — navigation, paging — and the disabled state
-- `danger` is secondary_btn washed red rather than a fourth face, so a
-- destructive control still reads as part of the same set.
local BTN_ART = {
    primary   = { "primary_btn",   vmath.vector4(1.00, 1.00, 1.00, 1), P_DARK_TXT },
    secondary = { "secondary_btn", vmath.vector4(1.00, 1.00, 1.00, 1), P_CREAM },
    neutral   = { "default_btn",   vmath.vector4(1.00, 1.00, 1.00, 1), P_CREAM },
    danger    = { "secondary_btn", vmath.vector4(1.00, 0.62, 0.62, 1), P_LOSS },
    off       = { "default_btn",   vmath.vector4(0.55, 0.55, 0.55, 1), P_MUTED },
}

local function btn(self, id, x, y, w, h, label, kind, data, enabled)
    local on = enabled ~= false
    local art = BTN_ART[on and (kind or "secondary") or "off"] or BTN_ART.secondary
    btn_art(self, x, y, w, h, art[1], art[2])
    text(self, x, y, label, fit_font(label, w, h), art[3])
    if on then
        local hit = box(self, x, y, w, h, P_TRANSP)
        self.buttons[#self.buttons + 1] = { node = hit, id = id, data = data }
    end
end

----------------------------------------------------------------------
-- data helpers
----------------------------------------------------------------------
local function is_owner(self)
    local c = self.cup
    return c and tostring(c.ownerId or "") == my_id()
end

local function find_player(self, pid)
    for _, p in ipairs((self.cup or {}).players or {}) do
        if tostring(p.playerId) == tostring(pid) then return p end
    end
    return nil
end

-- Entrants who have not played a match yet still belong on the drawing —
-- otherwise a cup that has just started looks empty.
local function unplayed(self)
    local out = {}
    for _, p in ipairs((self.cup or {}).players or {}) do
        if #(p.levelResults or {}) == 0 then out[#out + 1] = p end
    end
    return out
end

----------------------------------------------------------------------
-- roster (pre-start)
----------------------------------------------------------------------
-- Sizing lives here rather than being sprinkled through the draw code, so the
-- whole block can be made roomier by moving two numbers. The first cut packed
-- a 26px avatar, two 20px text lines and a 28px button into a 40px row: every
-- element touched its neighbour and the button was shorter than its own label.
local ROW_H      = 66
local ROW_GAP    = 10
local COL_PAD    = 16   -- inset from the column panel's edge to its contents
local COL_HDR_H  = 46
local AVATAR     = 42
local ACT_W      = 138  -- roster action button (REMOVE / WITHDRAW)
local ACT_H      = 42

-- One person's row: avatar, name, what state they are in, and — for the owner
-- — the action that applies to THIS list (remove from the bracket, or withdraw
-- an invitation that was never accepted).
local function roster_row(self, cl, cy_, w, entry, kind, owner)
    local mine    = tostring(entry.playerId) == my_id()
    local pending = kind == "pending"
    local accent  = mine and P_GOLD_LIGHT or (pending and P_MUTED or P_GOLD)

    -- No panel art on a list item: the column already sits on one, and
    -- stacking a second textured face inside it made the rows fight the
    -- container they live in. A flat fill plus a state-coloured spine down the
    -- left edge separates the rows and says which list this is, at a fraction
    -- of the visual weight.
    box(self, cl + w / 2, cy_, w, ROW_H, mine and ROW_MINE or ROW_FILL)
    box(self, cl + 2, cy_, 4, ROW_H - 10, accent)

    -- Avatar in a framed disc, so it reads as a portrait rather than a sticker
    -- floating on the row.
    local av_x = cl + COL_PAD + AVATAR / 2
    track(self, ui.pie(vmath.vector3(av_x, cy_, 0), AVATAR / 2 + 3, accent))
    track(self, ui.pie(vmath.vector3(av_x, cy_, 0), AVATAR / 2, P_B_OUTER))
    track(self, ui.avatar(vmath.vector3(av_x, cy_, 0),
        vmath.vector3(AVATAR - 4, AVATAR - 4, 0), tonumber(entry.avatar) or 1))

    -- Name on top in the body face, state underneath in the muted small one:
    -- two clearly different weights instead of two identical grey lines.
    local tx = av_x + AVATAR / 2 + 14
    text_w(self, tx, cy_ + 12, short(entry.username, 14), "body",
        mine and P_GOLD_LIGHT or P_CREAM)
    text_w(self, tx, cy_ - 13,
        pending and "Awaiting reply" or "Ready to play", "small",
        pending and P_MUTED or P_WIN)

    if owner then
        btn(self, pending and "invite_revoke" or "player_remove",
            cl + w - COL_PAD - ACT_W / 2, cy_, ACT_W, ACT_H,
            pending and "WITHDRAW" or "REMOVE", "danger", entry.playerId)
    elseif mine then
        -- A pill, not bare text, so the viewer's own row is findable at a
        -- glance in a list of eight.
        local pw = btn_w("YOU", 20, 64)
        btn_art(self, cl + w - COL_PAD - pw / 2, cy_, pw, 30, "default_btn", P_GOLD_LIGHT)
        text(self, cl + w - COL_PAD - pw / 2, cy_, "YOU", "small", P_GOLD_LIGHT)
    end
end

-- A titled column: one panel holding a header band and a windowed run of rows,
-- with paging when the list is longer than the space. Paging beats a "+3 more"
-- footnote — the owner needs to reach every invitee, not just the first five.
local function roster_column(self, cl, w, top, bottom, title, list, kind, owner, empty_msg)
    local ccx = cl + w / 2
    local h   = top - bottom

    -- Panel behind the whole column, so the rows sit *inside* something.
    panel(self, ccx, bottom + h / 2, w, h)

    -- Title: type and a hairline, no panel art. A textured band here read as a
    -- third nested surface and buried the word it was supposed to present.
    local hdr_cy = top - COL_HDR_H / 2 - 4
    text_w(self, cl + COL_PAD, hdr_cy, string.upper(title), "small", P_GOLD_LIGHT)
    box(self, ccx, hdr_cy - COL_HDR_H / 2 + 4, w - COL_PAD * 2, 2, P_LINE)

    local rows_t = top - COL_HDR_H - 8
    local rows_b = bottom + COL_PAD

    if #list == 0 then
        text_e(self, cl + w - COL_PAD, hdr_cy, "0", "body", P_MUTED)
        text(self, ccx, (rows_t + rows_b) / 2, empty_msg, "small", P_MUTED)
        return
    end

    local per_page = math.max(1, math.floor((rows_t - rows_b + ROW_GAP) / (ROW_H + ROW_GAP)))
    self.roster_off = self.roster_off or {}
    local max_off = math.max(0, #list - per_page)
    local off = math.max(0, math.min(max_off, self.roster_off[kind] or 0))
    self.roster_off[kind] = off

    -- Count on the right of the header, showing the window when there is one.
    text_e(self, cl + w - COL_PAD - (max_off > 0 and 84 or 0), hdr_cy,
        max_off > 0
            and string.format("%d-%d of %d", off + 1, math.min(#list, off + per_page), #list)
            or tostring(#list),
        "body", P_CREAM)

    if max_off > 0 then
        btn(self, "roster_up",   cl + w - COL_PAD - 58, hdr_cy, 34, 32, "^", "neutral",
            kind, off > 0)
        btn(self, "roster_down", cl + w - COL_PAD - 18, hdr_cy, 34, 32, "v", "neutral",
            kind, off < max_off)
    end

    local y = rows_t
    for i = 1, per_page do
        local e = list[off + i]
        if not e then break end
        roster_row(self, cl + COL_PAD, y - ROW_H / 2, w - COL_PAD * 2, e, kind, owner)
        y = y - ROW_H - ROW_GAP
    end
end

-- The invite code, given its own band above the two columns. Anyone holding it
-- can join without being invited by name, so it is the one thing on this screen
-- a player actually needs to read off and pass on — it deserves better than a
-- fragment of the header's detail line.
local CODE_H = 54

local function draw_code_strip(self, cup, top)
    local code = tostring(cup.invitationCode or "")
    if code == "" then return top end

    local l, r = EDGE_L + 30, EDGE_R - 30
    local cy_  = top - CODE_H / 2

    text_w(self, l + 4, cy_ + 11, "INVITE CODE", "small", P_MUTED)
    text_w(self, l + 4, cy_ - 13, string.upper(code), "subtitle2", P_GOLD_LIGHT)
    text_w(self, l + 4 + #code * 34 * CHAR_W + 18, cy_ - 13,
        "anyone with this code can join", "small", P_MUTED)

    -- No clipboard API in the engine, so SHARE hands the code to WhatsApp the
    -- same way the lobby's share button does.
    local sw = btn_w("SHARE CODE", 25, 168)
    btn(self, "code_share", r - sw / 2, cy_, sw, 44, "SHARE CODE", "secondary", code)

    box(self, (l + r) / 2, top - CODE_H, r - l, 2, P_LINE)
    return top - CODE_H - 12
end

local function draw_roster(self, cup, owner, body_t, body_b)
    local joined  = cup.players or {}
    local pending = cup.pending or {}

    body_t = draw_code_strip(self, cup, body_t)

    local l, r = EDGE_L + 30, EDGE_R - 30
    local gap  = 26
    local w    = math.floor((r - l - gap) / 2)

    -- Reserve a line under the columns for the "why can't I start" note, so it
    -- never lands on top of a row.
    local note = owner and cup.canStart == false
    local cols_b = body_b + (note and 30 or 0)

    roster_column(self, l, w, body_t, cols_b, "Accepted", joined, "joined", owner,
        "Nobody has joined yet.")
    roster_column(self, l + w + gap, w, body_t, cols_b, "Pending", pending, "pending", owner,
        owner and "No invitations outstanding." or "No pending invitations.")

    if note then
        local need = 2 - #joined
        text(self, CX, body_b + 10,
            need > 0
                and string.format("%d more player%s needed before this cup can start.",
                    need, need == 1 and "" or "s")
                or "This cup cannot be started right now.",
            "small", P_GOLD_LIGHT)
    end
end

----------------------------------------------------------------------
-- draw
----------------------------------------------------------------------
local function rebuild(self)
    clear(self)
    if not self._active then return end

    track(self, ui.cover(LOGICAL_W, LOGICAL_H, P_BG))
    local bg = track(self, gui.new_box_node(vmath.vector3(CX, CY, 0),
        vmath.vector3(VISIBLE_W, VISIBLE_H, 0)))
    gui.set_texture(bg, "ui")
    pcall(gui.play_flipbook, bg, "texture_bg")

    -- Header + 3-stripe divider
    local hdr_h = 76
    box(self, CX, EDGE_T - hdr_h / 2, VISIBLE_W, hdr_h, vmath.vector4(0, 0, 0, 0.45))
    local d_y = EDGE_T - hdr_h - 9
    box(self, CX, d_y + 7, VISIBLE_W, 4, STRIPE_OUTER)
    box(self, CX, d_y,     VISIBLE_W, 10, STRIPE_MID)
    box(self, CX, d_y - 7, VISIBLE_W, 4, STRIPE_INNER)

    local hy = EDGE_T - hdr_h / 2
    -- Sized to their own labels, like the strip below, so neither gets clipped
    -- and both sit at the same visual weight.
    -- BACK / REFRESH are chrome, so they take the neutral face rather than
    -- competing with the actions at the foot of the screen.
    local nav_w, nav_h = btn_w("REFRESH", 25, 124), 48
    btn(self, "back", EDGE_L + 24 + nav_w / 2, hy, nav_w, nav_h, "BACK", "neutral")

    -- Title is THIS cup's name with CUP after it — "ADA CUP". Owners who
    -- already named their cup "…Cup" would otherwise read "ADA CUP CUP", so
    -- the suffix is only added when it is not already there.
    local cup = self.cup
    text(self, CX, hy + 10, cup_title(cup), "subtitle2", P_GOLD)
    if cup then
        local detail = string.format("%s  •  %s %s  •  best of %d  •  %d players",
            cup.started and "RUNNING" or "NOT STARTED",
            commas((cup.grandPrize or {}).value or 0),
            tostring(GameMode.CURRENCY_CODE or ""),
            tonumber(cup.matchFormat) or 3,
            #((cup.players) or {}))
        -- Pre-start the code gets its own band over the roster, so repeating it
        -- here would be noise. Once running there is no roster, and this is the
        -- only place left to show it.
        local code = tostring(cup.invitationCode or "")
        if cup.started and code ~= "" then
            detail = detail .. "  •  code " .. string.upper(code)
        end
        text(self, CX, hy - 16, detail, "small", P_MUTED)
    end
    btn(self, "refresh", EDGE_R - 24 - nav_w / 2, hy, nav_w, nav_h, "REFRESH",
        "neutral", nil, not self.loading)

    if self.loading then
        text(self, CX, CY, "Loading bracket...", "body", P_MUTED); return
    end
    if not cup then
        text(self, CX, CY + 10, self.err or "Could not load this cup.", "body", P_LOSS); return
    end

    local owner = is_owner(self)

    -- Owner control strip along the bottom. Which controls appear depends on
    -- the phase: before the start there is a roster to fill (INVITE) and a cup
    -- to launch; after it there is a bracket to police (REMOVE PLAYER).
    local body_b = EDGE_B + (owner and 92 or 30)
    if owner then
        local by = EDGE_B + 46
        local strip = {}
        if not cup.started then
            strip[#strip + 1] = { id = "cup_start", label = "START CUP",
                                  kind = "primary", enabled = cup.canStart ~= false }
            strip[#strip + 1] = { id = "cup_invite", label = "INVITE PLAYERS",
                                  kind = "secondary" }
        else
            strip[#strip + 1] = { id = "cup_remove_mode",
                label = self.remove_mode and "DONE REMOVING" or "REMOVE PLAYER",
                kind = self.remove_mode and "primary" or "secondary" }
        end
        strip[#strip + 1] = { id = "cup_delete",
            label = (self.confirm_delete and "TAP TO CONFIRM") or "DELETE CUP",
            kind = "danger" }

        -- Each button is sized to its own label at btn_sm rather than every
        -- button sharing one fixed width: "INVITE PLAYERS" needs noticeably
        -- more room than "START CUP", and a single width either cramped the
        -- long one or left the short ones swimming.
        local GAP, BH = 16, 52
        local total = 0
        for _, b in ipairs(strip) do
            b.w = btn_w(b.label, 25, 168)
            total = total + b.w
        end
        total = total + (#strip - 1) * GAP

        -- Shrink to fit rather than run off a narrow screen.
        local room = (EDGE_R - 30) - (EDGE_L + 30)
        if total > room then
            local scale = room / total
            total = 0
            for _, b in ipairs(strip) do
                b.w = math.floor(b.w * scale)
                total = total + b.w
            end
            total = total + (#strip - 1) * GAP
        end

        local x = CX - total / 2
        for _, b in ipairs(strip) do
            btn(self, b.id, x + b.w / 2, by, b.w, BH, b.label, b.kind, nil, b.enabled)
            x = x + b.w + GAP
        end
        if self.remove_mode then
            text(self, CX, by + 34, "Tap a player in the bracket to remove them",
                "small", P_GOLD_LIGHT)
        end
    end

    ------------------------------------------------------------------
    -- Before the start: the roster, not an empty bracket
    ------------------------------------------------------------------
    local body_t = d_y - 26
    if not cup.started then
        draw_roster(self, cup, owner, body_t, body_b + 22)
        return
    end

    ------------------------------------------------------------------
    -- The bracket itself
    ------------------------------------------------------------------
    local rounds = cup.rounds or {}
    local waiting = unplayed(self)

    -- An "ENTRANTS" column precedes the played stages so a freshly started
    -- cup still draws something meaningful.
    local cols = {}
    if #waiting > 0 then
        cols[#cols + 1] = { name = "ENTRANTS", entrants = waiting }
    end
    for _, r in ipairs(rounds) do
        cols[#cols + 1] = { name = r.name, matches = r.matches or {}, level = r.level }
    end

    if #cols == 0 then
        text(self, CX, CY + 12, "No matches played yet.", "body", P_MUTED)
        text(self, CX, CY - 14,
            cup.started and "The bracket fills in as games are won."
                or "Start the cup to begin the bracket.", "small", P_MUTED)
        return
    end

    local chart_l, chart_r = EDGE_L + 26, EDGE_R - 26
    local avail = chart_r - chart_l
    local col_w = math.floor(math.min(COL_MAX_W,
        math.max(COL_MIN_W, (avail - COL_GAP * (#cols - 1)) / #cols)))
    local span = #cols * col_w + (#cols - 1) * COL_GAP

    -- More stages than fit: scroll horizontally a column at a time.
    local max_scroll = math.max(0, #cols - math.max(1, math.floor((avail + COL_GAP) / (col_w + COL_GAP))))
    self.col_off = math.max(0, math.min(max_scroll, self.col_off or 0))
    local first = self.col_off + 1
    local visible = math.max(1, math.floor((avail + COL_GAP) / (col_w + COL_GAP)))

    if max_scroll > 0 then
        btn(self, "col_prev", chart_l + 40, body_b + 18, 76, 30, "<", "neutral", nil, self.col_off > 0)
        btn(self, "col_next", chart_l + 124, body_b + 18, 76, 30, ">", "neutral", nil, self.col_off < max_scroll)
        text_e(self, chart_r, body_b + 18,
            string.format("stages %d-%d of %d", first, math.min(#cols, first + visible - 1), #cols),
            "small", P_MUTED)
        body_b = body_b + 44
    end

    local col_top = body_t - 30

    for slot = 0, visible - 1 do
        local ci = first + slot
        local col = cols[ci]
        if not col then break end
        local cl  = chart_l + slot * (col_w + COL_GAP)
        local ccx = cl + col_w / 2

        -- Stage header: type and a hairline, matching the roster's column
        -- titles. No panel art on a title.
        text(self, ccx, body_t - 15, string.upper(tostring(col.name)), "small", P_GOLD_LIGHT)
        box(self, ccx, body_t - 30, col_w, 2, P_LINE)

        local y = col_top - 8

        -- Entrants column: one seat per waiting player.
        for _, p in ipairs(col.entrants or {}) do
            if y - SEAT_H < body_b then break end
            local cy_ = y - SEAT_H / 2
            local mine = tostring(p.playerId) == my_id()
            -- List item: flat fill with a state-coloured spine, as in the
            -- roster. The match boxes below ARE containers and keep their art.
            box(self, ccx, cy_, col_w, SEAT_H, mine and ROW_MINE or ROW_FILL)
            box(self, ccx - col_w / 2 + 2, cy_, 4, SEAT_H - 6,
                mine and P_GOLD_LIGHT or P_MUTED)
            text_w(self, cl + 12, cy_, short(p.username, 14), "small",
                mine and P_GOLD_LIGHT or P_CREAM)
            if owner and self.remove_mode then
                text_e(self, cl + col_w - 10, cy_, "X", "small", P_LOSS)
            end
            local hit = box(self, ccx, cy_, col_w, SEAT_H, P_TRANSP)
            self.buttons[#self.buttons + 1] =
                { node = hit, id = "player", data = p.playerId }
            y = y - SEAT_H - 6
        end

        -- Played stage: a match box per pairing, two seats each.
        for mi, m in ipairs(col.matches or {}) do
            if y - MATCH_H < body_b then break end
            local top = y
            local mcy = top - MATCH_H / 2

            panel(self, ccx, mcy, col_w, MATCH_H)

            local function seat(side, sy)
                local mine = tostring(side.playerId) == my_id()
                local col_txt = side.won and P_WIN or P_LOSS
                box(self, ccx, sy, col_w - 14, SEAT_H - 4,
                    side.won and vmath.vector4(0.10, 0.16, 0.11, 1) or P_B_OUTER)
                text_w(self, cl + 14, sy, short(side.username, 12), "small",
                    mine and P_GOLD_LIGHT or P_CREAM)
                text_e(self, cl + col_w - 14, sy, tostring(tonumber(side.score) or 0),
                    "small", col_txt)
                local hit = box(self, ccx, sy, col_w - 14, SEAT_H - 4, P_TRANSP)
                self.buttons[#self.buttons + 1] =
                    { node = hit, id = "player", data = side.playerId }
            end
            seat(m.a, top - SEAT_H / 2 - 3)
            seat(m.b, top - SEAT_H - SEAT_H / 2 - 3)

            -- Elbow connector into the next stage: out of the match's right
            -- edge, then a short vertical join. Drawn only when there IS a
            -- next column on screen, so nothing dangles off the edge.
            if cols[ci + 1] and slot < visible - 1 then
                box(self, cl + col_w + COL_GAP / 4, mcy, COL_GAP / 2, 2, P_LINE)
                if mi % 2 == 1 and col.matches[mi + 1] then
                    local nxt_cy = mcy - (MATCH_H + MATCH_GAP)
                    box(self, cl + col_w + COL_GAP / 2, (mcy + nxt_cy) / 2,
                        2, math.abs(mcy - nxt_cy), P_LINE)
                end
            end

            y = y - MATCH_H - MATCH_GAP
        end
    end

    ------------------------------------------------------------------
    -- Selected player strip
    ------------------------------------------------------------------
    local p = self.selected and find_player(self, self.selected) or nil
    if p then
        local sy = body_b + 4
        local sw = math.min(560, chart_r - chart_l)
        panel(self, CX, sy + 22, sw, 44, nil, "container_bg_active")
        local wins, losses = 0, 0
        for _, r in ipairs(p.levelResults or {}) do
            if r.won then wins = wins + 1 else losses = losses + 1 end
        end
        text_w(self, CX - sw / 2 + 14, sy + 22,
            string.upper(short(p.username, 16)) ..
            (p.isChampion and "  —  CHAMPION" or ""), "small",
            p.isChampion and P_GOLD or P_CREAM)
        text_e(self, CX + sw / 2 - 14, sy + 22,
            string.format("%d won  •  %d lost  •  cleared %d",
                wins, losses, tonumber(p.clearedLevel) or 0), "small", P_MUTED)
    end
end

----------------------------------------------------------------------
-- actions
----------------------------------------------------------------------
local function load(self)
    local id = self.cup_id
    if not id or id == "" then
        self.loading, self.err = false, "No cup selected."
        rebuild(self); return
    end
    self.loading, self.err = true, nil
    rebuild(self)
    api.get_team_tournament_bracket(id, function(res)
        if not self._active then return end
        self.loading = false
        if res.success then
            self.cup = res.data
            if not self.selected then
                local me = find_player(self, my_id())
                self.selected = me and me.playerId or nil
            end
        else
            self.cup = nil
            self.err = (res.data and res.data.error) or res.message or "Could not load this cup."
        end
        rebuild(self)
    end)
end

local function remove_player(self, player_id)
    local p = find_player(self, player_id)
    if not p then return end
    api.drop_team_player(self.cup_id, my_id(), player_id, function(res)
        if res.success then
            toast.success(short(p.username, 16) .. " removed.")
        else
            toast.error((res.data and res.data.error) or res.message or "Could not remove them.")
        end
        load(self)
    end)
end

local function find_pending(self, pid)
    for _, p in ipairs((self.cup or {}).pending or {}) do
        if tostring(p.playerId) == tostring(pid) then return p end
    end
    return nil
end

local function revoke_invite(self, player_id)
    local p = find_pending(self, player_id)
    if not p then return end
    api.revoke_team_invitation(self.cup_id, my_id(), player_id, function(res)
        if res.success then
            toast.success("Invitation to " .. short(p.username, 16) .. " withdrawn.")
        else
            toast.error((res.data and res.data.error) or res.message
                or "Could not withdraw that invitation.")
        end
        load(self)
    end)
end

----------------------------------------------------------------------
-- lifecycle
----------------------------------------------------------------------
function init(self)
    self.nodes, self.buttons = {}, {}
    refresh_wh()
end

function on_message(self, message_id, message, sender)
    if message_id == hash("screen_enter") then
        refresh_wh()
        msg.post(".", "acquire_input_focus")
        self._active = true
        self.cup_id = tostring(app_state.standings_cup_id or "")
        self.cup, self.selected, self.err = nil, nil, nil
        self.col_off, self.remove_mode, self.confirm_delete = 0, false, false
        self.roster_off = { joined = 0, pending = 0 }
        load(self)
    elseif message_id == hash("enable") then
        refresh_wh(); self._active = true; rebuild(self)
    elseif message_id == hash("disable") then
        -- No release_input_focus: it is a game-OBJECT message and every screen
        -- is a component on the same object, so releasing kills input for all
        -- of them. self._active already gates this screen's on_input.
        self._active = false
        clear(self)
    elseif message_id == hash("layout_changed") then
        refresh_wh(); rebuild(self)
    end
end

function on_input(self, action_id, action)
    -- Any modal on top outranks a screen. These components are listed
    -- BEFORE the dialogs in controller.go, so without this they would
    -- consume the tap first and act on it behind an open dialog.
    if app_state.input_blocked() then return false end
    if not self._active then return false end
    if action_id ~= hash("touch") or not action.pressed then return false end

    -- Raw coordinates, as on every other screen.
    for i = #self.buttons, 1, -1 do
        local b = self.buttons[i]
        if gui.pick_node(b.node, action.x, action.y) then
            if b.id == "back" then
                msg.post("#controller", "goto_lobby")
            elseif b.id == "refresh" then
                load(self)
            elseif b.id == "col_prev" then
                self.col_off = math.max(0, (self.col_off or 0) - 1); rebuild(self)
            elseif b.id == "col_next" then
                self.col_off = (self.col_off or 0) + 1; rebuild(self)
            elseif b.id == "player" then
                if self.remove_mode and is_owner(self) then
                    remove_player(self, b.data)
                elseif tostring(self.selected or "") == tostring(b.data) then
                    self.selected = nil; rebuild(self)
                else
                    self.selected = b.data; rebuild(self)
                end
            elseif b.id == "cup_start" then
                if not self.starting then
                    self.starting = true
                    api.start_team_tournament(self.cup_id, my_id(), function(res)
                        self.starting = false
                        if res.success then toast.success("Cup started — good luck!")
                        else toast.error((res.data and res.data.error) or res.message
                            or "Could not start the cup.") end
                        load(self)
                    end)
                end
            elseif b.id == "code_share" then
                pcall(function()
                    local cfg = require("modules.config")
                    local name = tostring((self.cup or {}).name or "my team cup")
                    sys.open_url("https://wa.me/?text="
                        .. url_encode("Join " .. name .. " on " .. tostring(GameMode.BRAND or "")
                            .. "! Invite code: " .. string.upper(tostring(b.data or ""))
                            .. "  https://" .. tostring(cfg.DOMAIN or "")))
                end)
            elseif b.id == "roster_up" or b.id == "roster_down" then
                -- b.data is the column key ("joined" / "pending"), so the two
                -- lists page independently.
                self.roster_off = self.roster_off or {}
                local k = tostring(b.data)
                local d = (b.id == "roster_up") and -1 or 1
                self.roster_off[k] = math.max(0, (self.roster_off[k] or 0) + d)
                rebuild(self)
            elseif b.id == "player_remove" then
                if is_owner(self) then remove_player(self, b.data) end
            elseif b.id == "invite_revoke" then
                if is_owner(self) then revoke_invite(self, b.data) end
            elseif b.id == "cup_invite" then
                -- Inviting needs the keyboard-driven username field, which
                -- lives on the create/edit screen. Seed it with this cup so it
                -- opens in EDIT mode against the right bracket rather than
                -- starting a second one.
                app_state.team_edit = self.cup
                msg.post("#controller", "goto_team_tournament")
            elseif b.id == "cup_remove_mode" then
                self.remove_mode = not self.remove_mode
                self.confirm_delete = false
                rebuild(self)
            elseif b.id == "cup_delete" then
                -- Two taps: deleting drops the cup for everyone who joined.
                if not self.confirm_delete then
                    self.confirm_delete = true
                    rebuild(self)
                elseif not self.deleting then
                    self.deleting = true
                    api.delete_team_tournament(self.cup_id, my_id(), function(res)
                        self.deleting = false
                        if res.success then
                            local refund = tonumber((res.data or {}).refunded) or 0
                            local u = ws.current_user_data or {}
                            if refund > 0 then u.balance = (tonumber(u.balance) or 0) + refund end
                            u.myTeamTournamentId = nil
                            u.myTeamTournamentIsOwner = nil
                            ws.current_user_data = u
                            toast.success(refund > 0
                                and ("Cup deleted — " .. commas(refund) .. " refunded.")
                                or "Cup deleted.")
                            msg.post("#controller", "goto_lobby")
                        else
                            self.confirm_delete = false
                            toast.error((res.data and res.data.error) or res.message
                                or "Could not delete the cup.")
                            rebuild(self)
                        end
                    end)
                end
            end
            return true
        end
    end
    return false
end
